//@version=6
// Independent book companion. No EBW code is included or overwritten.
// Source: แกะกราฟเทคนิคอล, นพ.เมธา อาจหาญ (2563), supplied by the user.
// Computational conventions and discretionary limits: BOOK_RULES_TH.md.
// Internal revision 1.7: optional single-row Hero TF dashboard.
// EW source: Frost/Prechter, Elliott Wave Principle, tenth edition (2005).
// Swing matches are explicit engineering tests, NOT proof of Elliott degree/subwaves.
indicator("EBW-Fibo 1.9 • Strength Map", "EBW-Fibo 1.9 ZB", overlay = true, max_lines_count = 150, max_labels_count = 200, max_boxes_count = 10, max_bars_back = 2000)

// BEGIN ZONE BRIDGE SWITCHES
// Keep the seven input positions and all 17 source input titles/order compatible.
const string CF_QUICK = "00 · ความแข็งแรงของแนวรับ–แนวต้าน"
bool cf_enabled = input.bool(true, "ประเมินแนวกล่อง + ฟิโบ", group=CF_QUICK, tooltip="อ่านกล่องจาก All Indy ผ่าน ZB 00–16 แล้วแสดงหลักฐานของแต่ละบริเวณ สูงสุด 2 แนวรับ + 2 แนวต้าน", display=display.none)
bool cf_showLabels = input.bool(true, "แสดงคะแนนและช่วงราคาของแต่ละแนว", group=CF_QUICK, display=display.none)
bool cf_debug = input.bool(false, "แสดงสถานะการเชื่อมและเหตุผล", group=CF_QUICK, display=display.none)
const string CF_RULES = "08 · รวมแนวใกล้กัน / เกณฑ์ช่วยประเมิน"
float cf_minZone = input.float(0, "คะแนนกล่องขั้นต่ำที่แสดง", minval=0, maxval=100, step=1, group=CF_RULES, tooltip="0 = แสดงทุกกล่องที่ต้นทางส่งมา พร้อมคะแนนจริง ไม่ได้แปลว่าทุกกล่องแข็งแรง", display=display.none)
float cf_tolerance = input.float(1.0, "ระยะฟิโบใกล้กล่อง (ATR ของกราฟ)", minval=0, maxval=2, step=0.05, group=CF_RULES, tooltip="นับเป้าที่ห่างจากขอบกล่องไม่เกินระยะนี้เป็นบริเวณเดียวกัน ไม่ผูกกับความบางของกล่อง; 0 = ต้องทับกล่องจริง ระยะนี้เป็นค่าช่วยจัดกลุ่ม ไม่ใช่สูตรจากหนังสือ", display=display.none)
string cf_scope = input.string("ชุดฟิโบที่เปิดแสดง", "ชุดฟิโบที่นำมาเทียบ", options=["ชุดฟิโบที่เปิดแสดง", "Current + TF ใหญ่ 1/2"], group=CF_RULES, tooltip="พิจารณาเฉพาะชุดที่ยังมีผลหลัง Break ค่าแรกใช้ชุดที่เปิดแสดง; ตัวเลือกที่สองรวม TF ใหญ่แม้ปิดการวาด", display=display.none)
int cf_labelBars = input.int(5, "ระยะป้ายจากแท่งล่าสุด", minval=1, maxval=100, group=CF_RULES, display=display.none)
// END ZONE BRIDGE SWITCHES

// Switches are deliberately the first inputs.
string G0 = "01 · เปิด / ปิดระบบ"
bool uiBoard = input.bool(false, "Dashboard · รายละเอียดที่มีข้อมูล", group = G0, display = display.none)
bool uiLinks = input.bool(true, "แผง TF พระเอก / ความสัมพันธ์ที่ตรวจพบ", group = G0, tooltip = "พระเอกอ้างอิงช่วงราคา ไม่ใช่ TF ที่เปิดกราฟ; สแกน 10m / 30m / 1H / 2H / 4H / 1D / 1W / 1M และ TF อ้างอิง ไม่ใช้ Chart เป็น fallback", display = display.none)
bool uiEW = input.bool(true, "EW · ผลตรวจราคาที่ชัดเจนบนแผง", group = G0, tooltip = "แสดงเฉพาะเมื่อเปิดตรวจจุดเองและใส่ราคา/เวลาครบ; ไม่แสดง 1–2? / ABC? / W3? และไม่ยืนยัน subwaves หรือ degree", display = display.none)
bool uiEWManual = input.bool(false, "EW · ตรวจจุดที่เลือกเองเพิ่มเติม", group = G0, display = display.none)
bool uiEWChannel = input.bool(false, "EW · Channel ของ Impulse ที่เลือกเอง", group = G0, display = display.none)
bool uiFrames = input.bool(true, "กรอบปรับฐานที่ผ่านเงื่อนไข", group = G0, display = display.none)
bool uiTargets = input.bool(true, "Fibonacci หาเป้า (หลัง Break เท่านั้น)", group = G0, display = display.none)
bool uiAnchors = input.bool(true, "จุดยึดฟิโบ + เส้นเชื่อมสวิง", group = G0, display = display.none)
bool uiRetrace = input.bool(false, "Fibonacci Retrace / Gauge", group = G0, display = display.none)
bool uiZones = input.bool(false, "โซนสุญญากาศ 261.8–423.6", group = G0, display = display.none)
bool uiTS = input.bool(false, "เส้น Trailing Stop / Cut (ไม่มีป้าย Action)", group = G0, display = display.none)
bool uiInvalid = input.bool(false, "ข้อความเมื่อชุดฟิโบถูกทำลาย", group = G0, display = display.none)
bool uiDiv = input.bool(false, "Regular + Hidden divergence", group = G0, display = display.none)
bool uiCycles = input.bool(false, "จุดรอบ Stochastic / RSI", group = G0, display = display.none)
bool uiMTF = input.bool(false, "กรอบและเป้า TF ใหญ่ที่เลือก", group = G0, display = display.none)
bool uiClusters = input.bool(false, "Cluster ระหว่างชุด Current / TF ใหญ่", group = G0, display = display.none)

string G1 = "02 · ค่าหนังสือ / การยืนยัน"
int rLen = input.int(14, "RSI", minval = 2, maxval = 100, group = G1, display = display.none)
int kLen = input.int(9, "Stochastic length", minval = 2, maxval = 100, group = G1, display = display.none)
int kSmooth = input.int(3, "Smooth K", minval = 1, maxval = 20, group = G1, display = display.none)
int dSmooth = input.int(3, "Smooth D", minval = 1, maxval = 20, group = G1, display = display.none)
float rOS = input.float(30, "RSI OS", minval = 1, maxval = 49, group = G1, display = display.none)
float rOB = input.float(70, "RSI OB", minval = 51, maxval = 99, group = G1, display = display.none)
float kOS = input.float(20, "Stochastic OS", minval = 1, maxval = 49, group = G1, display = display.none)
float kOB = input.float(80, "Stochastic OB", minval = 51, maxval = 99, group = G1, display = display.none)
string breakMode = input.string("Wick ของแท่งปิด", "Break กรอบ", options = ["Wick ของแท่งปิด", "Close ของแท่งปิด"], group = G1, display = display.none)
bool allowNeck = input.bool(true, "กรอบหักคอ: ต้องมี Regular divergence ในรอบ", group = G1, display = display.none)
int divLen = input.int(3, "ยืนยัน pivot สำหรับ Divergence เท่านั้น", minval = 1, maxval = 20, group = G1, display = display.none)

string G2 = "03 · เชื่อม Time Frame"
string tf1 = input.timeframe("240", "TF ใหญ่ 1", group = G2, display = display.none)
string tf2 = input.timeframe("D", "TF ใหญ่ 2", group = G2, display = display.none)
string controlTF = input.string("TF ใหญ่ 1", "บริบทสำหรับ Action 2–5", options = ["TF ใหญ่ 1", "TF ใหญ่ 2"], group = G2, display = display.none)
float clusterATR = input.float(0.1, "ระยะ Cluster (ATR) — ค่าของโค้ด ไม่ใช่สูตรเล่ม", minval = 0, maxval = 1, step = 0.01, group = G2, display = display.none)
float linkATR = input.float(0.03, "คลาดเคลื่อนจุดร่วม (ATR ของ TF ใหญ่)", minval = 0, maxval = 0.2, step = 0.01, group = G2, tooltip = "ข้อกำหนดของโค้ด ไม่ใช่สูตรหนังสือ; ต้องตรงช่วงแท่ง A/B/C และราคาด้วย ไม่ใช้ทิศตรงกันอย่างเดียว", display = display.none)
bool requireLink = input.bool(false, "Action 2–5 ต้องผ่านการเชื่อม TF ด้วย", group = G2, tooltip = "ปิด = คง Action เดิม; เปิด = ต้องมีความสัมพันธ์เวลา/ราคาในกรอบใหญ่ที่ Break แล้ว อาจได้ Alert น้อยลง ไม่เปลี่ยนสูตรฟิโบ", display = display.none)
string boardCorner = input.string("ขวาบน", "ตำแหน่งแผง", options = ["ขวาบน", "ซ้ายบน", "ขวาล่าง"], group = G2, display = display.none)

string GH = "03A · TF พระเอก — ช่วงราคาอ้างอิง"
string heroRefTF = input.timeframe("60", "TF อ้างอิงรอบราคา (ไม่ใช่ TF พระเอก)", group = GH, tooltip = "ใช้รอบ Sto ของ TF นี้ระบุจุดเริ่มของขาล่าสุด ไม่เปลี่ยนตาม TF กราฟ; TF อ้างอิงไม่มี Form ก็ไม่ถูกตั้งเป็นพระเอก", display = display.none)
string heroRefMode = input.string("Auto · ขาจากรอบ Sto ล่าสุด", "ช่วงที่ต้องการหาพระเอก", options = ["Auto · ขาจากรอบ Sto ล่าสุด", "เลือกจุดเริ่มเอง → ราคาล่าสุด"], group = GH, tooltip = "พระเอกผูกกับช่วง M→N หรือ N→O ที่กำลังศึกษา ไม่ใช่ชื่อเดียวสำหรับทุกขา; Auto ใช้จุดสุดขั้ว Sto ที่ยืนยันแล้ว → ราคาปิดล่าสุดของ TF อ้างอิง", display = display.none)
float heroStartP = input.float(0, "ราคาจุดเริ่ม M / N", inline = "href", group = GH, active = heroRefMode == "เลือกจุดเริ่มเอง → ราคาล่าสุด", display = display.none)
int heroStartT = input.time(0, "เวลาจุดเริ่ม", inline = "href", group = GH, active = heroRefMode == "เลือกจุดเริ่มเอง → ราคาล่าสุด", display = display.none)

string G3 = "04 · Action 5 ท่า / เครื่องมือวางแผน"
bool act1 = input.bool(true, "A1 · บริบท Current + Trailing Start", group = G3, display = display.none)
bool act2 = input.bool(true, "A2 · บริบท TF ใหญ่ + Regular divergence Current + TS", group = G3, display = display.none)
bool act3 = input.bool(true, "A3 · บริบท TF ใหญ่ + Form Current + TS", group = G3, display = display.none)
bool act4 = input.bool(true, "A4 · บริบท TF ใหญ่ + Break Form Current", group = G3, display = display.none)
bool act5 = input.bool(true, "A5 · Gap ข้าม Form + Break แท่งแรก", group = G3, display = display.none)

string G4 = "05 · Fibonacci / ภาพ"
string fibChoice = input.string("Auto ตาม Gauge D→A→B", "เลือกวิธี", options = ["Auto ตาม Gauge D→A→B", "Extension (เลือกเอง)", "Projection (เลือกเอง)"], group = G4, display = display.none)
bool overrideD = input.bool(false, "ใช้ D อ้างอิงใหญ่ที่เลือกเอง (เฉพาะ Current)", group = G4, display = display.none)
float manualD = input.float(0, "ราคา D ก่อน A", group = G4, active = overrideD, display = display.none)
int manualDT = input.time(0, "เวลา D ก่อน A", group = G4, active = overrideD, display = display.none)
int reach = input.int(8, "ระยะป้ายไปทางขวา (แท่ง)", minval = 1, maxval = 100, group = G4, display = display.none)
bool uiInner = input.bool(false, "เป้า: แสดงระดับย่อย 38.2–78.6%", group = G4, display = display.none)
bool uiLabels = input.bool(true, "ราคา / ป้ายระดับ", group = G4, display = display.none)
bool stickLabels = input.bool(true, "ป้ายชิดแท่งล่าสุด (เหมาะกับจอแคบ)", group = G4, display = display.none)
bool pairLabels = input.bool(true, "รวมป้าย 350% / 361.8% ที่อยู่ใกล้กัน", group = G4, display = display.none)
string labelScale = input.string("ปกติ", "ขนาดตัวอักษร", options = ["เล็ก", "ปกติ", "ใหญ่"], group = G4, display = display.none)

string G5 = "06 · Elliott — ตรวจราคา ไม่ยืนยันคลื่นย่อย"
string ewKind = input.string("Impulse 0–5", "แบบที่ตรวจ", options = ["Impulse 0–5", "Zigzag 0–A–B–C", "Flat 0–A–B–C", "Diagonal 0–5", "Triangle 0–A–B–C–D–E"], group = G5, active = uiEWManual, display = display.none)
string ewDiag = input.string("Ending 5/C", "ตำแหน่ง Diagonal ที่ผู้ใช้เลือก", options = ["Ending 5/C", "Leading 1/A"], group = G5, active = uiEWManual and ewKind == "Diagonal 0–5", display = display.none)
string ewTriangle = input.string("Contracting", "ชนิด Triangle", options = ["Contracting", "Barrier", "Expanding"], group = G5, active = uiEWManual and ewKind == "Triangle 0–A–B–C–D–E", display = display.none)
// Manual prices are hypotheses; no subwave/parent classification is inferred.
float ew0 = input.float(0, "จุด 0", inline = "w0", group = G5, active = uiEWManual, display = display.none)
int et0 = input.time(0, "เวลา", inline = "w0", group = G5, active = uiEWManual, display = display.none)
float ew1 = input.float(0, "จุด 1 / A", inline = "w1", group = G5, active = uiEWManual, display = display.none)
int et1 = input.time(0, "เวลา", inline = "w1", group = G5, active = uiEWManual, display = display.none)
float ew2 = input.float(0, "จุด 2 / B", inline = "w2", group = G5, active = uiEWManual, display = display.none)
int et2 = input.time(0, "เวลา", inline = "w2", group = G5, active = uiEWManual, display = display.none)
float ew3 = input.float(0, "จุด 3 / C", inline = "w3", group = G5, active = uiEWManual, display = display.none)
int et3 = input.time(0, "เวลา", inline = "w3", group = G5, active = uiEWManual, display = display.none)
float ew4 = input.float(0, "จุด 4 / D", inline = "w4", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)
int et4 = input.time(0, "เวลา", inline = "w4", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)
float ew5 = input.float(0, "จุด 5 / E", inline = "w5", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)
int et5 = input.time(0, "เวลา", inline = "w5", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)

// Append inputs to preserve the saved input order; group G0 keeps them near the top.
string visualMode = input.string("สะอาด", "รูปแบบการแสดงผล", options = ["สะอาด", "ละเอียด"], group = G0, tooltip = "สะอาด: ลดข้อความซ้ำ เน้นระดับหลัก แผงสั้น; เส้นระดับเสริมยังอยู่ เลือกละเอียดเพื่อดูป้ายทุกระดับและความสัมพันธ์ TF ครบ", display = display.none)
bool uiHeroOnly = input.bool(true, "แสดงเฉพาะ TF พระเอก (แผงแถวเดียว)", group = G0, tooltip = "เปิด: แผงเหลือเพียง TF พระเอกและทิศทาง เช่น 2H · ขาลง ↓; ปิด: แสดงรายละเอียดตามตัวเลือก Dashboard / TF Link / EW เดิม รายละเอียดพระเอกยังอ่านได้จาก tooltip ของแถวนี้", display = display.none)
// BEGIN ZONE BRIDGE SOURCES
const string CF_CONNECT = "07 · เชื่อม All Indy / เลือกชื่อ ZB ให้ตรงกันครั้งแรก"
float cf_sync = input.source(close, "ZB 00 SYNC", group=CF_CONNECT, tooltip="เลือก All Indy EBW ZB: ZB 00 SYNC ไม่ใช่ Close; ทุกช่องต้องมาจาก All Indy ตัวเดียวกัน", display=display.none)
float cf_d1_low = input.source(close, "ZB 01 D1 LOW", group=CF_CONNECT, display=display.none)
float cf_d1_high = input.source(close, "ZB 02 D1 HIGH", group=CF_CONNECT, display=display.none)
float cf_d1_score = input.source(close, "ZB 03 D1 SCORE", group=CF_CONNECT, display=display.none)
float cf_d1_check = input.source(close, "ZB 04 D1 CHECK", group=CF_CONNECT, display=display.none)
float cf_d2_low = input.source(close, "ZB 05 D2 LOW", group=CF_CONNECT, display=display.none)
float cf_d2_high = input.source(close, "ZB 06 D2 HIGH", group=CF_CONNECT, display=display.none)
float cf_d2_score = input.source(close, "ZB 07 D2 SCORE", group=CF_CONNECT, display=display.none)
float cf_d2_check = input.source(close, "ZB 08 D2 CHECK", group=CF_CONNECT, display=display.none)
float cf_s1_low = input.source(close, "ZB 09 S1 LOW", group=CF_CONNECT, display=display.none)
float cf_s1_high = input.source(close, "ZB 10 S1 HIGH", group=CF_CONNECT, display=display.none)
float cf_s1_score = input.source(close, "ZB 11 S1 SCORE", group=CF_CONNECT, display=display.none)
float cf_s1_check = input.source(close, "ZB 12 S1 CHECK", group=CF_CONNECT, display=display.none)
float cf_s2_low = input.source(close, "ZB 13 S2 LOW", group=CF_CONNECT, display=display.none)
float cf_s2_high = input.source(close, "ZB 14 S2 HIGH", group=CF_CONNECT, display=display.none)
float cf_s2_score = input.source(close, "ZB 15 S2 SCORE", group=CF_CONNECT, display=display.none)
float cf_s2_check = input.source(close, "ZB 16 S2 CHECK", group=CF_CONNECT, display=display.none)
// END ZONE BRIDGE SOURCES

bool cleanView = visualMode == "สะอาด"
bool darkView = color.r(chart.bg_color) * 0.299 + color.g(chart.bg_color) * 0.587 + color.b(chart.bg_color) * 0.114 < 128
color UP = darkView ? #6BBFA9 : #1F7661
color DN = darkView ? #D797A2 : #A34659
color GOLD = darkView ? #E6C77B : #8D6828
color INK = darkView ? #D7DEE8 : #253449
color MUTED = darkView ? #94A2B4 : #65758A
color PANEL = darkView ? #111820 : #F4F6F9
color RULE = darkView ? #506073 : #B1BCCB
color HEAD = darkView ? #1B2531 : #E5EBF2
string labelSize = labelScale == "ใหญ่" ? size.normal : labelScale == "เล็ก" ? size.tiny : size.small
int panelTextSize = labelScale == "ใหญ่" ? 14 : labelScale == "เล็ก" ? 10 : 12
int panelTitleSize = labelScale == "ใหญ่" ? 18 : labelScale == "เล็ก" ? 13 : 16
var array<float> ratios = array.from(0.0, 0.382, 0.5, 0.618, 0.786, 1.0, 1.618, 2.0, 2.618, 3.5, 3.618, 4.236)

type Point
    int kind = 0
    float p = na
    float r = na
    int t = na
    int i = na
    float trigger = na
    int closeT = na

type Episode
    int kind = 0
    float p = na
    float r = na
    int t = na
    int i = na
    float trigger = na
    int closeT = na

type Frame
    int side = 0
    int stage = 0
    bool neck = false
    bool joint = false
    Point a
    Point b
    Point c
    Point ref
    float gauge = na
    int known = na

// Flat scalar snapshot: no mutable nested references cross request.security.
type View
    int asof = na
    float rangeATR = na
    int aEnd = na
    int bEnd = na
    int cEnd = na
    int paEnd = na
    int pbEnd = na
    int pcEnd = na
    float legLow = na
    float legHigh = na
    float frameLow = na
    float frameHigh = na
    float r = na
    float k = na
    float d = na
    int rBias = 0
    int kBias = 0
    float rCut = na
    float kCut = na
    int rCutT = na
    int kCutT = na
    int div = 0
    float divFrom = na
    int divFromT = na
    float divTo = na
    int divToT = na
    int divKnown = na
    int eventKind = 0
    float eventPrice = na
    int eventT = na
    int rEvent = 0
    int fside = 0
    int fstage = 0
    bool neck = false
    bool joint = false
    float a = na
    float b = na
    float c = na
    float ref = na
    int at = na
    int bt = na
    int ct = na
    int rt = na
    float gauge = na
    int fknown = na
    int side = 0
    int method = 0
    float zero = na
    float span = na
    int id = na
    int zeroT = na
    int born = na
    float pa = na
    float pb = na
    int pat = na
    int pbt = na
    float pref = na
    int preft = na
    float pgauge = na
    bool pneck = false
    bool pjoint = false
    int ts = 0
    bool formedTS = false
    int broke = 0
    int gap = 0
    float cut = na
    float trail = na
    int trailSide = 0
    int stopped = 0
    int invalid = 0
    int progress = 0

// Chart-side snapshots only. No nested mutable object crosses request.security.
type SwingContext
    int side = 0
    int phase = 0
    float a = na
    float b = na
    float c = na
    int at = na
    int bt = na
    int ct = na
    int ae = na
    int be = na
    int ce = na
    int known = na
    int asof = na
    float lo = na
    float hi = na
    bool neck = false

type LinkState
    int code = 0
    int parentId = na
    int parentPhase = 0
    int parentSide = 0

// Compact immutable feed for the hero scanner; no chart drawings or Action state.
type HeroFeed
    bool ready = false
    int historyFrom = na
    int asof = na
    float price = na
    float atr = na
    int pivotKind = 0
    float pivotP = na
    int pivotT = na
    float pivotLow = na
    float pivotHigh = na
    bool rangeKnown = false
    float manualLow = na
    float manualHigh = na
    bool manualRangeKnown = false
    int formSide = 0
    int formKnown = na
    int watchT = na
    float watchLow = na
    float watchHigh = na
    int upPhase = 0
    float upA = na
    float upB = na
    float upC = na
    int upAT = na
    int upAE = na
    int upBT = na
    int upCT = na
    int upCE = na
    int upKnown = na
    float upLow = na
    float upHigh = na
    int dnPhase = 0
    float dnA = na
    float dnB = na
    float dnC = na
    int dnAT = na
    int dnAE = na
    int dnBT = na
    int dnCT = na
    int dnCE = na
    int dnKnown = na
    float dnLow = na
    float dnHigh = na

type HeroRange
    int side = 0
    float fromP = na
    int fromT = na
    float toP = na
    int toT = na
    float lo = na
    float hi = na
    bool rangeKnown = false

f_price(float p) =>
    na(p) ? "—" : str.tostring(p, format.mintick)

f_copy(Point p) =>
    Point.new(p.kind, p.p, p.r, p.t, p.i, p.trigger, p.closeT)

// The episode is a zone visit, not an arbitrary Zigzag pivot.
method step(Episode e, float osc, float os, float ob, float rr) =>
    Point event = Point.new()
    int zone = osc <= os ? -1 : osc >= ob ? 1 : 0
    if e.kind != 0
        bool newExtreme = e.kind == -1 ? low < e.p : high > e.p
        if newExtreme
            e.p := e.kind == -1 ? low : high
            e.r := rr
            e.t := time
            e.i := bar_index
            e.trigger := e.kind == -1 ? high[1] : low[1]
            e.closeT := time_close
        if zone != e.kind
            event := Point.new(e.kind, e.p, e.r, e.t, e.i, e.trigger, e.closeT)
            e.kind := 0
    if e.kind == 0 and zone != 0
        e.kind := zone
        e.p := zone == -1 ? low : high
        e.r := rr
        e.t := time
        e.i := bar_index
        e.trigger := zone == -1 ? high[1] : low[1]
        e.closeT := time_close
    event

f_push(array<Point> seq, Point event) =>
    bool changed = false
    if event.kind != 0
        int n = seq.size()
        if n > 0 and seq.get(n - 1).kind == event.kind
            Point old = seq.get(n - 1)
            bool better = event.kind == -1 ? event.p < old.p : event.p > old.p
            if better
                seq.set(n - 1, f_copy(event))
                changed := true
        else
            seq.push(f_copy(event))
            if seq.size() > 6
                seq.shift()
            changed := true
    changed

f_breached(int side, float zero) =>
    side == 1 ? low < zero : side == -1 ? high > zero : false

f_break(int side, float boundary) =>
    float observed = breakMode == "Close ของแท่งปิด" ? close : side == 1 ? high : low
    side == 1 ? observed > boundary : observed < boundary

f_gauge(Point ref, Point a, Point b, int side) =>
    bool valid = not na(ref.p) and ref.t < a.t and side * (ref.p - a.p) > 0 and side * (b.p - a.p) > 0
    valid ? math.abs(b.p - a.p) / math.abs(ref.p - a.p) : na

f_method(Frame frame) =>
    frame.neck ? 3 : fibChoice == "Extension (เลือกเอง)" ? 1 : fibChoice == "Projection (เลือกเอง)" ? 2 : na(frame.gauge) ? 0 : frame.gauge >= 0.5 ? 1 : 2

f_engine(bool chartContext) =>
    float contextATR = ta.atr(14)
    float rr = ta.rsi(close, rLen)
    float kk = ta.sma(ta.stoch(close, high, low, kLen), kSmooth)
    float dd = ta.sma(kk, dSmooth)
    var Episode re = Episode.new()
    var Episode ke = Episode.new()
    var array<Point> rseq = array.new<Point>()
    var array<Point> kseq = array.new<Point>()
    var Frame bull = Frame.new(a = Point.new(), b = Point.new(), c = Point.new(), ref = Point.new())
    var Frame bear = Frame.new(a = Point.new(), b = Point.new(), c = Point.new(), ref = Point.new())
    var int rBias = 0
    var int kBias = 0
    var float kHoldPrice = na
    var int kHoldT = na
    var int lastROS = na
    var int lastROB = na
    var float rLowPrice = na
    var float rHighPrice = na
    var int divState = 0
    var float divR = na
    var float divRef = na
    var int divFromT = na
    var int divToT = na
    var float divTo = na
    var int divKnown = na
    var Point prevLow = Point.new()
    var Point prevHigh = Point.new()
    var Point tsLow = Point.new()
    var Point tsHigh = Point.new()
    var bool lowHold = false
    var bool highHold = false
    var int usedLowTS = na
    var int usedHighTS = na
    var int usedBull = na
    var int usedBear = na
    var int chainSide = 0
    var float chainOrigin = na
    var View plan = View.new()
    var int stopSide = 0
    var float stopPrice = na
    var float runExtreme = na
    var int stopBorn = na
    var int gapSide = 0
    var float gapTrigger = na
    var float gapCut = na
    var int gapBorn = na
    var int legId = na
    var float legLow = na
    var float legHigh = na
    var int frameLegId = na
    var float frameLow = na
    var float frameHigh = na

    View out = View.new(r = rr, k = kk, d = dd)
    Point rp = re.step(rr, rOS, rOB, rr)
    bool rc = f_push(rseq, rp)
    if rp.kind == -1
        lastROS := rp.t
        rLowPrice := rp.p
    if rp.kind == 1
        lastROB := rp.t
        rHighPrice := rp.p
    if rc and rseq.size() >= 3
        Point ra = rseq.get(rseq.size() - 3)
        Point rb = rseq.get(rseq.size() - 2)
        Point rz = rseq.get(rseq.size() - 1)
        rBias := rz.kind == -1 and rz.p >= ra.p ? 1 : rz.kind == 1 and rz.p <= ra.p ? -1 : 0
    if rBias == 1 and low < rLowPrice or rBias == -1 and high > rHighPrice
        rBias := 0

    // Divergence only: confirmed price pivots, with RSI at the same candle.
    float pl = ta.pivotlow(low, divLen, divLen)
    float ph = ta.pivothigh(high, divLen, divLen)
    if not na(pl)
        Point p = Point.new(-1, pl, rr[divLen], time[divLen], bar_index - divLen, high[divLen + 1])
        bool separated = not na(lastROB) and lastROB > prevLow.t
        bool regular = not na(prevLow.p) and not separated and p.p < prevLow.p and p.r > prevLow.r
        bool hidden = not na(prevLow.p) and not separated and p.p > prevLow.p and p.r < prevLow.r
        if regular or hidden
            divState := regular ? 1 : 2
            divR := p.r
            divRef := prevLow.p
            divFromT := prevLow.t
            divToT := p.t
            divTo := p.p
            divKnown := time
        prevLow := p
    if not na(ph)
        Point p = Point.new(1, ph, rr[divLen], time[divLen], bar_index - divLen, low[divLen + 1])
        bool separated = not na(lastROS) and lastROS > prevHigh.t
        bool regular = not na(prevHigh.p) and not separated and p.p > prevHigh.p and p.r < prevHigh.r
        bool hidden = not na(prevHigh.p) and not separated and p.p < prevHigh.p and p.r > prevHigh.r
        if regular or hidden
            divState := regular ? -1 : -2
            divR := p.r
            divRef := prevHigh.p
            divFromT := prevHigh.t
            divToT := p.t
            divTo := p.p
            divKnown := time
        prevHigh := p
    bool clearBull = divState == 1 and (rr <= rOS and rr < divR or kk >= kOB)
    bool clearBear = divState == -1 and (rr >= rOB and rr > divR or kk <= kOS)
    bool clearHB = divState == 2 and (low < divRef or rr >= rOB)
    bool clearHS = divState == -2 and (high > divRef or rr <= rOS)
    if clearBull or clearBear or clearHB or clearHS
        divState := 0

    // Old zero breach never moves zero and never reuses the same candidate.
    if plan.side != 0 and f_breached(plan.side, plan.zero)
        out.invalid := plan.side
        plan := View.new()
    if chainSide != 0 and f_breached(chainSide, chainOrigin)
        chainSide := 0
        chainOrigin := na
    if bull.stage > 0 and f_breached(1, bull.c.p)
        usedBull := bull.c.t
        bull.stage := 0
    if bear.stage > 0 and f_breached(-1, bear.c.p)
        usedBear := bear.c.t
        bear.stage := 0

    Point kp = ke.step(kk, kOS, kOB, rr)
    bool kc = f_push(kseq, kp)
    if kc
        out.eventKind := kp.kind
        out.eventPrice := kp.p
        out.eventT := kp.t
        int n = kseq.size()
        if n >= 3
            Point a = kseq.get(n - 3)
            Point b = kseq.get(n - 2)
            Point c = kseq.get(n - 1)
            Point ref = n >= 4 ? kseq.get(n - 4) : Point.new()
            int side = c.kind == -1 ? 1 : -1
            bool held = side * (c.p - a.p) >= 0
            bool sameRSI = side == 1 ? na(lastROB) or lastROB < a.t : na(lastROS) or lastROS < a.t
            bool neck = not held and sameRSI and side * (c.r - a.r) > 0
            kBias := held ? side : 0
            kHoldPrice := held ? c.p : na
            kHoldT := c.t
            bool initialContext = side == 1 ? a.r <= rOS or rBias == 1 or divState == 1 : a.r >= rOB or rBias == -1 or divState == -1
            bool joint = chainSide == side and not f_breached(side, chainOrigin)
            bool validShape = a.t < b.t and b.t < c.t and side * (b.p - a.p) > 0 and side * (b.p - c.p) > 0
            bool candidate = validShape and ((held and (initialContext or joint)) or (allowNeck and neck))
            if kp.kind == -1
                tsLow := f_copy(c)
                lowHold := held or neck or rBias == 1 or divState == 1
                highHold := false
                if candidate and (na(usedBull) or c.t != usedBull)
                    bull := Frame.new(1, 1, neck, joint, f_copy(a), f_copy(b), f_copy(c), f_copy(ref), na, time)
                    if chartContext and overrideD
                        bull.ref := Point.new(1, manualD, na, manualDT, na, na)
                    bull.gauge := f_gauge(bull.ref, a, b, 1)
            else
                tsHigh := f_copy(c)
                highHold := held or neck or rBias == -1 or divState == -1
                lowHold := false
                if candidate and (na(usedBear) or c.t != usedBear)
                    bear := Frame.new(-1, 1, neck, joint, f_copy(a), f_copy(b), f_copy(c), f_copy(ref), na, time)
                    if chartContext and overrideD
                        bear.ref := Point.new(-1, manualD, na, manualDT, na, na)
                    bear.gauge := f_gauge(bear.ref, a, b, -1)

    if kBias == 1 and (low < kHoldPrice or kk >= kOB) or kBias == -1 and (high > kHoldPrice or kk <= kOS)
        kBias := 0
    if lowHold and low < tsLow.p
        lowHold := false
    if highHold and high > tsHigh.p
        highHold := false
    bool tsUp = lowHold and time > tsLow.t and high > tsLow.trigger and (na(usedLowTS) or usedLowTS != tsLow.t)
    bool tsDn = highHold and time > tsHigh.t and low < tsHigh.trigger and (na(usedHighTS) or usedHighTS != tsHigh.t)
    if tsUp and tsDn
        tsUp := false
        tsDn := false
    if tsUp or tsDn
        out.ts := tsUp ? 1 : -1
        out.cut := tsUp ? tsLow.p : tsHigh.p
        out.formedTS := tsUp ? bull.stage == 1 : bear.stage == 1
        if tsUp
            usedLowTS := tsLow.t
        else
            usedHighTS := tsHigh.t
        stopSide := out.ts
        stopPrice := out.cut
        runExtreme := tsUp ? high : low
        stopBorn := time

    // Invalidate before break; reject bars touching both boundaries.
    bool bullBreak = bull.stage == 1 and time > bull.c.t and not f_breached(1, bull.c.p) and f_break(1, bull.b.p)
    bool bearBreak = bear.stage == 1 and time > bear.c.t and not f_breached(-1, bear.c.p) and f_break(-1, bear.b.p)
    if bullBreak and bearBreak
        bull.stage := 0
        bear.stage := 0
        usedBull := bull.c.t
        usedBear := bear.c.t
        bullBreak := false
        bearBreak := false
    if bullBreak or bearBreak
        Frame chosen = bullBreak ? bull : bear
        int method = f_method(chosen)
        int side = chosen.side
        chosen.stage := 2
        out.broke := side
        out.cut := chosen.c.p
        if side == 1
            usedBull := chosen.c.t
        else
            usedBear := chosen.c.t
        chainOrigin := chainSide == side ? chainOrigin : chosen.a.p
        chainSide := side
        // Missing reference means no invented Auto target grid.
        plan := View.new()
        if method != 0
            float span = method == 2 ? chosen.b.p - chosen.a.p : chosen.b.p - chosen.c.p
            plan := View.new(side = side, method = method, zero = chosen.c.p, span = span, id = chosen.c.t, zeroT = chosen.c.t, born = time, pa = chosen.a.p, pb = chosen.b.p, pat = chosen.a.t, pbt = chosen.b.t, paEnd = chosen.a.closeT, pbEnd = chosen.b.closeT, pcEnd = chosen.c.closeT, pref = chosen.ref.p, preft = chosen.ref.t, pgauge = chosen.gauge, pneck = chosen.neck, pjoint = chosen.joint)
        bool gap = side == 1 ? low > chosen.b.p and close[1] <= chosen.b.p : high < chosen.b.p and close[1] >= chosen.b.p
        if gap
            gapSide := side
            gapTrigger := side == 1 ? high : low
            gapCut := side == 1 ? low : high
            gapBorn := time
    if gapSide != 0
        if f_breached(gapSide, gapCut)
            gapSide := 0
        else if time > gapBorn and (gapSide == 1 ? high > gapTrigger : low < gapTrigger)
            out.gap := gapSide
            out.cut := gapCut
            gapSide := 0

    // Conservative OHLC stop handling: test old stop BEFORE moving it.
    if stopSide != 0 and time > stopBorn
        if f_breached(stopSide, stopPrice)
            out.stopped := stopSide
            stopSide := 0
            stopPrice := na
        else if stopSide == 1 and high > runExtreme
            stopPrice := math.max(stopPrice, low[1])
            runExtreme := high
        else if stopSide == -1 and low < runExtreme
            stopPrice := math.min(stopPrice, high[1])
            runExtreme := low

    // Track the observed leg only for a live ID; never mix highs/lows of old plans.
    if plan.side != 0
        if na(legId) or legId != plan.id
            legId := plan.id
            legLow := math.min(math.min(plan.pa, plan.pb), math.min(plan.zero, low))
            legHigh := math.max(math.max(plan.pa, plan.pb), math.max(plan.zero, high))
        else
            legLow := math.min(legLow, low)
            legHigh := math.max(legHigh, high)
    else
        legId := na
        legLow := na
        legHigh := na
    out.asof := time_close
    out.rangeATR := contextATR
    out.legLow := legLow
    out.legHigh := legHigh
    // A newer destroyed frame must not hide the other still-valid frame.
    bool useBullFrame = bull.stage > 0 and (bear.stage == 0 or na(bear.known) or bull.known >= bear.known)
    Frame currentFrame = useBullFrame ? bull : bear.stage > 0 ? bear : Frame.new(a = Point.new(), b = Point.new(), c = Point.new(), ref = Point.new())
    if currentFrame.stage > 0
        if na(frameLegId) or frameLegId != currentFrame.c.t
            frameLegId := currentFrame.c.t
            frameLow := math.min(math.min(currentFrame.a.p, currentFrame.b.p), math.min(currentFrame.c.p, low))
            frameHigh := math.max(math.max(currentFrame.a.p, currentFrame.b.p), math.max(currentFrame.c.p, high))
        else
            frameLow := math.min(frameLow, low)
            frameHigh := math.max(frameHigh, high)
    else
        frameLegId := na
        frameLow := na
        frameHigh := na
    out.frameLow := frameLow
    out.frameHigh := frameHigh
    out.fside := currentFrame.side
    out.fstage := currentFrame.stage
    out.neck := currentFrame.neck
    out.joint := currentFrame.joint
    out.a := currentFrame.a.p
    out.b := currentFrame.b.p
    out.c := currentFrame.c.p
    out.ref := currentFrame.ref.p
    out.at := currentFrame.a.t
    out.bt := currentFrame.b.t
    out.ct := currentFrame.c.t
    out.aEnd := currentFrame.a.closeT
    out.bEnd := currentFrame.b.closeT
    out.cEnd := currentFrame.c.closeT
    out.rt := currentFrame.ref.t
    out.gauge := currentFrame.gauge
    out.fknown := currentFrame.known
    out.side := plan.side
    out.method := plan.method
    out.zero := plan.zero
    out.span := plan.span
    out.id := plan.id
    out.zeroT := plan.zeroT
    out.born := plan.born
    out.pa := plan.pa
    out.pb := plan.pb
    out.pat := plan.pat
    out.pbt := plan.pbt
    out.paEnd := plan.paEnd
    out.pbEnd := plan.pbEnd
    out.pcEnd := plan.pcEnd
    out.pref := plan.pref
    out.preft := plan.preft
    out.pgauge := plan.pgauge
    out.pneck := plan.pneck
    out.pjoint := plan.pjoint
    out.rBias := rBias
    out.kBias := kBias
    out.rCut := rBias == 1 ? rLowPrice : rBias == -1 ? rHighPrice : na
    out.kCut := kHoldPrice
    out.rCutT := rBias == 1 ? lastROS : rBias == -1 ? lastROB : na
    out.kCutT := kHoldT
    out.div := divState
    out.divFrom := divRef
    out.divFromT := divFromT
    out.divTo := divTo
    out.divToT := divToT
    out.divKnown := divKnown
    out.rEvent := rp.kind
    out.trail := stopPrice
    out.trailSide := stopSide
    if plan.side != 0
        float progress = (close - plan.zero) / plan.span
        out.progress := progress >= 4.236 ? 4 : progress >= 2.618 ? 3 : progress >= (plan.method == 2 ? 1 : plan.method == 3 ? 1.618 : 2.618) ? 2 : 1
    out

f_confirmed() =>
    View snapshot = f_engine(false)
    snapshot[1]

f_context(View v, bool pending, bool running) =>
    SwingContext s = SwingContext.new()
    if not na(v)
        if pending
            s := SwingContext.new(v.fside, v.fstage, v.a, v.b, v.c, v.at, v.bt, v.ct, v.aEnd, v.bEnd, v.cEnd, v.fknown, v.asof, v.fstage == 1 ? math.min(math.min(v.a, v.b), v.c) : v.frameLow, v.fstage == 1 ? math.max(math.max(v.a, v.b), v.c) : v.frameHigh, v.neck)
        else if running
            s := SwingContext.new(v.side, 2, v.pa, v.pb, v.zero, v.pat, v.pbt, v.zeroT, v.paEnd, v.pbEnd, v.pcEnd, v.born, v.asof, v.legLow, v.legHigh, v.pneck)
    s

f_samePoint(int childT, float childP, int parentT, int parentEnd, float parentP, float tolerance) =>
    // Use the ACTUAL source candle end, not assumed 4H/24H duration.
    not na(childT) and not na(parentEnd) and childT >= parentT and childT < parentEnd and math.abs(childP - parentP) <= tolerance

f_sameSwing(SwingContext c, SwingContext p, float tolerance) =>
    c.side != 0 and p.side == c.side and f_samePoint(c.at, c.a, p.at, p.ae, p.a, tolerance) and f_samePoint(c.bt, c.b, p.bt, p.be, p.b, tolerance) and f_samePoint(c.ct, c.c, p.ct, p.ce, p.c, tolerance)

// Presentation-only eligibility. Never changes the engine, links or Action gates.
f_heroValid(SwingContext s) =>
    (s.side == 1 or s.side == -1) and (s.phase == 1 or s.phase == 2) and not na(s.a) and not na(s.b) and not na(s.c) and not na(s.at) and not na(s.bt) and not na(s.ct) and s.at < s.bt and s.bt < s.ct

// Chapter 5 hero Form: OS–OB–OS with higher low, or OB–OS–OB without a
// higher high. RSI/Action/Gauge filters do NOT define whether this Form exists.
// Neck cases require the special context discussed on book p.147 and are not
// automatically certified by this normal-Form scanner.
f_heroEngine() =>
    float kk = ta.sma(ta.stoch(close, high, low, kLen), kSmooth)
    float rangeATR = ta.atr(14)
    var int historyFrom = na
    var bool episodeArmed = false
    var float manualLow = na
    var float manualHigh = na
    var bool manualRangeKnown = false
    if not na(kk)
        if na(historyFrom)
            historyFrom := time
        // Do not mistake a truncated initial zone visit for a full cycle.
        if kk > kOS and kk < kOB
            episodeArmed := true
    if heroStartT > 0 and not na(historyFrom)
        if time <= heroStartT and time_close > heroStartT
            manualLow := math.min(heroStartP, low)
            manualHigh := math.max(heroStartP, high)
            manualRangeKnown := historyFrom <= heroStartT and heroStartP >= low and heroStartP <= high
        else if manualRangeKnown and time > heroStartT
            manualLow := math.min(manualLow, low)
            manualHigh := math.max(manualHigh, high)
    var Episode visit = Episode.new()
    var array<Point> seq = array.new<Point>()
    var SwingContext up = SwingContext.new()
    var SwingContext dn = SwingContext.new()
    // Retain chronology even after the newest opposite Form is destroyed.
    var int formSide = 0
    var int formKnown = na
    if up.phase > 0 and low < up.c
        up := SwingContext.new()
    if dn.phase > 0 and high > dn.c
        dn := SwingContext.new()
    Point event = episodeArmed ? visit.step(kk, kOS, kOB, 0) : Point.new()
    bool changed = f_push(seq, event)
    int count = seq.size()
    Point origin = count >= 3 ? seq.get(count - 3) : Point.new()
    Point pivot = count > 0 ? seq.get(count - 1) : Point.new()
    int formLength = not na(origin.i) ? math.max(1, bar_index - origin.i + 1) : 1
    int pivotLength = not na(pivot.i) ? math.max(1, bar_index - pivot.i + 1) : 1
    float formLow = ta.lowest(low, math.min(2000, formLength))
    float formHigh = ta.highest(high, math.min(2000, formLength))
    float pivotLow = ta.lowest(low, math.min(2000, pivotLength))
    float pivotHigh = ta.highest(high, math.min(2000, pivotLength))
    if changed and count >= 3
        Point a = seq.get(count - 3)
        Point b = seq.get(count - 2)
        Point c = seq.get(count - 1)
        int side = c.kind == -1 ? 1 : -1
        bool alternating = a.kind == c.kind and b.kind == -c.kind
        bool held = side == 1 ? c.p > a.p : c.p <= a.p
        bool geometry = a.t < b.t and b.t < c.t and side * (b.p - a.p) > 0 and side * (b.p - c.p) > 0
        if alternating and held and geometry and not f_breached(side, c.p)
            SwingContext formed = SwingContext.new(side = side, phase = 1, a = a.p, b = b.p, c = c.p, at = a.t, bt = b.t, ct = c.t, ae = a.closeT, be = b.closeT, ce = c.closeT, known = time_close, asof = time_close, lo = formLow, hi = formHigh)
            formSide := side
            formKnown := time_close
            if side == 1
                up := formed
            else
                dn := formed
    if up.phase > 0
        up.lo := math.min(up.lo, low)
        up.hi := math.max(up.hi, high)
        if up.phase == 1 and time > up.ct and f_break(1, up.b)
            up.phase := 2
    if dn.phase > 0
        dn.lo := math.min(dn.lo, low)
        dn.hi := math.max(dn.hi, high)
        if dn.phase == 1 and time > dn.ct and f_break(-1, dn.b)
            dn.phase := 2
    HeroFeed.new(ready = not na(kk) and episodeArmed, historyFrom = historyFrom, asof = time_close, price = close, atr = rangeATR, pivotKind = pivot.kind, pivotP = pivot.p, pivotT = pivot.t, pivotLow = pivotLow, pivotHigh = pivotHigh, rangeKnown = pivotLength <= 2000, manualLow = manualLow, manualHigh = manualHigh, manualRangeKnown = manualRangeKnown, formSide = formSide, formKnown = formKnown, upPhase = up.phase, upA = up.a, upB = up.b, upC = up.c, upAT = up.at, upAE = up.ae, upBT = up.bt, upCT = up.ct, upCE = up.ce, upKnown = up.known, upLow = up.lo, upHigh = up.hi, dnPhase = dn.phase, dnA = dn.a, dnB = dn.b, dnC = dn.c, dnAT = dn.at, dnAE = dn.ae, dnBT = dn.bt, dnCT = dn.ct, dnCE = dn.ce, dnKnown = dn.known, dnLow = dn.lo, dnHigh = dn.hi)

f_heroClosedFeed() =>
    HeroFeed fresh = f_heroEngine()
    // Never confirm a Form from a still-open source candle. A closed market's
    // last completed candle is usable, avoiding an extra chart-dependent delay.
    HeroFeed confirmed = time_close <= timenow ? fresh : fresh[1]
    na(confirmed) ? HeroFeed.new() : confirmed.copy()

f_heroFetch(string tf) =>
    var HeroFeed latest = HeroFeed.new()
    varip int killedUp = na
    varip int killedDn = na
    // A separate source OHLC watch is shared by BOTH fetch paths. It is not
    // used to create Form/Break or reference endpoints from an open candle.
    [watchT, watchLow, watchHigh] = request.security(syminfo.tickerid, tf, [time, low, high], lookahead = barmerge.lookahead_off, calc_bars_count = 2000)
    if timeframe.in_seconds(tf) < timeframe.in_seconds()
        // Pine may hoist fixed-TF requests out of this function's branch.
        // A larger-TF call must be harmless; its regular-security path is used.
        array<HeroFeed> packets = request.security_lower_tf(syminfo.tickerid, tf, f_heroEngine(), ignore_invalid_timeframe = true, calc_bars_count = 2000)
        int idx = packets.size() - 1
        bool found = false
        while idx >= 0 and not found
            HeroFeed packet = packets.get(idx)
            if not na(packet.asof) and packet.asof <= timenow
                latest := packet.copy()
                found := true
            idx -= 1
    else
        HeroFeed packet = request.security(syminfo.tickerid, tf, f_heroClosedFeed(), lookahead = barmerge.lookahead_off, calc_bars_count = 2000)
        if not na(packet)
            latest := packet.copy()
    HeroFeed result = latest.copy()
    result.watchT := watchT
    result.watchLow := watchLow
    result.watchHigh := watchHigh
    bool watchAfterSnapshot = not na(watchT) and not na(result.asof) and watchT >= result.asof
    if watchAfterSnapshot and result.upPhase > 0 and watchLow < result.upC
        killedUp := result.upCT
    if watchAfterSnapshot and result.dnPhase > 0 and watchHigh > result.dnC
        killedDn := result.dnCT
    if not na(killedUp) and killedUp == result.upCT
        result.upPhase := 0
    if not na(killedDn) and killedDn == result.dnCT
        result.dnPhase := 0
    result

f_heroForm(HeroFeed feed, int side) =>
    SwingContext s = SwingContext.new()
    if not na(feed)
        int phase = side == 1 ? feed.upPhase : feed.dnPhase
        int known = side == 1 ? feed.upKnown : feed.dnKnown
        float zero = side == 1 ? feed.upC : feed.dnC
        bool observedBreach = not na(feed.watchT) and not na(feed.asof) and feed.watchT >= feed.asof and (side == 1 ? feed.watchLow < zero : feed.watchHigh > zero)
        bool latestDirection = feed.formSide == side and not na(known) and known == feed.formKnown
        if phase > 0 and latestDirection and not observedBreach
            s := side == 1 ? SwingContext.new(side = 1, phase = phase, a = feed.upA, b = feed.upB, c = feed.upC, at = feed.upAT, ae = feed.upAE, bt = feed.upBT, ct = feed.upCT, ce = feed.upCE, known = feed.upKnown, asof = feed.asof, lo = feed.upLow, hi = feed.upHigh) : SwingContext.new(side = -1, phase = phase, a = feed.dnA, b = feed.dnB, c = feed.dnC, at = feed.dnAT, ae = feed.dnAE, bt = feed.dnBT, ct = feed.dnCT, ce = feed.dnCE, known = feed.dnKnown, asof = feed.asof, lo = feed.dnLow, hi = feed.dnHigh)
    s

f_heroRange(HeroFeed reference) =>
    HeroRange study = HeroRange.new()
    if not na(reference) and not na(reference.price) and not na(reference.asof)
        bool manual = heroRefMode == "เลือกจุดเริ่มเอง → ราคาล่าสุด"
        float startP = manual ? heroStartP : reference.pivotP
        int startT = manual ? heroStartT : reference.pivotT
        bool knownStart = manual ? startP > 0 and startT > 0 : reference.pivotKind != 0
        if knownStart and not na(startP) and not na(startT) and startT < reference.asof and reference.price != startP
            int side = reference.price > startP ? 1 : -1
            bool correctRound = manual or (reference.pivotKind == -1 and side == 1 or reference.pivotKind == 1 and side == -1)
            if correctRound
                study := HeroRange.new(side, startP, startT, reference.price, reference.asof, manual ? reference.manualLow : reference.pivotLow, manual ? reference.manualHigh : reference.pivotHigh, manual ? reference.manualRangeKnown : reference.rangeKnown)
    study

// Same study LEG, not identical A/B/C. A larger Form may contain several
// smaller Forms (book pp.144–147). Direction alone never proves this relation.
f_heroFits(HeroRange study, SwingContext s, HeroFeed feed, float tolerance) =>
    bool fits = false
    if study.side != 0 and f_heroValid(s) and s.side == study.side and not na(s.known) and s.known <= study.toT and s.ct <= study.toT
        bool sharedOrigin = f_samePoint(study.fromT, study.fromP, s.at, s.ae, s.a, tolerance)
        bool formInsideLeg = study.rangeKnown and s.at >= study.fromT and s.ct <= study.toT and not na(study.lo) and not na(study.hi) and math.min(math.min(s.a, s.b), s.c) >= study.lo - tolerance and math.max(math.max(s.a, s.b), s.c) <= study.hi + tolerance
        bool sharedRestart = f_samePoint(study.fromT, study.fromP, s.ct, s.ce, s.c, tolerance)
        // Continuation requires the SAME outgoing Sto cycle after C, a confirmed
        // Break and no completed intervening opposite pivot. Range alone is not ID.
        bool sameCycle = feed.pivotKind == -s.side and feed.pivotT == s.ct
        bool nestedLeg = s.phase == 2 and sameCycle and study.rangeKnown and not na(s.ce) and study.fromT >= s.ce and not na(s.lo) and not na(s.hi) and study.fromP >= s.lo - tolerance and study.fromP <= s.hi + tolerance and (s.side == 1 ? study.lo >= s.c : study.hi <= s.c)
        // Protected C is hard: ATR tolerance cannot excuse a zero breach.
        bool zeroHeld = study.rangeKnown and (s.side == 1 ? study.lo >= s.c or sharedOrigin or formInsideLeg : study.hi <= s.c or sharedOrigin or formInsideLeg)
        fits := (sharedOrigin or formInsideLeg or sharedRestart or nestedLeg) and zeroHeld and s.side * (study.toP - s.c) >= 0
    fits

f_heroCovered(HeroFeed feed, HeroRange study) =>
    feed.ready and study.side != 0 and not na(feed.historyFrom) and feed.historyFrom <= study.fromT

f_inside(float price, SwingContext p, float tolerance) =>
    // Tolerance is NOT permission to cross the protected C/zero of an active leg.
    not na(price) and not na(p.lo) and not na(p.hi) and price >= p.lo - tolerance and price <= p.hi + tolerance and p.side * (price - p.c) >= 0

f_relation(SwingContext c, SwingContext pending, SwingContext running, bool validTF, float tolerance) =>
    LinkState link = LinkState.new()
    SwingContext p = running.side != 0 ? running : pending
    if not validTF
        link.code := -1
    else if c.side == 0
        link.code := 0
    else if p.side == 0
        link.code := -2
    else if f_sameSwing(c, pending, tolerance) or f_sameSwing(c, running, tolerance)
        p := f_sameSwing(c, running, tolerance) ? running : pending
        link.code := 1
    else if c.ct >= p.asof
        link.code := 7
    else if c.at < p.ct
        link.code := 6
    else if not (f_inside(c.a, p, tolerance) and f_inside(c.b, p, tolerance) and f_inside(c.c, p, tolerance))
        link.code := 4
    else
        link.code := c.side == p.side ? 2 : 3
    link.parentId := p.ct
    link.parentPhase := p.phase
    link.parentSide := p.side
    link

f_linkCaption(LinkState l) =>
    l.code == 1 ? "จุด A/B/C ร่วมเวลา–ราคา" : l.code == 2 ? "กรอบย่อยในขา/กรอบใหญ่" : l.code == 3 ? "สวนทางในขา/กรอบใหญ่" : l.code == 4 ? "ราคาพ้นช่วงใหญ่ที่ยืนยัน" : l.code == 5 ? "แค่ทิศตรงกัน ยังไม่จับคู่" : l.code == 6 ? "สวิงก่อน C ใหญ่ / คนละช่วง" : l.code == 7 ? "รอแท่งใหญ่ปิดให้ครอบคลุม C" : l.code == -1 ? "TF ต้องใหญ่กว่าและไม่ซ้ำ" : l.code == -2 ? "ไม่มีกรอบใหญ่ valid" : "รอกรอบ Current ที่ valid"

f_linkReady(LinkState l) =>
    (l.code == 1 or l.code == 2) and l.parentPhase == 2

f_pairInParent(SwingContext p, int fromT, float fromP, int toT, float toP) =>
    p.phase == 2 and not na(fromT) and fromT < toT and fromT >= p.ct and toT < p.asof and f_inside(fromP, p, 0) and f_inside(toP, p, 0)

f_ewContext(SwingContext s) =>
    string caption = "ไม่มีชุด · ไม่เดานับคลื่น"
    if s.side != 0
        bool startShape = s.side * (s.b - s.a) > 0 and s.side * (s.c - s.a) > 0 and s.side * (s.b - s.c) > 0
        caption := s.neck ? "หักคอ · ไม่เรียก Impulse 1–2" : not startShape ? "ยังไม่เข้าโครงราคา 1–2" : s.phase == 1 ? "1–2? / ABC? · รอ Break" : "หลัง Break · W3? หรือ C?"
        caption := (s.side == 1 ? "ขึ้น" : "ลง") + " · " + caption
    caption

View raw = f_engine(true)
View current = barstate.isconfirmed ? raw : raw[1]
float chartSeconds = timeframe.in_seconds()
bool tf1OK = timeframe.in_seconds(tf1) > chartSeconds
bool tf2OK = timeframe.in_seconds(tf2) > chartSeconds and timeframe.in_seconds(tf2) != timeframe.in_seconds(tf1)
View big1 = request.security(syminfo.tickerid, tf1OK ? tf1 : timeframe.period, f_confirmed(), lookahead = barmerge.lookahead_on, calc_bars_count = 2000)
View big2 = request.security(syminfo.tickerid, tf2OK ? tf2 : timeframe.period, f_confirmed(), lookahead = barmerge.lookahead_on, calc_bars_count = 2000)
View controller = controlTF == "TF ใหญ่ 1" ? big1 : big2
bool controlOK = controlTF == "TF ใหญ่ 1" ? tf1OK : tf2OK
int controlSide = 0
varip int killedControlR = na
varip int killedControlK = na
if controlOK and not na(controller)
    if controller.rBias != 0 and f_breached(controller.rBias, controller.rCut)
        killedControlR := controller.rCutT
    if controller.kBias != 0 and f_breached(controller.kBias, controller.kCut)
        killedControlK := controller.kCutT
    bool rContextLive = controller.rBias != 0 and (na(killedControlR) or killedControlR != controller.rCutT) and not f_breached(controller.rBias, controller.rCut)
    bool kContextLive = controller.kBias != 0 and (na(killedControlK) or killedControlK != controller.kCutT) and not f_breached(controller.kBias, controller.kCut)
    controlSide := rContextLive ? controller.rBias : kContextLive ? controller.kBias : 0

// Intrabar kill latch. A wick through zero cannot reappear on a later tick.
varip int killedId = na
if barstate.isnew
    killedId := na
if not na(current) and current.side != 0 and f_breached(current.side, current.zero)
    killedId := current.id
bool live = not na(current) and current.side != 0 and (na(killedId) or killedId != current.id) and not f_breached(current.side, current.zero)
// Retain observed HTF invalidation across ALL child bars until a NEW plan arrives.
// Otherwise a recovered child close could resurrect an old HTF grid before HTF close.
varip int killedBig1 = na
varip int killedBig2 = na
if tf1OK and not na(big1) and big1.side != 0 and f_breached(big1.side, big1.zero)
    killedBig1 := big1.id
if tf2OK and not na(big2) and big2.side != 0 and f_breached(big2.side, big2.zero)
    killedBig2 := big2.id