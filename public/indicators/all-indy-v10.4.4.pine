color combo_rsiColor = input.color(#FFFFFF, "RSI", inline="oscColors", group=COMBO_OSC, display=display.none)

// Allocate only the OHLC/time buffers required by the bounded source audit.
// Bounded source audit, including delayed QML activation. No unbounded indexing.
max_bars_back(time, 320)
max_bars_back(time_close, 320)
max_bars_back(high, 320)
max_bars_back(low, 320)
max_bars_back(close, 320)
var int ebw_firstBar = bar_index
var int ebw_firstTime = time

// V10.4.4 Intraday: preserves EBW, WaveTrend and the audited S&D / Limit Planner engines.
// New: sweep-aware structural SL + restart-safe plan lifecycle + runtime guard.
// Pending Entry/SL/TP freeze when a plan appears; after Entry they stay locked until TP/SL.
// SL is placed beyond mapped liquidity / swing structure with an adaptive sweep buffer.
// Runtime guard removes the expensive aligned-LTF intrabar-array path and caps the POI registry.
// If the structurally-correct SL becomes too wide or RR becomes poor, the setup is rejected rather than squeezed.
// Inputs are starting heuristics, not optimized parameters or win probabilities.
// Signal entry is the confirmed chart close, NOT an assumed broker fill.
// SL/TP touch monitoring starts on the NEXT chart bar; no intrabar order is inferred.
// Historical signals are limited to the latest 1000 chart bars plus source warmup.
// HTF prior-source snapshots and final LTF sample semantics are preserved.

const string I_GROUP = "00 · Intraday / ตั้งค่าสำหรับ 5m 15m 1h"
bool i_htfFilter = input.bool(true, "Confirm higher-TF trend / กรองเทรนด์ TF ใหญ่", group=I_GROUP, tooltip="Auto context: 5m -> 15m; 15m -> 1h; 1h -> 4h. Uses only the previous completed source bar.", display=display.none)
bool i_chopFilter = input.bool(true, "Avoid compressed MAs / กรองเส้น MA ชิดกัน", group=I_GROUP, display=display.none)
float i_minSeparation = input.float(0.10, "Minimum MA gap / previous ATR", minval=0.0, maxval=1.0, step=0.05, group=I_GROUP, display=display.none)
float i_maxChase = input.float(1.25, "Maximum distance from fast MA / ATR", minval=0.25, maxval=5, step=0.25, group=I_GROUP, tooltip="Rejects a trigger that closes too far from the fast MA. Uses previous ATR.", display=display.none)
float i_minNetR = input.float(1.5, "Minimum net reward / risk", minval=0.5, maxval=5, step=0.25, group=I_GROUP, display=display.none)
float i_targetR = input.float(2.0, "Target cap / gross R", minval=1, maxval=10, step=0.25, group=I_GROUP, tooltip="Target is capped by the FIRST mapped opposing POI or liquidity level. No mapped target = no final signal.", display=display.none)
float i_costTicks = input.float(0, "Round-trip costs / ticks · ตั้งตามโบรกเกอร์", minval=0, maxval=100000, group=I_GROUP, tooltip="Total spread + commission + slippage converted to price ticks. Zero means costs have NOT been modeled. Net R = (reward - cost) / (risk + cost).", display=display.none)
float i_minStopATR = input.float(0.75, "Minimum stop distance / previous ATR", minval=0.1, maxval=3, step=0.1, group=I_GROUP, display=display.none)
float i_maxStopATR = input.float(2.5, "Maximum stop distance / previous ATR", minval=0.5, maxval=10, step=0.25, group=I_GROUP, display=display.none)
float i_stopBuffer = input.float(0.18, "SL beyond zone / candle · previous ATR", minval=0, maxval=1, step=0.01, group=I_GROUP, tooltip="Base structural buffer for confirmed reference plans. Sweep-aware logic may use a wider buffer when liquidity sits directly behind the POI.", display=display.none)
int i_planBars = input.int(12, "Pending setup expires after chart bars", minval=1, maxval=100, group=I_GROUP, tooltip="Applies only before Entry is reached. After Entry, Entry / SL / TP stay locked until TP or SL.", display=display.none)
int i_zoneContexts = input.int(2, "Higher-TF map layers / จำนวน TF ของโซน", minval=1, maxval=4, group=I_GROUP, tooltip="Default 2: chart + next two higher contexts. Increase for a broader map and more calculations.", display=display.none)
bool i_dailyMap = input.bool(false, "Add separate Daily map / เพิ่มโซนรายวัน", group=I_GROUP, display=display.none)
if barstate.isfirst and i_minStopATR > i_maxStopATR
    runtime.error("Minimum stop ATR must not exceed maximum stop ATR.")

const string PERF_GROUP = "00 · Runtime / ประสิทธิภาพ"
bool perf_runtimeGuard = input.bool(true, "Runtime guard · Recommended", group=PERF_GROUP, tooltip="Keeps the expensive POI registry bounded and uses a lighter aligned lower-TF sampling path. Entry/SL/TP logic and the locked non-repaint lifecycle are unchanged.", display=display.none)
int perf_recordCap = input.int(110, "Runtime guard · POI record cap", minval=80, maxval=160, step=10, group=PERF_GROUP, tooltip="Maximum active POI records retained while Runtime guard is enabled. Premium Clean normally needs far fewer than this.", display=display.none)

const string V10_GROUP = "00 · V10 Decision & Display / การตัดสินใจและหน้าจอ"
bool v10_displayMaster = input.bool(true, "Show V10 on chart / แสดง V10 บนกราฟ", group=V10_GROUP, tooltip="Presentation master only. Turning this off hides V10 drawings/panels while the underlying calculations and alerts continue.", display=display.none)
string v10_layout = input.string("Trading", "Workspace preset", options=["Mobile", "Trading", "Research", "Custom"], group=V10_GROUP, tooltip="Mobile: minimum clutter. Trading: decision + clean map. Research: full diagnostics. Custom: use the switches below.", display=display.none)
bool v10_customEdge = input.bool(true, "Custom · Market Edge panel", group=V10_GROUP, display=display.none)
bool v10_customMajor = input.bool(true, "Custom · Major zones", group=V10_GROUP, display=display.none)
bool v10_customReaction = input.bool(true, "Custom · Reaction zones", group=V10_GROUP, display=display.none)
bool v10_customLiquidity = input.bool(true, "Custom · BSL / SSL liquidity", group=V10_GROUP, display=display.none)
bool v10_customPlan = input.bool(true, "Custom · Entry / SL / TP drawings", group=V10_GROUP, display=display.none)
bool v10_customConfirmation = input.bool(true, "Custom · Confirmation / signal marks", group=V10_GROUP, display=display.none)
bool v10_customDiagnostics = input.bool(false, "Custom · Diagnostics rows", group=V10_GROUP, display=display.none)
float v10_edgeMinScore = input.float(56.0, "Minimum directional evidence score", minval=40.0, maxval=90.0, step=1.0, group=V10_GROUP, tooltip="Market Edge is an evidence score, not a win probability.", display=display.none)
float v10_edgeGap = input.float(10.0, "Minimum BUY/SELL evidence gap", minval=2.0, maxval=40.0, step=1.0, group=V10_GROUP, tooltip="If BUY and SELL evidence are too close, V10 stays NEUTRAL instead of forcing a direction.", display=display.none)
float v10_edgeSearchATR = input.float(8.0, "Focus-zone search · ATR", minval=1.0, maxval=30.0, step=0.5, group=V10_GROUP, display=display.none)
float v10_watchATR = input.float(0.35, "Approaching preferred zone · ATR", minval=0.05, maxval=2.0, step=0.05, group=V10_GROUP, display=display.none)
float v10_minRoomATR = input.float(0.75, "Minimum distance to first obstacle · ATR", minval=0.0, maxval=5.0, step=0.25, group=V10_GROUP, tooltip="Execution state becomes NO TRADE when the first opposing POI is too close to the planned entry.", display=display.none)
float v10_minPlanR = input.float(1.0, "Minimum R to first obstacle", minval=0.25, maxval=5.0, step=0.25, group=V10_GROUP, tooltip="Quick planning filter only. Uses planned Entry to Invalidation versus the first opposing structural obstacle. This is not a win probability.", display=display.none)
float v10_invalidBuffer = input.float(0.15, "Base invalidation buffer · ATR", minval=0.0, maxval=1.0, step=0.01, group=V10_GROUP, tooltip="Base distance beyond the selected protective structure. V10.4.4 can automatically widen this when liquidity sits immediately behind the POI.", display=display.none)
float v10_anchorSearchATR = input.float(1.50, "Protective anchor search · ATR", minval=0.25, maxval=5.0, step=0.25, group=V10_GROUP, tooltip="Search behind the focus zone for same-side swing / SSL / BSL liquidity. V10.4.4 protects beyond the deepest mapped anchor inside this window, then applies the sweep buffer.", display=display.none)
float v10_sweepRiskATR = input.float(0.60, "Nearby sweep-risk band · ATR", minval=0.05, maxval=2.0, step=0.05, group=V10_GROUP, tooltip="If the selected liquidity anchor is within this distance behind the zone, the setup is treated as vulnerable to a stop-hunt / liquidity sweep.", display=display.none)
float v10_sweepBufferATR = input.float(0.25, "Sweep-protection buffer · ATR", minval=0.05, maxval=1.0, step=0.05, group=V10_GROUP, tooltip="Minimum buffer beyond a nearby protective liquidity anchor. The setup is rejected if this structural SL violates maximum-risk or RR rules; the engine does not squeeze the SL inward.", display=display.none)
bool v10_requireAnchor = input.bool(true, "Require protective anchor for pending LIMIT", group=V10_GROUP, tooltip="When enabled, a raw pending BUY/SELL LIMIT is withheld if no mapped protective liquidity/swing exists behind the zone. Confirmed signal plans may still use the zone plus candle structure.", display=display.none)
float v10_cancelProgress = input.float(0.90, "Cancel pending after path-to-TP", minval=0.50, maxval=1.00, step=0.05, group=V10_GROUP, tooltip="Before Entry only. 0.90 cancels a still-pending plan after price has travelled 90% of the Entry-to-TP path without reaching Entry. Once Entry is reached, the plan is locked until TP/SL.", display=display.none)

bool v10_showEdge = v10_displayMaster and (v10_layout == "Custom" ? v10_customEdge : true)
bool v10_showMajor = v10_displayMaster and (v10_layout == "Custom" ? v10_customMajor : true)
bool v10_showReaction = v10_displayMaster and (v10_layout == "Mobile" ? false : v10_layout == "Custom" ? v10_customReaction : true)
bool v10_showLiquidity = v10_displayMaster and (v10_layout == "Custom" ? v10_customLiquidity : true)
bool v10_showPlan = v10_displayMaster and (v10_layout == "Mobile" ? false : v10_layout == "Custom" ? v10_customPlan : true)
bool v10_showConfirmation = v10_displayMaster and (v10_layout == "Mobile" ? false : v10_layout == "Custom" ? v10_customConfirmation : true)
bool v10_showDiagnostics = v10_displayMaster and (v10_layout == "Research" ? true : v10_layout == "Custom" ? v10_customDiagnostics : false)
bool v10_showMap = v10_showMajor or v10_showReaction or v10_showLiquidity

const string UI_GROUP = "01 · Appearance / หน้าตา"
string uiTheme = input.string("Dark", "Theme", options=["Dark", "Light"], group=UI_GROUP, display=display.none)
bool uiLabels = input.bool(true, "Zone labels / ชื่อโซน", group=UI_GROUP, display=display.none)
string uiSizeInput = input.string("Small", "Text size", options=["Tiny", "Small", "Normal"], group=UI_GROUP, display=display.none)
bool uiFinalSignals = input.bool(true, "Show final BUY / SELL", group=UI_GROUP, display=display.none)
color uiBull = input.color(#14B8A6, "Support / Buy", inline="palette", group=UI_GROUP, display=display.none)
color uiBear = input.color(#F47068, "Resistance / Sell", inline="palette", group=UI_GROUP, display=display.none)
color uiAccent = input.color(#E5B95C, "Accent", inline="palette", group=UI_GROUP, display=display.none)
color uiMuted = uiTheme == "Dark" ? #94A3B8 : #64748B
color uiText = uiTheme == "Dark" ? #E2E8F0 : #1E293B
color uiPanel = uiTheme == "Dark" ? #111827 : #F8FAFC
color uiBorder = uiTheme == "Dark" ? #334155 : #CBD5E1
string uiSize = uiSizeInput == "Tiny" ? size.tiny : uiSizeInput == "Normal" ? size.normal : size.small
int chartSec = timeframe.isticks ? na : int(timeframe.in_seconds(timeframe.main_period))
if timeframe.isticks
    runtime.error("EBW supports time-based charts. Tick intervals are not supported; select a seconds, minutes, daily, weekly or monthly interval.")

// Keep valid time-based requests inside Pine's 1 second to 12 month range.
// Minute charts never implicitly request paid seconds data for the fast slots.
f_relativeTf(simple float multiple) =>
    float floorSeconds = chartSec >= 60 ? 60.0 : float(chartSec)
    int target = int(math.min(timeframe.in_seconds("12M"), math.max(floorSeconds, chartSec * multiple)))
    multiple == 1.0 ? timeframe.main_period : timeframe.from_seconds(target)

string contextTf = chartSec < 86400 ? "1D" : f_relativeTf(3.0)

f_tfName(string tf) =>
    switch tf
        "1" => "1m"
        "3" => "3m"
        "5" => "5m"
        "15" => "15m"
        "30" => "30m"
        "60" => "1h"
        "120" => "2h"
        "240" => "4h"
        "360" => "6h"
        "600" => "10h"
        "45" => "45m"
        "90" => "90m"
        "180" => "3h"
        "D" => "1D"
        "1D" => "1D"
        "W" => "1W"
        "1W" => "1W"
        "M" => "1M"
        "1M" => "1M"
        "3M" => "3M"
        "12M" => "12M"
        => tf

f_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

const string X_GROUP = "08 · Execution confirmation / การยืนยันเข้า"
string x_mode = input.string("Balanced", "Confirmation mode", options=["Source triggers", "Balanced", "Strict"], group=X_GROUP, tooltip="Source triggers: corrected EBW/WT events. Balanced: MA trend plus a nearby zone OR agreeing structure. Strict: MA trend, nearby zone AND agreeing structure. All modes still require an aligned Edge and valid V10.4.4 close-reference plan. These are rules to evaluate, not calibrated probabilities.", display=display.none)
string x_direction = input.string("Both", "Signal direction", options=["Both", "BUY only", "SELL only"], group=X_GROUP, display=display.none)
bool x_signalDetails = input.bool(true, "Signal detail tooltips (last 20)", group=X_GROUP, display=display.none)
string x_trigger = input.string("Pullback + EBW / WT", "Trigger source", options=["Pullback + EBW / WT", "Pullback only", "EBW or WaveTrend", "EBW only", "WaveTrend only", "EBW + WaveTrend"], group=X_GROUP, display=display.none)
int x_pairWindow = input.int(3, "EBW + WT confirmation window (bars)", minval=0, maxval=12, group=X_GROUP, tooltip="Used only for EBW + WaveTrend. Requires a new source event on this bar and both same-direction events within the window.", display=display.none)
int x_cooldown = input.int(3, "Minimum bars between final signals", minval=0, maxval=50, group=X_GROUP, display=display.none)
bool x_spaceFilter = input.bool(true, "Require room before opposing zone", group=X_GROUP, display=display.none)
float x_minSpace = input.float(0.75, "Minimum room (chart ATR)", minval=0.0, maxval=5.0, step=0.25, group=X_GROUP, display=display.none)
int x_structureAge = input.int(40, "Maximum structure age · chart bars (0 = unlimited)", minval=0, maxval=1000, group=X_GROUP, tooltip="Limits the age of structure used for confirmation; does not change structure alert timing.", display=display.none)
bool x_rejection = input.bool(true, "Zone branch requires rejection close", group=X_GROUP, tooltip="For zone confirmation: candle intersects the POI and closes outside its proximal edge in signal direction. Balanced can still pass via structure.", display=display.none)
bool x_candleFilter = input.bool(true, "Require directional candle body", group=X_GROUP, display=display.none)
float x_minBody = input.float(0.30, "Minimum body / candle range", minval=0.0, maxval=0.9, step=0.05, group=X_GROUP, display=display.none)
bool x_shockFilter = input.bool(true, "Avoid unusually large signal candles", group=X_GROUP, display=display.none)
float x_maxRangeATR = input.float(2.5, "Maximum true range / previous ATR", minval=1.0, maxval=8.0, step=0.25, group=X_GROUP, tooltip="Uses the previous ATR, so the signal spike cannot inflate its own baseline. Includes opening gaps.", display=display.none)
bool x_sessionFilter = input.bool(false, "Only during selected sessions", group=X_GROUP, display=display.none)

const string ALERT_GROUP = "10 · Alerts / แจ้งเตือน"
bool x_alertMaster = input.bool(true, "Enable alerts", group=ALERT_GROUP, display=display.none)
bool x_alertFinal = input.bool(true, "Final BUY / SELL", group=ALERT_GROUP, display=display.none)
bool x_alertStructure = input.bool(false, "BOS / ChoCH", group=ALERT_GROUP, display=display.none)
bool x_alertPhase = input.bool(false, "Phase changes", group=ALERT_GROUP, display=display.none)
string x_phaseChoice = input.string("All", "Phase alert selection", options=["All", "Bullish", "Warning", "Accumulation", "Distribution", "Recovery", "Bearish"], group=ALERT_GROUP, display=display.none)
bool x_alertSession = input.bool(false, "Selected session opens", group=ALERT_GROUP, display=display.none)

// LIMIT PLANNER: independent source-clock registries; no chart-ATR merging.
const string LP_GROUP = "12 · Limit Planner / การบ้านล่วงหน้า"
string lp_view = input.string("Confirmation", "Workspace", options=["Limit Planner", "Confirmation", "Both"], group=LP_GROUP, tooltip="Confirmation suspends Limit Planner calculations and alerts. Choose Both to run both engines.", display=display.none)
bool lp_visible = lp_view != "Confirmation"
bool confirmationRun = lp_view != "Limit Planner"
bool structureRun = confirmationRun or (x_alertMaster and x_alertStructure)
bool phaseRun = confirmationRun or (x_alertMaster and x_alertPhase)
string lp_tf1 = input.timeframe("60", "Primary planning TF", group=LP_GROUP, display=display.none)
string lp_tf2 = input.timeframe("240", "Context / backup TF", group=LP_GROUP, display=display.none)
string lp_tf3 = input.timeframe("1D", "Macro TF", group=LP_GROUP, display=display.none)
bool lp_sd = input.bool(true, "Plan from confirmed base / departure", group=LP_GROUP, display=display.none)
bool lp_swings = input.bool(true, "Track swings as liquidity / SL structure", group=LP_GROUP, tooltip="Swings are kept for structure, stop placement and targets. They are not used as entry zones by themselves in V10.4.4.", display=display.none)
bool lp_ob = input.bool(true, "Plan from volume-pivot OB", group=LP_GROUP, display=display.none)
bool lp_flip = input.bool(true, "Plan from structural flips", group=LP_GROUP, display=display.none)
string lp_entryMode = input.string("Adaptive S&D", "Entry location", options=["Adaptive S&D", "Near edge", "Midpoint", "Custom depth"], group=LP_GROUP, tooltip="Adaptive S&D favors the proximal side of fresh supply/demand, deeper placement for OB/flip, and never uses a plain swing as an entry POI.", display=display.none)
float lp_depth = input.float(0.25, "Custom depth (0 proximal / 1 distal)", minval=0, maxval=1, step=0.05, group=LP_GROUP, display=display.none)
int lp_retests = input.int(0, "Maximum completed retests", minval=0, maxval=5, group=LP_GROUP, tooltip="Fresh-only default follows the supplied S&D material: repeated tests imply orders may be consumed.", display=display.none)
int lp_zoneAge = input.int(300, "Zone lifetime · source bars", minval=20, maxval=1500, group=LP_GROUP, display=display.none)
int lp_planAge = input.int(24, "Plan lifetime · source bars", minval=2, maxval=200, group=LP_GROUP, display=display.none)
string lp_stopMode = input.string("Structural", "SL placement", options=["Structural", "Zone edge", "ATR only"], group=LP_GROUP, tooltip="Structural places SL beyond the distal edge and, when a nearby same-side swing/liquidity anchor exists, beyond that anchor too.", display=display.none)
float lp_buffer = input.float(0.15, "SL safety buffer · source ATR", minval=0.01, maxval=2, step=0.01, group=LP_GROUP, tooltip="Base buffer beyond the structural anchor. Increased from the older tight 0.08 ATR default to reduce normal XAU liquidity-sweep stop-outs.", display=display.none)
float lp_swingStopMax = input.float(1.25, "Max extra swing protection · ATR", minval=0.0, maxval=3.0, step=0.05, group=LP_GROUP, tooltip="Maximum distance behind the POI where a same-side swing/liquidity anchor may protect the stop. If the resulting risk is too wide, the setup is rejected rather than using a tighter artificial SL.", display=display.none)
float lp_atrStop = input.float(1.5, "ATR-only stop · ATR", minval=0.25, maxval=10.0, step=0.25, group=LP_GROUP, display=display.none)
float lp_maxRisk = input.float(3.0, "Maximum stop distance · source ATR", minval=0.25, maxval=15, step=0.25, group=LP_GROUP, display=display.none)
float lp_minR = input.float(2.0, "Minimum target R after cost allowance", minval=0.25, maxval=5, step=0.25, group=LP_GROUP, tooltip="The supplied S&D material treats roughly 1:2 as a good benchmark; 2.0 follows the supplied S&D planning benchmark and is not a claim of profitability.", display=display.none)
float lp_costTicks = input.float(10, "Round-trip cost allowance · ticks", minval=0, maxval=10000, group=LP_GROUP, tooltip="User assumption, not live broker spread. Verify symbol tick size and your execution costs.", display=display.none)
bool lp_trend = input.bool(false, "Require source SMA 50 / 200 trend", group=LP_GROUP, display=display.none)
bool lp_cancelTarget = input.bool(true, "Cancel pending plan if target reached first", group=LP_GROUP, display=display.none)
bool lp_archive = input.bool(true, "Show latest archived plan per side", group=LP_GROUP, display=display.none)
bool lp_alerts = input.bool(true, "Limit plan event alerts", group=LP_GROUP, display=display.none)
string lp_alertScope = input.string("Primary", "Limit alert scope", options=["Primary", "All planning TFs"], group=LP_GROUP, display=display.none)
float lp_drawDistance = input.float(12, "Drawing distance · primary source ATR", minval=2, maxval=100, group=LP_GROUP, display=display.none)
string lp_panelMode = input.string("Compact", "Dashboard layout", options=["Compact", "Detailed", "Hidden"], group=LP_GROUP, tooltip="Compact is designed for phones. Detailed shows diagnostics and archives. Hidden removes only the dashboard.", display=display.none)
string lp_panelPosition = input.string("Bottom Right", "Dashboard position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=LP_GROUP, display=display.none)
string lp_panelSizeInput = input.string("Tiny", "Dashboard text size", options=["Tiny", "Small"], group=LP_GROUP, display=display.none)
string lp_chartDetail = input.string("Compact", "Chart label detail", options=["Compact", "Full", "Hidden"], group=LP_GROUP, tooltip="Compact shortens zone and Entry/SL/Target labels. Hidden keeps lines and zones without text.", display=display.none)
if barstate.isfirst and lp_visible and not (timeframe.in_seconds(lp_tf1) < timeframe.in_seconds(lp_tf2) and timeframe.in_seconds(lp_tf2) < timeframe.in_seconds(lp_tf3))
    runtime.error("Planning TFs must be strictly increasing: Primary < Context < Macro. For example 1H / 4H / 1D, or 1D / 1W / 1M.")

// One source event has immutable origin/confirmation/bounds. No merging.
type lp_Zone
    string id = ""
    string family = ""
    int side = 0
    float lo = na
    float hi = na
    int origin = na
    int known = na
    int observed = na
    int born = na
    float atr = na
    int tests = 0
    bool touching = false
    bool departed = false
    bool used = false
    string status = "Unknown"

type lp_Plan
    string id = ""
    string zoneId = ""
    string family = ""
    int side = 0
    float lo = na
    float hi = na
    float entry = na
    float stop = na
    float target = na
    float netR = na
    float buffer = na
    int origin = na
    int created = na
    int born = na
    int changed = na
    string status = "Waiting"
    string reason = "No eligible zone"

type lp_Pack
    int stamp = na
    int firstTime = na
    int clockBar = na
    float atr = na
    lp_Plan buy = na
    lp_Plan sell = na
    lp_Plan oldBuy = na
    lp_Plan oldSell = na
    lp_Zone support = na
    lp_Zone resistance = na
    int activeCount = 0
    int archivedCount = 0

type lp_Wire
    int stamp
    int firstTime
    int clockBar
    float atr
    string buy_id
    string buy_zoneId
    string buy_family
    int buy_side
    float buy_lo
    float buy_hi
    float buy_entry
    float buy_stop
    float buy_target
    float buy_netR
    float buy_buffer
    int buy_origin
    int buy_created
    int buy_born
    int buy_changed
    string buy_status
    string buy_reason
    string sell_id
    string sell_zoneId
    string sell_family
    int sell_side
    float sell_lo
    float sell_hi
    float sell_entry
    float sell_stop
    float sell_target
    float sell_netR
    float sell_buffer
    int sell_origin
    int sell_created
    int sell_born
    int sell_changed
    string sell_status
    string sell_reason
    string oldBuy_id
    string oldBuy_zoneId
    string oldBuy_family
    int oldBuy_side
    float oldBuy_lo
    float oldBuy_hi
    float oldBuy_entry
    float oldBuy_stop
    float oldBuy_target
    float oldBuy_netR
    float oldBuy_buffer
    int oldBuy_origin
    int oldBuy_created
    int oldBuy_born
    int oldBuy_changed
    string oldBuy_status
    string oldBuy_reason
    string oldSell_id
    string oldSell_zoneId
    string oldSell_family
    int oldSell_side
    float oldSell_lo
    float oldSell_hi
    float oldSell_entry
    float oldSell_stop
    float oldSell_target
    float oldSell_netR
    float oldSell_buffer
    int oldSell_origin
    int oldSell_created
    int oldSell_born
    int oldSell_changed
    string oldSell_status
    string oldSell_reason
    string support_id
    string support_family
    int support_side
    float support_lo
    float support_hi
    int support_origin
    int support_known
    int support_observed
    int support_born
    float support_atr
    int support_tests
    bool support_touching
    bool support_departed
    bool support_used
    string support_status
    string resistance_id
    string resistance_family
    int resistance_side
    float resistance_lo
    float resistance_hi
    int resistance_origin
    int resistance_known
    int resistance_observed
    int resistance_born
    float resistance_atr
    int resistance_tests
    bool resistance_touching
    bool resistance_departed
    bool resistance_used
    string resistance_status
    int activeCount
    int archivedCount

f_lp_wire(lp_Pack p) =>
    lp_Wire.new(p.stamp, p.firstTime, p.clockBar, p.atr, p.buy.id, p.buy.zoneId, p.buy.family, p.buy.side, p.buy.lo, p.buy.hi, p.buy.entry, p.buy.stop, p.buy.target, p.buy.netR, p.buy.buffer, p.buy.origin, p.buy.created, p.buy.born, p.buy.changed, p.buy.status, p.buy.reason, p.sell.id, p.sell.zoneId, p.sell.family, p.sell.side, p.sell.lo, p.sell.hi, p.sell.entry, p.sell.stop, p.sell.target, p.sell.netR, p.sell.buffer, p.sell.origin, p.sell.created, p.sell.born, p.sell.changed, p.sell.status, p.sell.reason, p.oldBuy.id, p.oldBuy.zoneId, p.oldBuy.family, p.oldBuy.side, p.oldBuy.lo, p.oldBuy.hi, p.oldBuy.entry, p.oldBuy.stop, p.oldBuy.target, p.oldBuy.netR, p.oldBuy.buffer, p.oldBuy.origin, p.oldBuy.created, p.oldBuy.born, p.oldBuy.changed, p.oldBuy.status, p.oldBuy.reason, p.oldSell.id, p.oldSell.zoneId, p.oldSell.family, p.oldSell.side, p.oldSell.lo, p.oldSell.hi, p.oldSell.entry, p.oldSell.stop, p.oldSell.target, p.oldSell.netR, p.oldSell.buffer, p.oldSell.origin, p.oldSell.created, p.oldSell.born, p.oldSell.changed, p.oldSell.status, p.oldSell.reason, p.support.id, p.support.family, p.support.side, p.support.lo, p.support.hi, p.support.origin, p.support.known, p.support.observed, p.support.born, p.support.atr, p.support.tests, p.support.touching, p.support.departed, p.support.used, p.support.status, p.resistance.id, p.resistance.family, p.resistance.side, p.resistance.lo, p.resistance.hi, p.resistance.origin, p.resistance.known, p.resistance.observed, p.resistance.born, p.resistance.atr, p.resistance.tests, p.resistance.touching, p.resistance.departed, p.resistance.used, p.resistance.status, p.activeCount, p.archivedCount)

f_lp_unwire(lp_Wire w) =>
    lp_Pack.new(w.stamp, w.firstTime, w.clockBar, w.atr, lp_Plan.new(w.buy_id, w.buy_zoneId, w.buy_family, w.buy_side, w.buy_lo, w.buy_hi, w.buy_entry, w.buy_stop, w.buy_target, w.buy_netR, w.buy_buffer, w.buy_origin, w.buy_created, w.buy_born, w.buy_changed, w.buy_status, w.buy_reason), lp_Plan.new(w.sell_id, w.sell_zoneId, w.sell_family, w.sell_side, w.sell_lo, w.sell_hi, w.sell_entry, w.sell_stop, w.sell_target, w.sell_netR, w.sell_buffer, w.sell_origin, w.sell_created, w.sell_born, w.sell_changed, w.sell_status, w.sell_reason), lp_Plan.new(w.oldBuy_id, w.oldBuy_zoneId, w.oldBuy_family, w.oldBuy_side, w.oldBuy_lo, w.oldBuy_hi, w.oldBuy_entry, w.oldBuy_stop, w.oldBuy_target, w.oldBuy_netR, w.oldBuy_buffer, w.oldBuy_origin, w.oldBuy_created, w.oldBuy_born, w.oldBuy_changed, w.oldBuy_status, w.oldBuy_reason), lp_Plan.new(w.oldSell_id, w.oldSell_zoneId, w.oldSell_family, w.oldSell_side, w.oldSell_lo, w.oldSell_hi, w.oldSell_entry, w.oldSell_stop, w.oldSell_target, w.oldSell_netR, w.oldSell_buffer, w.oldSell_origin, w.oldSell_created, w.oldSell_born, w.oldSell_changed, w.oldSell_status, w.oldSell_reason), lp_Zone.new(w.support_id, w.support_family, w.support_side, w.support_lo, w.support_hi, w.support_origin, w.support_known, w.support_observed, w.support_born, w.support_atr, w.support_tests, w.support_touching, w.support_departed, w.support_used, w.support_status), lp_Zone.new(w.resistance_id, w.resistance_family, w.resistance_side, w.resistance_lo, w.resistance_hi, w.resistance_origin, w.resistance_known, w.resistance_observed, w.resistance_born, w.resistance_atr, w.resistance_tests, w.resistance_touching, w.resistance_departed, w.resistance_used, w.resistance_status), w.activeCount, w.archivedCount)

f_lp_price(float p, bool upward) =>
    (upward ? math.ceil(p / syminfo.mintick) : math.floor(p / syminfo.mintick)) * syminfo.mintick

f_lp_entry(float lo, float hi, int side, float depth) =>
    side == 1 ? hi - depth * (hi - lo) : lo + depth * (hi - lo)

f_lp_ruleKey() =>
    string mode = lp_entryMode == "Adaptive S&D" ? "A" : lp_entryMode == "Near edge" ? "N" : lp_entryMode == "Midpoint" ? "M" : "C" + str.tostring(lp_depth, "#.##")
    string stopMode = lp_stopMode == "Structural" ? "S" : lp_stopMode == "Zone edge" ? "Z" : "A"
    "V99" + mode + stopMode + (lp_sd ? "d1" : "d0") + (lp_swings ? "w1" : "w0") + (lp_ob ? "o1" : "o0") + (lp_flip ? "f1" : "f0") + "r" + str.tostring(lp_retests) + "z" + str.tostring(lp_zoneAge) + "p" + str.tostring(lp_planAge) + "b" + str.tostring(lp_buffer, "#.##") + "s" + str.tostring(lp_swingStopMax, "#.##") + "a" + str.tostring(lp_atrStop, "#.##") + "m" + str.tostring(lp_maxRisk, "#.##") + "q" + str.tostring(lp_minR, "#.##") + "c" + str.tostring(lp_costTicks, "#.##") + (lp_trend ? "t1" : "t0") + (lp_cancelTarget ? "x1" : "x0")

f_lp_add(array<lp_Zone> zones, string family, int side, float lo, float hi, int originOffset, float atrValue) =>
    // Retrospective scan uses ONLY candles already available at confirmation.
    // Origin is excluded. First departure candle is not a retest.
    if not na(atrValue) and atrValue > 0 and not na(time[originOffset]) and hi > lo
        string id = syminfo.tickerid + ":" + timeframe.period + ":" + family + ":" + str.tostring(side) + ":" + str.tostring(time[originOffset])
        bool departed = originOffset == 0 and (side == 1 ? close > hi : close < lo)
        bool touching = false
        bool broken = false
        int tests = 0
        if originOffset > 0
            for offset = originOffset - 1 to 0
                broken := broken or (side == 1 ? low[offset] < lo - atrValue * lp_buffer : high[offset] > hi + atrValue * lp_buffer)
                if not departed
                    departed := side == 1 ? close[offset] > hi : close[offset] < lo
                else
                    bool hit = low[offset] <= hi and high[offset] >= lo
                    if hit and not touching
                        tests += 1
                    touching := hit
        if not broken
            string state = not departed ? "Unknown" : tests == 0 ? "Fresh" : "Retested"
            array.push(zones, lp_Zone.new(id, family, side, lo, hi, time[originOffset], time_close, time_close, bar_index, atrValue, tests, touching, departed, false, state))
    0

f_lp_updatePlan(lp_Plan plan, array<lp_Zone> zones, bool trendOK) =>
    // Restart-safe source-TF lifecycle. Prices are immutable after creation.
    if plan.id != "" and bar_index > plan.born
        bool waiting = plan.status == "Watching"
        bool active = plan.status == "Active"
        bool entryHit = low <= plan.entry and high >= plan.entry
        bool gappedPast = plan.side == 1 ? high < plan.entry : low > plan.entry
        bool stopHit = plan.side == 1 ? low <= plan.stop : high >= plan.stop
        bool targetHit = plan.side == 1 ? high >= plan.target : low <= plan.target
        float path = math.max(math.abs(plan.target - plan.entry), syminfo.mintick)
        float progress = ((plan.side == 1 ? high : low) - plan.entry) * plan.side / path
        bool invalidZone = true
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                lp_Zone z = array.get(zones, i)
                if z.id == plan.zoneId
                    invalidZone := z.status == "Broken" or z.status == "Expired"
                    break
        if waiting
            if gappedPast
                plan.status := "Gap / unverified"
                plan.reason := "Entire source range crossed beyond Entry between bars"
            else if entryHit
                plan.status := stopHit or targetHit ? "Ambiguous touch" : "Active"
                plan.reason := stopHit or targetHit ? "Entry and SL/TP touched in one source bar; sequence unknown" : "ENTRY REACHED · Entry / SL / TP locked"
            else if targetHit or (lp_cancelTarget and progress >= v10_cancelProgress)
                plan.status := "Invalidated"
                plan.reason := "Stale before Entry · price already travelled toward TP"
            else if bar_index - plan.born >= lp_planAge
                plan.status := "Expired"
                plan.reason := "Pending source-bar lifetime ended"
            else if invalidZone or not trendOK
                plan.status := "Invalidated"
                plan.reason := invalidZone ? "Source zone broken / expired before Entry" : "Source trend filter changed before Entry"
        else if active
            if stopHit and targetHit
                plan.status := "Closed · Ambiguous"
                plan.reason := "TP and SL touched in the same source bar; sequence unknown"
            else if stopHit
                plan.status := "Closed · SL"
                plan.reason := "SL touched after Entry"
            else if targetHit
                plan.status := "Closed · TP"
                plan.reason := "TP touched after Entry"
        if (waiting and plan.status != "Watching") or (active and plan.status != "Active")
            plan.changed := time_close
    0
f_lp_make(array<lp_Zone> zones, int side, float atrValue, bool trendOK) =>
    lp_Plan result = lp_Plan.new()
    float bestRank = -1e20
    float rejectionGap = 1e20
    string rejection = "No confirmed defend zone on this side"
    if not trendOK
        rejection := "Source trend filter"
    else if array.size(zones) > 0 and not na(atrValue)
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.side == side and not z.used and z.status != "Broken" and z.status != "Expired"
                bool prelimSide = side == 1 ? close > z.hi + lp_costTicks * syminfo.mintick : close < z.lo - lp_costTicks * syminfo.mintick
                string prelimReason = z.family == "Swing" ? "Swing is liquidity, not entry POI" : z.status == "Unknown" ? "Unknown departure history" : z.tests > lp_retests ? "Retest limit" : not prelimSide ? "Already reached / inside zone" : ""
                if prelimReason != ""
                    float prelimGap = math.abs(close - math.avg(z.lo, z.hi))
                    if prelimGap < rejectionGap
                        rejectionGap := prelimGap
                        rejection := z.family + " · " + prelimReason
                    continue
                // A plain swing is liquidity / structure. It may protect the stop or act as a target,
                // V10.4.4 keeps this rule: a plain swing is liquidity/structure, never an entry POI by itself.
                bool entryFamily = z.family != "Swing"
                float adaptiveDepth = z.family == "Demand" or z.family == "Supply" ? 0.15 : z.family == "Volume OB" ? 0.40 : z.family == "Flip" ? 0.35 : 0.20
                float depth = lp_entryMode == "Adaptive S&D" ? adaptiveDepth : lp_entryMode == "Near edge" ? 0.0 : lp_entryMode == "Midpoint" ? 0.5 : lp_depth
                float minEntry = f_lp_price(z.lo, true)
                float maxEntry = f_lp_price(z.hi, false)
                float e = math.max(minEntry, math.min(maxEntry, math.round_to_mintick(f_lp_entry(z.lo, z.hi, side, depth))))
                float cost = lp_costTicks * syminfo.mintick
                float safety = math.max(atrValue * lp_buffer, cost)

                // Structural stop logic: distal edge first, then extend beyond the nearest
                // same-side swing/liquidity anchor if it sits just behind the POI.
                float anchor = side == 1 ? z.lo : z.hi
                float anchorGap = -1.0
                if lp_stopMode == "Structural" and lp_swings and array.size(zones) > 0
                    for j = 0 to array.size(zones) - 1
                        lp_Zone structural = array.get(zones, j)
                        if structural.family == "Swing" and structural.side == side and structural.status != "Broken" and structural.status != "Expired"
                            float swingLevel = side == 1 ? structural.lo : structural.hi
                            float extension = side == 1 ? z.lo - swingLevel : swingLevel - z.hi
                            // Sweep-aware: protect beyond the deepest valid swing inside the allowed window.
                            // lp_maxRisk still rejects a stop that becomes structurally too wide.
                            if extension >= 0 and extension <= atrValue * lp_swingStopMax and extension > anchorGap
                                anchor := swingLevel
                                anchorGap := extension

                float rawStop = lp_stopMode == "ATR only" ? e - side * atrValue * lp_atrStop : side == 1 ? anchor - safety : anchor + safety
                float stop = f_lp_price(rawStop, side == -1)
                float risk = math.abs(e - stop)

                // First structural target: nearest active opposite-side level. Opposing swings are
                // allowed as targets because they represent liquidity; they are not entry zones.
                float target = na
                bool conflict = false
                for j = 0 to array.size(zones) - 1
                    lp_Zone other = array.get(zones, j)
                    if other.side == -side and other.status != "Broken" and other.status != "Expired"
                        conflict := conflict or (other.lo <= z.hi and other.hi >= z.lo)
                        float candidate = side == 1 ? other.lo : other.hi
                        if side == 1 ? candidate > e : candidate < e
                            if na(target) or math.abs(candidate - e) < math.abs(target - e)
                                target := candidate

                float netR = na(target) ? na : (math.abs(target - e) - cost) / math.max(risk + cost, syminfo.mintick)
                bool waitingSide = side == 1 ? close > z.hi + cost and close > e + cost : close < z.lo - cost and close < e - cost
                string reason = not entryFamily ? "Swing is liquidity, not entry POI" : z.status == "Unknown" ? "Unknown departure history" : z.tests > lp_retests ? "Retest limit" : not waitingSide ? "Already reached / inside zone" : conflict ? "Opposing zones overlap" : minEntry > maxEntry ? "Zone narrower than a tradable tick" : (side == 1 ? stop >= z.lo : stop <= z.hi) ? "Stop must clear distal zone edge" : risk < syminfo.mintick or risk > atrValue * lp_maxRisk ? "Structural stop-distance limit" : na(target) ? "No structural target" : netR < lp_minR ? "Insufficient net R" : "Eligible"

                float gap = math.abs(close - e)
                float familyPriority = z.family == "Demand" or z.family == "Supply" ? 30.0 : z.family == "Volume OB" ? 25.0 : z.family == "Flip" ? 22.0 : 0.0
                float freshBonus = z.tests == 0 ? 12.0 : z.tests == 1 ? 4.0 : -10.0
                float rank = familyPriority + freshBonus - gap / math.max(atrValue, syminfo.mintick) * 3.0
                if reason == "Eligible" and rank > bestRank
                    bestRank := rank
                    result := lp_Plan.new(z.id + ":" + f_lp_ruleKey(), z.id, z.family, side, z.lo, z.hi, e, stop, target, netR, safety, z.origin, time_close, bar_index, time_close, "Watching", "Eligible · Adaptive POI / structural invalidation · " + z.status + " · " + str.tostring(z.tests) + " retests")
                else if reason != "Eligible" and gap < rejectionGap
                    rejectionGap := gap
                    rejection := z.family + " · " + reason
    if result.id == ""
        result.reason := rejection
    else
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.id == result.zoneId
                z.used := true
    result

f_lp_engine() =>
    // This entire state machine executes in the requested source TF context.
    var array<lp_Zone> zones = array.new<lp_Zone>()
    var int archivedCount = 0
    var lp_Plan buy = lp_Plan.new()
    var lp_Plan sell = lp_Plan.new()
    var lp_Plan oldBuy = lp_Plan.new()
    var lp_Plan oldSell = lp_Plan.new()
    var int firstTime = time
    float a = ta.atr(14)
    float fast = ta.sma(close, 50)
    float slow = ta.sma(close, 200)
    bool trendBuy = not lp_trend or (close > slow and fast > slow)
    bool trendSell = not lp_trend or (close < slow and fast < slow)
    float ph = ta.pivothigh(high, 3, 3)
    float pl = ta.pivotlow(low, 3, 3)
    float vp = ta.pivothigh(volume, 10, 10)
    var float pendingHigh = na
    var float pendingLow = na
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.status != "Broken" and z.status != "Expired" and bar_index > z.born
                bool broken = z.side == 1 ? low < z.lo - z.atr * lp_buffer : high > z.hi + z.atr * lp_buffer
                if broken
                    z.status := "Broken"
                else if bar_index - z.born >= lp_zoneAge
                    z.status := "Expired"
                else
                    if not z.departed
                        z.departed := z.side == 1 ? close > z.hi : close < z.lo
                        if z.departed
                            // Unknown historical departure never silently becomes Fresh.
                            z.status := "Unknown"
                    else
                        bool hit = low <= z.hi and high >= z.lo
                        if hit and not z.touching
                            z.tests += 1
                        z.touching := hit
                        if z.status != "Unknown"
                            z.status := z.tests == 0 ? "Fresh" : "Retested"
    f_lp_updatePlan(buy, zones, trendBuy)
    f_lp_updatePlan(sell, zones, trendSell)
    // Archive only terminal plans. Active plans keep the original frozen levels.
    if buy.id != "" and buy.status != "Watching" and buy.status != "Active"
        oldBuy := buy.copy()
        if timeframe.in_seconds() == timeframe.in_seconds(lp_tf1)
            archivedCount := math.min(40, archivedCount + 1)
        buy := lp_Plan.new()
    if sell.id != "" and sell.status != "Watching" and sell.status != "Active"
        oldSell := sell.copy()
        if timeframe.in_seconds() == timeframe.in_seconds(lp_tf1)
            archivedCount := math.min(40, archivedCount + 1)
        sell := lp_Plan.new()
    if lp_flip and not na(a)
        if not na(pendingHigh) and close > pendingHigh + a * 0.1
            f_lp_add(zones, "Flip", 1, pendingHigh - a * 0.1, pendingHigh + a * 0.1, 0, a)
            pendingHigh := na
        if not na(pendingLow) and close < pendingLow - a * 0.1
            f_lp_add(zones, "Flip", -1, pendingLow - a * 0.1, pendingLow + a * 0.1, 0, a)
            pendingLow := na
    if not na(ph)
        pendingHigh := ph
        if lp_swings
            f_lp_add(zones, "Swing", -1, ph - a[3] * 0.15, ph, 3, a[3])
    if not na(pl)
        pendingLow := pl
        if lp_swings
            f_lp_add(zones, "Swing", 1, pl, pl + a[3] * 0.15, 3, a[3])
    bool base = math.abs(close[1] - open[1]) <= (high[1] - low[1]) * 0.4
    if lp_sd and base and not na(a)
        if close > high[1] and close - open >= a * 0.6
            f_lp_add(zones, "Demand", 1, low[1], math.max(open[1], close[1]), 1, a[1])
        if close < low[1] and open - close >= a * 0.6
            f_lp_add(zones, "Supply", -1, math.min(open[1], close[1]), high[1], 1, a[1])
    if lp_ob and not na(vp)
        if close > high[10]
            f_lp_add(zones, "Volume OB", 1, low[10], hl2[10], 10, a[10])
        if close < low[10]
            f_lp_add(zones, "Volume OB", -1, hl2[10], high[10], 10, a[10])
    if buy.id == ""
        buy := f_lp_make(zones, 1, a, trendBuy)
    if sell.id == ""
        sell := f_lp_make(zones, -1, a, trendSell)
    // Deterministic bounded history. Never drop a zone referenced by a pending/active plan.
    while array.size(zones) > 100
        int removeIndex = -1
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            bool protected = ((buy.status == "Watching" or buy.status == "Active") and z.id == buy.zoneId) or ((sell.status == "Watching" or sell.status == "Active") and z.id == sell.zoneId)
            if not protected and removeIndex == -1
                removeIndex := i
        if removeIndex >= 0
            array.remove(zones, removeIndex)
        else
            break
    lp_Zone support = lp_Zone.new()
    lp_Zone resistance = lp_Zone.new()
    int activeCount = 0
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.status != "Broken" and z.status != "Expired"
                activeCount += 1
                if z.side == 1 and z.lo < close and (na(support.hi) or math.abs(close - z.hi) < math.abs(close - support.hi))
                    support := z.copy()
                if z.side == -1 and z.hi > close and (na(resistance.lo) or math.abs(close - z.lo) < math.abs(close - resistance.lo))
                    resistance := z.copy()
    // Primitive value snapshots: historical packets cannot mutate with future plans/zones.
    lp_Pack result = lp_Pack.new(time_close, firstTime, bar_index, a, buy, sell, oldBuy, oldSell, support, resistance, activeCount, archivedCount)
    lp_Wire wire = f_lp_wire(result)
    wire[1]

bool lp_aligned = timeframe.in_seconds(lp_tf1) % chartSec == 0 and timeframe.in_seconds(lp_tf2) % chartSec == 0 and timeframe.in_seconds(lp_tf3) % chartSec == 0
bool lp_supported = chart.is_standard and not timeframe.isticks and lp_aligned and chartSec <= timeframe.in_seconds(lp_tf1) and chartSec <= timeframe.in_seconds(lp_tf2) and chartSec <= timeframe.in_seconds(lp_tf3)
// A single dynamic request scope serves the three independent source contexts.
// This avoids compiling the full planner and wire conversion three times.
var array<string> lp_sourceTFs = array.from(lp_tf1, lp_tf2, lp_tf3)
var array<lp_Pack> lp_packets = array.new<lp_Pack>(3, na)
if lp_visible and lp_supported
    for sourceIndex = 0 to 2
        string sourceTf = array.get(lp_sourceTFs, sourceIndex)
        lp_Wire wire = request.security(syminfo.tickerid, sourceTf, f_lp_engine(), lookahead=barmerge.lookahead_on, calc_bars_count=1200)
        lp_Pack previous = array.get(lp_packets, sourceIndex)
        if not na(wire) and (na(previous) or wire.stamp != previous.stamp)
            array.set(lp_packets, sourceIndex, f_lp_unwire(wire))
lp_Pack lp_a = array.get(lp_packets, 0)
lp_Pack lp_b = array.get(lp_packets, 1)
lp_Pack lp_c = array.get(lp_packets, 2)

f_lp_planText(lp_Plan p) =>
    lp_Plan q = na(p) ? lp_Plan.new() : p
    q.id == "" ? q.reason : q.status + " · " + q.family + "\nE " + f_price(q.entry) + " | SL " + f_price(q.stop) + "\nTarget " + f_price(q.target) + " | net " + str.tostring(q.netR, "#.##") + "R\n" + q.reason

f_lp_event(lp_Plan p, string previous, string tf, string eventType) =>
    // Host compatibility: during MTF warm-up PineTS can surface an uninitialized nested UDT as na.
    lp_Plan q = na(p) ? lp_Plan.new() : p
    string key = q.id + ":" + q.status
    string message = key != previous and q.id != "" ? eventType + " | " + tf + " | " + q.id + " | " + q.status + "\n" + q.reason + "\nE " + f_price(q.entry) + " | SL " + f_price(q.stop) + " | Target " + f_price(q.target) + "\nSource close " + str.format_time(q.changed, "yyyy-MM-dd HH:mm", syminfo.timezone) + " " + syminfo.timezone + "\nNot a broker order or fill.\n" : ""
    [key, message]

var string lp_prevBuy = ""
var string lp_prevSell = ""
var string lp_prevBuyB = ""
var string lp_prevSellB = ""
var string lp_prevBuyC = ""
var string lp_prevSellC = ""
var string lp_prevClosedBuy = ""
var string lp_prevClosedSell = ""
var string lp_prevClosedBuyB = ""
var string lp_prevClosedSellB = ""
var string lp_prevClosedBuyC = ""
var string lp_prevClosedSellC = ""
string lp_events = ""
if lp_supported and not na(lp_a) and barstate.isconfirmed
    [closedBuyKey, closedBuyEvent] = f_lp_event(lp_a.oldBuy, lp_prevClosedBuy, lp_tf1, "PLAN CLOSED")
    [closedSellKey, closedSellEvent] = f_lp_event(lp_a.oldSell, lp_prevClosedSell, lp_tf1, "PLAN CLOSED")
    [buyKey, buyEvent] = f_lp_event(lp_a.buy, lp_prevBuy, lp_tf1, "NEW PLAN")
    [sellKey, sellEvent] = f_lp_event(lp_a.sell, lp_prevSell, lp_tf1, "NEW PLAN")
    lp_events := lp_alerts ? closedBuyEvent + closedSellEvent + buyEvent + sellEvent : ""
    lp_prevClosedBuy := closedBuyKey
    lp_prevClosedSell := closedSellKey
    lp_prevBuy := buyKey
    lp_prevSell := sellKey
    if lp_alerts and lp_alertScope == "All planning TFs" and not na(lp_b) and not na(lp_c)
        [closedBuyKeyB, closedBuyEventB] = f_lp_event(lp_b.oldBuy, lp_prevClosedBuyB, lp_tf2, "PLAN CLOSED")
        [closedSellKeyB, closedSellEventB] = f_lp_event(lp_b.oldSell, lp_prevClosedSellB, lp_tf2, "PLAN CLOSED")
        [closedBuyKeyC, closedBuyEventC] = f_lp_event(lp_c.oldBuy, lp_prevClosedBuyC, lp_tf3, "PLAN CLOSED")
        [closedSellKeyC, closedSellEventC] = f_lp_event(lp_c.oldSell, lp_prevClosedSellC, lp_tf3, "PLAN CLOSED")
        [buyKeyB, buyEventB] = f_lp_event(lp_b.buy, lp_prevBuyB, lp_tf2, "NEW PLAN")
        [sellKeyB, sellEventB] = f_lp_event(lp_b.sell, lp_prevSellB, lp_tf2, "NEW PLAN")
        [buyKeyC, buyEventC] = f_lp_event(lp_c.buy, lp_prevBuyC, lp_tf3, "NEW PLAN")
        [sellKeyC, sellEventC] = f_lp_event(lp_c.sell, lp_prevSellC, lp_tf3, "NEW PLAN")
        lp_events += closedBuyEventB + closedSellEventB + closedBuyEventC + closedSellEventC + buyEventB + sellEventB + buyEventC + sellEventC
        lp_prevClosedBuyB := closedBuyKeyB
        lp_prevClosedSellB := closedSellKeyB
        lp_prevClosedBuyC := closedBuyKeyC
        lp_prevClosedSellC := closedSellKeyC
        lp_prevBuyB := buyKeyB
        lp_prevSellB := sellKeyB
        lp_prevBuyC := buyKeyC
        lp_prevSellC := sellKeyC

// Fixed drawing pools: six map bands and two primary plans (three levels each).
var array<box> lp_boxes = array.new<box>()
var array<label> lp_badges = array.new<label>()
var array<line> lp_rays = array.new<line>()
var array<label> lp_prices = array.new<label>()
if barstate.isfirst
    for i = 0 to 5
        array.push(lp_boxes, box.new(na, na, na, na, force_overlay=true))
        array.push(lp_badges, label.new(na, na, "", style=label.style_label_right, force_overlay=true))
        array.push(lp_rays, line.new(na, na, na, na, force_overlay=true))
        array.push(lp_prices, label.new(na, na, "", style=label.style_label_left, force_overlay=true))
string lp_panelPositionValue = lp_panelPosition == "Top Left" ? position.top_left : lp_panelPosition == "Bottom Right" ? position.bottom_right : lp_panelPosition == "Bottom Left" ? position.bottom_left : position.top_right
string lp_panelSize = lp_panelSizeInput == "Small" ? size.small : size.tiny
var table lp_board = table.new(lp_panelPositionValue, 2, 13, bgcolor=color.new(uiPanel, 3), frame_color=uiBorder, frame_width=1, force_overlay=true)
f_lp_row(int row, string title, string value, color tint) =>
    table.cell(lp_board, 0, row, title, text_color=uiMuted, text_size=lp_panelSize, text_halign=text.align_left, bgcolor=uiPanel)
    table.cell(lp_board, 1, row, value, text_color=tint, text_size=lp_panelSize, text_halign=text.align_right, bgcolor=uiPanel)

f_lp_statusCode(lp_Plan p) =>
    lp_Plan q = na(p) ? lp_Plan.new() : p
    q.id == "" ? "—" : q.status == "Watching" ? "WAIT" : q.status == "Active" ? "ACTIVE" : q.status == "Ambiguous touch" ? "CHECK" : q.status == "Expired" ? "EXPIRED" : q.status == "Invalidated" ? "VOID" : str.upper(q.status)

f_lp_compactPlan(lp_Plan p) =>
    lp_Plan q = na(p) ? lp_Plan.new() : p
    q.id == "" ? "—" : f_lp_statusCode(q) + ((q.status == "Watching" or q.status == "Active") ? " · " + f_price(q.entry) : "")

f_lp_pair(lp_Pack packet) =>
    na(packet) ? "—" : "B " + f_lp_compactPlan(packet.buy) + " / S " + f_lp_compactPlan(packet.sell)

f_lp_left(lp_Pack packet, lp_Plan p) =>
    lp_Plan q = na(p) ? lp_Plan.new() : p
    q.id == "" or na(packet) ? "—" : str.tostring(math.max(0, lp_planAge - (packet.clockBar - q.born)))

f_lp_familyCode(string family) =>
    family == "Demand" ? "D" : family == "Supply" ? "S" : family == "Swing" ? "SW" : family == "Flip" ? "FL" : family == "Volume OB" ? "OB" : family

if barstate.islast
    table.set_position(lp_board, lp_panelPositionValue)
    table.clear(lp_board, 0, 0, 1, 12)
    bool lp_showPanel = v10_displayMaster and uiDashboard and lp_visible and lp_panelMode != "Hidden"
    if lp_showPanel and lp_panelMode == "Compact"
        f_lp_row(0, "EBW PLAN", f_tfName(lp_tf1) + " / " + f_tfName(lp_tf2) + " / " + f_tfName(lp_tf3), uiAccent)
        if lp_supported and not na(lp_a)
            f_lp_row(1, "BUY " + f_tfName(lp_tf1), f_lp_compactPlan(lp_a.buy), uiBull)
            f_lp_row(2, "SELL " + f_tfName(lp_tf1), f_lp_compactPlan(lp_a.sell), uiBear)
            f_lp_row(3, f_tfName(lp_tf2), f_lp_pair(lp_b), uiText)
            f_lp_row(4, f_tfName(lp_tf3), f_lp_pair(lp_c), uiText)
            f_lp_row(5, "AS OF · LEFT", str.format_time(lp_a.stamp, "MM-dd HH:mm", syminfo.timezone) + " · B" + f_lp_left(lp_a, lp_a.buy) + "/S" + f_lp_left(lp_a, lp_a.sell), uiMuted)
        else if lp_supported
            f_lp_row(1, "STATUS", "LOADING SOURCE DATA", uiAccent)
            f_lp_row(2, "SOURCE", f_tfName(lp_tf1) + " / " + f_tfName(lp_tf2) + " / " + f_tfName(lp_tf3), uiMuted)
        else
            f_lp_row(1, "STATUS", "ADJUST CHART / TF", uiBear)
            f_lp_row(2, "RULE", "Chart <= planning TFs", uiMuted)
            f_lp_row(3, "ALIGN", "Use divisible intervals", uiMuted)
    if lp_showPanel and lp_panelMode == "Detailed"
        f_lp_row(0, "EBW LIMIT PLANNER", "SOURCE CLOCK · " + f_tfName(lp_tf1), uiAccent)
        f_lp_row(1, "STATUS", not lp_supported ? "Use standard chart <= TFs with divisible intervals" : "Source-close checks · broker orders unknown", lp_supported ? uiMuted : uiBear)
        f_lp_row(2, "ENTRY / LIFETIME", lp_entryMode + " / " + str.tostring(lp_planAge) + " source bars", uiText)
    for i = 0 to 5
        lp_Pack packet = na
        if i < 2
            packet := lp_a
        else if i < 4
            packet := lp_b
        else
            packet := lp_c
        string sourceTf = i < 2 ? lp_tf1 : i < 4 ? lp_tf2 : lp_tf3
        lp_Zone z = lp_Zone.new()
        if not na(packet)
            lp_Zone candidateZone = i % 2 == 0 ? packet.support : packet.resistance
            if not na(candidateZone)
                z := candidateZone
        box band = array.get(lp_boxes, i)
        label badge = array.get(lp_badges, i)
        color tint = i % 2 == 0 ? uiBull : uiBear
        bool draw = v10_displayMaster and lp_visible and lp_supported and z.id != "" and not na(lp_a) and math.abs(close - math.avg(z.lo, z.hi)) <= lp_a.atr * lp_drawDistance
        if draw
            box.set_lefttop(band, bar_index - 80, z.hi)
            box.set_rightbottom(band, bar_index + 10 + i * 3, z.lo)
            box.set_bgcolor(band, color.new(tint, 94))
            box.set_border_color(band, color.new(tint, 55))
            label.set_xy(badge, lp_chartDetail == "Hidden" ? na : bar_index + 10 + i * 3, i % 2 == 0 ? z.hi : z.lo)
            string zoneText = lp_chartDetail == "Hidden" ? "" : lp_chartDetail == "Compact" ? f_tfName(sourceTf) + " " + f_lp_familyCode(z.family) + " · " + z.status : f_tfName(sourceTf) + " " + z.family + " · " + z.status
            label.set_text(badge, zoneText)
            label.set_color(badge, color.new(uiPanel, 10))
            label.set_textcolor(badge, tint)
            label.set_size(badge, lp_panelSize)
            label.set_tooltip(badge, z.id + "\nBounds " + f_price(z.lo) + "–" + f_price(z.hi) + "\nOrigin " + str.format_time(z.origin, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nKnown " + str.format_time(z.known, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nFirst observed in replay " + str.format_time(z.observed, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nRetests " + str.tostring(z.tests) + "; not a probability. Band extension is a current map, not historical availability.")
        else
            box.set_lefttop(band, na, na)
            box.set_rightbottom(band, na, na)
            label.set_xy(badge, na, na)
        if lp_showPanel and lp_panelMode == "Detailed"
            lp_Plan p = lp_Plan.new()
            if not na(packet)
                lp_Plan candidatePlan = i % 2 == 0 ? packet.buy : packet.sell
                if not na(candidatePlan)
                    p := candidatePlan
            string prefix = i < 2 ? "PRIMARY " : i < 4 ? "CONTEXT " : "MACRO "
            f_lp_row(i + 3, prefix + f_tfName(sourceTf) + (i % 2 == 0 ? " BUY" : " SELL"), not lp_supported ? "Overview only / planning unsupported" : f_lp_planText(p), tint)
    for i = 0 to 5
        lp_Plan p = lp_Plan.new()
        if not na(lp_a)
            lp_Plan candidatePlan = i < 3 ? lp_a.buy : lp_a.sell
            if not na(candidatePlan)
                p := candidatePlan
        int levelIndex = i % 3
        float level = levelIndex == 0 ? p.entry : levelIndex == 1 ? p.stop : p.target
        line ray = array.get(lp_rays, i)
        label badge = array.get(lp_prices, i)
        bool draw = v10_displayMaster and lp_visible and lp_supported and p.id != "" and not na(lp_a) and math.abs(close - level) <= lp_a.atr * lp_drawDistance
        if draw
            color tint = levelIndex == 1 ? uiBear : levelIndex == 0 ? uiAccent : uiBull
            line.set_xy1(ray, bar_index - 30, level)
            line.set_xy2(ray, bar_index + 35, level)
            line.set_color(ray, color.new(tint, (p.status == "Watching" or p.status == "Active") ? 0 : 65))
            line.set_style(ray, line.style_dashed)
            label.set_xy(badge, lp_chartDetail == "Hidden" ? na : bar_index + 35, level)
            string levelName = levelIndex == 0 ? "E" : levelIndex == 1 ? "SL" : "TP"
            string levelText = lp_chartDetail == "Hidden" ? "" : lp_chartDetail == "Compact" ? (p.side == 1 ? "B " : "S ") + levelName + " " + f_price(level) : (p.side == 1 ? "BUY LIMIT " : "SELL LIMIT ") + (levelIndex == 0 ? "ENTRY " : levelIndex == 1 ? "STOP " : "TARGET ") + f_price(level)
            label.set_text(badge, levelText)
            label.set_textcolor(badge, tint)
            label.set_color(badge, color.new(uiPanel, 8))
            label.set_size(badge, lp_panelSize)
            label.set_tooltip(badge, p.id + "\n" + p.status + "\n" + p.reason + "\nCreated " + str.format_time(p.created, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nFrozen prices; source-bar checks; not an order or fill.")
        else
            line.set_xy1(ray, na, na)
            line.set_xy2(ray, na, na)
            label.set_xy(badge, na, na)
    if lp_showPanel and lp_panelMode == "Detailed" and not na(lp_a)
        f_lp_row(9, "PRIMARY MAP", "S " + f_price(lp_a.support.lo) + "–" + f_price(lp_a.support.hi) + "\nR " + f_price(lp_a.resistance.lo) + "–" + f_price(lp_a.resistance.hi), uiText)
        f_lp_row(10, "DATA START", str.format_time(lp_a.firstTime, "yyyy-MM-dd", syminfo.timezone) + " · max 2000 source bars", uiMuted)
        f_lp_row(11, "LAST BUY ARCHIVE", lp_archive ? lp_a.oldBuy.status + " · " + lp_a.oldBuy.reason : "Hidden", uiMuted)
        f_lp_row(12, "LAST SELL ARCHIVE", lp_archive ? lp_a.oldSell.status + " · " + lp_a.oldSell.reason : "Hidden", uiMuted)

// ============================================================================
// SIGNALS: source-timeframe data -> confirmed events -> bounded state machines.
// All permanent events and state changes are committed only at chart-bar close.
// Any lower-TF momentum is the final confirmed sample, NOT a replay of all
// intrabars. Events in omitted samples can be missed; standard fast TFs divide 5m/15m/1h.
// ============================================================================
const string s_GROUP_EBW = "02 | EBW patterns"
const string s_GROUP_WT = "03 | WaveTrend"
const string s_GROUP_PHASE = "05 | Market phase"

string s_tfMode = input.string("Intraday standard", "Signal timeframes", options=["Intraday standard", "Adaptive", "Legacy fixed"], group=s_GROUP_EBW, tooltip="Intraday standard uses aligned lower samples and familiar higher contexts on 5m/15m/1h; on 5m the second fast slot reuses 5m. Adaptive: fast samples near chart/5 and chart*3/5, base=chart, trend contexts near chart*3, *6, *12, *48. Rounded to valid timeframes and capped at 12M. Minute charts use at least 1m; seconds charts use the chart itself for fast slots. Legacy fixed retains the V8 set.", display=display.none)
bool s_standard = s_tfMode == "Intraday standard" and (chartSec == 300 or chartSec == 900 or chartSec == 3600)
bool s_adaptive = s_tfMode != "Legacy fixed"
string s_tf1 = s_standard ? (chartSec == 300 ? "1" : chartSec == 900 ? "3" : "5") : s_adaptive ? f_relativeTf(0.2) : "1"
string s_tf3 = s_standard ? (chartSec <= 900 ? "5" : "15") : s_adaptive ? f_relativeTf(0.6) : "3"
string s_tf5 = s_adaptive ? timeframe.period : "5"
string s_tf15 = s_standard ? (chartSec == 300 ? "15" : chartSec == 900 ? "30" : "120") : s_adaptive ? f_relativeTf(3.0) : "15"
string s_tf30 = s_standard ? (chartSec == 300 ? "30" : chartSec == 900 ? "60" : "240") : s_adaptive ? f_relativeTf(6.0) : "30"
string s_tf60 = s_standard ? (chartSec == 300 ? "60" : chartSec == 900 ? "240" : "720") : s_adaptive ? f_relativeTf(12.0) : "60"
string s_tf240 = s_standard ? (chartSec == 300 ? "240" : "1D") : s_adaptive ? f_relativeTf(48.0) : "240"

bool s_ebwOn = input.bool(true, "Enable six EBW patterns", group=s_GROUP_EBW, display=display.none) and confirmationRun
int s_expiry = input.int(100, "Pattern expires after chart bars", minval=20, maxval=1000, group=s_GROUP_EBW, tooltip="Whole-pattern lifetime, measured from the first armed stage. Default 100 bars = about 8h20m on a continuous 5m chart.", display=display.none)
bool s_wtOn = input.bool(true, "Enable WaveTrend signals", group=s_GROUP_WT, display=display.none) and confirmationRun
int s_wtChannel = input.int(9, "Channel length", minval=2, maxval=100, group=s_GROUP_WT, display=display.none)
int s_wtAverage = input.int(12, "Average length", minval=2, maxval=100, group=s_GROUP_WT, display=display.none)
int s_wtSmooth = input.int(3, "Signal smoothing", minval=1, maxval=50, group=s_GROUP_WT, display=display.none)
float s_wtExtreme = input.float(75.0, "Extreme threshold (+/-)", minval=10.0, maxval=150.0, step=5.0, group=s_GROUP_WT, display=display.none)
string s_maMethod = input.string("EMA", "MA method", options=["EMA", "SMA"], group=s_GROUP_PHASE, display=display.none)
int s_fastLen = input.int(20, "Fast MA", minval=2, maxval=500, group=s_GROUP_PHASE, display=display.none)
int s_slowLen = input.int(50, "Slow MA", minval=3, maxval=1000, group=s_GROUP_PHASE, display=display.none)

if barstate.isfirst and s_fastLen >= s_slowLen
    runtime.error("Fast MA must be shorter than Slow MA.")

type s_Momentum
    float rsi = na
    float k = na
    float d = na
    float rawK = na
    bool kdDown = false
    bool kdUp = false
    bool kUp20 = false
    bool kDown80 = false
    int stamp = na
    int closedAt = na

// History references are evaluated INSIDE the source context. Crosses therefore
// refer to source candles rather than to chart bars after the series is merged.
f_s_momentum(int offsetBars) =>
    float r = ta.rsi(close, 14)
    float raw = ta.stoch(close, high, low, 9)
    float kk = ta.sma(raw, 3)
    float dd = ta.sma(kk, 3)
    bool crossDown = ta.crossunder(kk, dd)
    bool crossUp = ta.crossover(kk, dd)
    bool up20 = ta.crossover(kk, 20.0)
    bool down80 = ta.crossunder(kk, 80.0)
    s_Momentum.new(r[offsetBars], kk[offsetBars], dd[offsetBars], raw[offsetBars], crossDown[offsetBars], crossUp[offsetBars], up20[offsetBars], down80[offsetBars], time[offsetBars], time_close[offsetBars])

simple int i_ltfBars = 2600
// PineTS compatibility: each MTF slot uses a unique request callsite.
// TradingView supports one dynamic callsite in a loop; unique callsites avoid
// PineTS secondary-context cache collisions while preserving the same rules.
f_s_request_0(string sourceTf) =>
    int sourceSeconds = int(timeframe.in_seconds(sourceTf))
    bool alignedLower = sourceSeconds < chartSec and chartSec % sourceSeconds == 0
    s_Momentum result = s_Momentum.new()
    if sourceSeconds > chartSec
        result := request.security(syminfo.tickerid, sourceTf, f_s_momentum(1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=1200)
    else if sourceSeconds == chartSec
        result := f_s_momentum(0)
    else if sourceSeconds < chartSec
        // PineTS host compatibility: use the dedicated LTF API for lower-timeframe
        // sampling. Select the final confirmed sample whose close is inside this chart bar.
        array<s_Momentum> samples = request.security_lower_tf(syminfo.tickerid, sourceTf, f_s_momentum(0), ignore_invalid_timeframe=true, calc_bars_count=i_ltfBars)
        if array.size(samples) > 0
            for index = array.size(samples) - 1 to 0
                s_Momentum sample = array.get(samples, index)
                if sample.closedAt <= time_close
                    result := sample
                    break
    na(result) ? s_Momentum.new() : result

f_s_request_1(string sourceTf) =>
    int sourceSeconds = int(timeframe.in_seconds(sourceTf))
    bool alignedLower = sourceSeconds < chartSec and chartSec % sourceSeconds == 0
    s_Momentum result = s_Momentum.new()
    if sourceSeconds > chartSec
        result := request.security(syminfo.tickerid, sourceTf, f_s_momentum(1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=1200)
    else if sourceSeconds == chartSec
        result := f_s_momentum(0)
    else if sourceSeconds < chartSec
        // PineTS host compatibility: use the dedicated LTF API for lower-timeframe
        // sampling. Select the final confirmed sample whose close is inside this chart bar.
        array<s_Momentum> samples = request.security_lower_tf(syminfo.tickerid, sourceTf, f_s_momentum(0), ignore_invalid_timeframe=true, calc_bars_count=i_ltfBars)
        if array.size(samples) > 0
            for index = array.size(samples) - 1 to 0
                s_Momentum sample = array.get(samples, index)
                if sample.closedAt <= time_close
                    result := sample
                    break
    na(result) ? s_Momentum.new() : result

f_s_request_2(string sourceTf) =>
    int sourceSeconds = int(timeframe.in_seconds(sourceTf))
    bool alignedLower = sourceSeconds < chartSec and chartSec % sourceSeconds == 0
    s_Momentum result = s_Momentum.new()
    if sourceSeconds > chartSec
        result := request.security(syminfo.tickerid, sourceTf, f_s_momentum(1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=1200)
    else if sourceSeconds == chartSec
        result := f_s_momentum(0)
    else if sourceSeconds < chartSec
        // PineTS host compatibility: use the dedicated LTF API for lower-timeframe
        // sampling. Select the final confirmed sample whose close is inside this chart bar.
        array<s_Momentum> samples = request.security_lower_tf(syminfo.tickerid, sourceTf, f_s_momentum(0), ignore_invalid_timeframe=true, calc_bars_count=i_ltfBars)
        if array.size(samples) > 0
            for index = array.size(samples) - 1 to 0
                s_Momentum sample = array.get(samples, index)
                if sample.closedAt <= time_close
                    result := sample
                    break
    na(result) ? s_Momentum.new() : result

f_s_request_3(string sourceTf) =>
    int sourceSeconds = int(timeframe.in_seconds(sourceTf))
    bool alignedLower = sourceSeconds < chartSec and chartSec % sourceSeconds == 0
    s_Momentum result = s_Momentum.new()
    if sourceSeconds > chartSec
        result := request.security(syminfo.tickerid, sourceTf, f_s_momentum(1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=1200)
    else if sourceSeconds == chartSec
        result := f_s_momentum(0)
    else if sourceSeconds < chartSec
        // PineTS host compatibility: use the dedicated LTF API for lower-timeframe
        // sampling. Select the final confirmed sample whose close is inside this chart bar.
        array<s_Momentum> samples = request.security_lower_tf(syminfo.tickerid, sourceTf, f_s_momentum(0), ignore_invalid_timeframe=true, calc_bars_count=i_ltfBars)
        if array.size(samples) > 0
            for index = array.size(samples) - 1 to 0
                s_Momentum sample = array.get(samples, index)
                if sample.closedAt <= time_close
                    result := sample
                    break
    na(result) ? s_Momentum.new() : result

