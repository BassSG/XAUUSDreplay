//@version=6
indicator("All Indy (EBW) V10.4.4 • Clean + Stochastic + RSI • Zone Bridge 1.1", shorttitle="EBW ZB 1.1", overlay=false, max_lines_count=200, max_boxes_count=160, max_labels_count=160, dynamic_requests=true, calc_bars_count=1000)

// BEGIN ZONE BRIDGE SWITCH
const string ZB_GROUP = "00 · เชื่อม EBW-Fibo"
bool zb_enabled = input.bool(true, "ส่งโซนให้ EBW-Fibo (ไม่วาดเพิ่ม)", group=ZB_GROUP, tooltip="ส่งกล่องที่แสดงจริง มีประวัติครบ ออกจากฐานแล้ว และยังไม่ถูกทำลาย สูงสุด 2 Demand + 2 Supply; ไปเลือกช่อง ZB ใน EBW-Fibo ก่อนใช้งาน", display=display.none)
// END ZONE BRIDGE SWITCH

// One script: EBW on the price chart; Stochastic and RSI in this script's pane.
const string COMBO_DASH = "00 · Dashboard / เปิด–ปิดแดชบอร์ด"
bool uiDashboard = input.bool(false, "Show dashboards / แสดงแดชบอร์ด", group=COMBO_DASH, tooltip="Show EBW dashboards on the main price chart. Off by default.", display=display.none)
string uiPosition = input.string("Top Right", "Dashboard position / ตำแหน่ง", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=COMBO_DASH, display=display.none)

const string COMBO_OSC = "00 · Stochastic + RSI / พาเนลด้านล่าง"
bool combo_showStoch = input.bool(true, "Show Stochastic / แสดง Stochastic", group=COMBO_OSC, display=display.none)
int combo_kLength = input.int(9, "Stochastic length", minval=1, maxval=200, group=COMBO_OSC, display=display.none)
