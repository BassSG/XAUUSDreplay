s_Momentum s_m1 = s_ebwOn ? f_s_request_0(s_tf1) : s_Momentum.new()
s_Momentum s_m3 = s_ebwOn ? f_s_request_1(s_tf3) : s_Momentum.new()
s_Momentum s_m5 = s_ebwOn ? f_s_request_2(s_tf5) : s_Momentum.new()
s_Momentum s_m15 = s_ebwOn ? f_s_request_3(s_tf15) : s_Momentum.new()
s_Momentum s_m30 = s_ebwOn ? f_s_request_4(s_tf30) : s_Momentum.new()
s_Momentum s_m60 = s_ebwOn ? f_s_request_5(s_tf60) : s_Momentum.new()
s_Momentum s_m240 = s_ebwOn ? f_s_request_6(s_tf240) : s_Momentum.new()

var int s_seen5 = na
var int s_seen15 = na
bool s_new5 = barstate.isconfirmed and not na(s_m5.stamp) and (na(s_seen5) or s_m5.stamp != s_seen5)
bool s_new15 = barstate.isconfirmed and not na(s_m15.stamp) and (na(s_seen15) or s_m15.stamp != s_seen15)
bool s_kdDown5 = s_new5 and s_m5.kdDown
bool s_kdUp5 = s_new5 and s_m5.kdUp
bool s_kUp20_15 = s_new15 and s_m15.kUp20
bool s_kDown80_5 = s_new5 and s_m5.kDown80
bool s_ebwReady = not na(s_m1.rsi) and not na(s_m1.k) and not na(s_m3.rsi) and not na(s_m3.k) and not na(s_m5.rsi) and not na(s_m5.d) and not na(s_m15.rsi) and not na(s_m15.k) and not na(s_m30.rsi) and not na(s_m30.k) and not na(s_m60.rsi) and not na(s_m60.k) and not na(s_m240.k)
bool s_bullEngulf = close[1] < open[1] and close > high[1]
bool s_bearEngulf = close[1] > open[1] and close < low[1]

type s_Machine
    int stage = 0
    int started = na

// A single switch uses the state at the START of this confirmed chart bar.
// Threshold stages are retained from V7; source-cross stages use timestamped
// events. Reaching the terminal stage arms the trigger for subsequent bars.
f_s_nextP(int stage) =>
    switch stage
        0 => s_m5.rsi < 27 or s_m60.k > 40 or s_m240.k > 40 ? 1 : 0
        1 => s_m5.rsi > 32 ? 2 : 1
        2 => s_m5.rsi < 30 ? 3 : 2
        3 => s_m5.k > 20 ? 4 : 3
        4 => s_m5.k < 80 ? 5 : 4
        5 => s_m5.k > 20 or s_m5.rsi < 18 or s_m30.rsi < 18 ? 6 : 5
        6 => s_m5.rsi < 25 ? 7 : 6
        7 => s_m5.rsi > 31 or s_m5.k > 60 ? 8 : s_m15.rsi < 30 ? 4 : 7
        8 => s_m30.rsi > 35 ? 0 : s_m5.k < 20 ? 9 : 8
        9 => s_m1.k < 20 and s_m1.rsi < 30 ? 10 : 9
        => stage

f_s_nextL1(int stage) =>
    switch stage
        0 => s_m5.rsi < 25 ? 1 : 0
        1 => s_m5.k < 20 ? 2 : 1
        2 => s_m5.k > 80 ? 3 : 2
        3 => s_m5.k < 20 ? 4 : 3
        4 => s_m1.k > 80 ? 5 : 4
        5 => s_m1.k < 20 ? 6 : 5
        6 => s_m5.rsi > 35 ? 7 : 6
        7 => s_m5.rsi < 25 ? 8 : 7