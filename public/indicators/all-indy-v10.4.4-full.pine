//@version=6
indicator("All Indy (EBW) V10.4.4 • Clean + Stochastic + RSI • Zone Bridge 1.1", shorttitle="EBW ZB 1.1", overlay=false, max_lines_count=200, max_boxes_count=160, max_labels_count=160, dynamic_requests=true, calc_bars_count=1000)

// BEGIN ZONE BRIDGE SWITCH
const string ZB_GROUP = "00 · เชื่อม EBW-Fibo"
bool zb_enabled = input.bool(true, "ส่งโซนให้ EBW-Fibo (ไม่วาดเพิ่ม)", group=ZB_GROUP, tooltip="ส่งกล่องที่แสดงจริง มีประวัติครบ ออกจากฐานแล้ว และยังไม่ถูกทำลาย สูงสุด 2 Demand + 2 Supply; ไปเลือกช่อง ZB ใน EBW-Fibo ก่อนใช้งาน", display=display.none)
// END ZONE BRIDGE SWITCH

// One script: EBW on the price chart; Stochastic and RSI in this script's pane.
const string COMBO_DASH = "00 · Dashboard / เปิด–ปิดแดชบอร์ด"
bool uiDashboard = input.bool(false, "Show dashboards / แสดงแดชบอร์ด", group=COMBO_DASH, tooltip="Show EBW dashboards on the main price chart. Off by default.", display=display.none)
string uiPosition = input.string("Top Right", "Dashboard position / ตำแหน่ง", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=COMBO_DASH, display=display.none)

const string COMBO_OSC = "00 · Stochastic + RSI / พาเนลด้านล่าง"
bool combo_showStoch = input.bool(true, "Show Stochastic / แสดง Stochastic", group=COMBO_OSC, display=display.none)
int combo_kLength = input.int(9, "Stochastic length", minval=1, maxval=200, group=COMBO_OSC, display=display.none)
int combo_kSmooth = input.int(3, "Smooth K", minval=1, maxval=50, group=COMBO_OSC, display=display.none)
int combo_dLength = input.int(3, "Smooth D", minval=1, maxval=50, group=COMBO_OSC, display=display.none)
bool combo_showRSI = input.bool(true, "Show RSI / แสดง RSI", group=COMBO_OSC, display=display.none)
int combo_rsiLength = input.int(14, "RSI length", minval=1, maxval=200, group=COMBO_OSC, display=display.none)
color combo_kColor = input.color(#FFFFFF, "Stochastic K", inline="oscColors", group=COMBO_OSC, display=display.none)
color combo_dColor = input.color(#F04747, "D", inline="oscColors", group=COMBO_OSC, display=display.none)
color combo_rsiColor = input.color(#FFFFFF, "RSI", inline="oscColors", group=COMBO_OSC, display=display.none)

// Allocate only the OHLC/time buffers required by the bounded source audit.
// Bounded source audit, including delayed QML activation. No unbounded indexing.
max_bars_back(time, 320)
max_bars_back(time_close, 320)
max_bars_back(high, 320)
max_bars_back(low, 320)
max_bars_back(close, 320)
var int ebw_firstBar = bar_index
var int ebw_firstTime = time

// V10.4.4 Intraday: preserves EBW, WaveTrend and the audited S&D / Limit Planner engines.
// New: sweep-aware structural SL + restart-safe plan lifecycle + runtime guard.
// Pending Entry/SL/TP freeze when a plan appears; after Entry they stay locked until TP/SL.
// SL is placed beyond mapped liquidity / swing structure with an adaptive sweep buffer.
// Runtime guard removes the expensive aligned-LTF intrabar-array path and caps the POI registry.
// If the structurally-correct SL becomes too wide or RR becomes poor, the setup is rejected rather than squeezed.
// Inputs are starting heuristics, not optimized parameters or win probabilities.
// Signal entry is the confirmed chart close, NOT an assumed broker fill.
// SL/TP touch monitoring starts on the NEXT chart bar; no intrabar order is inferred.
// Historical signals are limited to the latest 1000 chart bars plus source warmup.
// HTF prior-source snapshots and final LTF sample semantics are preserved.

const string I_GROUP = "00 · Intraday / ตั้งค่าสำหรับ 5m 15m 1h"
bool i_htfFilter = input.bool(true, "Confirm higher-TF trend / กรองเทรนด์ TF ใหญ่", group=I_GROUP, tooltip="Auto context: 5m -> 15m; 15m -> 1h; 1h -> 4h. Uses only the previous completed source bar.", display=display.none)
bool i_chopFilter = input.bool(true, "Avoid compressed MAs / กรองเส้น MA ชิดกัน", group=I_GROUP, display=display.none)
float i_minSeparation = input.float(0.10, "Minimum MA gap / previous ATR", minval=0.0, maxval=1.0, step=0.05, group=I_GROUP, display=display.none)
float i_maxChase = input.float(1.25, "Maximum distance from fast MA / ATR", minval=0.25, maxval=5, step=0.25, group=I_GROUP, tooltip="Rejects a trigger that closes too far from the fast MA. Uses previous ATR.", display=display.none)
float i_minNetR = input.float(1.5, "Minimum net reward / risk", minval=0.5, maxval=5, step=0.25, group=I_GROUP, display=display.none)
float i_targetR = input.float(2.0, "Target cap / gross R", minval=1, maxval=10, step=0.25, group=I_GROUP, tooltip="Target is capped by the FIRST mapped opposing POI or liquidity level. No mapped target = no final signal.", display=display.none)
float i_costTicks = input.float(0, "Round-trip costs / ticks · ตั้งตามโบรกเกอร์", minval=0, maxval=100000, group=I_GROUP, tooltip="Total spread + commission + slippage converted to price ticks. Zero means costs have NOT been modeled. Net R = (reward - cost) / (risk + cost).", display=display.none)
float i_minStopATR = input.float(0.75, "Minimum stop distance / previous ATR", minval=0.1, maxval=3, step=0.1, group=I_GROUP, display=display.none)
float i_maxStopATR = input.float(2.5, "Maximum stop distance / previous ATR", minval=0.5, maxval=10, step=0.25, group=I_GROUP, display=display.none)
float i_stopBuffer = input.float(0.18, "SL beyond zone / candle · previous ATR", minval=0, maxval=1, step=0.01, group=I_GROUP, tooltip="Base structural buffer for confirmed reference plans. Sweep-aware logic may use a wider buffer when liquidity sits directly behind the POI.", display=display.none)
int i_planBars = input.int(12, "Pending setup expires after chart bars", minval=1, maxval=100, group=I_GROUP, tooltip="Applies only before Entry is reached. After Entry, Entry / SL / TP stay locked until TP or SL.", display=display.none)
int i_zoneContexts = input.int(2, "Higher-TF map layers / จำนวน TF ของโซน", minval=1, maxval=4, group=I_GROUP, tooltip="Default 2: chart + next two higher contexts. Increase for a broader map and more calculations.", display=display.none)
bool i_dailyMap = input.bool(false, "Add separate Daily map / เพิ่มโซนรายวัน", group=I_GROUP, display=display.none)
if barstate.isfirst and i_minStopATR > i_maxStopATR
    runtime.error("Minimum stop ATR must not exceed maximum stop ATR.")

const string PERF_GROUP = "00 · Runtime / ประสิทธิภาพ"
bool perf_runtimeGuard = input.bool(true, "Runtime guard · Recommended", group=PERF_GROUP, tooltip="Keeps the expensive POI registry bounded and uses a lighter aligned lower-TF sampling path. Entry/SL/TP logic and the locked non-repaint lifecycle are unchanged.", display=display.none)
int perf_recordCap = input.int(110, "Runtime guard · POI record cap", minval=80, maxval=160, step=10, group=PERF_GROUP, tooltip="Maximum active POI records retained while Runtime guard is enabled. Premium Clean normally needs far fewer than this.", display=display.none)

const string V10_GROUP = "00 · V10 Decision & Display / การตัดสินใจและหน้าจอ"
bool v10_displayMaster = input.bool(true, "Show V10 on chart / แสดง V10 บนกราฟ", group=V10_GROUP, tooltip="Presentation master only. Turning this off hides V10 drawings/panels while the underlying calculations and alerts continue.", display=display.none)
string v10_layout = input.string("Trading", "Workspace preset", options=["Mobile", "Trading", "Research", "Custom"], group=V10_GROUP, tooltip="Mobile: minimum clutter. Trading: decision + clean map. Research: full diagnostics. Custom: use the switches below.", display=display.none)
bool v10_customEdge = input.bool(true, "Custom · Market Edge panel", group=V10_GROUP, display=display.none)
bool v10_customMajor = input.bool(true, "Custom · Major zones", group=V10_GROUP, display=display.none)
bool v10_customReaction = input.bool(true, "Custom · Reaction zones", group=V10_GROUP, display=display.none)
bool v10_customLiquidity = input.bool(true, "Custom · BSL / SSL liquidity", group=V10_GROUP, display=display.none)
bool v10_customPlan = input.bool(true, "Custom · Entry / SL / TP drawings", group=V10_GROUP, display=display.none)
bool v10_customConfirmation = input.bool(true, "Custom · Confirmation / signal marks", group=V10_GROUP, display=display.none)
bool v10_customDiagnostics = input.bool(false, "Custom · Diagnostics rows", group=V10_GROUP, display=display.none)
float v10_edgeMinScore = input.float(56.0, "Minimum directional evidence score", minval=40.0, maxval=90.0, step=1.0, group=V10_GROUP, tooltip="Market Edge is an evidence score, not a win probability.", display=display.none)
float v10_edgeGap = input.float(10.0, "Minimum BUY/SELL evidence gap", minval=2.0, maxval=40.0, step=1.0, group=V10_GROUP, tooltip="If BUY and SELL evidence are too close, V10 stays NEUTRAL instead of forcing a direction.", display=display.none)
float v10_edgeSearchATR = input.float(8.0, "Focus-zone search · ATR", minval=1.0, maxval=30.0, step=0.5, group=V10_GROUP, display=display.none)
float v10_watchATR = input.float(0.35, "Approaching preferred zone · ATR", minval=0.05, maxval=2.0, step=0.05, group=V10_GROUP, display=display.none)
float v10_minRoomATR = input.float(0.75, "Minimum distance to first obstacle · ATR", minval=0.0, maxval=5.0, step=0.25, group=V10_GROUP, tooltip="Execution state becomes NO TRADE when the first opposing POI is too close to the planned entry.", display=display.none)
float v10_minPlanR = input.float(1.0, "Minimum R to first obstacle", minval=0.25, maxval=5.0, step=0.25, group=V10_GROUP, tooltip="Quick planning filter only. Uses planned Entry to Invalidation versus the first opposing structural obstacle. This is not a win probability.", display=display.none)
float v10_invalidBuffer = input.float(0.15, "Base invalidation buffer · ATR", minval=0.0, maxval=1.0, step=0.01, group=V10_GROUP, tooltip="Base distance beyond the selected protective structure. V10.4.4 can automatically widen this when liquidity sits immediately behind the POI.", display=display.none)
float v10_anchorSearchATR = input.float(1.50, "Protective anchor search · ATR", minval=0.25, maxval=5.0, step=0.25, group=V10_GROUP, tooltip="Search behind the focus zone for same-side swing / SSL / BSL liquidity. V10.4.4 protects beyond the deepest mapped anchor inside this window, then applies the sweep buffer.", display=display.none)
float v10_sweepRiskATR = input.float(0.60, "Nearby sweep-risk band · ATR", minval=0.05, maxval=2.0, step=0.05, group=V10_GROUP, tooltip="If the selected liquidity anchor is within this distance behind the zone, the setup is treated as vulnerable to a stop-hunt / liquidity sweep.", display=display.none)
float v10_sweepBufferATR = input.float(0.25, "Sweep-protection buffer · ATR", minval=0.05, maxval=1.0, step=0.05, group=V10_GROUP, tooltip="Minimum buffer beyond a nearby protective liquidity anchor. The setup is rejected if this structural SL violates maximum-risk or RR rules; the engine does not squeeze the SL inward.", display=display.none)
bool v10_requireAnchor = input.bool(true, "Require protective anchor for pending LIMIT", group=V10_GROUP, tooltip="When enabled, a raw pending BUY/SELL LIMIT is withheld if no mapped protective liquidity/swing exists behind the zone. Confirmed signal plans may still use the zone plus candle structure.", display=display.none)
float v10_cancelProgress = input.float(0.90, "Cancel pending after path-to-TP", minval=0.50, maxval=1.00, step=0.05, group=V10_GROUP, tooltip="Before Entry only. 0.90 cancels a still-pending plan after price has travelled 90% of the Entry-to-TP path without reaching Entry. Once Entry is reached, the plan is locked until TP/SL.", display=display.none)

bool v10_showEdge = v10_displayMaster and (v10_layout == "Custom" ? v10_customEdge : true)
bool v10_showMajor = v10_displayMaster and (v10_layout == "Custom" ? v10_customMajor : true)
bool v10_showReaction = v10_displayMaster and (v10_layout == "Mobile" ? false : v10_layout == "Custom" ? v10_customReaction : true)
bool v10_showLiquidity = v10_displayMaster and (v10_layout == "Custom" ? v10_customLiquidity : true)
bool v10_showPlan = v10_displayMaster and (v10_layout == "Mobile" ? false : v10_layout == "Custom" ? v10_customPlan : true)
bool v10_showConfirmation = v10_displayMaster and (v10_layout == "Mobile" ? false : v10_layout == "Custom" ? v10_customConfirmation : true)
bool v10_showDiagnostics = v10_displayMaster and (v10_layout == "Research" ? true : v10_layout == "Custom" ? v10_customDiagnostics : false)
bool v10_showMap = v10_showMajor or v10_showReaction or v10_showLiquidity

const string UI_GROUP = "01 · Appearance / หน้าตา"
string uiTheme = input.string("Dark", "Theme", options=["Dark", "Light"], group=UI_GROUP, display=display.none)
bool uiLabels = input.bool(true, "Zone labels / ชื่อโซน", group=UI_GROUP, display=display.none)
string uiSizeInput = input.string("Small", "Text size", options=["Tiny", "Small", "Normal"], group=UI_GROUP, display=display.none)
bool uiFinalSignals = input.bool(true, "Show final BUY / SELL", group=UI_GROUP, display=display.none)
color uiBull = input.color(#14B8A6, "Support / Buy", inline="palette", group=UI_GROUP, display=display.none)
color uiBear = input.color(#F47068, "Resistance / Sell", inline="palette", group=UI_GROUP, display=display.none)
color uiAccent = input.color(#E5B95C, "Accent", inline="palette", group=UI_GROUP, display=display.none)
color uiMuted = uiTheme == "Dark" ? #94A3B8 : #64748B
color uiText = uiTheme == "Dark" ? #E2E8F0 : #1E293B
color uiPanel = uiTheme == "Dark" ? #111827 : #F8FAFC
color uiBorder = uiTheme == "Dark" ? #334155 : #CBD5E1
string uiSize = uiSizeInput == "Tiny" ? size.tiny : uiSizeInput == "Normal" ? size.normal : size.small
int chartSec = timeframe.isticks ? na : int(timeframe.in_seconds(timeframe.main_period))
if timeframe.isticks
    runtime.error("EBW supports time-based charts. Tick intervals are not supported; select a seconds, minutes, daily, weekly or monthly interval.")

// Keep valid time-based requests inside Pine's 1 second to 12 month range.
// Minute charts never implicitly request paid seconds data for the fast slots.
f_relativeTf(simple float multiple) =>
    float floorSeconds = chartSec >= 60 ? 60.0 : float(chartSec)
    int target = int(math.min(timeframe.in_seconds("12M"), math.max(floorSeconds, chartSec * multiple)))
    multiple == 1.0 ? timeframe.main_period : timeframe.from_seconds(target)

string contextTf = chartSec < 86400 ? "1D" : f_relativeTf(3.0)

f_tfName(string tf) =>
    switch tf
        "1" => "1m"
        "3" => "3m"
        "5" => "5m"
        "15" => "15m"
        "30" => "30m"
        "60" => "1h"
        "120" => "2h"
        "240" => "4h"
        "360" => "6h"
        "600" => "10h"
        "45" => "45m"
        "90" => "90m"
        "180" => "3h"
        "D" => "1D"
        "1D" => "1D"
        "W" => "1W"
        "1W" => "1W"
        "M" => "1M"
        "1M" => "1M"
        "3M" => "3M"
        "12M" => "12M"
        => tf

f_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

const string X_GROUP = "08 · Execution confirmation / การยืนยันเข้า"
string x_mode = input.string("Balanced", "Confirmation mode", options=["Source triggers", "Balanced", "Strict"], group=X_GROUP, tooltip="Source triggers: corrected EBW/WT events. Balanced: MA trend plus a nearby zone OR agreeing structure. Strict: MA trend, nearby zone AND agreeing structure. All modes still require an aligned Edge and valid V10.4.4 close-reference plan. These are rules to evaluate, not calibrated probabilities.", display=display.none)
string x_direction = input.string("Both", "Signal direction", options=["Both", "BUY only", "SELL only"], group=X_GROUP, display=display.none)
bool x_signalDetails = input.bool(true, "Signal detail tooltips (last 20)", group=X_GROUP, display=display.none)
string x_trigger = input.string("Pullback + EBW / WT", "Trigger source", options=["Pullback + EBW / WT", "Pullback only", "EBW or WaveTrend", "EBW only", "WaveTrend only", "EBW + WaveTrend"], group=X_GROUP, display=display.none)
int x_pairWindow = input.int(3, "EBW + WT confirmation window (bars)", minval=0, maxval=12, group=X_GROUP, tooltip="Used only for EBW + WaveTrend. Requires a new source event on this bar and both same-direction events within the window.", display=display.none)
int x_cooldown = input.int(3, "Minimum bars between final signals", minval=0, maxval=50, group=X_GROUP, display=display.none)
bool x_spaceFilter = input.bool(true, "Require room before opposing zone", group=X_GROUP, display=display.none)
float x_minSpace = input.float(0.75, "Minimum room (chart ATR)", minval=0.0, maxval=5.0, step=0.25, group=X_GROUP, display=display.none)
int x_structureAge = input.int(40, "Maximum structure age · chart bars (0 = unlimited)", minval=0, maxval=1000, group=X_GROUP, tooltip="Limits the age of structure used for confirmation; does not change structure alert timing.", display=display.none)
bool x_rejection = input.bool(true, "Zone branch requires rejection close", group=X_GROUP, tooltip="For zone confirmation: candle intersects the POI and closes outside its proximal edge in signal direction. Balanced can still pass via structure.", display=display.none)
bool x_candleFilter = input.bool(true, "Require directional candle body", group=X_GROUP, display=display.none)
float x_minBody = input.float(0.30, "Minimum body / candle range", minval=0.0, maxval=0.9, step=0.05, group=X_GROUP, display=display.none)
bool x_shockFilter = input.bool(true, "Avoid unusually large signal candles", group=X_GROUP, display=display.none)
float x_maxRangeATR = input.float(2.5, "Maximum true range / previous ATR", minval=1.0, maxval=8.0, step=0.25, group=X_GROUP, tooltip="Uses the previous ATR, so the signal spike cannot inflate its own baseline. Includes opening gaps.", display=display.none)
bool x_sessionFilter = input.bool(false, "Only during selected sessions", group=X_GROUP, display=display.none)

const string ALERT_GROUP = "10 · Alerts / แจ้งเตือน"
bool x_alertMaster = input.bool(true, "Enable alerts", group=ALERT_GROUP, display=display.none)
bool x_alertFinal = input.bool(true, "Final BUY / SELL", group=ALERT_GROUP, display=display.none)
bool x_alertStructure = input.bool(false, "BOS / ChoCH", group=ALERT_GROUP, display=display.none)
bool x_alertPhase = input.bool(false, "Phase changes", group=ALERT_GROUP, display=display.none)
string x_phaseChoice = input.string("All", "Phase alert selection", options=["All", "Bullish", "Warning", "Accumulation", "Distribution", "Recovery", "Bearish"], group=ALERT_GROUP, display=display.none)
bool x_alertSession = input.bool(false, "Selected session opens", group=ALERT_GROUP, display=display.none)

// LIMIT PLANNER: independent source-clock registries; no chart-ATR merging.
const string LP_GROUP = "12 · Limit Planner / การบ้านล่วงหน้า"
string lp_view = input.string("Confirmation", "Workspace", options=["Limit Planner", "Confirmation", "Both"], group=LP_GROUP, tooltip="Confirmation suspends Limit Planner calculations and alerts. Choose Both to run both engines.", display=display.none)
bool lp_visible = lp_view != "Confirmation"
bool confirmationRun = lp_view != "Limit Planner"
bool structureRun = confirmationRun or (x_alertMaster and x_alertStructure)
bool phaseRun = confirmationRun or (x_alertMaster and x_alertPhase)
string lp_tf1 = input.timeframe("60", "Primary planning TF", group=LP_GROUP, display=display.none)
string lp_tf2 = input.timeframe("240", "Context / backup TF", group=LP_GROUP, display=display.none)
string lp_tf3 = input.timeframe("1D", "Macro TF", group=LP_GROUP, display=display.none)
bool lp_sd = input.bool(true, "Plan from confirmed base / departure", group=LP_GROUP, display=display.none)
bool lp_swings = input.bool(true, "Track swings as liquidity / SL structure", group=LP_GROUP, tooltip="Swings are kept for structure, stop placement and targets. They are not used as entry zones by themselves in V10.4.4.", display=display.none)
bool lp_ob = input.bool(true, "Plan from volume-pivot OB", group=LP_GROUP, display=display.none)
bool lp_flip = input.bool(true, "Plan from structural flips", group=LP_GROUP, display=display.none)
string lp_entryMode = input.string("Adaptive S&D", "Entry location", options=["Adaptive S&D", "Near edge", "Midpoint", "Custom depth"], group=LP_GROUP, tooltip="Adaptive S&D favors the proximal side of fresh supply/demand, deeper placement for OB/flip, and never uses a plain swing as an entry POI.", display=display.none)
float lp_depth = input.float(0.25, "Custom depth (0 proximal / 1 distal)", minval=0, maxval=1, step=0.05, group=LP_GROUP, display=display.none)
int lp_retests = input.int(0, "Maximum completed retests", minval=0, maxval=5, group=LP_GROUP, tooltip="Fresh-only default follows the supplied S&D material: repeated tests imply orders may be consumed.", display=display.none)
int lp_zoneAge = input.int(300, "Zone lifetime · source bars", minval=20, maxval=1500, group=LP_GROUP, display=display.none)
int lp_planAge = input.int(24, "Plan lifetime · source bars", minval=2, maxval=200, group=LP_GROUP, display=display.none)
string lp_stopMode = input.string("Structural", "SL placement", options=["Structural", "Zone edge", "ATR only"], group=LP_GROUP, tooltip="Structural places SL beyond the distal edge and, when a nearby same-side swing/liquidity anchor exists, beyond that anchor too.", display=display.none)
float lp_buffer = input.float(0.15, "SL safety buffer · source ATR", minval=0.01, maxval=2, step=0.01, group=LP_GROUP, tooltip="Base buffer beyond the structural anchor. Increased from the older tight 0.08 ATR default to reduce normal XAU liquidity-sweep stop-outs.", display=display.none)
float lp_swingStopMax = input.float(1.25, "Max extra swing protection · ATR", minval=0.0, maxval=3.0, step=0.05, group=LP_GROUP, tooltip="Maximum distance behind the POI where a same-side swing/liquidity anchor may protect the stop. If the resulting risk is too wide, the setup is rejected rather than using a tighter artificial SL.", display=display.none)
float lp_atrStop = input.float(1.5, "ATR-only stop · ATR", minval=0.25, maxval=10.0, step=0.25, group=LP_GROUP, display=display.none)
float lp_maxRisk = input.float(3.0, "Maximum stop distance · source ATR", minval=0.25, maxval=15, step=0.25, group=LP_GROUP, display=display.none)
float lp_minR = input.float(2.0, "Minimum target R after cost allowance", minval=0.25, maxval=5, step=0.25, group=LP_GROUP, tooltip="The supplied S&D material treats roughly 1:2 as a good benchmark; 2.0 follows the supplied S&D planning benchmark and is not a claim of profitability.", display=display.none)
float lp_costTicks = input.float(10, "Round-trip cost allowance · ticks", minval=0, maxval=10000, group=LP_GROUP, tooltip="User assumption, not live broker spread. Verify symbol tick size and your execution costs.", display=display.none)
bool lp_trend = input.bool(false, "Require source SMA 50 / 200 trend", group=LP_GROUP, display=display.none)
bool lp_cancelTarget = input.bool(true, "Cancel pending plan if target reached first", group=LP_GROUP, display=display.none)
bool lp_archive = input.bool(true, "Show latest archived plan per side", group=LP_GROUP, display=display.none)
bool lp_alerts = input.bool(true, "Limit plan event alerts", group=LP_GROUP, display=display.none)
string lp_alertScope = input.string("Primary", "Limit alert scope", options=["Primary", "All planning TFs"], group=LP_GROUP, display=display.none)
float lp_drawDistance = input.float(12, "Drawing distance · primary source ATR", minval=2, maxval=100, group=LP_GROUP, display=display.none)
string lp_panelMode = input.string("Compact", "Dashboard layout", options=["Compact", "Detailed", "Hidden"], group=LP_GROUP, tooltip="Compact is designed for phones. Detailed shows diagnostics and archives. Hidden removes only the dashboard.", display=display.none)
string lp_panelPosition = input.string("Bottom Right", "Dashboard position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=LP_GROUP, display=display.none)
string lp_panelSizeInput = input.string("Tiny", "Dashboard text size", options=["Tiny", "Small"], group=LP_GROUP, display=display.none)
string lp_chartDetail = input.string("Compact", "Chart label detail", options=["Compact", "Full", "Hidden"], group=LP_GROUP, tooltip="Compact shortens zone and Entry/SL/Target labels. Hidden keeps lines and zones without text.", display=display.none)
if barstate.isfirst and lp_visible and not (timeframe.in_seconds(lp_tf1) < timeframe.in_seconds(lp_tf2) and timeframe.in_seconds(lp_tf2) < timeframe.in_seconds(lp_tf3))
    runtime.error("Planning TFs must be strictly increasing: Primary < Context < Macro. For example 1H / 4H / 1D, or 1D / 1W / 1M.")

// One source event has immutable origin/confirmation/bounds. No merging.
type lp_Zone
    string id = ""
    string family = ""
    int side = 0
    float lo = na
    float hi = na
    int origin = na
    int known = na
    int observed = na
    int born = na
    float atr = na
    int tests = 0
    bool touching = false
    bool departed = false
    bool used = false
    string status = "Unknown"

type lp_Plan
    string id = ""
    string zoneId = ""
    string family = ""
    int side = 0
    float lo = na
    float hi = na
    float entry = na
    float stop = na
    float target = na
    float netR = na
    float buffer = na
    int origin = na
    int created = na
    int born = na
    int changed = na
    string status = "Waiting"
    string reason = "No eligible zone"

type lp_Pack
    int stamp = na
    int firstTime = na
    int clockBar = na
    float atr = na
    lp_Plan buy = na
    lp_Plan sell = na
    lp_Plan oldBuy = na
    lp_Plan oldSell = na
    lp_Zone support = na
    lp_Zone resistance = na
    int activeCount = 0
    int archivedCount = 0

type lp_Wire
    int stamp
    int firstTime
    int clockBar
    float atr
    string buy_id
    string buy_zoneId
    string buy_family
    int buy_side
    float buy_lo
    float buy_hi
    float buy_entry
    float buy_stop
    float buy_target
    float buy_netR
    float buy_buffer
    int buy_origin
    int buy_created
    int buy_born
    int buy_changed
    string buy_status
    string buy_reason
    string sell_id
    string sell_zoneId
    string sell_family
    int sell_side
    float sell_lo
    float sell_hi
    float sell_entry
    float sell_stop
    float sell_target
    float sell_netR
    float sell_buffer
    int sell_origin
    int sell_created
    int sell_born
    int sell_changed
    string sell_status
    string sell_reason
    string oldBuy_id
    string oldBuy_zoneId
    string oldBuy_family
    int oldBuy_side
    float oldBuy_lo
    float oldBuy_hi
    float oldBuy_entry
    float oldBuy_stop
    float oldBuy_target
    float oldBuy_netR
    float oldBuy_buffer
    int oldBuy_origin
    int oldBuy_created
    int oldBuy_born
    int oldBuy_changed
    string oldBuy_status
    string oldBuy_reason
    string oldSell_id
    string oldSell_zoneId
    string oldSell_family
    int oldSell_side
    float oldSell_lo
    float oldSell_hi
    float oldSell_entry
    float oldSell_stop
    float oldSell_target
    float oldSell_netR
    float oldSell_buffer
    int oldSell_origin
    int oldSell_created
    int oldSell_born
    int oldSell_changed
    string oldSell_status
    string oldSell_reason
    string support_id
    string support_family
    int support_side
    float support_lo
    float support_hi
    int support_origin
    int support_known
    int support_observed
    int support_born
    float support_atr
    int support_tests
    bool support_touching
    bool support_departed
    bool support_used
    string support_status
    string resistance_id
    string resistance_family
    int resistance_side
    float resistance_lo
    float resistance_hi
    int resistance_origin
    int resistance_known
    int resistance_observed
    int resistance_born
    float resistance_atr
    int resistance_tests
    bool resistance_touching
    bool resistance_departed
    bool resistance_used
    string resistance_status
    int activeCount
    int archivedCount

f_lp_wire(lp_Pack p) =>
    lp_Wire.new(p.stamp, p.firstTime, p.clockBar, p.atr, p.buy.id, p.buy.zoneId, p.buy.family, p.buy.side, p.buy.lo, p.buy.hi, p.buy.entry, p.buy.stop, p.buy.target, p.buy.netR, p.buy.buffer, p.buy.origin, p.buy.created, p.buy.born, p.buy.changed, p.buy.status, p.buy.reason, p.sell.id, p.sell.zoneId, p.sell.family, p.sell.side, p.sell.lo, p.sell.hi, p.sell.entry, p.sell.stop, p.sell.target, p.sell.netR, p.sell.buffer, p.sell.origin, p.sell.created, p.sell.born, p.sell.changed, p.sell.status, p.sell.reason, p.oldBuy.id, p.oldBuy.zoneId, p.oldBuy.family, p.oldBuy.side, p.oldBuy.lo, p.oldBuy.hi, p.oldBuy.entry, p.oldBuy.stop, p.oldBuy.target, p.oldBuy.netR, p.oldBuy.buffer, p.oldBuy.origin, p.oldBuy.created, p.oldBuy.born, p.oldBuy.changed, p.oldBuy.status, p.oldBuy.reason, p.oldSell.id, p.oldSell.zoneId, p.oldSell.family, p.oldSell.side, p.oldSell.lo, p.oldSell.hi, p.oldSell.entry, p.oldSell.stop, p.oldSell.target, p.oldSell.netR, p.oldSell.buffer, p.oldSell.origin, p.oldSell.created, p.oldSell.born, p.oldSell.changed, p.oldSell.status, p.oldSell.reason, p.support.id, p.support.family, p.support.side, p.support.lo, p.support.hi, p.support.origin, p.support.known, p.support.observed, p.support.born, p.support.atr, p.support.tests, p.support.touching, p.support.departed, p.support.used, p.support.status, p.resistance.id, p.resistance.family, p.resistance.side, p.resistance.lo, p.resistance.hi, p.resistance.origin, p.resistance.known, p.resistance.observed, p.resistance.born, p.resistance.atr, p.resistance.tests, p.resistance.touching, p.resistance.departed, p.resistance.used, p.resistance.status, p.activeCount, p.archivedCount)

f_lp_unwire(lp_Wire w) =>
    lp_Pack.new(w.stamp, w.firstTime, w.clockBar, w.atr, lp_Plan.new(w.buy_id, w.buy_zoneId, w.buy_family, w.buy_side, w.buy_lo, w.buy_hi, w.buy_entry, w.buy_stop, w.buy_target, w.buy_netR, w.buy_buffer, w.buy_origin, w.buy_created, w.buy_born, w.buy_changed, w.buy_status, w.buy_reason), lp_Plan.new(w.sell_id, w.sell_zoneId, w.sell_family, w.sell_side, w.sell_lo, w.sell_hi, w.sell_entry, w.sell_stop, w.sell_target, w.sell_netR, w.sell_buffer, w.sell_origin, w.sell_created, w.sell_born, w.sell_changed, w.sell_status, w.sell_reason), lp_Plan.new(w.oldBuy_id, w.oldBuy_zoneId, w.oldBuy_family, w.oldBuy_side, w.oldBuy_lo, w.oldBuy_hi, w.oldBuy_entry, w.oldBuy_stop, w.oldBuy_target, w.oldBuy_netR, w.oldBuy_buffer, w.oldBuy_origin, w.oldBuy_created, w.oldBuy_born, w.oldBuy_changed, w.oldBuy_status, w.oldBuy_reason), lp_Plan.new(w.oldSell_id, w.oldSell_zoneId, w.oldSell_family, w.oldSell_side, w.oldSell_lo, w.oldSell_hi, w.oldSell_entry, w.oldSell_stop, w.oldSell_target, w.oldSell_netR, w.oldSell_buffer, w.oldSell_origin, w.oldSell_created, w.oldSell_born, w.oldSell_changed, w.oldSell_status, w.oldSell_reason), lp_Zone.new(w.support_id, w.support_family, w.support_side, w.support_lo, w.support_hi, w.support_origin, w.support_known, w.support_observed, w.support_born, w.support_atr, w.support_tests, w.support_touching, w.support_departed, w.support_used, w.support_status), lp_Zone.new(w.resistance_id, w.resistance_family, w.resistance_side, w.resistance_lo, w.resistance_hi, w.resistance_origin, w.resistance_known, w.resistance_observed, w.resistance_born, w.resistance_atr, w.resistance_tests, w.resistance_touching, w.resistance_departed, w.resistance_used, w.resistance_status), w.activeCount, w.archivedCount)

f_lp_price(float p, bool upward) =>
    (upward ? math.ceil(p / syminfo.mintick) : math.floor(p / syminfo.mintick)) * syminfo.mintick

f_lp_entry(float lo, float hi, int side, float depth) =>
    side == 1 ? hi - depth * (hi - lo) : lo + depth * (hi - lo)

f_lp_ruleKey() =>
    string mode = lp_entryMode == "Adaptive S&D" ? "A" : lp_entryMode == "Near edge" ? "N" : lp_entryMode == "Midpoint" ? "M" : "C" + str.tostring(lp_depth, "#.##")
    string stopMode = lp_stopMode == "Structural" ? "S" : lp_stopMode == "Zone edge" ? "Z" : "A"
    "V99" + mode + stopMode + (lp_sd ? "d1" : "d0") + (lp_swings ? "w1" : "w0") + (lp_ob ? "o1" : "o0") + (lp_flip ? "f1" : "f0") + "r" + str.tostring(lp_retests) + "z" + str.tostring(lp_zoneAge) + "p" + str.tostring(lp_planAge) + "b" + str.tostring(lp_buffer, "#.##") + "s" + str.tostring(lp_swingStopMax, "#.##") + "a" + str.tostring(lp_atrStop, "#.##") + "m" + str.tostring(lp_maxRisk, "#.##") + "q" + str.tostring(lp_minR, "#.##") + "c" + str.tostring(lp_costTicks, "#.##") + (lp_trend ? "t1" : "t0") + (lp_cancelTarget ? "x1" : "x0")

f_lp_add(array<lp_Zone> zones, string family, int side, float lo, float hi, int originOffset, float atrValue) =>
    // Retrospective scan uses ONLY candles already available at confirmation.
    // Origin is excluded. First departure candle is not a retest.
    if not na(atrValue) and atrValue > 0 and not na(time[originOffset]) and hi > lo
        string id = syminfo.tickerid + ":" + timeframe.period + ":" + family + ":" + str.tostring(side) + ":" + str.tostring(time[originOffset])
        bool departed = originOffset == 0 and (side == 1 ? close > hi : close < lo)
        bool touching = false
        bool broken = false
        int tests = 0
        if originOffset > 0
            for offset = originOffset - 1 to 0
                broken := broken or (side == 1 ? low[offset] < lo - atrValue * lp_buffer : high[offset] > hi + atrValue * lp_buffer)
                if not departed
                    departed := side == 1 ? close[offset] > hi : close[offset] < lo
                else
                    bool hit = low[offset] <= hi and high[offset] >= lo
                    if hit and not touching
                        tests += 1
                    touching := hit
        if not broken
            string state = not departed ? "Unknown" : tests == 0 ? "Fresh" : "Retested"
            array.push(zones, lp_Zone.new(id, family, side, lo, hi, time[originOffset], time_close, time_close, bar_index, atrValue, tests, touching, departed, false, state))
    0

f_lp_updatePlan(lp_Plan plan, array<lp_Zone> zones, bool trendOK) =>
    // Restart-safe source-TF lifecycle. Prices are immutable after creation.
    if plan.id != "" and bar_index > plan.born
        bool waiting = plan.status == "Watching"
        bool active = plan.status == "Active"
        bool entryHit = low <= plan.entry and high >= plan.entry
        bool gappedPast = plan.side == 1 ? high < plan.entry : low > plan.entry
        bool stopHit = plan.side == 1 ? low <= plan.stop : high >= plan.stop
        bool targetHit = plan.side == 1 ? high >= plan.target : low <= plan.target
        float path = math.max(math.abs(plan.target - plan.entry), syminfo.mintick)
        float progress = ((plan.side == 1 ? high : low) - plan.entry) * plan.side / path
        bool invalidZone = true
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                lp_Zone z = array.get(zones, i)
                if z.id == plan.zoneId
                    invalidZone := z.status == "Broken" or z.status == "Expired"
                    break
        if waiting
            if gappedPast
                plan.status := "Gap / unverified"
                plan.reason := "Entire source range crossed beyond Entry between bars"
            else if entryHit
                plan.status := stopHit or targetHit ? "Ambiguous touch" : "Active"
                plan.reason := stopHit or targetHit ? "Entry and SL/TP touched in one source bar; sequence unknown" : "ENTRY REACHED · Entry / SL / TP locked"
            else if targetHit or (lp_cancelTarget and progress >= v10_cancelProgress)
                plan.status := "Invalidated"
                plan.reason := "Stale before Entry · price already travelled toward TP"
            else if bar_index - plan.born >= lp_planAge
                plan.status := "Expired"
                plan.reason := "Pending source-bar lifetime ended"
            else if invalidZone or not trendOK
                plan.status := "Invalidated"
                plan.reason := invalidZone ? "Source zone broken / expired before Entry" : "Source trend filter changed before Entry"
        else if active
            if stopHit and targetHit
                plan.status := "Closed · Ambiguous"
                plan.reason := "TP and SL touched in the same source bar; sequence unknown"
            else if stopHit
                plan.status := "Closed · SL"
                plan.reason := "SL touched after Entry"
            else if targetHit
                plan.status := "Closed · TP"
                plan.reason := "TP touched after Entry"
        if (waiting and plan.status != "Watching") or (active and plan.status != "Active")
            plan.changed := time_close
    0
f_lp_make(array<lp_Zone> zones, int side, float atrValue, bool trendOK) =>
    lp_Plan result = lp_Plan.new()
    float bestRank = -1e20
    float rejectionGap = 1e20
    string rejection = "No confirmed defend zone on this side"
    if not trendOK
        rejection := "Source trend filter"
    else if array.size(zones) > 0 and not na(atrValue)
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.side == side and not z.used and z.status != "Broken" and z.status != "Expired"
                bool prelimSide = side == 1 ? close > z.hi + lp_costTicks * syminfo.mintick : close < z.lo - lp_costTicks * syminfo.mintick
                string prelimReason = z.family == "Swing" ? "Swing is liquidity, not entry POI" : z.status == "Unknown" ? "Unknown departure history" : z.tests > lp_retests ? "Retest limit" : not prelimSide ? "Already reached / inside zone" : ""
                if prelimReason != ""
                    float prelimGap = math.abs(close - math.avg(z.lo, z.hi))
                    if prelimGap < rejectionGap
                        rejectionGap := prelimGap
                        rejection := z.family + " · " + prelimReason
                    continue
                // A plain swing is liquidity / structure. It may protect the stop or act as a target,
                // V10.4.4 keeps this rule: a plain swing is liquidity/structure, never an entry POI by itself.
                bool entryFamily = z.family != "Swing"
                float adaptiveDepth = z.family == "Demand" or z.family == "Supply" ? 0.15 : z.family == "Volume OB" ? 0.40 : z.family == "Flip" ? 0.35 : 0.20
                float depth = lp_entryMode == "Adaptive S&D" ? adaptiveDepth : lp_entryMode == "Near edge" ? 0.0 : lp_entryMode == "Midpoint" ? 0.5 : lp_depth
                float minEntry = f_lp_price(z.lo, true)
                float maxEntry = f_lp_price(z.hi, false)
                float e = math.max(minEntry, math.min(maxEntry, math.round_to_mintick(f_lp_entry(z.lo, z.hi, side, depth))))
                float cost = lp_costTicks * syminfo.mintick
                float safety = math.max(atrValue * lp_buffer, cost)

                // Structural stop logic: distal edge first, then extend beyond the nearest
                // same-side swing/liquidity anchor if it sits just behind the POI.
                float anchor = side == 1 ? z.lo : z.hi
                float anchorGap = -1.0
                if lp_stopMode == "Structural" and lp_swings and array.size(zones) > 0
                    for j = 0 to array.size(zones) - 1
                        lp_Zone structural = array.get(zones, j)
                        if structural.family == "Swing" and structural.side == side and structural.status != "Broken" and structural.status != "Expired"
                            float swingLevel = side == 1 ? structural.lo : structural.hi
                            float extension = side == 1 ? z.lo - swingLevel : swingLevel - z.hi
                            // Sweep-aware: protect beyond the deepest valid swing inside the allowed window.
                            // lp_maxRisk still rejects a stop that becomes structurally too wide.
                            if extension >= 0 and extension <= atrValue * lp_swingStopMax and extension > anchorGap
                                anchor := swingLevel
                                anchorGap := extension

                float rawStop = lp_stopMode == "ATR only" ? e - side * atrValue * lp_atrStop : side == 1 ? anchor - safety : anchor + safety
                float stop = f_lp_price(rawStop, side == -1)
                float risk = math.abs(e - stop)

                // First structural target: nearest active opposite-side level. Opposing swings are
                // allowed as targets because they represent liquidity; they are not entry zones.
                float target = na
                bool conflict = false
                for j = 0 to array.size(zones) - 1
                    lp_Zone other = array.get(zones, j)
                    if other.side == -side and other.status != "Broken" and other.status != "Expired"
                        conflict := conflict or (other.lo <= z.hi and other.hi >= z.lo)
                        float candidate = side == 1 ? other.lo : other.hi
                        if side == 1 ? candidate > e : candidate < e
                            if na(target) or math.abs(candidate - e) < math.abs(target - e)
                                target := candidate

                float netR = na(target) ? na : (math.abs(target - e) - cost) / math.max(risk + cost, syminfo.mintick)
                bool waitingSide = side == 1 ? close > z.hi + cost and close > e + cost : close < z.lo - cost and close < e - cost
                string reason = not entryFamily ? "Swing is liquidity, not entry POI" : z.status == "Unknown" ? "Unknown departure history" : z.tests > lp_retests ? "Retest limit" : not waitingSide ? "Already reached / inside zone" : conflict ? "Opposing zones overlap" : minEntry > maxEntry ? "Zone narrower than a tradable tick" : (side == 1 ? stop >= z.lo : stop <= z.hi) ? "Stop must clear distal zone edge" : risk < syminfo.mintick or risk > atrValue * lp_maxRisk ? "Structural stop-distance limit" : na(target) ? "No structural target" : netR < lp_minR ? "Insufficient net R" : "Eligible"

                float gap = math.abs(close - e)
                float familyPriority = z.family == "Demand" or z.family == "Supply" ? 30.0 : z.family == "Volume OB" ? 25.0 : z.family == "Flip" ? 22.0 : 0.0
                float freshBonus = z.tests == 0 ? 12.0 : z.tests == 1 ? 4.0 : -10.0
                float rank = familyPriority + freshBonus - gap / math.max(atrValue, syminfo.mintick) * 3.0
                if reason == "Eligible" and rank > bestRank
                    bestRank := rank
                    result := lp_Plan.new(z.id + ":" + f_lp_ruleKey(), z.id, z.family, side, z.lo, z.hi, e, stop, target, netR, safety, z.origin, time_close, bar_index, time_close, "Watching", "Eligible · Adaptive POI / structural invalidation · " + z.status + " · " + str.tostring(z.tests) + " retests")
                else if reason != "Eligible" and gap < rejectionGap
                    rejectionGap := gap
                    rejection := z.family + " · " + reason
    if result.id == ""
        result.reason := rejection
    else
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.id == result.zoneId
                z.used := true
    result

f_lp_engine() =>
    // This entire state machine executes in the requested source TF context.
    var array<lp_Zone> zones = array.new<lp_Zone>()
    var int archivedCount = 0
    var lp_Plan buy = lp_Plan.new()
    var lp_Plan sell = lp_Plan.new()
    var lp_Plan oldBuy = lp_Plan.new()
    var lp_Plan oldSell = lp_Plan.new()
    var int firstTime = time
    float a = ta.atr(14)
    float fast = ta.sma(close, 50)
    float slow = ta.sma(close, 200)
    bool trendBuy = not lp_trend or (close > slow and fast > slow)
    bool trendSell = not lp_trend or (close < slow and fast < slow)
    float ph = ta.pivothigh(high, 3, 3)
    float pl = ta.pivotlow(low, 3, 3)
    float vp = ta.pivothigh(volume, 10, 10)
    var float pendingHigh = na
    var float pendingLow = na
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.status != "Broken" and z.status != "Expired" and bar_index > z.born
                bool broken = z.side == 1 ? low < z.lo - z.atr * lp_buffer : high > z.hi + z.atr * lp_buffer
                if broken
                    z.status := "Broken"
                else if bar_index - z.born >= lp_zoneAge
                    z.status := "Expired"
                else
                    if not z.departed
                        z.departed := z.side == 1 ? close > z.hi : close < z.lo
                        if z.departed
                            // Unknown historical departure never silently becomes Fresh.
                            z.status := "Unknown"
                    else
                        bool hit = low <= z.hi and high >= z.lo
                        if hit and not z.touching
                            z.tests += 1
                        z.touching := hit
                        if z.status != "Unknown"
                            z.status := z.tests == 0 ? "Fresh" : "Retested"
    f_lp_updatePlan(buy, zones, trendBuy)
    f_lp_updatePlan(sell, zones, trendSell)
    // Archive only terminal plans. Active plans keep the original frozen levels.
    if buy.id != "" and buy.status != "Watching" and buy.status != "Active"
        oldBuy := buy.copy()
        if timeframe.in_seconds() == timeframe.in_seconds(lp_tf1)
            archivedCount := math.min(40, archivedCount + 1)
        buy := lp_Plan.new()
    if sell.id != "" and sell.status != "Watching" and sell.status != "Active"
        oldSell := sell.copy()
        if timeframe.in_seconds() == timeframe.in_seconds(lp_tf1)
            archivedCount := math.min(40, archivedCount + 1)
        sell := lp_Plan.new()
    if lp_flip and not na(a)
        if not na(pendingHigh) and close > pendingHigh + a * 0.1
            f_lp_add(zones, "Flip", 1, pendingHigh - a * 0.1, pendingHigh + a * 0.1, 0, a)
            pendingHigh := na
        if not na(pendingLow) and close < pendingLow - a * 0.1
            f_lp_add(zones, "Flip", -1, pendingLow - a * 0.1, pendingLow + a * 0.1, 0, a)
            pendingLow := na
    if not na(ph)
        pendingHigh := ph
        if lp_swings
            f_lp_add(zones, "Swing", -1, ph - a[3] * 0.15, ph, 3, a[3])
    if not na(pl)
        pendingLow := pl
        if lp_swings
            f_lp_add(zones, "Swing", 1, pl, pl + a[3] * 0.15, 3, a[3])
    bool base = math.abs(close[1] - open[1]) <= (high[1] - low[1]) * 0.4
    if lp_sd and base and not na(a)
        if close > high[1] and close - open >= a * 0.6
            f_lp_add(zones, "Demand", 1, low[1], math.max(open[1], close[1]), 1, a[1])
        if close < low[1] and open - close >= a * 0.6
            f_lp_add(zones, "Supply", -1, math.min(open[1], close[1]), high[1], 1, a[1])
    if lp_ob and not na(vp)
        if close > high[10]
            f_lp_add(zones, "Volume OB", 1, low[10], hl2[10], 10, a[10])
        if close < low[10]
            f_lp_add(zones, "Volume OB", -1, hl2[10], high[10], 10, a[10])
    if buy.id == ""
        buy := f_lp_make(zones, 1, a, trendBuy)
    if sell.id == ""
        sell := f_lp_make(zones, -1, a, trendSell)
    // Deterministic bounded history. Never drop a zone referenced by a pending/active plan.
    while array.size(zones) > 100
        int removeIndex = -1
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            bool protected = ((buy.status == "Watching" or buy.status == "Active") and z.id == buy.zoneId) or ((sell.status == "Watching" or sell.status == "Active") and z.id == sell.zoneId)
            if not protected and removeIndex == -1
                removeIndex := i
        if removeIndex >= 0
            array.remove(zones, removeIndex)
        else
            break
    lp_Zone support = lp_Zone.new()
    lp_Zone resistance = lp_Zone.new()
    int activeCount = 0
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            lp_Zone z = array.get(zones, i)
            if z.status != "Broken" and z.status != "Expired"
                activeCount += 1
                if z.side == 1 and z.lo < close and (na(support.hi) or math.abs(close - z.hi) < math.abs(close - support.hi))
                    support := z.copy()
                if z.side == -1 and z.hi > close and (na(resistance.lo) or math.abs(close - z.lo) < math.abs(close - resistance.lo))
                    resistance := z.copy()
    // Primitive value snapshots: historical packets cannot mutate with future plans/zones.
    lp_Pack result = lp_Pack.new(time_close, firstTime, bar_index, a, buy, sell, oldBuy, oldSell, support, resistance, activeCount, archivedCount)
    lp_Wire wire = f_lp_wire(result)
    wire[1]

bool lp_aligned = timeframe.in_seconds(lp_tf1) % chartSec == 0 and timeframe.in_seconds(lp_tf2) % chartSec == 0 and timeframe.in_seconds(lp_tf3) % chartSec == 0
bool lp_supported = chart.is_standard and not timeframe.isticks and lp_aligned and chartSec <= timeframe.in_seconds(lp_tf1) and chartSec <= timeframe.in_seconds(lp_tf2) and chartSec <= timeframe.in_seconds(lp_tf3)
// A single dynamic request scope serves the three independent source contexts.
// This avoids compiling the full planner and wire conversion three times.
var array<string> lp_sourceTFs = array.from(lp_tf1, lp_tf2, lp_tf3)
var array<lp_Pack> lp_packets = array.new<lp_Pack>(3, na)
if lp_visible and lp_supported
    for sourceIndex = 0 to 2
        string sourceTf = array.get(lp_sourceTFs, sourceIndex)
        lp_Wire wire = request.security(syminfo.tickerid, sourceTf, f_lp_engine(), lookahead=barmerge.lookahead_on, calc_bars_count=1200)
        lp_Pack previous = array.get(lp_packets, sourceIndex)
        if not na(wire) and (na(previous) or wire.stamp != previous.stamp)
            array.set(lp_packets, sourceIndex, f_lp_unwire(wire))
lp_Pack lp_a = array.get(lp_packets, 0)
lp_Pack lp_b = array.get(lp_packets, 1)
lp_Pack lp_c = array.get(lp_packets, 2)

f_lp_planText(lp_Plan p) =>
    p.id == "" ? p.reason : p.status + " · " + p.family + "\nE " + f_price(p.entry) + " | SL " + f_price(p.stop) + "\nTarget " + f_price(p.target) + " | net " + str.tostring(p.netR, "#.##") + "R\n" + p.reason

f_lp_event(lp_Plan p, string previous, string tf, string eventType) =>
    string key = p.id + ":" + p.status
    string message = key != previous and p.id != "" ? eventType + " | " + tf + " | " + p.id + " | " + p.status + "\n" + p.reason + "\nE " + f_price(p.entry) + " | SL " + f_price(p.stop) + " | Target " + f_price(p.target) + "\nSource close " + str.format_time(p.changed, "yyyy-MM-dd HH:mm", syminfo.timezone) + " " + syminfo.timezone + "\nNot a broker order or fill.\n" : ""
    [key, message]

var string lp_prevBuy = ""
var string lp_prevSell = ""
var string lp_prevBuyB = ""
var string lp_prevSellB = ""
var string lp_prevBuyC = ""
var string lp_prevSellC = ""
var string lp_prevClosedBuy = ""
var string lp_prevClosedSell = ""
var string lp_prevClosedBuyB = ""
var string lp_prevClosedSellB = ""
var string lp_prevClosedBuyC = ""
var string lp_prevClosedSellC = ""
string lp_events = ""
if lp_supported and not na(lp_a) and barstate.isconfirmed
    [closedBuyKey, closedBuyEvent] = f_lp_event(lp_a.oldBuy, lp_prevClosedBuy, lp_tf1, "PLAN CLOSED")
    [closedSellKey, closedSellEvent] = f_lp_event(lp_a.oldSell, lp_prevClosedSell, lp_tf1, "PLAN CLOSED")
    [buyKey, buyEvent] = f_lp_event(lp_a.buy, lp_prevBuy, lp_tf1, "NEW PLAN")
    [sellKey, sellEvent] = f_lp_event(lp_a.sell, lp_prevSell, lp_tf1, "NEW PLAN")
    lp_events := lp_alerts ? closedBuyEvent + closedSellEvent + buyEvent + sellEvent : ""
    lp_prevClosedBuy := closedBuyKey
    lp_prevClosedSell := closedSellKey
    lp_prevBuy := buyKey
    lp_prevSell := sellKey
    if lp_alerts and lp_alertScope == "All planning TFs" and not na(lp_b) and not na(lp_c)
        [closedBuyKeyB, closedBuyEventB] = f_lp_event(lp_b.oldBuy, lp_prevClosedBuyB, lp_tf2, "PLAN CLOSED")
        [closedSellKeyB, closedSellEventB] = f_lp_event(lp_b.oldSell, lp_prevClosedSellB, lp_tf2, "PLAN CLOSED")
        [closedBuyKeyC, closedBuyEventC] = f_lp_event(lp_c.oldBuy, lp_prevClosedBuyC, lp_tf3, "PLAN CLOSED")
        [closedSellKeyC, closedSellEventC] = f_lp_event(lp_c.oldSell, lp_prevClosedSellC, lp_tf3, "PLAN CLOSED")
        [buyKeyB, buyEventB] = f_lp_event(lp_b.buy, lp_prevBuyB, lp_tf2, "NEW PLAN")
        [sellKeyB, sellEventB] = f_lp_event(lp_b.sell, lp_prevSellB, lp_tf2, "NEW PLAN")
        [buyKeyC, buyEventC] = f_lp_event(lp_c.buy, lp_prevBuyC, lp_tf3, "NEW PLAN")
        [sellKeyC, sellEventC] = f_lp_event(lp_c.sell, lp_prevSellC, lp_tf3, "NEW PLAN")
        lp_events += closedBuyEventB + closedSellEventB + closedBuyEventC + closedSellEventC + buyEventB + sellEventB + buyEventC + sellEventC
        lp_prevClosedBuyB := closedBuyKeyB
        lp_prevClosedSellB := closedSellKeyB
        lp_prevClosedBuyC := closedBuyKeyC
        lp_prevClosedSellC := closedSellKeyC
        lp_prevBuyB := buyKeyB
        lp_prevSellB := sellKeyB
        lp_prevBuyC := buyKeyC
        lp_prevSellC := sellKeyC

// Fixed drawing pools: six map bands and two primary plans (three levels each).
var array<box> lp_boxes = array.new<box>()
var array<label> lp_badges = array.new<label>()
var array<line> lp_rays = array.new<line>()
var array<label> lp_prices = array.new<label>()
if barstate.isfirst
    for i = 0 to 5
        array.push(lp_boxes, box.new(na, na, na, na, force_overlay=true))
        array.push(lp_badges, label.new(na, na, "", style=label.style_label_right, force_overlay=true))
        array.push(lp_rays, line.new(na, na, na, na, force_overlay=true))
        array.push(lp_prices, label.new(na, na, "", style=label.style_label_left, force_overlay=true))
string lp_panelPositionValue = lp_panelPosition == "Top Left" ? position.top_left : lp_panelPosition == "Bottom Right" ? position.bottom_right : lp_panelPosition == "Bottom Left" ? position.bottom_left : position.top_right
string lp_panelSize = lp_panelSizeInput == "Small" ? size.small : size.tiny
var table lp_board = table.new(lp_panelPositionValue, 2, 13, bgcolor=color.new(uiPanel, 3), frame_color=uiBorder, frame_width=1, force_overlay=true)
f_lp_row(int row, string title, string value, color tint) =>
    table.cell(lp_board, 0, row, title, text_color=uiMuted, text_size=lp_panelSize, text_halign=text.align_left, bgcolor=uiPanel)
    table.cell(lp_board, 1, row, value, text_color=tint, text_size=lp_panelSize, text_halign=text.align_right, bgcolor=uiPanel)

f_lp_statusCode(lp_Plan p) =>
    p.id == "" ? "—" : p.status == "Watching" ? "WAIT" : p.status == "Active" ? "ACTIVE" : p.status == "Ambiguous touch" ? "CHECK" : p.status == "Expired" ? "EXPIRED" : p.status == "Invalidated" ? "VOID" : str.upper(p.status)

f_lp_compactPlan(lp_Plan p) =>
    p.id == "" ? "—" : f_lp_statusCode(p) + ((p.status == "Watching" or p.status == "Active") ? " · " + f_price(p.entry) : "")

f_lp_pair(lp_Pack packet) =>
    na(packet) ? "—" : "B " + f_lp_compactPlan(packet.buy) + " / S " + f_lp_compactPlan(packet.sell)

f_lp_left(lp_Pack packet, lp_Plan p) =>
    p.id == "" or na(packet) ? "—" : str.tostring(math.max(0, lp_planAge - (packet.clockBar - p.born)))

f_lp_familyCode(string family) =>
    family == "Demand" ? "D" : family == "Supply" ? "S" : family == "Swing" ? "SW" : family == "Flip" ? "FL" : family == "Volume OB" ? "OB" : family

if barstate.islast
    table.set_position(lp_board, lp_panelPositionValue)
    table.clear(lp_board, 0, 0, 1, 12)
    bool lp_showPanel = v10_displayMaster and uiDashboard and lp_visible and lp_panelMode != "Hidden"
    if lp_showPanel and lp_panelMode == "Compact"
        f_lp_row(0, "EBW PLAN", f_tfName(lp_tf1) + " / " + f_tfName(lp_tf2) + " / " + f_tfName(lp_tf3), uiAccent)
        if lp_supported and not na(lp_a)
            f_lp_row(1, "BUY " + f_tfName(lp_tf1), f_lp_compactPlan(lp_a.buy), uiBull)
            f_lp_row(2, "SELL " + f_tfName(lp_tf1), f_lp_compactPlan(lp_a.sell), uiBear)
            f_lp_row(3, f_tfName(lp_tf2), f_lp_pair(lp_b), uiText)
            f_lp_row(4, f_tfName(lp_tf3), f_lp_pair(lp_c), uiText)
            f_lp_row(5, "AS OF · LEFT", str.format_time(lp_a.stamp, "MM-dd HH:mm", syminfo.timezone) + " · B" + f_lp_left(lp_a, lp_a.buy) + "/S" + f_lp_left(lp_a, lp_a.sell), uiMuted)
        else if lp_supported
            f_lp_row(1, "STATUS", "LOADING SOURCE DATA", uiAccent)
            f_lp_row(2, "SOURCE", f_tfName(lp_tf1) + " / " + f_tfName(lp_tf2) + " / " + f_tfName(lp_tf3), uiMuted)
        else
            f_lp_row(1, "STATUS", "ADJUST CHART / TF", uiBear)
            f_lp_row(2, "RULE", "Chart <= planning TFs", uiMuted)
            f_lp_row(3, "ALIGN", "Use divisible intervals", uiMuted)
    if lp_showPanel and lp_panelMode == "Detailed"
        f_lp_row(0, "EBW LIMIT PLANNER", "SOURCE CLOCK · " + f_tfName(lp_tf1), uiAccent)
        f_lp_row(1, "STATUS", not lp_supported ? "Use standard chart <= TFs with divisible intervals" : "Source-close checks · broker orders unknown", lp_supported ? uiMuted : uiBear)
        f_lp_row(2, "ENTRY / LIFETIME", lp_entryMode + " / " + str.tostring(lp_planAge) + " source bars", uiText)
    for i = 0 to 5
        lp_Pack packet = i < 2 ? lp_a : i < 4 ? lp_b : lp_c
        string sourceTf = i < 2 ? lp_tf1 : i < 4 ? lp_tf2 : lp_tf3
        lp_Zone z = na(packet) ? lp_Zone.new() : i % 2 == 0 ? packet.support : packet.resistance
        box band = array.get(lp_boxes, i)
        label badge = array.get(lp_badges, i)
        color tint = i % 2 == 0 ? uiBull : uiBear
        bool draw = v10_displayMaster and lp_visible and lp_supported and z.id != "" and not na(lp_a) and math.abs(close - math.avg(z.lo, z.hi)) <= lp_a.atr * lp_drawDistance
        if draw
            box.set_lefttop(band, bar_index - 80, z.hi)
            box.set_rightbottom(band, bar_index + 10 + i * 3, z.lo)
            box.set_bgcolor(band, color.new(tint, 94))
            box.set_border_color(band, color.new(tint, 55))
            label.set_xy(badge, lp_chartDetail == "Hidden" ? na : bar_index + 10 + i * 3, i % 2 == 0 ? z.hi : z.lo)
            string zoneText = lp_chartDetail == "Hidden" ? "" : lp_chartDetail == "Compact" ? f_tfName(sourceTf) + " " + f_lp_familyCode(z.family) + " · " + z.status : f_tfName(sourceTf) + " " + z.family + " · " + z.status
            label.set_text(badge, zoneText)
            label.set_color(badge, color.new(uiPanel, 10))
            label.set_textcolor(badge, tint)
            label.set_size(badge, lp_panelSize)
            label.set_tooltip(badge, z.id + "\nBounds " + f_price(z.lo) + "–" + f_price(z.hi) + "\nOrigin " + str.format_time(z.origin, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nKnown " + str.format_time(z.known, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nFirst observed in replay " + str.format_time(z.observed, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nRetests " + str.tostring(z.tests) + "; not a probability. Band extension is a current map, not historical availability.")
        else
            box.set_lefttop(band, na, na)
            box.set_rightbottom(band, na, na)
            label.set_xy(badge, na, na)
        if lp_showPanel and lp_panelMode == "Detailed"
            lp_Plan p = na(packet) ? lp_Plan.new() : i % 2 == 0 ? packet.buy : packet.sell
            string prefix = i < 2 ? "PRIMARY " : i < 4 ? "CONTEXT " : "MACRO "
            f_lp_row(i + 3, prefix + f_tfName(sourceTf) + (i % 2 == 0 ? " BUY" : " SELL"), not lp_supported ? "Overview only / planning unsupported" : f_lp_planText(p), tint)
    for i = 0 to 5
        lp_Plan p = na(lp_a) ? lp_Plan.new() : i < 3 ? lp_a.buy : lp_a.sell
        int levelIndex = i % 3
        float level = levelIndex == 0 ? p.entry : levelIndex == 1 ? p.stop : p.target
        line ray = array.get(lp_rays, i)
        label badge = array.get(lp_prices, i)
        bool draw = v10_displayMaster and lp_visible and lp_supported and p.id != "" and not na(lp_a) and math.abs(close - level) <= lp_a.atr * lp_drawDistance
        if draw
            color tint = levelIndex == 1 ? uiBear : levelIndex == 0 ? uiAccent : uiBull
            line.set_xy1(ray, bar_index - 30, level)
            line.set_xy2(ray, bar_index + 35, level)
            line.set_color(ray, color.new(tint, (p.status == "Watching" or p.status == "Active") ? 0 : 65))
            line.set_style(ray, line.style_dashed)
            label.set_xy(badge, lp_chartDetail == "Hidden" ? na : bar_index + 35, level)
            string levelName = levelIndex == 0 ? "E" : levelIndex == 1 ? "SL" : "TP"
            string levelText = lp_chartDetail == "Hidden" ? "" : lp_chartDetail == "Compact" ? (p.side == 1 ? "B " : "S ") + levelName + " " + f_price(level) : (p.side == 1 ? "BUY LIMIT " : "SELL LIMIT ") + (levelIndex == 0 ? "ENTRY " : levelIndex == 1 ? "STOP " : "TARGET ") + f_price(level)
            label.set_text(badge, levelText)
            label.set_textcolor(badge, tint)
            label.set_color(badge, color.new(uiPanel, 8))
            label.set_size(badge, lp_panelSize)
            label.set_tooltip(badge, p.id + "\n" + p.status + "\n" + p.reason + "\nCreated " + str.format_time(p.created, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nFrozen prices; source-bar checks; not an order or fill.")
        else
            line.set_xy1(ray, na, na)
            line.set_xy2(ray, na, na)
            label.set_xy(badge, na, na)
    if lp_showPanel and lp_panelMode == "Detailed" and not na(lp_a)
        f_lp_row(9, "PRIMARY MAP", "S " + f_price(lp_a.support.lo) + "–" + f_price(lp_a.support.hi) + "\nR " + f_price(lp_a.resistance.lo) + "–" + f_price(lp_a.resistance.hi), uiText)
        f_lp_row(10, "DATA START", str.format_time(lp_a.firstTime, "yyyy-MM-dd", syminfo.timezone) + " · max 2000 source bars", uiMuted)
        f_lp_row(11, "LAST BUY ARCHIVE", lp_archive ? lp_a.oldBuy.status + " · " + lp_a.oldBuy.reason : "Hidden", uiMuted)
        f_lp_row(12, "LAST SELL ARCHIVE", lp_archive ? lp_a.oldSell.status + " · " + lp_a.oldSell.reason : "Hidden", uiMuted)

// ============================================================================
// SIGNALS: source-timeframe data -> confirmed events -> bounded state machines.
// All permanent events and state changes are committed only at chart-bar close.
// Any lower-TF momentum is the final confirmed sample, NOT a replay of all
// intrabars. Events in omitted samples can be missed; standard fast TFs divide 5m/15m/1h.
// ============================================================================
const string s_GROUP_EBW = "02 | EBW patterns"
const string s_GROUP_WT = "03 | WaveTrend"
const string s_GROUP_PHASE = "05 | Market phase"

string s_tfMode = input.string("Intraday standard", "Signal timeframes", options=["Intraday standard", "Adaptive", "Legacy fixed"], group=s_GROUP_EBW, tooltip="Intraday standard uses aligned lower samples and familiar higher contexts on 5m/15m/1h; on 5m the second fast slot reuses 5m. Adaptive: fast samples near chart/5 and chart*3/5, base=chart, trend contexts near chart*3, *6, *12, *48. Rounded to valid timeframes and capped at 12M. Minute charts use at least 1m; seconds charts use the chart itself for fast slots. Legacy fixed retains the V8 set.", display=display.none)
bool s_standard = s_tfMode == "Intraday standard" and (chartSec == 300 or chartSec == 900 or chartSec == 3600)
bool s_adaptive = s_tfMode != "Legacy fixed"
string s_tf1 = s_standard ? (chartSec == 300 ? "1" : chartSec == 900 ? "3" : "5") : s_adaptive ? f_relativeTf(0.2) : "1"
string s_tf3 = s_standard ? (chartSec <= 900 ? "5" : "15") : s_adaptive ? f_relativeTf(0.6) : "3"
string s_tf5 = s_adaptive ? timeframe.period : "5"
string s_tf15 = s_standard ? (chartSec == 300 ? "15" : chartSec == 900 ? "30" : "120") : s_adaptive ? f_relativeTf(3.0) : "15"
string s_tf30 = s_standard ? (chartSec == 300 ? "30" : chartSec == 900 ? "60" : "240") : s_adaptive ? f_relativeTf(6.0) : "30"
string s_tf60 = s_standard ? (chartSec == 300 ? "60" : chartSec == 900 ? "240" : "720") : s_adaptive ? f_relativeTf(12.0) : "60"
string s_tf240 = s_standard ? (chartSec == 300 ? "240" : "1D") : s_adaptive ? f_relativeTf(48.0) : "240"

bool s_ebwOn = input.bool(true, "Enable six EBW patterns", group=s_GROUP_EBW, display=display.none) and confirmationRun
int s_expiry = input.int(100, "Pattern expires after chart bars", minval=20, maxval=1000, group=s_GROUP_EBW, tooltip="Whole-pattern lifetime, measured from the first armed stage. Default 100 bars = about 8h20m on a continuous 5m chart.", display=display.none)
bool s_wtOn = input.bool(true, "Enable WaveTrend signals", group=s_GROUP_WT, display=display.none) and confirmationRun
int s_wtChannel = input.int(9, "Channel length", minval=2, maxval=100, group=s_GROUP_WT, display=display.none)
int s_wtAverage = input.int(12, "Average length", minval=2, maxval=100, group=s_GROUP_WT, display=display.none)
int s_wtSmooth = input.int(3, "Signal smoothing", minval=1, maxval=50, group=s_GROUP_WT, display=display.none)
float s_wtExtreme = input.float(75.0, "Extreme threshold (+/-)", minval=10.0, maxval=150.0, step=5.0, group=s_GROUP_WT, display=display.none)
string s_maMethod = input.string("EMA", "MA method", options=["EMA", "SMA"], group=s_GROUP_PHASE, display=display.none)
int s_fastLen = input.int(20, "Fast MA", minval=2, maxval=500, group=s_GROUP_PHASE, display=display.none)
int s_slowLen = input.int(50, "Slow MA", minval=3, maxval=1000, group=s_GROUP_PHASE, display=display.none)

if barstate.isfirst and s_fastLen >= s_slowLen
    runtime.error("Fast MA must be shorter than Slow MA.")

type s_Momentum
    float rsi = na
    float k = na
    float d = na
    float rawK = na
    bool kdDown = false
    bool kdUp = false
    bool kUp20 = false
    bool kDown80 = false
    int stamp = na
    int closedAt = na

// History references are evaluated INSIDE the source context. Crosses therefore
// refer to source candles rather than to chart bars after the series is merged.
f_s_momentum(int offsetBars) =>
    float r = ta.rsi(close, 14)
    float raw = ta.stoch(close, high, low, 9)
    float kk = ta.sma(raw, 3)
    float dd = ta.sma(kk, 3)
    bool crossDown = ta.crossunder(kk, dd)
    bool crossUp = ta.crossover(kk, dd)
    bool up20 = ta.crossover(kk, 20.0)
    bool down80 = ta.crossunder(kk, 80.0)
    s_Momentum.new(r[offsetBars], kk[offsetBars], dd[offsetBars], raw[offsetBars], crossDown[offsetBars], crossUp[offsetBars], up20[offsetBars], down80[offsetBars], time[offsetBars], time_close[offsetBars])

simple int i_ltfBars = 2600
f_s_request(string sourceTf) =>
    int sourceSeconds = int(timeframe.in_seconds(sourceTf))
    bool alignedLower = sourceSeconds < chartSec and chartSec % sourceSeconds == 0
    s_Momentum result = s_Momentum.new()
    if sourceSeconds > chartSec
        // Previous completed HTF source bar: stable on reload.
        result := request.security(syminfo.tickerid, sourceTf, f_s_momentum(1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=1200)
    else if sourceSeconds == chartSec
        result := f_s_momentum(0)
    else if alignedLower and perf_runtimeGuard
        // FAST PATH: standard 5m / 15m / 1h ladders divide evenly.
        // request.security with lookahead_off returns the final LTF sample for a
        // completed chart candle, avoiding large intrabar arrays on every bar.
        result := request.security(syminfo.tickerid, sourceTf, f_s_momentum(0), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, calc_bars_count=1200)
    else
        // FALLBACK for unusual / non-divisible adaptive intervals.
        // We retain the exact "last sample whose close <= chart close" rule,
        // but bound the intrabar history to prevent TradingView runtime pressure.
        array<s_Momentum> samples = request.security_lower_tf(syminfo.tickerid, sourceTf, f_s_momentum(0), ignore_invalid_timeframe=true, calc_bars_count=i_ltfBars)
        if array.size(samples) > 0
            for index = array.size(samples) - 1 to 0
                s_Momentum sample = array.get(samples, index)
                if sample.closedAt <= time_close
                    result := sample
                    break
    na(result) ? s_Momentum.new() : result

var array<string> s_sourceTFs = array.from(s_tf1, s_tf3, s_tf5, s_tf15, s_tf30, s_tf60, s_tf240)
array<s_Momentum> s_packets = array.new<s_Momentum>(7, na)
for sourceIndex = 0 to 6
    string sourceTf = array.get(s_sourceTFs, sourceIndex)
    bool need = s_ebwOn
    int duplicate = -1
    if sourceIndex > 0 and need
        for j = 0 to sourceIndex - 1
            if timeframe.in_seconds(array.get(s_sourceTFs, j)) == timeframe.in_seconds(sourceTf) and not na(array.get(s_packets, j))
                duplicate := j
                break
    s_Momentum packet = na
    if need
        if duplicate >= 0
            packet := array.get(s_packets, duplicate)
        else
            packet := f_s_request(sourceTf)
    array.set(s_packets, sourceIndex, packet)
s_Momentum s_m1 = na(array.get(s_packets, 0)) ? s_Momentum.new() : array.get(s_packets, 0)
s_Momentum s_m3 = na(array.get(s_packets, 1)) ? s_Momentum.new() : array.get(s_packets, 1)
s_Momentum s_m5 = na(array.get(s_packets, 2)) ? s_Momentum.new() : array.get(s_packets, 2)
s_Momentum s_m15 = na(array.get(s_packets, 3)) ? s_Momentum.new() : array.get(s_packets, 3)
s_Momentum s_m30 = na(array.get(s_packets, 4)) ? s_Momentum.new() : array.get(s_packets, 4)
s_Momentum s_m60 = na(array.get(s_packets, 5)) ? s_Momentum.new() : array.get(s_packets, 5)
s_Momentum s_m240 = na(array.get(s_packets, 6)) ? s_Momentum.new() : array.get(s_packets, 6)

var int s_seen5 = na
var int s_seen15 = na
bool s_new5 = barstate.isconfirmed and not na(s_m5.stamp) and (na(s_seen5) or s_m5.stamp != s_seen5)
bool s_new15 = barstate.isconfirmed and not na(s_m15.stamp) and (na(s_seen15) or s_m15.stamp != s_seen15)
bool s_kdDown5 = s_new5 and s_m5.kdDown
bool s_kdUp5 = s_new5 and s_m5.kdUp
bool s_kUp20_15 = s_new15 and s_m15.kUp20
bool s_kDown80_5 = s_new5 and s_m5.kDown80
bool s_ebwReady = not na(s_m1.rsi) and not na(s_m1.k) and not na(s_m3.rsi) and not na(s_m3.k) and not na(s_m5.rsi) and not na(s_m5.d) and not na(s_m15.rsi) and not na(s_m15.k) and not na(s_m30.rsi) and not na(s_m30.k) and not na(s_m60.rsi) and not na(s_m60.k) and not na(s_m240.k)
bool s_bullEngulf = close[1] < open[1] and close > high[1]
bool s_bearEngulf = close[1] > open[1] and close < low[1]

type s_Machine
    int stage = 0
    int started = na

// A single switch uses the state at the START of this confirmed chart bar.
// Threshold stages are retained from V7; source-cross stages use timestamped
// events. Reaching the terminal stage arms the trigger for subsequent bars.
f_s_nextP(int stage) =>
    switch stage
        0 => s_m5.rsi < 27 or s_m60.k > 40 or s_m240.k > 40 ? 1 : 0
        1 => s_m5.rsi > 32 ? 2 : 1
        2 => s_m5.rsi < 30 ? 3 : 2
        3 => s_m5.k > 20 ? 4 : 3
        4 => s_m5.k < 80 ? 5 : 4
        5 => s_m5.k > 20 or s_m5.rsi < 18 or s_m30.rsi < 18 ? 6 : 5
        6 => s_m5.rsi < 25 ? 7 : 6
        7 => s_m5.rsi > 31 or s_m5.k > 60 ? 8 : s_m15.rsi < 30 ? 4 : 7
        8 => s_m30.rsi > 35 ? 0 : s_m5.k < 20 ? 9 : 8
        9 => s_m1.k < 20 and s_m1.rsi < 30 ? 10 : 9
        => stage

f_s_nextL1(int stage) =>
    switch stage
        0 => s_m5.rsi < 25 ? 1 : 0
        1 => s_m5.k < 20 ? 2 : 1
        2 => s_m5.k > 80 ? 3 : 2
        3 => s_m5.k < 20 ? 4 : 3
        4 => s_m1.k > 80 ? 5 : 4
        5 => s_m1.k < 20 ? 6 : 5
        6 => s_m5.rsi > 35 ? 7 : 6
        7 => s_m5.rsi < 25 ? 8 : 7
        8 => s_m5.rsi > 33 ? 9 : 8
        9 => s_kdDown5 ? 10 : 9
        10 => s_kUp20_15 ? 11 : 10
        11 => s_m1.k < 20 and s_m1.rsi < 30 ? 12 : 11
        => stage

f_s_nextL2(int stage) =>
    switch stage
        0 => s_m3.rsi < 25 ? 1 : 0
        1 => s_m3.k < 20 ? 2 : 1
        2 => s_m3.k > 80 ? 3 : 2
        3 => s_m3.k < 20 ? 4 : 3
        4 => s_m1.k > 80 ? 5 : 4
        5 => s_m1.k < 20 ? 6 : 5
        6 => s_m3.rsi > 35 ? 7 : 6
        7 => s_m5.rsi < 25 ? 8 : 7
        8 => s_m5.rsi > 31 ? 9 : 8
        9 => s_kdDown5 ? 10 : 9
        10 => s_kUp20_15 ? 11 : 10
        11 => s_m1.k < 20 and s_m1.rsi < 30 ? 12 : 11
        => stage

f_s_nextD(int stage) =>
    switch stage
        0 => s_m15.k > 70 ? 1 : 0
        1 => s_m5.rsi > 77 ? 2 : 1
        2 => s_m5.rsi < 69 ? 3 : 2
        // V7 mistakenly reset the long machine here. A renewed >77 extreme
        // now invalidates THIS short setup, before the >72 recovery transition.
        3 => s_m5.rsi > 77 ? 0 : s_m5.rsi > 72 ? 4 : 3
        4 => s_m1.k > 80 ? 5 : 4
        5 => s_m1.k < 20 ? 6 : 5
        6 => s_m1.k > 80 ? 7 : 6
        7 => s_m5.rsi > 75 ? 8 : 7
        8 => s_m5.rsi < 69 ? 9 : 8
        9 => s_m1.k > 80 and s_m1.rsi > 70 ? 10 : 9
        => stage

f_s_nextS1(int stage) =>
    switch stage
        0 => s_m15.k > 80 ? 1 : 0
        1 => s_m1.rsi > 70 ? 2 : 1
        2 => s_m1.k < 50 ? 3 : 2
        3 => s_m1.rsi < 50 ? 4 : 3
        4 => s_m1.k > 80 ? 5 : 4
        5 => s_m1.k < 79 ? 6 : 5
        6 => s_m15.rsi > 75 ? 7 : 6
        7 => s_m5.rsi > 75 ? 8 : 7
        8 => s_m1.rsi > 75 ? 9 : 8
        9 => s_m1.k > 80 ? 10 : 9
        10 => s_m5.rsi > 75 ? 11 : 10
        11 => s_m5.rsi < 68 ? 12 : 11
        12 => s_kdUp5 ? 13 : 12
        13 => s_kDown80_5 ? 14 : 13
        14 => s_m1.k > 80 and s_m1.rsi > 70 ? 15 : 14
        => stage

f_s_nextS2(int stage) =>
    switch stage
        0 => s_m1.k > 80 ? 1 : 0
        1 => s_m1.k < 79 ? 2 : 1
        2 => s_m15.rsi > 75 ? 3 : 2
        3 => s_m5.rsi > 75 ? 4 : 3
        4 => s_m5.rsi > 80 ? 5 : 4
        5 => s_m5.rsi < 77 ? 6 : 5
        6 => s_kdUp5 ? 7 : 6
        7 => s_kDown80_5 ? 8 : 7
        8 => s_m1.k > 80 and s_m1.rsi > 70 ? 9 : 8
        => stage

f_s_tick(s_Machine machine, int nextStage, int terminalStage, bool trigger, bool invalid) =>
    bool fired = false
    if barstate.isconfirmed
        bool expired = machine.stage > 0 and not na(machine.started) and bar_index - machine.started >= s_expiry
        if invalid or expired
            machine.stage := 0
            machine.started := na
        else if machine.stage == terminalStage and trigger
            fired := true
            machine.stage := 0
            machine.started := na
        else
            if machine.stage == 0 and nextStage > 0
                machine.started := bar_index
            if nextStage == 0
                machine.started := na
            machine.stage := nextStage
    fired

var s_Machine s_p = s_Machine.new()
var s_Machine s_l1 = s_Machine.new()
var s_Machine s_l2 = s_Machine.new()
var s_Machine s_d = s_Machine.new()
var s_Machine s_s1 = s_Machine.new()
var s_Machine s_s2 = s_Machine.new()
bool s_disabled = not s_ebwOn or not s_ebwReady
bool s_fireP = f_s_tick(s_p, f_s_nextP(s_p.stage), 10, s_bullEngulf, s_disabled or s_m30.k > 50 or s_m15.k > 50)
bool s_fireL1 = f_s_tick(s_l1, f_s_nextL1(s_l1.stage), 12, s_bullEngulf, s_disabled or s_m30.rsi > 50 or s_m15.rsi > 70)
bool s_fireL2 = f_s_tick(s_l2, f_s_nextL2(s_l2.stage), 12, s_bullEngulf, s_disabled or s_m30.rsi > 50 or s_m15.rsi > 70)
bool s_fireD = f_s_tick(s_d, f_s_nextD(s_d.stage), 10, s_bearEngulf, s_disabled or s_m15.k < 40 or s_m60.k < 50)
bool s_fireS1 = f_s_tick(s_s1, f_s_nextS1(s_s1.stage), 15, s_bearEngulf, s_disabled or s_m5.rsi < 30 or s_m60.rsi < 50)
bool s_fireS2 = f_s_tick(s_s2, f_s_nextS2(s_s2.stage), 9, s_bearEngulf, s_disabled or s_m15.rsi < 50 or s_m60.rsi < 50)
if barstate.isconfirmed
    s_seen5 := s_m5.stamp
    s_seen15 := s_m15.stamp

f_s_patternText(bool first, bool hasSecond, bool third, string firstName, string secondName, string thirdName) =>
    string result = first ? firstName : ""
    if hasSecond
        result += (str.length(result) > 0 ? "+" : "") + secondName
    if third
        result += (str.length(result) > 0 ? "+" : "") + thirdName
    result

bool sigEbwEnabled = s_ebwOn
bool sigEbwLong = s_fireP or s_fireL1 or s_fireL2
bool sigEbwShort = s_fireD or s_fireS1 or s_fireS2
string sigEbwLongPattern = f_s_patternText(s_fireP, s_fireL1, s_fireL2, "P", "L1", "L2")
string sigEbwShortPattern = f_s_patternText(s_fireD, s_fireS1, s_fireS2, "D", "S1", "S2")
int sigEbwStateLong = s_p.stage
int sigEbwStateShort = s_d.stage
float sigRsi5 = s_m5.rsi
float sigK5 = s_m5.k
bool sigUsesLowerSampling = sigEbwEnabled and (timeframe.in_seconds(s_tf1) < chartSec or timeframe.in_seconds(s_tf3) < chartSec)

// WaveTrend keeps the original oscillator + recent RSI/Stoch extreme setup.
// All history-dependent calculations execute every bar (v6 lazy booleans safe).
float s_chartRsi = ta.rsi(close, 14)
float s_chartRawK = ta.stoch(close, high, low, 9)
float s_esa = ta.ema(hlc3, s_wtChannel)
float s_de = ta.ema(math.abs(hlc3 - s_esa), s_wtChannel)
float s_ci = not na(s_de) and s_de > 0 ? (hlc3 - s_esa) / (0.015 * s_de) : 0.0
float s_wt1 = ta.ema(s_ci, s_wtAverage)
float s_wt2 = ta.sma(s_wt1, s_wtSmooth)
bool s_wtCrossUp = ta.crossover(s_wt1, s_wt2)
bool s_wtCrossDown = ta.crossunder(s_wt1, s_wt2)
bool s_originalOverbought = s_chartRsi > 75 and s_chartRawK > 85
bool s_originalOversold = s_chartRsi < 25 and s_chartRawK < 15
float s_recentOB = ta.highest(s_originalOverbought ? 1.0 : 0.0, 10)
float s_recentOS = ta.highest(s_originalOversold ? 1.0 : 0.0, 10)
bool sigWtEnabled = s_wtOn
bool sigWtLong = s_wtOn and barstate.isconfirmed and s_wtCrossUp and s_wt2 <= -s_wtExtreme and s_recentOS > 0
bool sigWtShort = s_wtOn and barstate.isconfirmed and s_wtCrossDown and s_wt2 >= s_wtExtreme and s_recentOB > 0

// All six strict orderings of close/Fast/Slow are reachable. Equal values and
// warmup explicitly return Neutral rather than leaving a stale prior phase.
float sigFastMA = s_maMethod == "EMA" ? ta.ema(close, s_fastLen) : ta.sma(close, s_fastLen)
float sigSlowMA = s_maMethod == "EMA" ? ta.ema(close, s_slowLen) : ta.sma(close, s_slowLen)
string i_biasTf = chartSec <= 300 ? "15" : chartSec <= 900 ? "60" : chartSec <= 3600 ? "240" : f_relativeTf(3.0)
f_i_bias() =>
    float fast = s_maMethod == "EMA" ? ta.ema(close, s_fastLen) : ta.sma(close, s_fastLen)
    float slow = s_maMethod == "EMA" ? ta.ema(close, s_slowLen) : ta.sma(close, s_slowLen)
    [close[1], fast[1], slow[1]]
[i_htfClose, i_htfFast, i_htfSlow] = request.security(syminfo.tickerid, i_biasTf, f_i_bias(), lookahead=barmerge.lookahead_on, calc_bars_count=1200)
bool i_htfL = not i_htfFilter or (i_htfFast > i_htfSlow and i_htfClose > i_htfSlow)
bool i_htfS = not i_htfFilter or (i_htfFast < i_htfSlow and i_htfClose < i_htfSlow)
// Every cross is evaluated every chart bar. A fresh reclaim triggers only at close.
bool i_crossUp = ta.crossover(close, sigFastMA)
bool i_crossDown = ta.crossunder(close, sigFastMA)
bool i_pullL = confirmationRun and barstate.isconfirmed and i_crossUp and low <= sigFastMA and sigFastMA > sigSlowMA and close > open
bool i_pullS = confirmationRun and barstate.isconfirmed and i_crossDown and high >= sigFastMA and sigFastMA < sigSlowMA and close < open
int s_phaseNow = 0
if not na(sigFastMA) and not na(sigSlowMA)
    if sigFastMA > sigSlowMA
        s_phaseNow := close > sigFastMA ? 1 : close > sigSlowMA and close < sigFastMA ? 2 : close < sigSlowMA ? 4 : 0
    else if sigFastMA < sigSlowMA
        s_phaseNow := close > sigSlowMA ? 3 : close > sigFastMA and close < sigSlowMA ? 5 : close < sigFastMA ? 6 : 0
var int sigPhase = 0
if barstate.isconfirmed
    sigPhase := s_phaseNow
string sigPhaseName = switch sigPhase
    1 => "Bullish"
    2 => "Warning"
    3 => "Accumulation"
    4 => "Distribution"
    5 => "Recovery"
    6 => "Bearish"
    => "Neutral / warming up"


// ZONES: V10.4.4 uses the audited V9.9 premium multi-layer Supply & Demand / POI map as its source of truth.
// Design basis: S&D quality (strength, freshness, spending time), source/clean zones,
// Quasimodo, SR-flip, imbalance/FVG, 50% wave context, and liquidity/inducement layers.
// IMPORTANT: liquidity levels are map targets, not assumed support/resistance.
const string Z_GROUP = "06 · Zones & structure"
const string Z_STYLE = "07 · Zone map appearance"
zoneEnabled = input.bool(true, "Enable zone engine", group=Z_GROUP, display=display.none) and structureRun
z_mtf = input.bool(true, "Add higher-TF zone contexts", group=Z_GROUP, display=display.none)
z_chartZones = input.bool(true, "Chart-timeframe zones", group=Z_GROUP, display=display.none)
z_scoreModel = input.string("Grouped evidence", "Evidence scoring", options=["Grouped evidence", "Legacy weights"], group=Z_GROUP, tooltip="Grouped caps related evidence so the same move cannot collect unlimited bonuses. Scores are not calibrated win probabilities.", display=display.none)
z_set = input.string("AUTO", "Timeframe set", options=["AUTO", "S · Scalp", "M · Day", "L · Swing", "XL · Position"], group=Z_GROUP, display=display.none)
string z_autoTfMode = input.string("Standard ladder", "AUTO timeframe mapping", options=["Standard ladder", "Relative legacy"], group=Z_GROUP, tooltip="Standard ladder keeps planning contexts human-readable. Example on a 15m chart: 15m / 1h / 4h / 1D / 1W. Relative legacy preserves the older chart x3/x6/x12 behavior.", display=display.none)
z_smartSD = input.bool(true, "Supply / Demand · RBR DBR RBD DBD", group=Z_GROUP, display=display.none) and confirmationRun
z_fvg = input.bool(true, "FVG / imbalance reaction zones", group=Z_GROUP, display=display.none) and confirmationRun
z_qml = input.bool(true, "Quasimodo decision levels", group=Z_GROUP, display=display.none) and confirmationRun
z_liquidity = input.bool(true, "Swing + equal H/L liquidity", group=Z_GROUP, display=display.none) and confirmationRun
z_inducement = input.bool(true, "Valid-pullback / inducement map", group=Z_GROUP, display=display.none) and confirmationRun
z_wave50 = input.bool(true, "50% of trending wave map", group=Z_GROUP, display=display.none) and confirmationRun
z_dailyPivots = input.bool(false, "Classic pivots (context only)", group=Z_GROUP, display=display.none) and confirmationRun
z_pivotLevels = input.int(2, "Context pivot levels", minval=2, maxval=4, group=Z_GROUP, display=display.none)
z_ob = input.bool(true, "Volume-pivot order blocks", group=Z_GROUP, display=display.none) and confirmationRun
z_obLen = input.int(10, "OB confirmation bars", minval=3, maxval=30, group=Z_GROUP, display=display.none)
z_structureOn = input.bool(true, "BOS / ChoCH structure", group=Z_GROUP, display=display.none)
z_swingLen = input.int(5, "Chart structure pivot bars", minval=2, maxval=30, group=Z_GROUP, display=display.none)
z_flip = input.bool(true, "S/R flip / breaker zones", group=Z_GROUP, display=display.none) and confirmationRun
z_breakMode = input.string("Close", "Zone invalidation", options=["Close", "Wick"], group=Z_GROUP, tooltip="Permanent updates occur on chart close. Wick mode invalidates from the completed candle extreme.", display=display.none)
z_breakBuffer = input.float(0.08, "Break buffer · ATR", minval=0.0, maxval=0.5, step=0.01, group=Z_GROUP, display=display.none)
z_mergeATR = input.float(0.14, "Merge nearby evidence · ATR", minval=0.02, maxval=0.8, step=0.01, group=Z_GROUP, display=display.none)
z_nearATR = input.float(0.35, "Signal proximity · ATR", minval=0.05, maxval=2.0, step=0.05, group=Z_GROUP, display=display.none)
z_minActionScore = input.float(62.0, "Minimum defend-zone score", minval=40.0, maxval=90.0, step=1.0, group=Z_GROUP, tooltip="Only defended POIs above this evidence score may confirm BUY/SELL. Liquidity levels never confirm an entry by themselves.", display=display.none)
z_majorScore = input.float(76.0, "Major-zone score", minval=55.0, maxval=95.0, step=1.0, group=Z_GROUP, display=display.none)
z_reactionMinScore = input.float(28.0, "Reaction-map minimum score", minval=10.0, maxval=70.0, step=1.0, group=Z_GROUP, display=display.none)
z_maxActionTests = input.int(1, "Maximum retests for defend zone", minval=0, maxval=3, group=Z_GROUP, tooltip="Fresh = 0. First return = 1. More touches are treated as increasingly consumed.", display=display.none)
z_maxAge = input.int(800, "Maximum zone age · chart bars", minval=100, maxval=4000, group=Z_GROUP, display=display.none)
z_capacity = input.int(140, "Maximum active map records", minval=60, maxval=260, group=Z_GROUP, display=display.none)
int z_runtimeCapacity = perf_runtimeGuard ? math.min(z_capacity, perf_recordCap) : z_capacity
int z_runtimeContexts = perf_runtimeGuard ? math.min(i_zoneContexts, 2) : i_zoneContexts

string z_refresh = input.string("Closed bars", "Map refresh", options=["Closed bars", "Live preview"], group=Z_STYLE, tooltip="Closed bars redraws only committed evidence; Live preview may change rankings before the current bar closes. Signals always require a closed bar.", display=display.none)
bool z_show = input.bool(true, "Show S&D / POI map", group=Z_STYLE, display=display.none) and lp_view != "Limit Planner"
string z_visualMode = input.string("Premium Clean", "Map density / ความหนาแน่น", options=["Premium Clean", "Balanced", "Full Map"], group=Z_STYLE, tooltip="Premium Clean is the default: one Major, one Reaction and one Liquidity level per side. Balanced shows a little more context. Full Map exposes the research map.", display=display.none)
int z_majorPerSide = input.int(2, "Full Map · Major zones per side", minval=0, maxval=4, group=Z_STYLE, display=display.none)
int z_reactionPerSide = input.int(3, "Full Map · Reaction zones per side", minval=0, maxval=6, group=Z_STYLE, display=display.none)
int z_liquidityPerSide = input.int(2, "Full Map · Liquidity levels per side", minval=0, maxval=6, group=Z_STYLE, display=display.none)
float z_showDistance = input.float(12.0, "Full Map · visible distance · ATR", minval=1.0, maxval=40.0, step=0.5, group=Z_STYLE, display=display.none)
float z_maxWidth = input.float(2.5, "Maximum defend-zone width · ATR", minval=0.5, maxval=30.0, step=0.5, group=Z_STYLE, tooltip="Broad areas may remain as context but cannot confirm a precise entry.", display=display.none)
float z_cleanReactionScore = input.float(58.0, "Premium · minimum Reaction score", minval=35.0, maxval=80.0, step=1.0, group=Z_STYLE, tooltip="Keeps low-quality Reaction zones off the default chart without changing the underlying zone engine.", display=display.none)
float z_visualClusterATR = input.float(0.30, "Premium · merge visual clutter · ATR", minval=0.05, maxval=1.0, step=0.05, group=Z_STYLE, tooltip="Nearby overlapping POIs are visually suppressed in Premium/Balanced modes. They remain in the engine and are still visible in Full Map.", display=display.none)
string z_labelMode = input.string("Premium", "Zone label detail", options=["Premium", "Full", "Hidden"], group=Z_STYLE, display=display.none)
int z_spanBars = input.int(100, "Visible history · bars", minval=20, maxval=500, group=Z_STYLE, display=display.none)
int z_rightBars = input.int(10, "Label offset · bars", minval=3, maxval=80, group=Z_STYLE, display=display.none)
float z_atr = ta.atr(14)
float z_band = math.max(syminfo.mintick * 2.0, nz(z_atr, high - low) * 0.055)

// Source-family bits.
const int Z_FAMILY_PIVOT = 1
const int Z_FAMILY_SD = 2
const int Z_FAMILY_SWING = 4
const int Z_FAMILY_OB = 8
const int Z_FAMILY_FLIP = 16
const int Z_FAMILY_IMPULSE = 32
const int Z_FAMILY_FVG = 64
const int Z_FAMILY_QML = 128
const int Z_FAMILY_LIQ = 256
const int Z_FAMILY_IDM = 512
const int Z_FAMILY_WAVE = 1024

// Evidence tags. LIQ means a sweep/raid occurred before departure; LIQUIDITY sources use families above.
const int Z_TAG_DISP = 1
const int Z_TAG_LIQ = 2
const int Z_TAG_STRUCT = 4
const int Z_TAG_PD = 8
const int Z_TAG_CLEAN = 16
const int Z_TAG_SOURCE = 32
const int Z_TAG_IMBALANCE = 64
const int Z_TAG_NESTED = 128
const int Z_TAG_EQUAL = 256
const int Z_TAG_IDM = 512

const int Z_ROLE_MAJOR = 1
const int Z_ROLE_REACTION = 2
const int Z_ROLE_LIQUIDITY = 3

f_z_has(int mask, int flag) =>
    int(math.floor(mask / flag)) % 2 == 1

f_z_familyCount(int mask) =>
    int count = 0
    for bitIndex = 0 to 10
        count += f_z_has(mask, int(math.pow(2, bitIndex))) ? 1 : 0
    count

f_z_familyName(int family) =>
    switch family
        Z_FAMILY_PIVOT => "Pivot"
        Z_FAMILY_SD => "S/D"
        Z_FAMILY_SWING => "Swing-LQ"
        Z_FAMILY_OB => "OB"
        Z_FAMILY_FLIP => "Flip/Breaker"
        Z_FAMILY_IMPULSE => "Impulse"
        Z_FAMILY_FVG => "FVG"
        Z_FAMILY_QML => "QML"
        Z_FAMILY_LIQ => "EQ-LQ"
        Z_FAMILY_IDM => "IDM"
        => "50% Wave"

f_z_tagsText(int tags) =>
    string tagText = ""
    tagText += f_z_has(tags, Z_TAG_SOURCE) ? "SOURCE " : ""
    tagText += f_z_has(tags, Z_TAG_CLEAN) ? "CLEAN " : ""
    tagText += f_z_has(tags, Z_TAG_DISP) ? "DISP " : ""
    tagText += f_z_has(tags, Z_TAG_STRUCT) ? "STRUCT " : ""
    tagText += f_z_has(tags, Z_TAG_LIQ) ? "SWEEP " : ""
    tagText += f_z_has(tags, Z_TAG_IMBALANCE) ? "FVG/IMB " : ""
    tagText += f_z_has(tags, Z_TAG_NESTED) ? "NESTED " : ""
    tagText += f_z_has(tags, Z_TAG_PD) ? "PD " : ""
    tagText += f_z_has(tags, Z_TAG_EQUAL) ? "EQ " : ""
    tagText += f_z_has(tags, Z_TAG_IDM) ? "IDM " : ""
    tagText == "" ? "basic" : tagText

f_z_tfKey(string tf) =>
    str.tostring(timeframe.in_seconds(tf))

type z_Audit
    int origin = na
    int known = na
    int checked = na
    int tests = 0
    bool touching = false
    bool departed = false
    bool complete = false
    bool broken = false
    float atr = na

f_z_broken(float lo, float hi, int side, float atrValue, float c, float h, float l) =>
    float probe = z_breakMode == "Close" ? c : side == 1 ? l : h
    float buffer = math.max(nz(atrValue, 0.0), syminfo.mintick) * z_breakBuffer
    side == 1 ? probe < lo - buffer : probe > hi + buffer

// The origin candle is excluded. First departure is not a retest.
// endOffset=1 for prior-source snapshots, 0 for chart-close candidates.
f_z_audit(float lo, float hi, int side, int origin, int startOffset, int endOffset, float atrValue, bool departedAtOrigin) =>
    z_Audit a = z_Audit.new(origin=origin, known=time_close[endOffset], checked=time_close[endOffset], atr=atrValue)
    a.complete := not na(startOffset) and startOffset >= endOffset and startOffset <= 300 and not na(atrValue) and atrValue > 0
    if a.complete
        a.complete := not na(time[startOffset])
        a.departed := departedAtOrigin
        if startOffset > endOffset
            for k = startOffset - 1 to endOffset
                if na(close[k]) or na(high[k]) or na(low[k])
                    a.complete := false
                else
                    a.broken := a.broken or f_z_broken(lo, hi, side, atrValue, close[k], high[k], low[k])
                    if not a.departed
                        a.departed := side == 1 ? close[k] > hi : close[k] < lo
                    else
                        bool hit = low[k] <= hi and high[k] >= lo
                        if hit and not a.touching
                            a.tests += 1
                        a.touching := hit
    a

// A QML activates after the head and the structural break, NOT at the old shoulder.
// The head crossing the shoulder before activation is expected, not an invalidation.
f_z_qmAudit(float lo, float hi, int side, int shoulder, int head, float breakLevel, int eventKey, float atrValue) =>
    var int seen = na
    var z_Audit saved = z_Audit.new()
    if not na(eventKey) and (na(seen) or seen != eventKey)
        int activation = na
        for k = 300 to 1
            if not na(time[k]) and time[k] > head and (side == 1 ? close[k] > breakLevel : close[k] < breakLevel)
                activation := k
                break
        if na(time[300]) or head < time[300]
            activation := na
        saved := f_z_audit(lo, hi, side, shoulder, activation, 1, atrValue, true)
        seen := eventKey
    saved

type z_Record
    float lo
    float hi
    int side
    string tfKeys
    string tfNames
    int tfCount
    int maxTfSec
    int families
    string names
    int bornBar
    int evidenceBar
    int tests
    bool wasTouching
    float quality
    float departureATR
    int tags
    int baseBars
    string id = ""
    int originTime = na
    int knownTime = na
    int observedTime = na
    float sourceAtr = na
    bool historyComplete = false
    bool departed = false
    float cachedScore = na
    int cachedRole = 0

var array<z_Record> z_records = array.new<z_Record>()
var map<string, int> z_consumed = map.new<string, int>()
var string z_planZoneId = ""
var string z_signalZoneId = ""

f_z_isDefendCore(z_Record record) =>
    f_z_has(record.families, Z_FAMILY_SD) or f_z_has(record.families, Z_FAMILY_OB) or f_z_has(record.families, Z_FAMILY_QML) or f_z_has(record.families, Z_FAMILY_FLIP)

f_z_isLiquidityOnly(z_Record record) =>
    bool liquidityFamily = f_z_has(record.families, Z_FAMILY_SWING) or f_z_has(record.families, Z_FAMILY_LIQ) or f_z_has(record.families, Z_FAMILY_IDM)
    liquidityFamily and not f_z_isDefendCore(record) and not f_z_has(record.families, Z_FAMILY_FVG) and not f_z_has(record.families, Z_FAMILY_WAVE)

f_z_score(z_Record record) =>
    // Evidence score: zone quality/importance, never a probability of winning.
    float baseQuality = math.max(0.0, math.min(1.0, record.quality)) * 12.0
    float displacement = math.min(1.0, math.max(0.0, record.departureATR) / 1.5) * 20.0
    float structure = f_z_has(record.tags, Z_TAG_STRUCT) ? 16.0 : 0.0
    float sweep = f_z_has(record.tags, Z_TAG_LIQ) ? 10.0 : 0.0
    float freshness = not record.historyComplete or not record.departed ? 0.0 : record.tests == 0 ? 15.0 : record.tests == 1 ? 7.0 : record.tests == 2 ? -8.0 : -20.0
    float tfRatio = chartSec > 0 ? float(record.maxTfSec) / float(chartSec) : 1.0
    float htfContext = tfRatio >= 12.0 ? 10.0 : tfRatio >= 6.0 ? 8.0 : tfRatio >= 3.0 ? 5.0 : 0.0
    float breadth = math.min(record.tfCount - 1, 3) * 2.5
    float diversity = math.min(f_z_familyCount(record.families) - 1, 4) * 2.0
    float location = f_z_has(record.tags, Z_TAG_PD) ? 4.0 : 0.0
    float cleanSource = (f_z_has(record.tags, Z_TAG_CLEAN) ? 6.0 : 0.0) + (f_z_has(record.tags, Z_TAG_SOURCE) ? 7.0 : 0.0)
    float qmlBonus = f_z_has(record.families, Z_FAMILY_QML) ? 7.0 : 0.0
    float nestedBonus = f_z_has(record.tags, Z_TAG_NESTED) ? 5.0 : 0.0
    float imbalanceBonus = f_z_has(record.tags, Z_TAG_IMBALANCE) ? 4.0 : 0.0
    float spendingPenalty = record.baseBars <= 2 ? 0.0 : math.min(12.0, (record.baseBars - 2) * 4.0)
    float agePenalty = math.min(10.0, (bar_index - record.bornBar) * 10.0 / z_maxAge)
    bool pivotOnly = record.families == Z_FAMILY_PIVOT
    bool impulseOnly = record.families == Z_FAMILY_IMPULSE
    bool swingOnly = record.families == Z_FAMILY_SWING
    bool fvgOnly = record.families == Z_FAMILY_FVG
    bool waveOnly = record.families == Z_FAMILY_WAVE
    float weakFamilyPenalty = pivotOnly ? 15.0 : impulseOnly ? 10.0 : swingOnly ? 6.0 : fvgOnly ? 4.0 : waveOnly ? 6.0 : 0.0
    // Strong one-way approach into a nearby defend zone reduces its current hold score modestly.
    float gap = record.side == 1 ? math.max(0.0, close - record.hi) : math.max(0.0, record.lo - close)
    float drive = bar_index >= 3 ? (record.side == 1 ? math.max(0.0, close[3] - close) : math.max(0.0, close - close[3])) / math.max(z_atr, syminfo.mintick) : 0.0
    float approachPenalty = f_z_isDefendCore(record) and gap <= z_atr * 2.0 ? math.min(6.0, drive * 3.0) : 0.0
    float raw = baseQuality + displacement + structure + sweep + freshness + htfContext + breadth + diversity + location + cleanSource + qmlBonus + nestedBonus + imbalanceBonus
    if z_scoreModel == "Grouped evidence"
        float qualityGroup = math.min(35.0, baseQuality + displacement + cleanSource + imbalanceBonus)
        float structureGroup = math.min(25.0, structure + sweep + qmlBonus)
        float locationGroup = math.min(25.0, htfContext + breadth + diversity + location + nestedBonus)
        raw := qualityGroup + structureGroup + locationGroup + freshness
    math.max(0.0, math.min(100.0, raw - spendingPenalty - agePenalty - weakFamilyPenalty - approachPenalty))

f_z_role(z_Record record, float score) =>
    bool defendCore = f_z_isDefendCore(record)
    bool cleanHtf = f_z_has(record.tags, Z_TAG_CLEAN) and record.maxTfSec >= chartSec * 3
    bool majorEvidence = f_z_has(record.tags, Z_TAG_SOURCE) or f_z_has(record.tags, Z_TAG_NESTED) or f_z_has(record.families, Z_FAMILY_QML) or cleanHtf or (f_z_has(record.tags, Z_TAG_STRUCT) and f_z_has(record.tags, Z_TAG_DISP))
    f_z_isLiquidityOnly(record) ? Z_ROLE_LIQUIDITY : defendCore and score >= z_majorScore and majorEvidence ? Z_ROLE_MAJOR : Z_ROLE_REACTION

f_z_roleName(int role) =>
    role == Z_ROLE_MAJOR ? "MAJOR" : role == Z_ROLE_REACTION ? "REACTION" : "LIQUIDITY"

f_z_actionable(z_Record record, float score) =>
    bool widthOK = record.hi - record.lo <= z_atr * z_maxWidth
    record.historyComplete and record.departed and widthOK and f_z_isDefendCore(record) and record.tests <= z_maxActionTests and score >= z_minActionScore

f_z_reference(z_Record record) =>
    float midpoint = math.avg(record.lo, record.hi)
    record.side == 1 ? (midpoint <= close ? midpoint : record.lo) : (midpoint >= close ? midpoint : record.hi)

f_z_mergeTag(int tags, int incoming, int flag) =>
    f_z_has(incoming, flag) and not f_z_has(tags, flag) ? tags + flag : tags

type z_Candidate
    float lower
    float upper
    int side
    string tf
    string source
    int eventTime
    int family
    float quality
    float departureATR
    int tags
    int baseBars
    z_Audit audit

var array<z_Candidate> z_candidates = array.new<z_Candidate>()

f_z_submit(float lower, float upper, int side, string tf, string source, int eventTime, int family, float quality, float departureATR, int tags, int baseBars, z_Audit audit = na) =>
    if not na(lower) and not na(upper) and not na(eventTime)
        array.push(z_candidates, z_Candidate.new(lower, upper, side, tf, source, eventTime, family, quality, departureATR, tags, baseBars, audit))

f_z_apply(float lower, float upper, int side, string tf, string source, int eventTime, int family, float quality, float departureATR, int tags, int baseBars, z_Audit audit = na) =>
    bool accepted = false
    if not na(lower) and not na(upper) and not na(eventTime) and not na(z_atr)
        string tfKey = f_z_tfKey(tf)
        int tfSeconds = int(timeframe.in_seconds(tf))
        string identity = tfKey + "|" + source
        int lastTime = map.contains(z_consumed, identity) ? map.get(z_consumed, identity) : 0
        if eventTime > lastTime
            map.put(z_consumed, identity, eventTime)
            float lo = math.min(lower, upper)
            float hi = math.max(lower, upper)
            float sourceAtr = not na(audit) and not na(audit.atr) ? audit.atr : z_atr
            bool createdNow = not na(audit) and audit.known == time_close and audit.origin == time
            // A current origin has no pre-creation touch; delayed zones must pass this whole observed bar.
            bool viable = not (not na(audit) and audit.broken) and not f_z_broken(lo, hi, side, sourceAtr, close, createdNow ? close : high, createdNow ? close : low)
            if viable
                string tfToken = "|" + tfKey + "|"
                int match = -1
                float bestGap = 1e20
                float center = math.avg(lo, hi)
                if array.size(z_records) > 0
                    for index = 0 to array.size(z_records) - 1
                        z_Record record = array.get(z_records, index)
                        float gap = math.abs(center - math.avg(record.lo, record.hi))
                        bool overlaps = lo <= record.hi + z_band and hi >= record.lo - z_band
                        float mergedWidth = math.max(record.hi, hi) - math.min(record.lo, lo)
                        float mergeWidthLimit = math.max(z_atr * 1.20, math.max(record.hi - record.lo, hi - lo))
                        bool incomingCore = family == Z_FAMILY_SD or family == Z_FAMILY_OB or family == Z_FAMILY_QML or family == Z_FAMILY_FLIP
                        bool incomingLiquidity = family == Z_FAMILY_SWING or family == Z_FAMILY_LIQ or family == Z_FAMILY_IDM
                        bool sameLayer = incomingCore ? f_z_isDefendCore(record) : incomingLiquidity ? f_z_isLiquidityOnly(record) : not f_z_isDefendCore(record) and not f_z_isLiquidityOnly(record)
                        bool contained = lo >= record.lo and hi <= record.hi
                        bool historiesOK = record.historyComplete and not na(audit) and audit.complete and audit.departed and (audit.checked == time or audit.checked == time_close)
                        if historiesOK and record.side == side and sameLayer and contained and overlaps and gap <= z_atr * z_mergeATR and mergedWidth <= mergeWidthLimit and gap < bestGap
                            match := index
                            bestGap := gap
                if match >= 0
                    z_Record record = array.get(z_records, match)
                    // Preserve the first observed bounds; no widening from later evidence.
                    if not str.contains(record.tfKeys, tfToken)
                        record.tfKeys += tfToken
                        record.tfNames += "/" + f_tfName(tf)
                        record.tfCount += 1
                    record.maxTfSec := math.max(record.maxTfSec, tfSeconds)
                    if not f_z_has(record.families, family)
                        record.families += family
                    if not str.contains(record.names, source)
                        record.names += " + " + source
                    record.quality := math.max(record.quality, quality)
                    record.departureATR := math.max(record.departureATR, departureATR)
                    record.baseBars := record.baseBars == 0 ? baseBars : baseBars == 0 ? record.baseBars : math.min(record.baseBars, baseBars)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_DISP)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_LIQ)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_STRUCT)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_PD)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_CLEAN)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_SOURCE)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_IMBALANCE)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_NESTED)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_EQUAL)
                    record.tags := f_z_mergeTag(record.tags, tags, Z_TAG_IDM)
                    // Inherit the more conservative history; no fresh reset from confluence.
                    record.tests := math.max(record.tests, audit.tests)
                    // A later confluence may strengthen the record, but never makes an old/used zone fresh again.
                    array.set(z_records, match, record)
                else
                    bool complete = not na(audit) and audit.complete and (audit.checked == time or audit.checked == time_close)
                    bool departed = complete and audit.departed
                    int tests = complete ? audit.tests : 0
                    bool touching = complete and audit.touching
                    if not na(audit) and audit.checked <= time and departed
                        bool currentHit = low <= hi and high >= lo
                        if currentHit and not touching
                            tests += 1
                        touching := currentHit
                    string id = syminfo.tickerid + "|" + tfKey + "|" + source + "|" + str.tostring(side) + "|" + str.tostring(eventTime)
                    array.push(z_records, z_Record.new(lo, hi, side, tfToken, f_tfName(tf), 1, tfSeconds, family, source, bar_index, bar_index, tests, touching, quality, departureATR, tags, baseBars, id, not na(audit) ? audit.origin : eventTime, not na(audit) ? audit.known : time_close, time_close, sourceAtr, complete, departed))
                accepted := true
    accepted

// Closed-candle context object. It carries S/D, FVG, QML and liquidity candidates from each requested TF.
type z_Data
    float highPrev
    float lowPrev
    float closePrev
    int stamp
    float sourceATR
    int known
    float demandLo
    float demandHi
    int demandStamp
    int demandKind
    int demandBaseBars
    float demandQuality
    float demandDeparture
    int demandTags
    float supplyLo
    float supplyHi
    int supplyStamp
    int supplyKind
    int supplyBaseBars
    float supplyQuality
    float supplyDeparture
    int supplyTags
    float swingHigh
    int swingHighStamp
    float swingLow
    int swingLowStamp
    float bullFvgLo
    float bullFvgHi
    int bullFvgStamp
    float bullFvgDeparture
    float bearFvgLo
    float bearFvgHi
    int bearFvgStamp
    float bearFvgDeparture
    float bullQml
    int bullQmlStamp
    float bullQmlDeparture
    int bullQmlTags
    float bearQml
    int bearQmlStamp
    float bearQmlDeparture
    int bearQmlTags
    float eqHigh
    int eqHighStamp
    float eqLow
    int eqLowStamp
    float idmLow
    int idmLowStamp
    float idmHigh
    int idmHighStamp
    float wave50Demand
    int wave50DemandStamp
    float wave50Supply
    int wave50SupplyStamp
    z_Audit demandAudit
    z_Audit supplyAudit
    z_Audit bullQmlAudit
    z_Audit bearQmlAudit

f_z_data() =>
    float sourceAtr = ta.atr(14)[1]
    float safeAtr = math.max(nz(sourceAtr, high[1] - low[1]), syminfo.mintick)
    float range1 = math.max(high[1] - low[1], syminfo.mintick)
    float range2 = math.max(high[2] - low[2], syminfo.mintick)
    float range3 = math.max(high[3] - low[3], syminfo.mintick)
    float range4 = math.max(high[4] - low[4], syminfo.mintick)
    float body1 = math.abs(close[1] - open[1]) / range1
    float body2 = math.abs(close[2] - open[2]) / range2
    float body3 = math.abs(close[3] - open[3]) / range3
    float body4 = math.abs(close[4] - open[4]) / range4

    // Canonical one-base S/D patterns from FXTA terminology.
    bool compactBase = body2 <= 0.35
    bool leaveBull = close[1] > open[1] and body1 >= 0.52 and close[1] > high[2]
    bool leaveBear = close[1] < open[1] and body1 >= 0.52 and close[1] < low[2]
    bool rbr = compactBase and close[3] > open[3] and leaveBull
    bool dbr = compactBase and close[3] < open[3] and leaveBull
    bool rbd = compactBase and close[3] > open[3] and leaveBear
    bool dbd = compactBase and close[3] < open[3] and leaveBear

    // Keep the earlier multi-candle patterns as secondary candidates so useful history is not lost.
    bool fiveDemand = close[5] > open[5] and close[4] < open[4] and close[3] < open[3] and close[2] > open[2] and close[1] > open[1]
    bool fiveSupply = close[5] < open[5] and close[4] > open[4] and close[3] > open[3] and close[2] < open[2] and close[1] < open[1]
    bool threeDemand = close[3] > open[3] and (compactBase or close[2] < open[2]) and close[1] > open[1] and low[1] > low[2] and close[1] > high[2]
    bool threeSupply = close[3] < open[3] and (compactBase or close[2] > open[2]) and close[1] < open[1] and high[1] < high[2] and close[1] < low[2]
    bool weak4 = body4 < 0.30
    bool strongDemand = (close[4] < open[4] or weak4) and close[3] - open[3] > range3 * 0.60 and close[2] > open[2] and close[2] > close[3] and low[3] > low[4]
    bool strongSupply = (close[4] > open[4] or weak4) and open[3] - close[3] > range3 * 0.60 and close[2] < open[2] and close[2] < close[3] and high[3] < high[4]

    bool primaryDemand = rbr or dbr
    bool primarySupply = rbd or dbd
    float demandLo = primaryDemand ? low[2] : threeDemand ? low[2] : fiveDemand ? math.min(low[4], low[3]) : strongDemand ? low[3] : na
    float demandHi = primaryDemand ? math.max(open[2], close[2]) : threeDemand ? math.max(open[2], close[2]) : fiveDemand ? math.max(math.max(open[4], close[4]), math.max(open[3], close[3])) : strongDemand ? open[3] : na
    float supplyHi = primarySupply ? high[2] : threeSupply ? high[2] : fiveSupply ? math.max(high[4], high[3]) : strongSupply ? high[3] : na
    float supplyLo = primarySupply ? math.min(open[2], close[2]) : threeSupply ? math.min(open[2], close[2]) : fiveSupply ? math.min(math.min(open[4], close[4]), math.min(open[3], close[3])) : strongSupply ? open[3] : na
    int demandStamp = not na(demandLo) ? time[1] : na
    int supplyStamp = not na(supplyLo) ? time[1] : na
    int demandKind = rbr ? 1 : dbr ? 2 : not na(demandLo) ? 3 : 0
    int supplyKind = rbd ? 1 : dbd ? 2 : not na(supplyLo) ? 3 : 0
    int demandBaseBars = fiveDemand and not primaryDemand and not threeDemand ? 2 : not na(demandLo) ? 1 : 0
    int supplyBaseBars = fiveSupply and not primarySupply and not threeSupply ? 2 : not na(supplyLo) ? 1 : 0
    float demandDeparture = na(demandHi) ? 0.0 : math.max(0.0, high[1] - demandHi) / safeAtr
    float supplyDeparture = na(supplyLo) ? 0.0 : math.max(0.0, supplyLo - low[1]) / safeAtr
    bool demandSweep = not na(demandLo) and low[2] < math.min(low[3], low[4])
    bool supplySweep = not na(supplyHi) and high[2] > math.max(high[3], high[4])
    float priorStructureHigh = math.max(high[3], math.max(high[4], high[5]))
    float priorStructureLow = math.min(low[3], math.min(low[4], low[5]))
    bool demandStructure = not na(demandHi) and close[1] > priorStructureHigh
    bool supplyStructure = not na(supplyLo) and close[1] < priorStructureLow

    // Confirmed pivot registry for trend, QML, equal highs/lows and premium/discount.
    float pivotHigh = ta.pivothigh(high, 3, 3)
    float pivotLow = ta.pivotlow(low, 3, 3)
    float h0 = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)[1]
    float h1 = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)[1]
    float l0 = ta.valuewhen(not na(pivotLow), pivotLow, 0)[1]
    float l1 = ta.valuewhen(not na(pivotLow), pivotLow, 1)[1]
    int h0t = ta.valuewhen(not na(pivotHigh), time[3], 0)[1]
    int h1t = ta.valuewhen(not na(pivotHigh), time[3], 1)[1]
    int l0t = ta.valuewhen(not na(pivotLow), time[3], 0)[1]
    int l1t = ta.valuewhen(not na(pivotLow), time[3], 1)[1]
    bool haveRange = not na(h0) and not na(l0) and h0 > l0
    float equilibrium = haveRange ? math.avg(h0, l0) : na
    bool demandPD = haveRange and not na(demandHi) and demandHi <= equilibrium
    bool supplyPD = haveRange and not na(supplyLo) and supplyLo >= equilibrium

    float demandBaseQuality = primaryDemand ? 1.0 - body2 : fiveDemand ? 1.0 - (body3 + body4) * 0.5 : threeDemand ? 1.0 - body2 : strongDemand ? 1.0 - body4 : 0.0
    float supplyBaseQuality = primarySupply ? 1.0 - body2 : fiveSupply ? 1.0 - (body3 + body4) * 0.5 : threeSupply ? 1.0 - body2 : strongSupply ? 1.0 - body4 : 0.0
    bool demandClean = not na(demandLo) and demandDeparture >= 0.75 and demandBaseBars <= 2
    bool supplyClean = not na(supplyLo) and supplyDeparture >= 0.75 and supplyBaseBars <= 2
    bool demandSource = demandClean and demandStructure and demandDeparture >= 0.90
    bool supplySource = supplyClean and supplyStructure and supplyDeparture >= 0.90
    float demandQuality = math.max(0.0, math.min(1.0, 0.38 + demandBaseQuality * 0.38 + (demandStructure ? 0.10 : 0.0) + (demandSweep ? 0.08 : 0.0) + (primaryDemand ? 0.06 : 0.0)))
    float supplyQuality = math.max(0.0, math.min(1.0, 0.38 + supplyBaseQuality * 0.38 + (supplyStructure ? 0.10 : 0.0) + (supplySweep ? 0.08 : 0.0) + (primarySupply ? 0.06 : 0.0)))
    int demandTags = (demandDeparture >= 0.60 ? Z_TAG_DISP : 0) + (demandSweep ? Z_TAG_LIQ : 0) + (demandStructure ? Z_TAG_STRUCT : 0) + (demandPD ? Z_TAG_PD : 0) + (demandClean ? Z_TAG_CLEAN : 0) + (demandSource ? Z_TAG_SOURCE : 0) + (low[1] > high[3] ? Z_TAG_IMBALANCE : 0)
    int supplyTags = (supplyDeparture >= 0.60 ? Z_TAG_DISP : 0) + (supplySweep ? Z_TAG_LIQ : 0) + (supplyStructure ? Z_TAG_STRUCT : 0) + (supplyPD ? Z_TAG_PD : 0) + (supplyClean ? Z_TAG_CLEAN : 0) + (supplySource ? Z_TAG_SOURCE : 0) + (high[1] < low[3] ? Z_TAG_IMBALANCE : 0)

    // Three-candle FVG/imbalance. It is a reaction layer unless merged with a stronger defend POI.
    bool bullFvg = low[1] > high[3]
    bool bearFvg = high[1] < low[3]
    float bullFvgLo = bullFvg ? high[3] : na
    float bullFvgHi = bullFvg ? low[1] : na
    float bearFvgLo = bearFvg ? high[1] : na
    float bearFvgHi = bearFvg ? low[3] : na
    float bullFvgDeparture = bullFvg ? (low[1] - high[3]) / safeAtr : 0.0
    float bearFvgDeparture = bearFvg ? (low[3] - high[1]) / safeAtr : 0.0

    // Quasimodo approximation from four confirmed alternating pivots.
    bool commonQmShape = not na(h0) and not na(h1) and not na(l0) and not na(l1) and not na(h0t) and not na(h1t) and not na(l0t) and not na(l1t) and h0 > h1 and l0 < l1
    bool bullQm = commonQmShape and l1t < h1t and h1t < l0t and l0t < h0t
    bool bearQm = commonQmShape and h1t < l1t and l1t < h0t and h0t < l0t
    float bullQml = bullQm ? l1 : na
    float bearQml = bearQm ? h1 : na
    int bullQmlStamp = bullQm ? h0t : na
    int bearQmlStamp = bearQm ? l0t : na
    float bullQmlDeparture = bullQm ? math.max(0.0, h0 - h1) / safeAtr : 0.0
    float bearQmlDeparture = bearQm ? math.max(0.0, l1 - l0) / safeAtr : 0.0
    bool bullNested = bullQm and not na(demandLo) and bullQml >= demandLo - safeAtr * 0.10 and bullQml <= demandHi + safeAtr * 0.10
    bool bearNested = bearQm and not na(supplyLo) and bearQml >= supplyLo - safeAtr * 0.10 and bearQml <= supplyHi + safeAtr * 0.10
    int bullQmlTags = Z_TAG_STRUCT + (bullQmlDeparture >= 0.60 ? Z_TAG_DISP : 0) + (haveRange and bullQml <= equilibrium ? Z_TAG_PD : 0) + (bullNested ? Z_TAG_NESTED : 0)
    int bearQmlTags = Z_TAG_STRUCT + (bearQmlDeparture >= 0.60 ? Z_TAG_DISP : 0) + (haveRange and bearQml >= equilibrium ? Z_TAG_PD : 0) + (bearNested ? Z_TAG_NESTED : 0)

    // Equal highs/lows are explicit liquidity pools, not defend zones.
    float eqTol = safeAtr * 0.16
    bool equalHigh = not na(h0) and not na(h1) and not na(h0t) and not na(h1t) and h0t != h1t and math.abs(h0 - h1) <= eqTol
    bool equalLow = not na(l0) and not na(l1) and not na(l0t) and not na(l1t) and l0t != l1t and math.abs(l0 - l1) <= eqTol
    float eqHigh = equalHigh ? math.avg(h0, h1) : na
    float eqLow = equalLow ? math.avg(l0, l1) : na
    int eqHighStamp = equalHigh ? math.max(h0t, h1t) : na
    int eqLowStamp = equalLow ? math.max(l0t, l1t) : na

    // Valid-pullback style inducement: a local probe followed by overlap/close through the prior candle.
    bool bullIdm = low[2] < low[3] and close[1] > high[2]
    bool bearIdm = high[2] > high[3] and close[1] < low[2]
    float idmLow = bullIdm ? low[2] : na
    float idmHigh = bearIdm ? high[2] : na
    int idmLowStamp = bullIdm ? time[1] : na
    int idmHighStamp = bearIdm ? time[1] : na

    // 50% of wave in an established HH/HL or LH/LL context. Context layer only.
    bool upTrend = not na(h0) and not na(h1) and not na(l0) and not na(l1) and h0 > h1 and l0 > l1
    bool downTrend = not na(h0) and not na(h1) and not na(l0) and not na(l1) and h0 < h1 and l0 < l1
    float wave50 = haveRange ? math.avg(h0, l0) : na
    int waveStamp = haveRange ? math.max(h0t, l0t) : na
    float wave50Demand = upTrend and close[1] >= wave50 ? wave50 : na
    float wave50Supply = downTrend and close[1] <= wave50 ? wave50 : na

    int demandOffset = primaryDemand or threeDemand ? 2 : fiveDemand ? 4 : strongDemand ? 3 : na
    int supplyOffset = primarySupply or threeSupply ? 2 : fiveSupply ? 4 : strongSupply ? 3 : na
    z_Audit demandAudit = f_z_audit(demandLo, demandHi, 1, not na(demandOffset) ? time[demandOffset] : na, demandOffset, 1, sourceAtr, false)
    z_Audit supplyAudit = f_z_audit(supplyLo, supplyHi, -1, not na(supplyOffset) ? time[supplyOffset] : na, supplyOffset, 1, sourceAtr, false)
    float qBand = math.max(syminfo.mintick * 2.0, nz(sourceAtr, safeAtr) * 0.06)
    z_Audit bullAudit = f_z_qmAudit(bullQml - qBand, bullQml + qBand, 1, l1t, l0t, h1, bullQmlStamp, sourceAtr)
    z_Audit bearAudit = f_z_qmAudit(bearQml - qBand, bearQml + qBand, -1, h1t, h0t, l1, bearQmlStamp, sourceAtr)
    z_Data.new(high[1], low[1], close[1], time[1], sourceAtr, time_close[1], demandLo, demandHi, demandStamp, demandKind, demandBaseBars, demandQuality, demandDeparture, demandTags, supplyLo, supplyHi, supplyStamp, supplyKind, supplyBaseBars, supplyQuality, supplyDeparture, supplyTags, h0, h0t, l0, l0t, bullFvgLo, bullFvgHi, bullFvg ? time[1] : na, bullFvgDeparture, bearFvgLo, bearFvgHi, bearFvg ? time[1] : na, bearFvgDeparture, bullQml, bullQmlStamp, bullQmlDeparture, bullQmlTags, bearQml, bearQmlStamp, bearQmlDeparture, bearQmlTags, eqHigh, eqHighStamp, eqLow, eqLowStamp, idmLow, idmLowStamp, idmHigh, idmHighStamp, wave50Demand, not na(wave50Demand) ? waveStamp : na, wave50Supply, not na(wave50Supply) ? waveStamp : na, demandAudit, supplyAudit, bullAudit, bearAudit)

f_z_standardTf(int slot) =>
    // Human-readable planning ladder. The current chart TF is already source slot 0,
    // so these are the next higher standard contexts rather than arbitrary 45m/90m steps.
    string result = "1D"
    if chartSec <= 60
        result := slot == 1 ? "5" : slot == 2 ? "15" : slot == 3 ? "60" : "240"
    else if chartSec <= 300
        result := slot == 1 ? "15" : slot == 2 ? "60" : slot == 3 ? "240" : "1D"
    else if chartSec <= 900
        result := slot == 1 ? "60" : slot == 2 ? "240" : slot == 3 ? "1D" : "1W"
    else if chartSec <= 3600
        result := slot == 1 ? "240" : slot == 2 ? "1D" : slot == 3 ? "1W" : "1M"
    else if chartSec <= 14400
        result := slot == 1 ? "1D" : slot == 2 ? "1W" : slot == 3 ? "1M" : "3M"
    else if chartSec < 86400
        result := slot == 1 ? "1D" : slot == 2 ? "1W" : slot == 3 ? "1M" : "3M"
    else
        result := slot == 1 ? "1W" : slot == 2 ? "1M" : slot == 3 ? "3M" : "12M"
    result

string zoneSetName = z_set == "AUTO" ? ("AUTO " + f_tfName(timeframe.period)) : z_set
bool z_standardAuto = z_set == "AUTO" and z_autoTfMode == "Standard ladder"
string z_tf1 = z_set == "AUTO" ? (z_standardAuto ? f_z_standardTf(1) : timeframe.period) : zoneSetName == "S · Scalp" ? "5" : zoneSetName == "M · Day" ? "15" : zoneSetName == "L · Swing" ? "30" : "60"
string z_tf2 = z_set == "AUTO" ? (z_standardAuto ? f_z_standardTf(2) : f_relativeTf(3.0)) : zoneSetName == "S · Scalp" ? "15" : zoneSetName == "M · Day" ? "30" : zoneSetName == "L · Swing" ? "60" : "240"
string z_tf3 = z_set == "AUTO" ? (z_standardAuto ? f_z_standardTf(3) : f_relativeTf(6.0)) : zoneSetName == "S · Scalp" ? "30" : zoneSetName == "M · Day" ? "60" : zoneSetName == "L · Swing" ? "240" : "D"
string z_tf4 = z_set == "AUTO" ? (z_standardAuto ? f_z_standardTf(4) : f_relativeTf(12.0)) : zoneSetName == "S · Scalp" ? "60" : zoneSetName == "M · Day" ? "240" : zoneSetName == "L · Swing" ? "D" : "W"

var array<string> z_sourceTFs = array.from(timeframe.period, z_tf1, z_tf2, z_tf3, z_tf4, contextTf)
array<z_Data> z_sourcePackets = array.new<z_Data>(6, na)
var array<int> z_seenPackets = array.new_int(6, na)
if zoneEnabled
    for sourceIndex = 0 to 5
        string sourceTf = array.get(z_sourceTFs, sourceIndex)
        bool enabledSlot = confirmationRun and (sourceIndex == 0 ? z_chartZones : sourceIndex < 5 ? z_mtf and sourceIndex <= z_runtimeContexts : z_mtf and (i_dailyMap or z_dailyPivots))
        // Reuse a matching source slot within this execution, including capped/rounded TFs.
        int duplicate = -1
        if sourceIndex > 0
            for j = 0 to sourceIndex - 1
                if timeframe.in_seconds(array.get(z_sourceTFs, j)) == timeframe.in_seconds(sourceTf) and not na(array.get(z_sourcePackets, j))
                    duplicate := j
                    break
        if enabledSlot and duplicate >= 0
            array.set(z_sourcePackets, sourceIndex, array.get(z_sourcePackets, duplicate))
            enabledSlot := false
        if enabledSlot and timeframe.in_seconds(sourceTf) >= chartSec
            z_Data packet = request.security(syminfo.tickerid, sourceTf, f_z_data(), lookahead=barmerge.lookahead_on, calc_bars_count=1000)
            array.set(z_sourcePackets, sourceIndex, packet)
f_z_feed(z_Data data, string tf, bool pivots, int depth) =>
    if not na(data)
        float sourceBand = math.max(syminfo.mintick * 2.0, nz(data.sourceATR, z_atr) * 0.06)
        if pivots
            float pp = (data.highPrev + data.lowPrev + data.closePrev) / 3.0
            float span = data.highPrev - data.lowPrev
            if not na(pp)
                float s1 = 2.0 * pp - data.highPrev
                float s2 = pp - span
                float r1 = 2.0 * pp - data.lowPrev
                float r2 = pp + span
                f_z_submit(s1 - sourceBand, s1 + sourceBand, 1, tf, "P-S1", data.stamp, Z_FAMILY_PIVOT, 0.25, 0.0, 0, 0)
                f_z_submit(s2 - sourceBand, s2 + sourceBand, 1, tf, "P-S2", data.stamp, Z_FAMILY_PIVOT, 0.28, 0.0, 0, 0)
                f_z_submit(r1 - sourceBand, r1 + sourceBand, -1, tf, "P-R1", data.stamp, Z_FAMILY_PIVOT, 0.25, 0.0, 0, 0)
                f_z_submit(r2 - sourceBand, r2 + sourceBand, -1, tf, "P-R2", data.stamp, Z_FAMILY_PIVOT, 0.28, 0.0, 0, 0)
                if depth >= 3
                    float s3 = data.lowPrev - 2.0 * (data.highPrev - pp)
                    float r3 = data.highPrev + 2.0 * (pp - data.lowPrev)
                    f_z_submit(s3 - sourceBand, s3 + sourceBand, 1, tf, "P-S3", data.stamp, Z_FAMILY_PIVOT, 0.26, 0.0, 0, 0)
                    f_z_submit(r3 - sourceBand, r3 + sourceBand, -1, tf, "P-R3", data.stamp, Z_FAMILY_PIVOT, 0.26, 0.0, 0, 0)
                if depth >= 4
                    float s4 = data.lowPrev - 3.0 * (data.highPrev - pp)
                    float r4 = data.highPrev + 3.0 * (pp - data.lowPrev)
                    f_z_submit(s4 - sourceBand, s4 + sourceBand, 1, tf, "P-S4", data.stamp, Z_FAMILY_PIVOT, 0.24, 0.0, 0, 0)
                    f_z_submit(r4 - sourceBand, r4 + sourceBand, -1, tf, "P-R4", data.stamp, Z_FAMILY_PIVOT, 0.24, 0.0, 0, 0)
        if z_liquidity
            f_z_submit(data.swingLow - sourceBand * 0.55, data.swingLow + sourceBand * 0.55, 1, tf, "SW-L", data.swingLowStamp, Z_FAMILY_SWING, 0.38, 0.0, 0, 0)
            f_z_submit(data.swingHigh - sourceBand * 0.55, data.swingHigh + sourceBand * 0.55, -1, tf, "SW-H", data.swingHighStamp, Z_FAMILY_SWING, 0.38, 0.0, 0, 0)
            f_z_submit(data.eqLow - sourceBand * 0.45, data.eqLow + sourceBand * 0.45, 1, tf, "EQL", data.eqLowStamp, Z_FAMILY_LIQ, 0.55, 0.0, Z_TAG_EQUAL, 0)
            f_z_submit(data.eqHigh - sourceBand * 0.45, data.eqHigh + sourceBand * 0.45, -1, tf, "EQH", data.eqHighStamp, Z_FAMILY_LIQ, 0.55, 0.0, Z_TAG_EQUAL, 0)
        if z_inducement
            f_z_submit(data.idmLow - sourceBand * 0.40, data.idmLow + sourceBand * 0.40, 1, tf, "IDM-L", data.idmLowStamp, Z_FAMILY_IDM, 0.50, 0.0, Z_TAG_IDM, 0)
            f_z_submit(data.idmHigh - sourceBand * 0.40, data.idmHigh + sourceBand * 0.40, -1, tf, "IDM-H", data.idmHighStamp, Z_FAMILY_IDM, 0.50, 0.0, Z_TAG_IDM, 0)
        if z_smartSD
            string demandSource = data.demandKind == 1 ? "SD-RBR" : data.demandKind == 2 ? "SD-DBR" : "SD-D"
            string supplySource = data.supplyKind == 1 ? "SD-RBD" : data.supplyKind == 2 ? "SD-DBD" : "SD-S"
            f_z_submit(data.demandLo, data.demandHi, 1, tf, demandSource, data.demandStamp, Z_FAMILY_SD, data.demandQuality, data.demandDeparture, data.demandTags, data.demandBaseBars, data.demandAudit)
            f_z_submit(data.supplyLo, data.supplyHi, -1, tf, supplySource, data.supplyStamp, Z_FAMILY_SD, data.supplyQuality, data.supplyDeparture, data.supplyTags, data.supplyBaseBars, data.supplyAudit)
        if z_fvg
            f_z_submit(data.bullFvgLo, data.bullFvgHi, 1, tf, "FVG-B", data.bullFvgStamp, Z_FAMILY_FVG, 0.46, data.bullFvgDeparture, Z_TAG_IMBALANCE + (data.bullFvgDeparture >= 0.35 ? Z_TAG_DISP : 0), 0, z_Audit.new(origin=data.stamp, known=data.known, checked=data.known, departed=true, complete=not na(data.sourceATR), atr=data.sourceATR))
            f_z_submit(data.bearFvgLo, data.bearFvgHi, -1, tf, "FVG-S", data.bearFvgStamp, Z_FAMILY_FVG, 0.46, data.bearFvgDeparture, Z_TAG_IMBALANCE + (data.bearFvgDeparture >= 0.35 ? Z_TAG_DISP : 0), 0, z_Audit.new(origin=data.stamp, known=data.known, checked=data.known, departed=true, complete=not na(data.sourceATR), atr=data.sourceATR))
        if z_qml
            f_z_submit(data.bullQml - sourceBand, data.bullQml + sourceBand, 1, tf, "QML-B", data.bullQmlStamp, Z_FAMILY_QML, 0.78, data.bullQmlDeparture, data.bullQmlTags, 1, data.bullQmlAudit)
            f_z_submit(data.bearQml - sourceBand, data.bearQml + sourceBand, -1, tf, "QML-S", data.bearQmlStamp, Z_FAMILY_QML, 0.78, data.bearQmlDeparture, data.bearQmlTags, 1, data.bearQmlAudit)
        if z_wave50
            f_z_submit(data.wave50Demand - sourceBand, data.wave50Demand + sourceBand, 1, tf, "W50-D", data.wave50DemandStamp, Z_FAMILY_WAVE, 0.40, 0.0, Z_TAG_PD, 0)
            f_z_submit(data.wave50Supply - sourceBand, data.wave50Supply + sourceBand, -1, tf, "W50-S", data.wave50SupplyStamp, Z_FAMILY_WAVE, 0.40, 0.0, Z_TAG_PD, 0)
    true

// Chart structure events and breaker/flip zones.
float z_chartHigh = ta.pivothigh(high, z_swingLen, z_swingLen)
float z_chartLow = ta.pivotlow(low, z_swingLen, z_swingLen)
var float z_pendingHigh = na
var float z_pendingLow = na
var int z_pendingHighTime = na
var int z_pendingLowTime = na
var int zoneStructure = 0
var int zoneStructureBar = na
bool zoneBosUp = false
bool zoneBosDown = false
bool zoneChochUp = false
bool zoneChochDown = false
float z_volumePivot = ta.pivothigh(volume, z_obLen, z_obLen)
float z_recentHigh = ta.highest(high, z_obLen)
float z_recentLow = ta.lowest(low, z_obLen)
float z_closeLowSinceOB = ta.lowest(close, z_obLen + 1)
float z_closeHighSinceOB = ta.highest(close, z_obLen + 1)
var int z_obSide = 0

if zoneEnabled and barstate.isconfirmed and not na(z_atr)
    // Remove broken/expired records and count actual re-entries into zones.
    if array.size(z_records) > 0
        int index = array.size(z_records) - 1
        while index >= 0
            z_Record record = array.get(z_records, index)
            bool broken = f_z_broken(record.lo, record.hi, record.side, record.sourceAtr, close, high, low)
            bool expired = bar_index - record.evidenceBar > z_maxAge
            if broken or expired
                array.remove(z_records, index)
            else if bar_index > record.bornBar
                bool touching = low <= record.hi and high >= record.lo
                if record.departed
                    if touching and not record.wasTouching
                        record.tests += 1
                    record.wasTouching := touching
                else if record.historyComplete and (record.side == 1 ? close > record.hi : close < record.lo)
                    record.departed := true
                    record.wasTouching := false
                array.set(z_records, index, record)
            index -= 1

    for i = 0 to 5
        z_Data packet = array.get(z_sourcePackets, i)
        int previousStamp = array.get(z_seenPackets, i)
        if not na(packet) and (na(previousStamp) or packet.stamp != previousStamp)
            string tf = array.get(z_sourceTFs, i)
            f_z_feed(packet, tf, i == 5 and z_dailyPivots, z_pivotLevels)
            array.set(z_seenPackets, i, packet.stamp)

    if z_structureOn or z_flip
        if not na(z_pendingHigh) and close > z_pendingHigh
            bool reversal = zoneStructure == -1
            zoneBosUp := z_structureOn and not reversal
            zoneChochUp := z_structureOn and reversal
            zoneStructure := 1
            zoneStructureBar := bar_index
            if z_flip
                float departure = math.max(0.0, close - z_pendingHigh) / math.max(z_atr, syminfo.mintick)
                int tags = Z_TAG_STRUCT + (departure >= 0.55 ? Z_TAG_DISP : 0) + (departure >= 0.75 ? Z_TAG_CLEAN : 0)
                f_z_submit(z_pendingHigh - z_atr * 0.18, z_pendingHigh + z_atr * 0.18, 1, timeframe.period, "FLIP-UP", time, Z_FAMILY_FLIP, 0.70, departure, tags, 1, f_z_audit(z_pendingHigh - z_atr * 0.18, z_pendingHigh + z_atr * 0.18, 1, time, 0, 0, z_atr, close > z_pendingHigh + z_atr * 0.18))
            z_pendingHigh := na
        if not na(z_pendingLow) and close < z_pendingLow
            bool reversal = zoneStructure == 1
            zoneBosDown := z_structureOn and not reversal
            zoneChochDown := z_structureOn and reversal
            zoneStructure := -1
            zoneStructureBar := bar_index
            if z_flip
                float departure = math.max(0.0, z_pendingLow - close) / math.max(z_atr, syminfo.mintick)
                int tags = Z_TAG_STRUCT + (departure >= 0.55 ? Z_TAG_DISP : 0) + (departure >= 0.75 ? Z_TAG_CLEAN : 0)
                f_z_submit(z_pendingLow - z_atr * 0.18, z_pendingLow + z_atr * 0.18, -1, timeframe.period, "FLIP-DOWN", time, Z_FAMILY_FLIP, 0.70, departure, tags, 1, f_z_audit(z_pendingLow - z_atr * 0.18, z_pendingLow + z_atr * 0.18, -1, time, 0, 0, z_atr, close < z_pendingLow - z_atr * 0.18))
            z_pendingLow := na
        if not na(z_chartHigh)
            z_pendingHigh := z_chartHigh
            z_pendingHighTime := time[z_swingLen]
            if z_liquidity
                f_z_submit(z_chartHigh - z_band, z_chartHigh + z_band, -1, timeframe.period, "CHART-SW-H", z_pendingHighTime, Z_FAMILY_SWING, 0.36, 0.0, 0, 0)
        if not na(z_chartLow)
            z_pendingLow := z_chartLow
            z_pendingLowTime := time[z_swingLen]
            if z_liquidity
                f_z_submit(z_chartLow - z_band, z_chartLow + z_band, 1, timeframe.period, "CHART-SW-L", z_pendingLowTime, Z_FAMILY_SWING, 0.36, 0.0, 0, 0)

    if z_ob
        z_obSide := high[z_obLen] > z_recentHigh ? -1 : low[z_obLen] < z_recentLow ? 1 : z_obSide
        if not na(z_volumePivot)
            if z_obSide == 1 and z_closeLowSinceOB >= low[z_obLen]
                float obMid = math.avg(low[z_obLen], hl2[z_obLen])
                float departure = math.max(0.0, close - obMid) / math.max(z_atr, syminfo.mintick)
                int tags = (departure >= 0.60 ? Z_TAG_DISP : 0) + (departure >= 0.85 ? Z_TAG_CLEAN : 0)
                f_z_submit(low[z_obLen], hl2[z_obLen], 1, timeframe.period, "OB-UP", time[z_obLen], Z_FAMILY_OB, 0.74, departure, tags, 1, f_z_audit(low[z_obLen], hl2[z_obLen], 1, time[z_obLen], z_obLen, 0, z_atr[z_obLen], false))
            if z_obSide == -1 and z_closeHighSinceOB <= high[z_obLen]
                float obMid = math.avg(hl2[z_obLen], high[z_obLen])
                float departure = math.max(0.0, obMid - close) / math.max(z_atr, syminfo.mintick)
                int tags = (departure >= 0.60 ? Z_TAG_DISP : 0) + (departure >= 0.85 ? Z_TAG_CLEAN : 0)
                f_z_submit(hl2[z_obLen], high[z_obLen], -1, timeframe.period, "OB-DOWN", time[z_obLen], Z_FAMILY_OB, 0.74, departure, tags, 1, f_z_audit(hl2[z_obLen], high[z_obLen], -1, time[z_obLen], z_obLen, 0, z_atr[z_obLen], false))

    if array.size(z_candidates) > 0
        for candidate in z_candidates
            f_z_apply(candidate.lower, candidate.upper, candidate.side, candidate.tf, candidate.source, candidate.eventTime, candidate.family, candidate.quality, candidate.departureATR, candidate.tags, candidate.baseBars, candidate.audit)
        array.clear(z_candidates)

    while array.size(z_records) > z_runtimeCapacity
        int drop = -1
        float weakest = 1e20
        for i = 0 to array.size(z_records) - 1
            z_Record item = array.get(z_records, i)
            if item.id != z_planZoneId and item.id != z_signalZoneId
                float pruneScore = na(item.cachedScore) ? f_z_score(item) : item.cachedScore
                float keepRank = pruneScore - math.abs(close - math.avg(item.lo, item.hi)) / math.max(z_atr, syminfo.mintick)
                if keepRank < weakest
                    weakest := keepRank
                    drop := i
        if drop < 0
            break
        array.remove(z_records, drop)

// Cache once per execution AFTER all registry mutations. Live preview gets a fresh cache each tick.
if array.size(z_records) > 0
    for i = 0 to array.size(z_records) - 1
        z_Record item = array.get(z_records, i)
        item.cachedScore := f_z_score(item)
        item.cachedRole := f_z_role(item, item.cachedScore)

f_z_cachedScore(z_Record item) =>
    item.cachedScore

f_z_cachedRole(z_Record item, float score) =>
    item.cachedRole

// Primary confirmation levels are selected only from defend POIs. Liquidity levels are never entry confirmation by themselves.
float zoneSupport = na
float zoneResistance = na
float zoneSupportScore = na
float zoneResistanceScore = na
int zoneSupportTFs = 0
int zoneResistanceTFs = 0
int zoneActiveCount = array.size(z_records)
int zoneMajorCount = 0
int zoneReactionCount = 0
int zoneLiquidityCount = 0
bool zoneNearSupport = false
bool zoneNearResistance = false
bool zoneReady = zoneEnabled and not na(z_atr) and bar_index >= math.max(z_obLen * 2, z_swingLen * 2)
float z_supportGap = 1e20
float z_resistanceGap = 1e20
int zoneSupportIndex = -1
int zoneResistanceIndex = -1
float z_supportRank = -1e20
float z_resistanceRank = -1e20
if zoneEnabled and array.size(z_records) > 0
    for index = 0 to array.size(z_records) - 1
        z_Record record = array.get(z_records, index)
        float score = f_z_cachedScore(record)
        int role = f_z_cachedRole(record, score)
        zoneMajorCount += role == Z_ROLE_MAJOR ? 1 : 0
        zoneReactionCount += role == Z_ROLE_REACTION and score >= z_reactionMinScore ? 1 : 0
        zoneLiquidityCount += role == Z_ROLE_LIQUIDITY ? 1 : 0
        bool actionable = f_z_actionable(record, score)
        if actionable and record.side == 1 and record.lo <= close
            float gap = math.max(0.0, close - record.hi)
            float rank = score - gap / math.max(z_atr, syminfo.mintick) * 3.0
            if gap < z_supportGap or (gap == z_supportGap and rank > z_supportRank)
                zoneSupportIndex := index
                z_supportRank := rank
                z_supportGap := gap
                zoneSupport := f_z_reference(record)
                zoneSupportScore := score
                zoneSupportTFs := record.tfCount
        if actionable and record.side == -1 and record.hi >= close
            float gap = math.max(0.0, record.lo - close)
            float rank = score - gap / math.max(z_atr, syminfo.mintick) * 3.0
            if gap < z_resistanceGap or (gap == z_resistanceGap and rank > z_resistanceRank)
                zoneResistanceIndex := index
                z_resistanceRank := rank
                z_resistanceGap := gap
                zoneResistance := f_z_reference(record)
                zoneResistanceScore := score
                zoneResistanceTFs := record.tfCount
    zoneNearSupport := not na(zoneSupport) and z_supportGap <= z_atr * z_nearATR
    zoneNearResistance := not na(zoneResistance) and z_resistanceGap <= z_atr * z_nearATR

// ============================================================================
// Sessions, confluence decision, presentation and one alert dispatcher.
// ============================================================================
const string SES_GROUP = "09 · Sessions / ช่วงตลาด"
bool sesLondon = input.bool(true, "London", inline="ses1", group=SES_GROUP, display=display.none)
string sesLondonHours = input.session("0800-1700", "Local hours", inline="ses1", group=SES_GROUP, display=display.none)
bool sesNewYork = input.bool(true, "New York", inline="ses2", group=SES_GROUP, display=display.none)
string sesNewYorkHours = input.session("0800-1700", "Local hours", inline="ses2", group=SES_GROUP, display=display.none)
bool sesTokyo = input.bool(false, "Tokyo", inline="ses3", group=SES_GROUP, display=display.none)
string sesTokyoHours = input.session("0900-1800", "Local hours", inline="ses3", group=SES_GROUP, display=display.none)
bool sesSydney = input.bool(false, "Sydney", inline="ses4", group=SES_GROUP, display=display.none)
string sesSydneyHours = input.session("0800-1700", "Local hours", inline="ses4", group=SES_GROUP, display=display.none)

// All four calls run consistently. Session validity is limited to intraday charts.
bool sesL = timeframe.isintraday and sesLondon and not na(time(timeframe.period, sesLondonHours + ":23456", "Europe/London"))
bool sesN = timeframe.isintraday and sesNewYork and not na(time(timeframe.period, sesNewYorkHours + ":23456", "America/New_York"))
bool sesT = timeframe.isintraday and sesTokyo and not na(time(timeframe.period, sesTokyoHours + ":23456", "Asia/Tokyo"))
bool sesS = timeframe.isintraday and sesSydney and not na(time(timeframe.period, sesSydneyHours + ":23456", "Australia/Sydney"))
bool sesAny = sesL or sesN or sesT or sesS
string sesName = (sesL ? "LDN " : "") + (sesN ? "NY " : "") + (sesT ? "TKY " : "") + (sesS ? "SYD " : "")
sesName := not timeframe.isintraday ? "N/A · intraday only" : sesName == "" ? "Outside selected" : sesName
bool sesOpenL = sesL and not sesL[1]
bool sesOpenN = sesN and not sesN[1]
bool sesOpenT = sesT and not sesT[1]
bool sesOpenS = sesS and not sesS[1]


// Only new source events can trigger. Pairing never emits on a bar with no event.
int x_sinceEbwL = ta.barssince(sigEbwLong)
int x_sinceEbwS = ta.barssince(sigEbwShort)
int x_sinceWtL = ta.barssince(sigWtLong)
int x_sinceWtS = ta.barssince(sigWtShort)
bool x_pairL = (sigEbwLong or sigWtLong) and not na(x_sinceEbwL) and not na(x_sinceWtL) and x_sinceEbwL <= x_pairWindow and x_sinceWtL <= x_pairWindow
bool x_pairS = (sigEbwShort or sigWtShort) and not na(x_sinceEbwS) and not na(x_sinceWtS) and x_sinceEbwS <= x_pairWindow and x_sinceWtS <= x_pairWindow
bool x_rawL = switch x_trigger
    "Pullback + EBW / WT" => i_pullL or sigEbwLong or sigWtLong
    "Pullback only" => i_pullL
    "EBW only" => sigEbwLong
    "WaveTrend only" => sigWtLong
    "EBW + WaveTrend" => x_pairL
    => sigEbwLong or sigWtLong
bool x_rawS = switch x_trigger
    "Pullback + EBW / WT" => i_pullS or sigEbwShort or sigWtShort
    "Pullback only" => i_pullS
    "EBW only" => sigEbwShort
    "WaveTrend only" => sigWtShort
    "EBW + WaveTrend" => x_pairS
    => sigEbwShort or sigWtShort

float x_atr = ta.atr(14)
bool x_trendL = close > sigSlowMA and sigFastMA > sigSlowMA
bool x_trendS = close < sigSlowMA and sigFastMA < sigSlowMA
// Select a real touched defend zone for the zone branch. A remote high score cannot hide it.
f_x_rejected(int index, int side) =>
    bool rejected = false
    if index >= 0
        z_Record record = array.get(z_records, index)
        rejected := bar_index > record.bornBar and low <= record.hi and high >= record.lo and (side == 1 ? close > record.hi and close > open : close < record.lo and close < open)
    rejected

f_x_zone(int side) =>
    int best = -1
    float bestRank = -1e20
    if array.size(z_records) > 0
        for i = 0 to array.size(z_records) - 1
            z_Record record = array.get(z_records, i)
            float score = record.cachedScore
            bool properSide = side == 1 ? record.lo <= close : record.hi >= close
            float gap = side == 1 ? math.max(0.0, close - record.hi) : math.max(0.0, record.lo - close)
            bool eligible = record.side == side and properSide and f_z_actionable(record, score) and gap <= z_atr * z_nearATR and (not x_rejection or f_x_rejected(i, side))
            float rank = score - gap / math.max(z_atr, syminfo.mintick) * 3.0
            if eligible and rank > bestRank
                best := i
                bestRank := rank
    best

int x_zoneIndexL = f_x_zone(1)
int x_zoneIndexS = f_x_zone(-1)
bool x_zoneL = x_zoneIndexL >= 0
bool x_zoneS = x_zoneIndexS >= 0
bool x_structureFresh = not na(zoneStructureBar) and (x_structureAge == 0 or bar_index - zoneStructureBar <= x_structureAge)
bool x_structureL = zoneStructure == 1 and x_structureFresh
bool x_structureS = zoneStructure == -1 and x_structureFresh
bool x_confirmL = x_mode == "Source triggers" ? true : x_mode == "Balanced" ? x_trendL and (x_zoneL or x_structureL) : x_trendL and x_zoneL and x_structureL
bool x_confirmS = x_mode == "Source triggers" ? true : x_mode == "Balanced" ? x_trendS and (x_zoneS or x_structureS) : x_trendS and x_zoneS and x_structureS

// First opposing POI edge, including weaker reaction zones. Never use score ranking or midpoint for room.
f_x_obstacle(int side, float price) =>
    float nearest = na
    if array.size(z_records) > 0
        for i = 0 to array.size(z_records) - 1
            z_Record record = array.get(z_records, i)
            float score = f_z_cachedScore(record)
            bool defend = f_z_isDefendCore(record) or f_z_has(record.families, Z_FAMILY_FVG)
            if record.side == -side and defend and score >= z_reactionMinScore
                bool ahead = side == 1 ? record.hi >= price : record.lo <= price
                float distance = side == 1 ? math.max(0.0, record.lo - price) : math.max(0.0, price - record.hi)
                if ahead and (na(nearest) or distance < nearest)
                    nearest := distance
    nearest

float x_spaceL = f_x_obstacle(1, close)
float x_spaceS = f_x_obstacle(-1, close)
bool x_roomL = not x_spaceFilter or (zoneEnabled and (na(x_spaceL) or x_spaceL >= x_atr * x_minSpace))
bool x_roomS = not x_spaceFilter or (zoneEnabled and (na(x_spaceS) or x_spaceS >= x_atr * x_minSpace))
float x_range = math.max(high - low, syminfo.mintick)
float x_bodyRatio = math.abs(close - open) / x_range
float x_trueRange = ta.tr(true)
bool x_shockOK = not x_shockFilter or (not na(x_atr[1]) and x_atr[1] > 0 and x_trueRange <= x_atr[1] * x_maxRangeATR)
bool x_qualityL = x_shockOK and (not x_candleFilter or (close > open and x_bodyRatio >= x_minBody))
bool x_qualityS = x_shockOK and (not x_candleFilter or (close < open and x_bodyRatio >= x_minBody))

bool x_sessionOK = not timeframe.isintraday or not x_sessionFilter or sesAny
var int x_lastSignalBar = na
bool x_cooldownOK = na(x_lastSignalBar) or bar_index - x_lastSignalBar >= x_cooldown
// Readiness follows the selected source, so an unavailable optional module does
// not silence an unrelated ready source. Filters fail visibly when disabled.
bool x_ebwReady = s_ebwOn and s_ebwReady
bool x_wtReady = s_wtOn and not na(s_wt2) and not na(s_chartRsi)
bool x_sourceReady = switch x_trigger
    "Pullback + EBW / WT" => not na(sigSlowMA) or x_ebwReady or x_wtReady
    "Pullback only" => not na(sigFastMA) and not na(sigSlowMA)
    "EBW only" => x_ebwReady
    "WaveTrend only" => x_wtReady
    "EBW + WaveTrend" => x_ebwReady and x_wtReady
    => x_ebwReady or x_wtReady
bool x_maReady = x_mode == "Source triggers" or (not na(sigFastMA) and not na(sigSlowMA))
bool x_filterReady = x_mode == "Source triggers" or zoneEnabled
bool x_directionL = x_direction != "SELL only"
bool x_directionS = x_direction != "BUY only"
bool x_chartOK = chart.is_standard and not timeframe.isticks
bool x_candidateL = x_chartOK and x_sourceReady and x_maReady and x_filterReady and x_directionL and x_rawL and x_confirmL and x_qualityL and x_roomL and x_sessionOK
bool x_candidateS = x_chartOK and x_sourceReady and x_maReady and x_filterReady and x_directionS and x_rawS and x_confirmS and x_qualityS and x_roomS and x_sessionOK
bool x_conflict = x_candidateL and x_candidateS
bool x_preBuy = confirmationRun and barstate.isconfirmed and x_cooldownOK and x_candidateL and not x_conflict
bool x_preSell = confirmationRun and barstate.isconfirmed and x_cooldownOK and x_candidateS and not x_conflict

f_x_reason(bool allowed, bool raw, bool confirmation, bool quality, bool room) =>
    not x_chartOK ? "Use standard time candles" : not allowed ? "Direction disabled" : not x_sourceReady ? "Source off / waiting for data" : not x_maReady ? "MA history warming" : not x_filterReady ? "Enable zones or Source mode" : not x_sessionOK ? "Outside selected sessions" : not raw ? "Waiting for source trigger" : not confirmation ? "Trend / zone / structure-age filter" : not quality ? "Candle direction / body / spike" : not room ? "Opposing zone too close" : x_conflict ? "Conflicting directions" : not x_cooldownOK ? "Cooldown" : "CONFIRMED"
var string x_buyReason = "Waiting for closed bar"
var string x_sellReason = "Waiting for closed bar"
if barstate.isconfirmed
    x_buyReason := f_x_reason(x_directionL, x_rawL, x_confirmL, x_qualityL, x_roomL)
    x_sellReason := f_x_reason(x_directionS, x_rawS, x_confirmS, x_qualityS, x_roomS)
else if not x_chartOK
    x_buyReason := "Use standard time candles"
    x_sellReason := x_buyReason

var string x_decisionDetail = "No confirmed decision"
var string x_lastEvent = "Waiting for trigger"
var int x_lastEventTime = na

string x_longSource = (sigEbwLong and x_trigger != "WaveTrend only" ? "EBW " + sigEbwLongPattern + " " : "") + (sigWtLong and x_trigger != "EBW only" ? "WaveTrend " : "")
string x_shortSource = (sigEbwShort and x_trigger != "WaveTrend only" ? "EBW " + sigEbwShortPattern + " " : "") + (sigWtShort and x_trigger != "EBW only" ? "WaveTrend " : "")
if x_trigger == "Pullback + EBW / WT" or x_trigger == "Pullback only"
    x_longSource := (i_pullL ? "EMA/MA pullback " : "") + (x_trigger == "Pullback only" ? "" : x_longSource)
    x_shortSource := (i_pullS ? "EMA/MA pullback " : "") + (x_trigger == "Pullback only" ? "" : x_shortSource)
if x_trigger == "EBW + WaveTrend"
    x_longSource := "EBW + WaveTrend within " + str.tostring(x_pairWindow) + " bars"
    x_shortSource := x_longSource

// ============================================================================
// V10 LEAN PLANNING HELPERS
// The legacy optional Structural Trade Plan engine remains removed in V10.4.4 to
// stay safely under TradingView's compiled-token ceiling. The active V10 Edge
// still derives Entry / Invalidation / first structural target from the same
// audited Premium S&D registry. Limit Planner remains available separately.
// ============================================================================
f_r_round(float price, bool upward) =>
    (upward ? math.ceil(price / syminfo.mintick) : math.floor(price / syminfo.mintick)) * syminfo.mintick

f_r_protectiveAnchor(z_Record core) =>
    float best = na
    float bestGap = -1.0
    if array.size(z_records) > 0 and not na(z_atr) and z_atr > 0
        for i = 0 to array.size(z_records) - 1
            z_Record record = array.get(z_records, i)
            if record.side == core.side and f_z_isLiquidityOnly(record)
                float candidate = core.side == 1 ? record.lo : record.hi
                float gap = core.side == 1 ? core.lo - candidate : candidate - core.hi
                // Use the deepest mapped liquidity/swing anchor inside the protection window.
                // This avoids parking the stop just behind the first shallow SSL/BSL that can be swept.
                if gap >= 0 and gap <= z_atr * v10_anchorSearchATR and gap > bestGap
                    best := candidate
                    bestGap := gap
    best

f_r_sweepBufferATR(z_Record core, float anchor) =>
    float result = v10_invalidBuffer
    if not na(anchor) and not na(z_atr) and z_atr > 0
        float distal = core.side == 1 ? core.lo : core.hi
        float anchorGapATR = math.abs(distal - anchor) / z_atr
        if anchorGapATR <= v10_sweepRiskATR
            result := math.max(result, v10_sweepBufferATR)
    result

f_r_adaptiveDepth(z_Record record, float anchor) =>
    float score = f_z_cachedScore(record)
    int role = f_z_cachedRole(record, score)
    float depth = record.tests == 0 ? (role == Z_ROLE_MAJOR ? (score >= 90 ? 0.28 : 0.33) : score >= 70 ? 0.45 : 0.52) : role == Z_ROLE_MAJOR ? 0.50 : 0.58
    float distal = record.side == 1 ? record.lo : record.hi
    float extension = na(anchor) or na(z_atr) or z_atr <= 0 ? 0.0 : math.abs(distal - anchor) / z_atr
    math.min(0.65, depth + math.min(0.12, extension * 0.08))

f_r_entryFromPOI(z_Record record, float anchor) =>
    float depth = f_r_adaptiveDepth(record, anchor)
    record.side == 1 ? record.hi - depth * (record.hi - record.lo) : record.lo + depth * (record.hi - record.lo)

f_r_directLimitOK(z_Record record) =>
    float score = f_z_cachedScore(record)
    int role = f_z_cachedRole(record, score)
    role == Z_ROLE_MAJOR ? record.tests <= 1 : role == Z_ROLE_REACTION and score >= 70 and record.tests == 0

f_r_nearer(float a, float b, float entry) =>
    na(a) ? b : na(b) ? a : math.abs(a - entry) <= math.abs(b - entry) ? a : b

// wantedRole: 1 liquidity, 2 any defend POI.
f_r_structuralTarget(int side, float entry, int wantedRole, float minDistance) =>
    float best = na
    float bestDistance = 1e20
    if array.size(z_records) > 0
        for i = 0 to array.size(z_records) - 1
            z_Record record = array.get(z_records, i)
            if record.side == -side
                float score = f_z_cachedScore(record)
                int role = f_z_cachedRole(record, score)
                bool roleOK = wantedRole == 1 ? role == Z_ROLE_LIQUIDITY : (f_z_isDefendCore(record) or f_z_has(record.families, Z_FAMILY_FVG)) and score >= z_reactionMinScore
                float candidate = side == 1 ? record.lo : record.hi
                float distance = math.abs(candidate - entry)
                bool inDirection = side == 1 ? candidate > entry : candidate < entry
                if roleOK and inDirection and distance > minDistance and distance >= syminfo.mintick and distance < bestDistance
                    best := candidate
                    bestDistance := distance
    best

// ============================================================================
// V10 DECISION LAYER
// Zone quality remains a property of the POI. Market Edge is separate evidence
// about which side currently has the better planning context. Neither score is
// a calibrated win probability. Execution state is also separate from direction.
// ============================================================================
f_e_phasePoints(int side) =>
    side == 1 ? (sigPhase == 1 ? 5.0 : sigPhase == 3 ? 3.0 : sigPhase == 5 ? 2.0 : 0.0) : (sigPhase == 6 ? 5.0 : sigPhase == 4 ? 3.0 : sigPhase == 2 ? 2.0 : 0.0)

f_e_bestDefendIndex(int side) =>
    int best = -1
    float bestRank = -1e20
    if array.size(z_records) > 0 and not na(z_atr) and z_atr > 0
        for i = 0 to array.size(z_records) - 1
            z_Record record = array.get(z_records, i)
            float score = f_z_cachedScore(record)
            int role = f_z_cachedRole(record, score)
            bool properSide = side == 1 ? record.lo <= close : record.hi >= close
            float gap = side == 1 ? math.max(0.0, close - record.hi) : math.max(0.0, record.lo - close)
            float majorBonus = role == Z_ROLE_MAJOR ? 12.0 : 0.0
            float sourceBonus = f_z_has(record.tags, Z_TAG_SOURCE) ? 8.0 : f_z_has(record.tags, Z_TAG_CLEAN) ? 5.0 : 0.0
            float nestedBonus = f_z_has(record.tags, Z_TAG_NESTED) ? 4.0 : 0.0
            float freshnessBonus = record.tests == 0 ? 6.0 : record.tests == 1 ? 2.0 : -8.0
            float distancePenalty = gap / math.max(z_atr, syminfo.mintick) * (role == Z_ROLE_MAJOR ? 1.6 : 2.4)
            float rank = score + majorBonus + sourceBonus + nestedBonus + freshnessBonus - distancePenalty
            bool candidate = record.side == side and properSide and f_z_actionable(record, score) and role != Z_ROLE_LIQUIDITY and gap <= z_atr * v10_edgeSearchATR
            if candidate and rank > bestRank
                best := i
                bestRank := rank
    best

f_e_gap(int index, int side) =>
    float result = na
    if index >= 0
        z_Record record = array.get(z_records, index)
        result := side == 1 ? math.max(0.0, close - record.hi) : math.max(0.0, record.lo - close)
    result

f_e_zonePoints(int index, int side) =>
    float result = 0.0
    if index >= 0 and not na(z_atr) and z_atr > 0
        z_Record record = array.get(z_records, index)
        float score = f_z_cachedScore(record)
        float gap = side == 1 ? math.max(0.0, close - record.hi) : math.max(0.0, record.lo - close)
        float proximity = 1.0 / (1.0 + gap / math.max(z_atr * 4.0, syminfo.mintick))
        result := score / 100.0 * 25.0 * math.max(0.35, proximity)
    result

f_e_locationPoints(int index, int side) =>
    float result = 0.0
    if index >= 0 and not na(z_atr) and z_atr > 0
        z_Record record = array.get(z_records, index)
        float gap = side == 1 ? math.max(0.0, close - record.hi) : math.max(0.0, record.lo - close)
        bool inside = low <= record.hi and high >= record.lo
        float gapATR = gap / math.max(z_atr, syminfo.mintick)
        result := inside ? 10.0 : gapATR <= v10_watchATR ? 8.0 : gapATR <= 1.0 ? 5.0 : gapATR <= 2.0 ? 2.0 : 0.0
    result

f_e_roomPoints(float room) =>
    na(z_atr) or z_atr <= 0 ? 0.0 : na(room) ? 7.5 : math.min(15.0, math.max(0.0, room / math.max(z_atr * 2.0, syminfo.mintick)) * 15.0)

f_e_freshness(z_Record record) =>
    not record.historyComplete ? "UNKNOWN" : not record.departed ? "WAIT" : record.tests == 0 ? "FRESH" : record.tests == 1 ? "TESTED" : "RETEST " + str.tostring(record.tests)

f_e_grade(float score, int role) =>
    role == Z_ROLE_MAJOR ? (score >= 90 ? "A+" : "A") : role == Z_ROLE_REACTION ? (score >= 70 ? "B+" : "B") : "LQ"

int e_buyIndex = f_e_bestDefendIndex(1)
int e_sellIndex = f_e_bestDefendIndex(-1)
float e_buyGap = f_e_gap(e_buyIndex, 1)
float e_sellGap = f_e_gap(e_sellIndex, -1)

float e_buyEntry = na
float e_sellEntry = na
float e_buyInvalid = na
float e_sellInvalid = na
float e_buyAnchor = na
float e_sellAnchor = na
bool e_buyDirect = false
bool e_sellDirect = false
float e_buyTargetLq = na
float e_sellTargetLq = na
float e_buyTargetDef = na
float e_sellTargetDef = na
float e_buyTarget = na
float e_sellTarget = na
float e_buyZoneScore = na
float e_sellZoneScore = na
string e_buyZoneName = "—"
string e_sellZoneName = "—"
string e_buyFresh = "—"
string e_sellFresh = "—"
string e_buyTargetName = "—"
string e_sellTargetName = "—"

if e_buyIndex >= 0
    z_Record buyCore = array.get(z_records, e_buyIndex)
    e_buyZoneScore := f_z_cachedScore(buyCore)
    int buyRole = f_z_cachedRole(buyCore, e_buyZoneScore)
    e_buyAnchor := f_r_protectiveAnchor(buyCore)
    e_buyDirect := f_r_directLimitOK(buyCore)
    e_buyEntry := math.round_to_mintick(f_r_entryFromPOI(buyCore, e_buyAnchor))
    float buyProtect = na(e_buyAnchor) ? buyCore.lo : math.min(buyCore.lo, e_buyAnchor)
    float buyBufferATR = f_r_sweepBufferATR(buyCore, e_buyAnchor)
    float buyBuffer = math.max(z_atr * buyBufferATR, syminfo.mintick * 2.0)
    e_buyInvalid := f_r_round(math.min(buyProtect - buyBuffer, e_buyEntry - z_atr * i_minStopATR), false)
    e_buyTargetLq := f_r_structuralTarget(1, e_buyEntry, 1, 0.0)
    e_buyTargetDef := f_r_structuralTarget(1, e_buyEntry, 2, 0.0)
    e_buyTarget := f_r_nearer(e_buyTargetLq, e_buyTargetDef, e_buyEntry)
    e_buyTargetName := not na(e_buyTargetLq) and (na(e_buyTargetDef) or math.abs(e_buyTargetLq - e_buyEntry) <= math.abs(e_buyTargetDef - e_buyEntry)) ? "BSL" : not na(e_buyTargetDef) ? "SUPPLY" : "—"
    e_buyZoneName := "DEMAND " + f_e_grade(e_buyZoneScore, buyRole) + " · " + buyCore.tfNames
    e_buyFresh := f_e_freshness(buyCore)

if e_sellIndex >= 0
    z_Record sellCore = array.get(z_records, e_sellIndex)
    e_sellZoneScore := f_z_cachedScore(sellCore)
    int sellRole = f_z_cachedRole(sellCore, e_sellZoneScore)
    e_sellAnchor := f_r_protectiveAnchor(sellCore)
    e_sellDirect := f_r_directLimitOK(sellCore)
    e_sellEntry := math.round_to_mintick(f_r_entryFromPOI(sellCore, e_sellAnchor))
    float sellProtect = na(e_sellAnchor) ? sellCore.hi : math.max(sellCore.hi, e_sellAnchor)
    float sellBufferATR = f_r_sweepBufferATR(sellCore, e_sellAnchor)
    float sellBuffer = math.max(z_atr * sellBufferATR, syminfo.mintick * 2.0)
    e_sellInvalid := f_r_round(math.max(sellProtect + sellBuffer, e_sellEntry + z_atr * i_minStopATR), true)
    e_sellTargetLq := f_r_structuralTarget(-1, e_sellEntry, 1, 0.0)
    e_sellTargetDef := f_r_structuralTarget(-1, e_sellEntry, 2, 0.0)
    e_sellTarget := f_r_nearer(e_sellTargetLq, e_sellTargetDef, e_sellEntry)
    e_sellTargetName := not na(e_sellTargetLq) and (na(e_sellTargetDef) or math.abs(e_sellTargetLq - e_sellEntry) <= math.abs(e_sellTargetDef - e_sellEntry)) ? "SSL" : not na(e_sellTargetDef) ? "DEMAND" : "—"
    e_sellZoneName := "SUPPLY " + f_e_grade(e_sellZoneScore, sellRole) + " · " + sellCore.tfNames
    e_sellFresh := f_e_freshness(sellCore)

float e_buyStructure = x_structureL ? 20.0 : 0.0
float e_sellStructure = x_structureS ? 20.0 : 0.0
float e_buyTrend = x_trendL ? 15.0 : not na(sigFastMA) and not na(sigSlowMA) and sigFastMA > sigSlowMA ? 8.0 : 0.0
float e_sellTrend = x_trendS ? 15.0 : not na(sigFastMA) and not na(sigSlowMA) and sigFastMA < sigSlowMA ? 8.0 : 0.0
float e_buyZone = f_e_zonePoints(e_buyIndex, 1)
float e_sellZone = f_e_zonePoints(e_sellIndex, -1)
float e_buyRoom = f_e_roomPoints(x_spaceL)
float e_sellRoom = f_e_roomPoints(x_spaceS)
float e_buyLiquidity = not na(e_buyTargetLq) ? 10.0 : 0.0
float e_sellLiquidity = not na(e_sellTargetLq) ? 10.0 : 0.0
float e_buyLocation = f_e_locationPoints(e_buyIndex, 1)
float e_sellLocation = f_e_locationPoints(e_sellIndex, -1)
float e_buyScore = math.min(100.0, e_buyStructure + e_buyTrend + f_e_phasePoints(1) + e_buyZone + e_buyRoom + e_buyLiquidity + e_buyLocation)
float e_sellScore = math.min(100.0, e_sellStructure + e_sellTrend + f_e_phasePoints(-1) + e_sellZone + e_sellRoom + e_sellLiquidity + e_sellLocation)
float e_scoreGap = math.abs(e_buyScore - e_sellScore)
int e_side = e_buyScore >= v10_edgeMinScore and e_buyScore - e_sellScore >= v10_edgeGap ? 1 : e_sellScore >= v10_edgeMinScore and e_sellScore - e_buyScore >= v10_edgeGap ? -1 : 0
float e_score = e_side == 1 ? e_buyScore : e_side == -1 ? e_sellScore : 0.0
int e_index = e_side == 1 ? e_buyIndex : e_side == -1 ? e_sellIndex : -1
float e_gap = e_side == 1 ? e_buyGap : e_side == -1 ? e_sellGap : na
float e_entry = e_side == 1 ? e_buyEntry : e_side == -1 ? e_sellEntry : na
float e_invalid = e_side == 1 ? e_buyInvalid : e_side == -1 ? e_sellInvalid : na
float e_target = e_side == 1 ? e_buyTarget : e_side == -1 ? e_sellTarget : na
string e_targetName = e_side == 1 ? e_buyTargetName : e_side == -1 ? e_sellTargetName : "—"
string e_focusZone = e_side == 1 ? e_buyZoneName : e_side == -1 ? e_sellZoneName : "—"
string e_fresh = e_side == 1 ? e_buyFresh : e_side == -1 ? e_sellFresh : "—"
float e_zoneScore = e_side == 1 ? e_buyZoneScore : e_side == -1 ? e_sellZoneScore : na
float e_anchor = e_side == 1 ? e_buyAnchor : e_side == -1 ? e_sellAnchor : na
bool e_directOK = e_side == 1 ? e_buyDirect : e_side == -1 ? e_sellDirect : false
bool e_anchorOK = not v10_requireAnchor or not na(e_anchor)
string e_anchorText = e_side == 0 ? "—" : na(e_anchor) ? "NONE" : (e_side == 1 ? "SSL/SWING " : "BSL/SWING ") + f_price(e_anchor)

// V10.4.4 uses ONE structural TP only.
// The target is the nearest valid mapped liquidity or opposing defend POI already
// selected by the decision engine. No TP ladder and no fixed-R target are invented.
float e_setupTP = e_target

// Execution quality is deliberately separate from directional edge.
// First obstacle is measured from the planned POI entry, not from current price.
float e_risk = not na(e_entry) and not na(e_invalid) ? math.abs(e_entry - e_invalid) : na
float e_reward = not na(e_entry) and not na(e_target) ? math.abs(e_target - e_entry) : na
float e_planR = not na(e_risk) and e_risk >= syminfo.mintick and not na(e_reward) ? e_reward / e_risk : na
bool e_targetKnown = not na(e_target)
float e_firstObstacle = e_side == 0 or na(e_entry) ? na : f_x_obstacle(e_side, e_entry)
bool e_targetRoomOK = e_targetKnown and not na(e_reward) and not na(z_atr) and z_atr > 0 and e_reward >= z_atr * v10_minRoomATR and (na(e_firstObstacle) or e_firstObstacle >= math.max(syminfo.mintick, z_atr * v10_minRoomATR))
bool e_rrOK = e_targetKnown and not na(e_planR) and e_planR >= v10_minPlanR
bool e_stopOK = not na(e_risk) and not na(z_atr) and z_atr > 0 and e_risk >= z_atr * i_minStopATR * 0.95 and e_risk <= z_atr * i_maxStopATR
bool e_limitOK = e_directOK and e_anchorOK and e_stopOK and e_targetRoomOK and e_rrOK

bool e_touching = false
if e_index >= 0
    z_Record edgeCore = array.get(z_records, e_index)
    e_touching := low <= edgeCore.hi and high >= edgeCore.lo
bool e_near = e_index >= 0 and not na(e_gap) and not na(z_atr) and z_atr > 0 and e_gap <= z_atr * v10_watchATR
// V10.4.4 execution: all final signals use chart-close reference prices and NET R.
// The mapped limit idea above is context only; it is never substituted for a fill.
float i_prevATR = x_atr[1]
float i_cost = i_costTicks * syminfo.mintick
bool i_atrReady = not na(i_prevATR) and i_prevATR > 0
bool i_chopOK = not i_chopFilter or (i_atrReady and math.abs(sigFastMA - sigSlowMA) >= i_prevATR * i_minSeparation)
bool i_chaseOK = i_atrReady and math.abs(close - sigFastMA) <= i_prevATR * i_maxChase
// For structure-only confirmation, prefer the nearest qualified defend POI.
// A distant high score must not force an unnecessarily wide execution stop.
f_i_nearestPOI(int side) =>
    int best = -1
    float smallestRisk = 1e20
    if i_atrReady and array.size(z_records) > 0
        for index = 0 to array.size(z_records) - 1
            z_Record core = array.get(z_records, index)
            bool properSide = side == 1 ? core.lo < close : core.hi > close
            float anchor = side == 1 ? math.min(core.lo, low) : math.max(core.hi, high)
            float risk = (close - anchor) * side
            if core.side == side and properSide and f_z_actionable(core, core.cachedScore) and risk < smallestRisk
                best := index
                smallestRisk := risk
    best
int i_execIndexL = x_zoneL ? x_zoneIndexL : x_preBuy ? f_i_nearestPOI(1) : -1
int i_execIndexS = x_zoneS ? x_zoneIndexS : x_preSell ? f_i_nearestPOI(-1) : -1
type i_Plan
    float entry = na
    float stop = na
    float target = na
    float netR = na
    string reason = "NO PLAN"
f_i_plan(int side, int index) =>
    i_Plan p = i_Plan.new()
    if index >= 0 and i_atrReady
        z_Record core = array.get(z_records, index)
        p.entry := math.round_to_mintick(close)
        float mappedAnchor = f_r_protectiveAnchor(core)
        float anchor = side == 1 ? math.min(math.min(core.lo, low), na(mappedAnchor) ? core.lo : mappedAnchor) : math.max(math.max(core.hi, high), na(mappedAnchor) ? core.hi : mappedAnchor)
        float adaptiveBufferATR = math.max(i_stopBuffer, f_r_sweepBufferATR(core, mappedAnchor))
        float buffer = math.max(syminfo.mintick * 2.0, i_prevATR * adaptiveBufferATR)
        float rawStop = side == 1 ? math.min(anchor - buffer, p.entry - i_prevATR * i_minStopATR) : math.max(anchor + buffer, p.entry + i_prevATR * i_minStopATR)
        p.stop := f_r_round(rawStop, side == -1)
        float risk = (p.entry - p.stop) * side
        float obstacle = f_x_obstacle(side, p.entry)
        float liquidity = f_r_structuralTarget(side, p.entry, 1, 0.0)
        float mapped = f_r_nearer(liquidity, na(obstacle) ? na : p.entry + side * obstacle, p.entry)
        if not na(mapped) and risk > 0
            float capped = side == 1 ? math.min(mapped, p.entry + risk * i_targetR) : math.max(mapped, p.entry - risk * i_targetR)
            p.target := f_r_round(capped, side == -1)
        float reward = (p.target - p.entry) * side
        p.netR := not na(reward) and risk > 0 ? (reward - i_cost) / (risk + i_cost) : na
        p.reason := core.side != side ? "WRONG POI SIDE" : risk < syminfo.mintick ? "INVALID SL" : risk > i_prevATR * i_maxStopATR ? "STOP TOO WIDE" : not na(obstacle) and (obstacle < syminfo.mintick or (x_spaceFilter and obstacle < i_prevATR * x_minSpace)) ? "OBSTACLE TOO CLOSE" : na(p.target) ? "NO MAPPED TARGET" : reward < math.max(syminfo.mintick, i_prevATR * v10_minRoomATR) ? "TARGET TOO CLOSE" : na(p.netR) or p.netR + 1e-9 < i_minNetR ? "NET RR TOO LOW" : "OK"
    p
i_Plan i_buyPlan = x_preBuy ? f_i_plan(1, i_execIndexL) : i_Plan.new()
i_Plan i_sellPlan = x_preSell ? f_i_plan(-1, i_execIndexS) : i_Plan.new()

// Frozen reference plan + restart-safe LIMIT plan state.
// State 0 = none, 1 = pending, 2 = Entry reached / active.
var bool i_active = false
var int i_side = 0
var int i_signalBar = na
var int i_signalTime = na
var float i_entry = na
var float i_stop = na
var float i_target = na
var float i_netR = na
var string i_poiText = "—"
var string i_status = "WAIT FOR FIRST SIGNAL"

var int e_lockState = 0
var int e_lockSide = 0
var int e_lockBar = na
var int e_lockTime = na
var float e_lockEntry = na
var float e_lockStop = na
var float e_lockTP = na
var float e_lockR = na
var string e_lockPoi = "—"
var string e_lockStatus = "WAIT"

bool i_ended = false
bool e_lockEnded = false

// A confirmed signal reference is already entered at the signal close.
// Never expire it by time after Entry; keep the frozen levels until TP or SL.
if barstate.isconfirmed and i_active and bar_index > i_signalBar
    bool stopTouched = i_side == 1 ? low <= i_stop : high >= i_stop
    bool targetTouched = i_side == 1 ? high >= i_target : low <= i_target
    if stopTouched or targetTouched
        i_status := stopTouched and targetTouched ? "SL + TP TOUCHED / ORDER UNKNOWN" : stopTouched ? "SL TOUCHED" : "TP TOUCHED"
        i_active := false
        i_ended := true

// Maintain the frozen LIMIT setup from historical closed bars.
// Reloading the same symbol/TF/settings replays the same state deterministically.
if barstate.isconfirmed and e_lockState > 0 and bar_index > e_lockBar
    bool entryTouched = low <= e_lockEntry and high >= e_lockEntry
    bool stopTouched = e_lockSide == 1 ? low <= e_lockStop : high >= e_lockStop
    bool targetTouched = e_lockSide == 1 ? high >= e_lockTP : low <= e_lockTP
    bool gappedPast = e_lockSide == 1 ? high < e_lockEntry : low > e_lockEntry
    float path = math.max(math.abs(e_lockTP - e_lockEntry), syminfo.mintick)
    float progress = ((e_lockSide == 1 ? high : low) - e_lockEntry) * e_lockSide / path
    if e_lockState == 1
        if gappedPast
            e_lockState := 0
            e_lockStatus := "CANCELLED · GAP / FILL UNKNOWN"
            e_lockEnded := true
        else if entryTouched
            if stopTouched or targetTouched
                e_lockState := 0
                e_lockStatus := "CLOSED · ENTRY + EXIT SAME BAR"
                e_lockEnded := true
            else
                e_lockState := 2
                e_lockStatus := "ACTIVE · ENTRY REACHED · LEVELS LOCKED"
        else if targetTouched or progress >= v10_cancelProgress
            e_lockState := 0
            e_lockStatus := "CANCELLED · STALE BEFORE ENTRY"
            e_lockEnded := true
        else if bar_index - e_lockBar >= i_planBars
            e_lockState := 0
            e_lockStatus := "EXPIRED · BEFORE ENTRY"
            e_lockEnded := true
    else
        if stopTouched and targetTouched
            e_lockState := 0
            e_lockStatus := "CLOSED · TP + SL SAME BAR"
            e_lockEnded := true
        else if stopTouched
            e_lockState := 0
            e_lockStatus := "CLOSED · SL"
            e_lockEnded := true
        else if targetTouched
            e_lockState := 0
            e_lockStatus := "CLOSED · TP"
            e_lockEnded := true
    if e_lockEnded
        z_planZoneId := ""

// Freeze a new direct LIMIT only on a confirmed bar, and never while another plan is live.
float e_candidatePath = not na(e_entry) and not na(e_setupTP) ? math.max(math.abs(e_setupTP - e_entry), syminfo.mintick) : na
float e_candidateProgress = e_side != 0 and not na(e_candidatePath) ? ((close - e_entry) * e_side) / e_candidatePath : na
bool e_lockCandidate = barstate.isconfirmed and e_lockState == 0 and not e_lockEnded and not i_active and not i_ended and e_side != 0 and e_index >= 0 and e_limitOK and not e_touching and not na(e_entry) and not na(e_invalid) and not na(e_setupTP) and (na(e_candidateProgress) or e_candidateProgress < v10_cancelProgress)
if e_lockCandidate
    e_lockState := 1
    e_lockSide := e_side
    e_lockBar := bar_index
    e_lockTime := time_close
    e_lockEntry := e_entry
    e_lockStop := e_invalid
    e_lockTP := e_setupTP
    e_lockR := e_planR
    z_Record lockedCore = array.get(z_records, e_index)
    z_planZoneId := lockedCore.id
    e_lockPoi := lockedCore.tfNames + " · " + f_price(lockedCore.lo) + "–" + f_price(lockedCore.hi)
    e_lockStatus := "PENDING · LEVELS LOCKED"

bool i_available = not i_active and not i_ended and e_lockState == 0
bool finalBuy = x_preBuy and i_available and e_side == 1 and i_htfL and i_chopOK and i_chaseOK and i_buyPlan.reason == "OK"
bool finalSell = x_preSell and i_available and e_side == -1 and i_htfS and i_chopOK and i_chaseOK and i_sellPlan.reason == "OK"
f_i_reason(bool pre, int side, bool htfOK, i_Plan p, string oldReason) =>
    not pre ? oldReason : not i_available ? "REFERENCE PLAN BUSY" : e_side != side ? "EDGE NOT ALIGNED" : not htfOK ? "HTF TREND / WARMUP" : not i_chopOK ? "MA COMPRESSION" : not i_chaseOK ? "DO NOT CHASE" : p.reason != "OK" ? p.reason : "CONFIRMED"
if barstate.isconfirmed
    x_buyReason := f_i_reason(x_preBuy, 1, i_htfL, i_buyPlan, x_buyReason)
    x_sellReason := f_i_reason(x_preSell, -1, i_htfS, i_sellPlan, x_sellReason)
if finalBuy or finalSell
    x_lastSignalBar := bar_index
    x_lastEvent := finalBuy ? "BUY" : "SELL"
    x_lastEventTime := time_close
    int decisionIndex = finalBuy ? i_execIndexL : i_execIndexS
    bool usedZone = x_mode != "Source triggers" and (finalBuy ? x_zoneL : x_zoneS)
    z_signalZoneId := decisionIndex >= 0 ? array.get(z_records, decisionIndex).id : ""
    string branch = x_mode == "Source triggers" ? "SOURCE ONLY" : usedZone ? "ZONE CONFIRMATION" : "STRUCTURE ONLY (no zone rejection)"
    x_decisionDetail := branch + ("\nPlan POI: " + z_signalZoneId) + "\nEnabled filters passed; disabled filters are not evidence."

    i_Plan accepted = finalBuy ? i_buyPlan : i_sellPlan
    i_side := finalBuy ? 1 : -1
    i_entry := accepted.entry
    i_stop := accepted.stop
    i_target := accepted.target
    i_netR := accepted.netR
    i_signalBar := bar_index
    i_signalTime := time_close
    i_active := true
    z_Record chosen = array.get(z_records, decisionIndex)
    i_poiText := chosen.tfNames + " · " + f_price(chosen.lo) + "–" + f_price(chosen.hi)
    i_status := finalBuy ? "TRACK BUY · REFERENCE" : "TRACK SELL · REFERENCE"
    x_decisionDetail += "\nREF " + f_price(i_entry) + " | SL " + f_price(i_stop) + " | TP " + f_price(i_target) + " | net " + str.tostring(i_netR, "#.##") + "R\nCost allowance: " + str.tostring(i_costTicks, "#.##") + " ticks. Reference prices, not fills."
bool i_hasPlan = not na(i_signalBar)

bool e_signalAligned = finalBuy or finalSell

string e_state = "WAIT · FOR ZONE"
if e_lockState == 2
    e_state := "ACTIVE · ENTRY LOCKED"
else if e_lockState == 1
    e_state := "PENDING · LEVELS LOCKED"
else if e_signalAligned
    e_state := "READY · CLOSED SIGNAL"
else if e_side == 0
    e_state := "NO TRADE · NO EDGE"
else if e_index < 0
    e_state := "NO TRADE · NO POI"
else if not e_directOK
    e_state := "WAIT · CONFIRM ONLY"
else if not e_anchorOK
    e_state := "WAIT · NO PROTECTIVE ANCHOR"
else if not e_targetKnown
    e_state := "NO TRADE · NO TARGET"
else if not e_stopOK
    e_state := "NO TRADE · STOP GEOMETRY"
else if not e_targetRoomOK
    e_state := "NO TRADE · TARGET TOO CLOSE"
else if not e_rrOK
    e_state := "NO TRADE · POOR RR"
else if e_touching
    e_state := "WATCH · CONFIRM"
else if e_near
    e_state := "APPROACHING"

string e_edgeName = e_side == 1 ? "BUY" : e_side == -1 ? "SELL" : "NEUTRAL"
color e_edgeColor = e_side == 1 ? uiBull : e_side == -1 ? uiBear : uiMuted
string e_zoneText = e_side == 0 or e_index < 0 ? "—" : f_price(array.get(z_records, e_index).lo) + "–" + f_price(array.get(z_records, e_index).hi) + " · " + e_fresh + (na(e_zoneScore) ? "" : " · Q" + str.tostring(e_zoneScore, "#"))
string e_targetText = na(e_target) ? "—" : e_targetName + " " + f_price(e_target) + (na(e_planR) ? "" : " · " + str.tostring(e_planR, "#.##") + "R")
string e_biasText = x_structureL ? "BULLISH STRUCTURE" : x_structureS ? "BEARISH STRUCTURE" : "NO FRESH STRUCTURE"

f_e_confirmSimple(int side) =>
    string reason = side == 1 ? x_buyReason : side == -1 ? x_sellReason : "Directional evidence too close"
    switch reason
        "CONFIRMED" => "CONFIRMED"
        "Waiting for source trigger" => "WAIT TRIGGER"
        "Trend / zone / structure-age filter" => "WAIT STRUCTURE"
        "Candle direction / body / spike" => "WAIT CANDLE"
        "Opposing zone too close" => "BLOCKED · OBSTACLE"
        "Cooldown" => "COOLDOWN"
        "Outside selected sessions" => "OUTSIDE SESSION"
        "Source off / waiting for data" => "SOURCE WARMUP"
        "MA history warming" => "MA WARMUP"
        "Enable zones or Source mode" => "ZONE FILTER OFF"
        "Direction disabled" => "DIRECTION OFF"
        "Use standard time candles" => "STANDARD CANDLES ONLY"
        "Conflicting directions" => "CONFLICT"
        => side == 0 ? "NO EDGE" : reason

// Premium visual hierarchy. V10 presets control presentation only; the engine keeps the full research map.
// Major = primary decision zone, Reaction = secondary POI, Liquidity = sweep/target line (never a filled box).
string z_effectiveVisualMode = v10_layout == "Mobile" ? "Premium Clean" : v10_layout == "Trading" ? "Premium Clean" : v10_layout == "Research" ? "Full Map" : z_visualMode
int z_majorQuota = not v10_showMajor ? 0 : z_effectiveVisualMode == "Premium Clean" ? 1 : z_effectiveVisualMode == "Balanced" ? 1 : z_majorPerSide
int z_reactionQuota = not v10_showReaction ? 0 : z_effectiveVisualMode == "Premium Clean" ? 1 : z_effectiveVisualMode == "Balanced" ? 2 : z_reactionPerSide
int z_liquidityQuota = not v10_showLiquidity ? 0 : z_effectiveVisualMode == "Premium Clean" ? 1 : z_effectiveVisualMode == "Balanced" ? 1 : z_liquidityPerSide
float z_visualDistance = z_effectiveVisualMode == "Premium Clean" ? math.min(z_showDistance, 8.0) : z_effectiveVisualMode == "Balanced" ? math.min(z_showDistance, 12.0) : z_showDistance
float z_visualReactionMin = z_effectiveVisualMode == "Premium Clean" ? math.max(z_reactionMinScore, z_cleanReactionScore) : z_effectiveVisualMode == "Balanced" ? math.max(z_reactionMinScore, 45.0) : z_reactionMinScore
int z_visualMaxTests = z_effectiveVisualMode == "Premium Clean" ? 1 : z_effectiveVisualMode == "Balanced" ? 2 : 99
bool z_suppressVisualOverlap = z_effectiveVisualMode != "Full Map"

// BEGIN ZONE BRIDGE VISIBLE IDS
var array<string> zb_visibleIds = array.new_string()
// END ZONE BRIDGE VISIBLE IDS

var array<box> z_boxPool = array.new_box()
var array<line> z_linePool = array.new_line()
var array<label> z_labelPool = array.new_label()
int z_slotsPerSide = z_majorQuota + z_reactionQuota + z_liquidityQuota
int z_slots = math.max(1, z_slotsPerSide * 2 + 2)
if barstate.isfirst
    for index = 0 to z_slots - 1
        array.push(z_boxPool, box.new(na, na, na, na, xloc=xloc.bar_index, bgcolor=na, border_color=na, force_overlay=true))
        array.push(z_linePool, line.new(na, na, na, na, xloc=xloc.bar_index, color=na, force_overlay=true))
        array.push(z_labelPool, label.new(na, na, "", xloc=xloc.bar_index, style=label.style_label_left, textcolor=uiText, color=na, size=uiSize, force_overlay=true))

f_z_displayRank(z_Record record, float score, int role, float gap) =>
    // Major favors evidence, Reaction favors relevance/proximity, Liquidity favors clean pools close enough to matter.
    float distancePenalty = role == Z_ROLE_MAJOR ? 1.35 : role == Z_ROLE_REACTION ? 3.8 : 2.2
    float liquidityBonus = role == Z_ROLE_LIQUIDITY ? (f_z_has(record.tags, Z_TAG_EQUAL) ? 16.0 : f_z_has(record.tags, Z_TAG_IDM) ? 10.0 : 4.0) : 0.0
    float freshnessBonus = role != Z_ROLE_LIQUIDITY ? (record.tests == 0 ? 4.0 : record.tests == 1 ? 1.0 : -8.0) : 0.0
    score + liquidityBonus + freshnessBonus - gap / math.max(z_atr, syminfo.mintick) * distancePenalty

f_z_grade(float score, int role) =>
    role == Z_ROLE_MAJOR ? (score >= 90 ? "A+" : "A") : role == Z_ROLE_REACTION ? (score >= 70 ? "B+" : "B") : "LQ"

if barstate.islastconfirmedhistory or (barstate.islast and (z_refresh == "Live preview" or barstate.isconfirmed))
    // BEGIN ZONE BRIDGE CLEAR IDS
    array.clear(zb_visibleIds)
    // END ZONE BRIDGE CLEAR IDS
    array<int> selected = array.new_int()
    if v10_showMap and zoneEnabled and z_show and array.size(z_records) > 0
        for i = 0 to array.size(z_records) - 1
            z_Record pinned = array.get(z_records, i)
            float pinnedScore = f_z_cachedScore(pinned)
            int pinnedRole = f_z_cachedRole(pinned, pinnedScore)
            bool pinnedVisible = pinnedRole == Z_ROLE_MAJOR ? v10_showMajor : pinnedRole == Z_ROLE_REACTION ? v10_showReaction : v10_showLiquidity
            if pinnedVisible and (pinned.id == z_planZoneId or pinned.id == z_signalZoneId)
                array.push(selected, i)
        for sideIndex = 0 to 1
            int desiredSide = sideIndex == 0 ? 1 : -1
            for roleIndex = 0 to 2
                int desiredRole = roleIndex == 0 ? Z_ROLE_MAJOR : roleIndex == 1 ? Z_ROLE_REACTION : Z_ROLE_LIQUIDITY
                int quota = desiredRole == Z_ROLE_MAJOR ? z_majorQuota : desiredRole == Z_ROLE_REACTION ? z_reactionQuota : z_liquidityQuota
                if quota > 0
                    for positionIndex = 0 to quota - 1
                        int best = -1
                        float bestRank = -1e20
                        for candidateIndex = 0 to array.size(z_records) - 1
                            z_Record record = array.get(z_records, candidateIndex)
                            float score = f_z_cachedScore(record)
                            int role = f_z_cachedRole(record, score)
                            bool properSide = desiredSide == 1 ? record.lo <= close : record.hi >= close
                            float gap = desiredSide == 1 ? math.max(0.0, close - record.hi) : math.max(0.0, record.lo - close)
                            bool widthOK = role == Z_ROLE_LIQUIDITY or record.hi - record.lo <= z_atr * math.max(z_maxWidth, 4.0)
                            bool reactionOK = role != Z_ROLE_REACTION or score >= z_visualReactionMin
                            bool retestOK = role == Z_ROLE_LIQUIDITY or record.tests <= z_visualMaxTests
                            bool distinct = true
                            if z_suppressVisualOverlap and array.size(selected) > 0
                                float candidateMid = math.avg(record.lo, record.hi)
                                for selectedPosition = 0 to array.size(selected) - 1
                                    int selectedIndex = array.get(selected, selectedPosition)
                                    z_Record chosen = array.get(z_records, selectedIndex)
                                    if chosen.side == desiredSide
                                        float chosenScore = f_z_cachedScore(chosen)
                                        int chosenRole = f_z_cachedRole(chosen, chosenScore)
                                        float chosenMid = math.avg(chosen.lo, chosen.hi)
                                        bool bothDefend = role != Z_ROLE_LIQUIDITY and chosenRole != Z_ROLE_LIQUIDITY
                                        bool bothLiquidity = role == Z_ROLE_LIQUIDITY and chosenRole == Z_ROLE_LIQUIDITY
                                        bool liquidityVsDefend = role == Z_ROLE_LIQUIDITY and chosenRole != Z_ROLE_LIQUIDITY
                                        bool overlap = math.min(record.hi, chosen.hi) >= math.max(record.lo, chosen.lo)
                                        bool tooClose = math.abs(candidateMid - chosenMid) <= z_atr * z_visualClusterATR
                                        bool liquidityInside = liquidityVsDefend and candidateMid >= chosen.lo - z_atr * 0.05 and candidateMid <= chosen.hi + z_atr * 0.05
                                        // In curated modes, nested/near-duplicate objects are hidden visually; the engine still keeps them for logic and Full Map.
                                        if (bothDefend and (overlap or tooClose)) or (bothLiquidity and tooClose) or liquidityInside
                                            distinct := false
                            bool candidate = record.side == desiredSide and role == desiredRole and properSide and gap <= z_atr * z_visualDistance and widthOK and reactionOK and retestOK and distinct and not array.includes(selected, candidateIndex)
                            float rank = f_z_displayRank(record, score, role, gap)
                            if candidate and rank > bestRank
                                best := candidateIndex
                                bestRank := rank
                        if best >= 0
                            array.push(selected, best)

    for index = 0 to z_slots - 1
        box band = array.get(z_boxPool, index)
        line guide = array.get(z_linePool, index)
        label badge = array.get(z_labelPool, index)
        if index < array.size(selected)
            z_Record record = array.get(z_records, array.get(selected, index))
            float score = f_z_cachedScore(record)
            int role = f_z_cachedRole(record, score)
            // BEGIN ZONE BRIDGE CAPTURE ID
            if role != Z_ROLE_LIQUIDITY
                array.push(zb_visibleIds, record.id)
            // END ZONE BRIDGE CAPTURE ID
            color sideColor = record.side == 1 ? uiBull : uiBear
            color visualColor = role == Z_ROLE_LIQUIDITY ? uiAccent : sideColor
            float midpoint = math.avg(record.lo, record.hi)
            int historyBars = role == Z_ROLE_MAJOR ? z_spanBars : role == Z_ROLE_REACTION ? math.min(z_spanBars, 75) : math.min(z_spanBars, 60)
            int leftBar = math.max(record.bornBar, bar_index - historyBars)
            int rightBar = bar_index + (role == Z_ROLE_MAJOR ? 4 : role == Z_ROLE_REACTION ? 6 : 8)
            int labelBar = bar_index + z_rightBars + (role == Z_ROLE_MAJOR ? 0 : role == Z_ROLE_REACTION ? 4 : 8)
            string demandSupply = record.side == 1 ? "DEMAND" : "SUPPLY"
            string liquiditySide = record.side == 1 ? "SSL" : "BSL"
            string roleText = f_z_roleName(role)
            string freshnessText = not record.historyComplete ? "UNKNOWN HISTORY" : not record.departed ? "WAIT DEPARTURE" : record.tests == 0 ? "FRESH" : "RET " + str.tostring(record.tests)
            string grade = f_z_grade(score, role)

            if role == Z_ROLE_LIQUIDITY
                // Liquidity is a destination / sweep pool. Draw it as a single dotted ray, never as a defend box.
                box.set_lefttop(band, na, na)
                box.set_rightbottom(band, na, na)
                line.set_xy1(guide, leftBar, midpoint)
                line.set_xy2(guide, labelBar, midpoint)
                line.set_color(guide, color.new(visualColor, 18))
                line.set_style(guide, line.style_dotted)
                line.set_width(guide, 1)
            else
                int bgAlpha = role == Z_ROLE_MAJOR ? (record.tests == 0 ? 84 : 89) : 95
                int borderAlpha = role == Z_ROLE_MAJOR ? 8 : 48
                int borderWidth = role == Z_ROLE_MAJOR ? 2 : 1
                box.set_lefttop(band, leftBar, record.hi)
                box.set_rightbottom(band, rightBar, record.lo)
                box.set_bgcolor(band, color.new(sideColor, bgAlpha))
                box.set_border_color(band, color.new(sideColor, borderAlpha))
                box.set_border_width(band, borderWidth)
                // Premium Clean removes internal center lines from defend boxes; Full/Balanced may show a faint guide.
                if z_effectiveVisualMode == "Premium Clean"
                    line.set_xy1(guide, na, na)
                    line.set_xy2(guide, na, na)
                else
                    line.set_xy1(guide, leftBar, f_z_reference(record))
                    line.set_xy2(guide, rightBar, f_z_reference(record))
                    line.set_color(guide, color.new(sideColor, role == Z_ROLE_MAJOR ? 42 : 68))
                    line.set_style(guide, role == Z_ROLE_MAJOR ? line.style_solid : line.style_dashed)
                    line.set_width(guide, 1)

            string premiumCaption = role == Z_ROLE_LIQUIDITY ? liquiditySide + " · " + record.tfNames + " · " + f_price(midpoint) : demandSupply + " · " + grade + " · " + record.tfNames + "\n" + freshnessText + " · " + str.tostring(int(math.round(score))) + "/100 · " + f_price(record.side == 1 ? record.hi : record.lo)
            string fullCaption = role == Z_ROLE_LIQUIDITY ? "LIQUIDITY " + liquiditySide + "\n" + record.names + " · " + record.tfNames : roleText + " " + demandSupply + " · " + grade + " · " + str.tostring(int(math.round(score))) + "/100\n" + freshnessText + " · " + record.tfNames + " · " + record.names
            string identityTag = record.id == z_planZoneId ? "ACTIVE PLAN · " : record.id == z_signalZoneId ? "SIGNAL POI · " : ""
            string caption = not uiLabels or z_labelMode == "Hidden" ? "" : z_labelMode == "Full" ? identityTag + fullCaption : identityTag + premiumCaption
            float labelY = role == Z_ROLE_LIQUIDITY ? midpoint : record.side == 1 ? record.hi : record.lo
            label.set_style(badge, label.style_label_left)
            label.set_xy(badge, labelBar, labelY)
            label.set_text(badge, caption)
            label.set_color(badge, caption == "" ? na : color.new(uiPanel, role == Z_ROLE_MAJOR ? 4 : role == Z_ROLE_REACTION ? 18 : 48))
            label.set_textcolor(badge, visualColor)
            label.set_size(badge, role == Z_ROLE_MAJOR ? uiSize : size.tiny)
            label.set_tooltip(badge, "PREMIUM POI MAP · not an order\nID: " + record.id + "\nOrigin: " + str.format_time(record.originTime, "MM-dd HH:mm", syminfo.timezone) + "\nKnown: " + str.format_time(record.knownTime, "MM-dd HH:mm", syminfo.timezone) + "\nObserved: " + str.format_time(record.observedTime, "MM-dd HH:mm", syminfo.timezone) + "\nPriority: " + grade + " · " + roleText + "\nMeaning: " + (role == Z_ROLE_MAJOR ? "Primary decision / defend zone" : role == Z_ROLE_REACTION ? "Secondary reaction POI" : "Liquidity sweep/target; not an entry by itself") + "\nSources: " + record.names + "\nTimeframes: " + record.tfNames + "\nBounds: " + f_price(record.lo) + " – " + f_price(record.hi) + "\nEvidence score: " + str.tostring(int(math.round(score))) + "/100; not win probability.\nDeparture: " + str.tostring(record.departureATR, "#.##") + " ATR\nEvidence: " + f_z_tagsText(record.tags) + "\nAudited returns: " + str.tostring(record.tests) + "\nHistory: " + (record.historyComplete ? "Audited from activation" : "Unknown; cannot confirm entry") + "\nScoring: " + z_scoreModel + "; evidence, not win probability.")
        else
            box.set_lefttop(band, na, na)
            box.set_rightbottom(band, na, na)
            line.set_xy1(guide, na, na)
            line.set_xy2(guide, na, na)
            label.set_xy(badge, na, na)
            label.set_text(badge, "")

// V10.4.4 Single-TP Setup Map: frozen lifecycle. A displayed LIMIT keeps the same Entry/SL/TP
// through Pending -> Active and is released only by pre-entry cancellation/expiry or TP/SL.
var array<line> e_planLines = array.new<line>()
var array<label> e_planLabels = array.new<label>()
var box e_riskBox = box.new(na, na, na, na, force_overlay=true)
var box e_rewardBox = box.new(na, na, na, na, force_overlay=true)
if barstate.isfirst
    for index = 0 to 2
        array.push(e_planLines, line.new(na, na, na, na, force_overlay=true))
        array.push(e_planLabels, label.new(na, na, "", style=label.style_label_left, force_overlay=true))
if barstate.islastconfirmedhistory or (barstate.islast and (z_refresh == "Live preview" or barstate.isconfirmed))
    bool signalSetup = i_active and not na(i_entry) and not na(i_stop) and not na(i_target)
    bool lockedSetup = e_lockState > 0 and not na(e_lockEntry) and not na(e_lockStop) and not na(e_lockTP)
    int setupSide = signalSetup ? i_side : lockedSetup ? e_lockSide : 0
    float setupEntry = signalSetup ? i_entry : lockedSetup ? e_lockEntry : na
    float setupStop = signalSetup ? i_stop : lockedSetup ? e_lockStop : na
    float setupTP = signalSetup ? i_target : lockedSetup ? e_lockTP : na
    float setupRisk = setupSide != 0 and not na(setupEntry) and not na(setupStop) ? math.abs(setupEntry - setupStop) : na
    bool drawSetup = v10_showPlan and setupSide != 0 and not na(setupRisk) and setupRisk >= syminfo.mintick

    int leftX = signalSetup ? i_signalBar : e_lockBar
    int rightX = bar_index + 18
    if drawSetup
        float riskTop = math.max(setupEntry, setupStop)
        float riskBottom = math.min(setupEntry, setupStop)
        float rewardTop = math.max(setupEntry, setupTP)
        float rewardBottom = math.min(setupEntry, setupTP)
        box.set_lefttop(e_riskBox, leftX, riskTop)
        box.set_rightbottom(e_riskBox, rightX, riskBottom)
        box.set_bgcolor(e_riskBox, color.new(uiBear, 90))
        box.set_border_color(e_riskBox, color.new(uiBear, 45))
        box.set_lefttop(e_rewardBox, leftX, rewardTop)
        box.set_rightbottom(e_rewardBox, rightX, rewardBottom)
        box.set_bgcolor(e_rewardBox, color.new(uiBull, 92))
        box.set_border_color(e_rewardBox, color.new(uiBull, 55))
    else
        box.set_lefttop(e_riskBox, na, na)
        box.set_rightbottom(e_riskBox, na, na)
        box.set_lefttop(e_rewardBox, na, na)
        box.set_rightbottom(e_rewardBox, na, na)

    for index = 0 to 2
        line ray = array.get(e_planLines, index)
        label badge = array.get(e_planLabels, index)
        float level = index == 0 ? setupEntry : index == 1 ? setupStop : setupTP
        color tint = index == 0 ? uiAccent : index == 1 ? uiBear : uiBull
        bool drawLevel = drawSetup and not na(level)
        if drawLevel
            float levelR = index == 2 ? math.abs(level - setupEntry) / setupRisk : na
            string caption = index == 0 ? (signalSetup ? (setupSide == 1 ? "BUY REF " : "SELL REF ") : e_lockState == 2 ? (setupSide == 1 ? "BUY ACTIVE " : "SELL ACTIVE ") : (setupSide == 1 ? "BUY LIMIT " : "SELL LIMIT ")) : index == 1 ? "SL " : "TP "
            string rrText = index == 2 ? " · " + str.tostring(levelR, "#.##") + "R" : ""
            line.set_xy1(ray, leftX, level)
            line.set_xy2(ray, rightX, level)
            line.set_color(ray, color.new(tint, index <= 1 ? 0 : 18))
            line.set_width(ray, index <= 1 ? 2 : 1)
            line.set_style(ray, index <= 1 ? line.style_solid : line.style_dashed)
            label.set_xy(badge, rightX, level)
            label.set_text(badge, caption + f_price(level) + rrText)
            label.set_color(badge, color.new(uiPanel, 4))
            label.set_textcolor(badge, tint)
            label.set_size(badge, uiSize)
            label.set_tooltip(badge, signalSetup ? "Frozen signal-close reference plan. Not a broker order or fill." : "EBW V10.4.4 sweep-protected locked setup. SL is built beyond mapped liquidity/swing structure plus an adaptive sweep buffer. Entry / SL / TP are frozen from plan creation and remain unchanged after Entry until TP/SL. Reloading replays the same closed-bar lifecycle.")
        else
            line.set_xy1(ray, na, na)
            line.set_xy2(ray, na, na)
            label.set_xy(badge, na, na)
            label.set_text(badge, "")

var array<label> x_details = array.new<label>()
if v10_showConfirmation and x_signalDetails and (finalBuy or finalSell)
    string cause = finalBuy ? x_longSource : x_shortSource
    label detail = label.new(bar_index, finalBuy ? low : high, "i", style=finalBuy ? label.style_label_upper_left : label.style_label_lower_left, color=color.new(uiPanel, 15), textcolor=uiText, size=size.tiny, force_overlay=true)
    label.set_tooltip(detail, (finalBuy ? "BUY" : "SELL") + " | " + cause + "\nMode: " + x_mode + "\nChart close: " + f_price(close) + "\n" + x_decisionDetail + "\nFrozen plan: REF " + f_price(i_entry) + " / SL " + f_price(i_stop) + " / TP " + f_price(i_target) + "\nSource events and filters are confirmed on this candle. Entry is not an executed fill.")
    array.push(x_details, detail)
    if array.size(x_details) > 20
        label.delete(array.shift(x_details))


plotshape(v10_showConfirmation and lp_view != "Limit Planner" and uiFinalSignals and finalBuy, title="Final BUY", style=shape.labelup, location=location.belowbar, color=uiBull, text="BUY", textcolor=#FFFFFF, size=size.small, display=display.pane, force_overlay=true)
plotshape(v10_showConfirmation and lp_view != "Limit Planner" and uiFinalSignals and finalSell, title="Final SELL", style=shape.labeldown, location=location.abovebar, color=uiBear, text="SELL", textcolor=#FFFFFF, size=size.small, display=display.pane, force_overlay=true)
plot(zoneSupport, "Nearest support", display=display.data_window, force_overlay=true)
plot(zoneResistance, "Nearest resistance", display=display.data_window, force_overlay=true)
plot(zoneSupportScore, "Support evidence score (not probability)", display=display.data_window, force_overlay=true)
plot(zoneResistanceScore, "Resistance evidence score (not probability)", display=display.data_window, force_overlay=true)
plot(e_buyScore, "V10.4.4 BUY edge evidence (not probability)", display=display.data_window, force_overlay=true)
plot(e_sellScore, "V10.4.4 SELL edge evidence (not probability)", display=display.data_window, force_overlay=true)
plot(e_side, "V10.4.4 preferred side (+1 buy / -1 sell / 0 neutral)", display=display.data_window, force_overlay=true)
plot(i_entry, "Signal reference entry", display=display.data_window, force_overlay=true)
plot(i_stop, "Signal SL", display=display.data_window, force_overlay=true)
plot(i_target, "Signal TP", display=display.data_window, force_overlay=true)
plot(e_setupTP, "V10.4.4 setup TP", display=display.data_window, force_overlay=true)
plot(e_anchor, "V10.4.4 protective anchor", display=display.data_window, force_overlay=true)
plot(i_netR, "Signal net R after cost allowance", display=display.data_window, force_overlay=true)

// One dispatch per confirmed bar prevents independent modules competing for alert().
string x_events = lp_events
if lp_view != "Limit Planner" and x_alertFinal and finalBuy
    x_events += "BUY | " + x_longSource + "\n" + x_decisionDetail + "\n"
if lp_view != "Limit Planner" and x_alertFinal and finalSell
    x_events += "SELL | " + x_shortSource + "\n" + x_decisionDetail + "\n"
if x_alertStructure
    if zoneBosUp or zoneChochUp
        x_events += (zoneChochUp ? "Bullish ChoCH" : "Bullish BOS") + "\n"
    if zoneBosDown or zoneChochDown
        x_events += (zoneChochDown ? "Bearish ChoCH" : "Bearish BOS") + "\n"
if x_alertPhase and sigPhase != sigPhase[1] and sigPhase > 0 and (x_phaseChoice == "All" or x_phaseChoice == sigPhaseName)
    x_events += "Phase: " + sigPhaseName + "\n"
if x_alertSession
    x_events += sesOpenL ? "London session opened\n" : ""
    x_events += sesOpenN ? "New York session opened\n" : ""
    x_events += sesOpenT ? "Tokyo session opened\n" : ""
    x_events += sesOpenS ? "Sydney session opened\n" : ""
if x_alertMaster and barstate.isconfirmed and str.length(x_events) > 0
    bool x_hasLimitEvents = str.length(lp_events) > 0
    string x_message = "EBW V10.4.4 | " + syminfo.tickerid + " | chart " + f_tfName(timeframe.period) + "\n" + x_events + "Close: " + f_price(close) + "\nMarket Edge: " + e_edgeName + " " + str.tostring(e_score, "#") + "/100 | State: " + e_state + "\nMap context: " + e_focusZone + "\nMode: " + x_mode + " | Phase: " + sigPhaseName + "\nClosed: " + str.format_time(time_close, "yyyy-MM-dd HH:mm", syminfo.timezone) + " " + syminfo.timezone
    if x_hasLimitEvents and not na(lp_a)
        x_message += "\nLIMIT MAP " + f_tfName(lp_tf1) + ": S " + f_price(lp_a.support.lo) + "–" + f_price(lp_a.support.hi) + " | R " + f_price(lp_a.resistance.lo) + "–" + f_price(lp_a.resistance.hi)
    else
        x_message += "\nCHART MAP: S " + f_price(zoneSupport) + " | R " + f_price(zoneResistance)
    alert(x_message, alert.freq_once_per_bar_close)
alertcondition(lp_view != "Limit Planner" and x_alertMaster and x_alertFinal and finalBuy, "EBW V10.4.4 • BUY", "EBW V10.4.4 confirmed BUY | {{ticker}} | {{interval}} | {{close}}")
alertcondition(lp_view != "Limit Planner" and x_alertMaster and x_alertFinal and finalSell, "EBW V10.4.4 • SELL", "EBW V10.4.4 confirmed SELL | {{ticker}} | {{interval}} | {{close}}")

string uiAnchor = uiPosition == "Top Left" ? position.top_left : uiPosition == "Bottom Right" ? position.bottom_right : uiPosition == "Bottom Left" ? position.bottom_left : position.top_right
var table uiBoard = table.new(uiAnchor, 2, 18, bgcolor=color.new(uiPanel, 5), frame_color=uiBorder, frame_width=1, border_width=0, force_overlay=true)
f_boardRow(table board, int row, string caption, string value, color valueColor) =>
    table.cell(board, 0, row, caption, text_color=uiMuted, text_size=uiSize, text_halign=text.align_left, bgcolor=color.new(uiPanel, 5))
    table.cell(board, 1, row, value, text_color=valueColor, text_size=uiSize, text_halign=text.align_right, bgcolor=color.new(uiPanel, 5))

if barstate.islastconfirmedhistory or (barstate.islast and (z_refresh == "Live preview" or barstate.isconfirmed))
    table.clear(uiBoard, 0, 0, 1, 17)
    string uiResolvedAnchor = lp_visible and lp_panelMode != "Hidden" and uiPosition == lp_panelPosition ? (uiPosition == "Top Right" ? position.top_left : uiPosition == "Top Left" ? position.top_right : uiPosition == "Bottom Right" ? position.bottom_left : position.bottom_right) : uiAnchor
    table.set_position(uiBoard, uiResolvedAnchor)
    if uiDashboard and v10_showEdge and lp_view != "Limit Planner"
        string edgeValue = e_side == 0 ? "NEUTRAL · B" + str.tostring(e_buyScore, "#") + "/S" + str.tostring(e_sellScore, "#") : e_edgeName + " · " + str.tostring(e_score, "#") + "/100"
        bool uiLocked = e_lockState > 0
        int uiPlanSide = i_active ? i_side : uiLocked ? e_lockSide : 0
        float uiPlanEntry = i_active ? i_entry : uiLocked ? e_lockEntry : na
        float uiPlanStop = i_active ? i_stop : uiLocked ? e_lockStop : na
        float uiPlanTP = i_active ? i_target : uiLocked ? e_lockTP : na
        float uiPlanR = i_active ? i_netR : uiLocked ? e_lockR : na
        string uiPlanStatus = i_active ? i_status : uiLocked ? e_lockStatus : e_state
        string uiPlanPoi = i_active ? i_poiText : uiLocked ? e_lockPoi : e_focusZone
        color stateColor = uiPlanSide == 1 ? uiBull : uiPlanSide == -1 ? uiBear : uiMuted
        f_boardRow(uiBoard, 0, "EBW / 10.4.4 INTRADAY", syminfo.ticker + " · " + f_tfName(timeframe.period), uiAccent)
        f_boardRow(uiBoard, 1, "LATEST SIGNAL", i_hasPlan ? (i_side == 1 ? "BUY" : "SELL") + " · " + str.format_time(i_signalTime, "MM-dd HH:mm", syminfo.timezone) : "—", stateColor)
        f_boardRow(uiBoard, 2, "PLAN STATUS", uiPlanStatus, stateColor)
        f_boardRow(uiBoard, 3, "PLAN POI", uiPlanPoi, uiText)
        f_boardRow(uiBoard, 4, "R / COST", not na(uiPlanR) ? str.tostring(uiPlanR, "#.##") + "R · " + str.tostring(i_costTicks, "#.##") + " ticks" : "Set broker costs in group 00", uiAccent)
        f_boardRow(uiBoard, 5, "ENTRY / REF", f_price(uiPlanEntry), uiAccent)
        f_boardRow(uiBoard, 6, "SL", f_price(uiPlanStop), uiBear)
        f_boardRow(uiBoard, 7, "TP", f_price(uiPlanTP), uiBull)
        if v10_layout != "Mobile"
            f_boardRow(uiBoard, 8, "NEXT SETUP", i_active or uiLocked ? "WAIT · PLAN LOCKED" : e_side != 0 and e_limitOK and not e_touching and not na(e_entry) ? (e_side == 1 ? "BUY LIMIT " : "SELL LIMIT ") + f_price(e_entry) + " · " + e_state : edgeValue + " · " + e_state, e_edgeColor)
            f_boardRow(uiBoard, 9, "PROTECTION", uiLocked ? "FROZEN · SWEEP-PROTECTED · SL " + f_price(e_lockStop) : e_anchorText + (na(e_risk) ? "" : " · SWEEP BUFFER · SL " + f_price(e_invalid)), e_anchorOK ? uiAccent : uiMuted)


        if v10_showDiagnostics
            f_boardRow(uiBoard, 10, "EDGE B / S", str.tostring(e_buyScore, "#") + " / " + str.tostring(e_sellScore, "#") + " · Δ" + str.tostring(e_scoreGap, "#") + " · " + f_e_confirmSimple(e_side) + " " + f_tfName(i_biasTf), uiText)
            f_boardRow(uiBoard, 11, "DEMAND", f_price(zoneSupport) + (na(zoneSupportScore) ? "" : " · Q" + str.tostring(zoneSupportScore, "#")), uiBull)
            f_boardRow(uiBoard, 12, "SUPPLY", f_price(zoneResistance) + (na(zoneResistanceScore) ? "" : " · Q" + str.tostring(zoneResistanceScore, "#")), uiBear)
            f_boardRow(uiBoard, 13, "EDGE COMPONENTS", "B " + str.tostring(e_buyStructure + e_buyTrend + f_e_phasePoints(1), "#") + "/" + str.tostring(e_buyZone, "#") + "/" + str.tostring(e_buyRoom + e_buyLiquidity + e_buyLocation, "#") + " · S " + str.tostring(e_sellStructure + e_sellTrend + f_e_phasePoints(-1), "#") + "/" + str.tostring(e_sellZone, "#") + "/" + str.tostring(e_sellRoom + e_sellLiquidity + e_sellLocation, "#"), uiMuted)
            f_boardRow(uiBoard, 14, "MAP", z_effectiveVisualMode + " · " + str.tostring(zoneActiveCount) + " records", uiMuted)
            f_boardRow(uiBoard, 15, "MAP IDEA R (GROSS)", na(e_planR) ? "—" : str.tostring(e_planR, "#.##") + "R · min " + str.tostring(v10_minPlanR, "#.##") + "R", e_rrOK ? uiBull : uiMuted)
            f_boardRow(uiBoard, 16, "DATA", not x_chartOK ? "Standard candles required" : not x_sourceReady ? "SOURCE WARMUP / UNAVAILABLE" : not x_maReady ? "MA WARMUP" : (barstate.isconfirmed ? "CHART CLOSED" : "WAIT CHART CLOSE") + (sigUsesLowerSampling ? " · LTF SAMPLE" : ""), uiMuted)
            f_boardRow(uiBoard, 17, "HISTORY", str.tostring(bar_index - ebw_firstBar + 1) + " chart bars since " + str.format_time(ebw_firstTime, "yyyy-MM-dd", syminfo.timezone) + (bar_index - ebw_firstBar < z_maxAge ? " · PARTIAL COVERAGE" : " · configured age covered"), uiMuted)
// END EBW V10.4.4


// Standard chart-timeframe oscillators, independent of EBW entry/exit logic.
// Stochastic is shifted UP by 100 for display only: 120/150/180 mean 20/50/80.
// Raw 0..100 values are provided separately in the Data Window.
float combo_rawK = ta.stoch(close, high, low, combo_kLength)
float combo_k = ta.sma(combo_rawK, combo_kSmooth)
float combo_d = ta.sma(combo_k, combo_dLength)
float combo_rsi = ta.rsi(close, combo_rsiLength)

hline(200, "Stochastic top (100)", color=#B6B8BF, linestyle=hline.style_solid, linewidth=2)
hline(180, "Stochastic overbought (80)", color=#B58B2A, linestyle=hline.style_solid)
hline(150, "Stochastic midpoint (50)", color=#806622, linestyle=hline.style_dotted)
hline(120, "Stochastic oversold (20)", color=#B58B2A, linestyle=hline.style_solid)
hline(100, "Divider: Stochastic above / RSI below", color=#B6B8BF, linestyle=hline.style_solid, linewidth=2)
hline(70, "RSI overbought (70)", color=#B58B2A, linestyle=hline.style_dotted)
hline(50, "RSI midpoint (50)", color=color.new(#B58B2A, 65), linestyle=hline.style_dotted)
hline(30, "RSI oversold (30)", color=#B58B2A, linestyle=hline.style_dotted)
hline(0, "RSI bottom (0)", color=#B6B8BF, linestyle=hline.style_solid, linewidth=2)
plot(combo_showStoch ? combo_k + 100.0 : na, "Stochastic K (display +100)", color=combo_kColor, linewidth=2, display=display.pane)
plot(combo_showStoch ? combo_d + 100.0 : na, "Stochastic D (display +100)", color=combo_dColor, linewidth=1, display=display.pane)
plot(combo_showRSI ? combo_rsi : na, "RSI", color=combo_rsiColor, linewidth=2, display=display.pane)
plot(combo_k, "Stochastic K (actual 0-100)", display=display.data_window, precision=2)
plot(combo_d, "Stochastic D (actual 0-100)", display=display.data_window, precision=2)
plot(combo_rsi, "RSI (actual 0-100)", display=display.data_window, precision=2)
// END COMBINED INDICATOR

// BEGIN ZONE BRIDGE EXPORT
// Transport validation, NOT encryption. Includes bar time, slot, bounds and score.
// Keep this function byte-identical in sender and receiver. Prices are NOT packed.
f_zb_check(int slot, float lower, float upper, float score) =>
    float loTicks = math.round(lower / syminfo.mintick) % 10000019
    float hiTicks = math.round(upper / syminfo.mintick) % 10000019
    float digest = (loTicks * 31 + hiTicks * 67 + math.round(score) * 97 + (time % 10000019) * 13) % 999999937
    -(7000000000000.0 + slot * 1000000000.0 + digest)

f_zb_sync() =>
    -(6000000000000.0 + time)

// Only IDs captured by the ORIGINAL map renderer can be exported.
// This is a current-chart watch interface, not a historical/backtest feed.
// No changes to zone detection, entry, SL/TP, original rankings or map drawings.
array<float> zb_lows = array.new_float(4, 0.0)
array<float> zb_highs = array.new_float(4, 0.0)
array<float> zb_scores = array.new_float(4, 0.0)
array<float> zb_ranks = array.new_float(4, -1e20)
bool zb_ready = zb_enabled and zoneEnabled and v10_showMap and z_show
if zb_ready and (barstate.islast or barstate.islastconfirmedhistory) and array.size(zb_visibleIds) > 0 and array.size(z_records) > 0
    for idx = 0 to array.size(z_records) - 1
        z_Record zr = array.get(z_records, idx)
        if array.includes(zb_visibleIds, zr.id)
            float quality = f_z_cachedScore(zr)
            int role = f_z_cachedRole(zr, quality)
            bool properSide = zr.side == 1 ? close >= zr.lo : close <= zr.hi
            bool unbroken = not f_z_broken(zr.lo, zr.hi, zr.side, zr.sourceAtr, close, high, low)
            bool eligible = zr.historyComplete and zr.departed and f_z_isDefendCore(zr) and role != Z_ROLE_LIQUIDITY and properSide and unbroken and not na(zr.knownTime) and zr.knownTime <= time_close and zr.lo < zr.hi
            if eligible
                float gap = zr.side == 1 ? math.max(0.0, close - zr.hi) : math.max(0.0, zr.lo - close)
                float rank = f_z_displayRank(zr, quality, role, gap)
                int first = zr.side == 1 ? 0 : 2
                int dest = -1
                if rank > array.get(zb_ranks, first)
                    array.set(zb_ranks, first + 1, array.get(zb_ranks, first))
                    array.set(zb_lows, first + 1, array.get(zb_lows, first))
                    array.set(zb_highs, first + 1, array.get(zb_highs, first))
                    array.set(zb_scores, first + 1, array.get(zb_scores, first))
                    dest := first
                else if rank > array.get(zb_ranks, first + 1)
                    dest := first + 1
                if dest >= 0
                    array.set(zb_ranks, dest, rank)
                    array.set(zb_lows, dest, zr.lo)
                    array.set(zb_highs, dest, zr.hi)
                    array.set(zb_scores, dest, math.round(quality))

plot(zb_ready ? f_zb_sync() : 0.0, "ZB 00 SYNC", display=display.none, editable=false)
// END ZONE BRIDGE EXPORT
plot(array.get(zb_lows, 0), "ZB 01 D1 LOW", display=display.none, editable=false)
plot(array.get(zb_highs, 0), "ZB 02 D1 HIGH", display=display.none, editable=false)
plot(array.get(zb_scores, 0), "ZB 03 D1 SCORE", display=display.none, editable=false)
plot(f_zb_check(0, array.get(zb_lows, 0), array.get(zb_highs, 0), array.get(zb_scores, 0)), "ZB 04 D1 CHECK", display=display.none, editable=false)
plot(array.get(zb_lows, 1), "ZB 05 D2 LOW", display=display.none, editable=false)
plot(array.get(zb_highs, 1), "ZB 06 D2 HIGH", display=display.none, editable=false)
plot(array.get(zb_scores, 1), "ZB 07 D2 SCORE", display=display.none, editable=false)
plot(f_zb_check(1, array.get(zb_lows, 1), array.get(zb_highs, 1), array.get(zb_scores, 1)), "ZB 08 D2 CHECK", display=display.none, editable=false)
plot(array.get(zb_lows, 2), "ZB 09 S1 LOW", display=display.none, editable=false)
plot(array.get(zb_highs, 2), "ZB 10 S1 HIGH", display=display.none, editable=false)
plot(array.get(zb_scores, 2), "ZB 11 S1 SCORE", display=display.none, editable=false)
plot(f_zb_check(2, array.get(zb_lows, 2), array.get(zb_highs, 2), array.get(zb_scores, 2)), "ZB 12 S1 CHECK", display=display.none, editable=false)
plot(array.get(zb_lows, 3), "ZB 13 S2 LOW", display=display.none, editable=false)
plot(array.get(zb_highs, 3), "ZB 14 S2 HIGH", display=display.none, editable=false)
plot(array.get(zb_scores, 3), "ZB 15 S2 SCORE", display=display.none, editable=false)
plot(f_zb_check(3, array.get(zb_lows, 3), array.get(zb_highs, 3), array.get(zb_scores, 3)), "ZB 16 S2 CHECK", display=display.none, editable=false)
