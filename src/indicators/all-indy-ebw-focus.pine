//@version=6
// EBW Focus · All-Indy-1.4.20 → All-Indy-1.4.33 Basic
indicator("All Indy 1.4.33 · Basic · EBW Focus", "ALL INDY · EBW", overlay=false, calc_bars_count=1200, max_boxes_count=8, dynamic_requests=true)

string boxText = input.string("ตัวย่อ", "ข้อความบนกล่อง", options=["ไม่แสดง", "ตัวย่อ", "เต็ม"], tooltip="ตัวย่อ: D = Demand, S = Supply, SB = STRUCT BUY, SS = STRUCT SELL")
bool showBoxText = boxText != "ไม่แสดง"
bool shortBoxText = boxText == "ตัวย่อ"
bool showSD = input.bool(true, "Supply / Demand")
bool showStruct = input.bool(true, "STRUCT ฟ้า / ม่วง")
bool showParent = input.bool(true, "กล่อง TF ใหญ่ถัดไป")
bool keepTested = input.bool(true, "แสดงหลังแตะครั้งแรก")
bool showStoch = input.bool(true, "แสดง Stochastic")
bool showRSI = input.bool(true, "แสดง RSI")

// Two slots per family: latest valid demand and supply for this source.
type Zone
    float lo = na
    float hi = na
    int origin = na
    int born = 0
    int tests = 0
    bool touching = false
    float buffer = na

method update(Zone z, int side, float bottom, float top, int origin, float atr) =>
    if not na(z.lo)
        bool broken = side == 1 ? close < z.lo - z.buffer : close > z.hi + z.buffer
        bool touched = low <= z.hi and high >= z.lo
        if touched and not z.touching
            z.tests += 1
        z.touching := touched
        if broken or z.tests > (keepTested ? 1 : 0) or bar_index - z.born > 240
            z.lo := na
    if not na(bottom) and not na(top) and top > bottom
        z.lo := bottom
        z.hi := top
        z.origin := origin
        z.born := bar_index
        z.tests := 0
        z.touching := false
        z.buffer := atr * 0.12
    true

f_zones(simple int lag) =>
    float atr = ta.atr(14)
    float body = close - open
    float baseBody = math.abs(close[1] - open[1])
    bool up = body >= atr * 0.8
    bool down = body <= -atr * 0.8
    bool base = high[1] - low[1] <= atr[1] * 1.25
    bool demand = showSD and base and baseBody <= atr[1] * 0.5 and up and close > high[1]
    bool supply = showSD and base and baseBody <= atr[1] * 0.5 and down and close < low[1]
    var Zone demandZone = Zone.new()
    var Zone supplyZone = Zone.new()
    demandZone.update(1, demand ? low[1] : na, math.max(open[1], close[1]), time[1], atr)
    supplyZone.update(-1, supply ? math.min(open[1], close[1]) : na, high[1], time[1], atr)
    float dl = demandZone.lo
    float dh = demandZone.hi
    int dt = demandZone.origin
    float sl = supplyZone.lo
    float sh = supplyZone.hi
    int st = supplyZone.origin
    bool demandTested = demandZone.tests > 0
    bool supplyTested = supplyZone.tests > 0
    [dl[lag], dh[lag], dt[lag], demandTested[lag], sl[lag], sh[lag], st[lag], supplyTested[lag]]

f_higher(simple int seconds) =>
    seconds < 300 ? "5" : seconds < 900 ? "15" : seconds < 3600 ? "60" : seconds < 14400 ? "240" : seconds < 86400 ? "1D" : seconds < 604800 ? "1W" : "1M"

f_caption(string tf) =>
    int seconds = timeframe.in_seconds(tf)
    seconds < 60 ? str.tostring(seconds) + "s" : seconds < 3600 ? str.tostring(seconds / 60) + "m" : seconds < 86400 ? str.tostring(seconds / 3600) + "H" : tf

var array<box> boxes = array.new<box>(8)
// Candidates are collected only for the most recent map. Kind +/-1 is
// demand/supply, +/-2 is STRUCT buy/sell. Each group keeps its common core.
type VisibleBand
    float lo
    float hi
    int origin
    int right
    int kind
    string tf
    bool tested
    int emphasis
    string names = ""
    string members = ""

var array<VisibleBand> candidates = array.new<VisibleBand>()

f_offer(float lo, float hi, int origin, int right, int kind, string tf, bool tested, int emphasis = 1) =>
    if not na(origin) and hi > lo
        candidates.push(VisibleBand.new(lo, hi, origin, right, kind, tf, tested, emphasis))
    true

f_shared(float aLo, float aHi, float bLo, float bHi) =>
    math.round((math.min(aHi, bHi) - math.max(aLo, bLo)) / syminfo.mintick)

f_draw(int slot, float lo, float hi, int origin, int right, string caption, color tint, bool tested = false, int emphasis = 1) =>
    box item = boxes.get(slot)
    if not na(lo) and not na(hi) and not na(origin)
        int borderFade = emphasis == 2 ? 0 : emphasis == 1 ? 24 : 55
        int fillFade = emphasis == 2 ? 87 : emphasis == 1 ? 93 : 97
        float borderTransparency = math.min(85, borderFade + (tested ? 15 : 0))
        color border = color.new(tint, borderTransparency)
        color interior = color.new(tint, math.min(99, fillFade + (tested ? 3 : 0)))
        string pattern = tested ? line.style_dashed : line.style_solid
        if na(item)
            item := box.new(origin, hi, right, lo, xloc=xloc.bar_time, text_size=size.tiny, text_halign=text.align_right, force_overlay=true)
            boxes.set(slot,item)
        box.set_lefttop(item, origin, hi)
        box.set_rightbottom(item, right, lo)
        box.set_bgcolor(item, interior)
        box.set_border_color(item, border)
        box.set_border_width(item, emphasis == 2 ? 2 : 1)
        box.set_border_style(item, pattern)
        if showBoxText
            box.set_text(item, caption)
            box.set_text_color(item, color.new(tint, emphasis == 0 ? 28 : 0))
    else if not na(item)
        box.set_lefttop(item, na, na)
        box.set_rightbottom(item, na, na)
    true

simple int seconds = timeframe.isticks ? na : timeframe.in_seconds()
simple string parent = na(seconds) ? "1D" : f_higher(seconds)
simple int parentSeconds = timeframe.in_seconds(parent)
bool zonesOK = chart.is_standard and not na(seconds)
bool chartZonesOK = zonesOK and seconds >= 300
bool parentOK = zonesOK and showParent and parentSeconds > seconds
int stepMs = int(nz(time_close - time, seconds * 1000))
bool drawNow = barstate.islast or barstate.islastconfirmedhistory
if drawNow
    candidates.clear()

bool book_filter = input.bool(false, "STRUCT · แสดงเฉพาะชุดที่กวาด IDM แล้ว", tooltip="เปิด: แสดงเฉพาะโซนที่ระบุ IDM ใกล้ FVG แล้วราคากลับมากวาดในแท่งถัดไป; ปิด: แสดงชุดรอ IDM ด้วย โดยไม่ติดป้าย VALID ก่อนครบลำดับ", display=display.none)
bool book_confirmSequence = true // Mandatory ordered structure; not an optional display setting.
bool book_context = input.bool(true, "ใช้สวิง TF ใหญ่ประเมินบริบท STRUCT", tooltip="ทดลอง: ใช้ pivot ที่ยืนยันแล้วของ TF ใหญ่ที่ใกล้ที่สุดเป็นบริบท การสวนเทรนด์ยังแสดงได้; ไม่มีคะแนนความน่าจะเป็น", display=display.none)
string book_qualityMode = "Balanced" // fixed internal setting
float book_pbMin = 0.12 // fixed internal setting
float book_pbMax = 0.90 // fixed internal setting
float book_pbNearATR = 2.0 // fixed internal setting
int book_maxTests = 1 // fixed internal setting
float book_breakATR = 0.12 // fixed internal setting
float book_defendATR = 0.5 // fixed internal setting
int book_maxAge = 240 // fixed internal setting
bool book_keepTested = keepTested
int z_swingLen = 5

type nz_Packet
    int stamp = na
    float barLow = na
    float barHigh = na
    float barClose = na
    int direction = 0
    float eventLo = na
    float eventHi = na
    int trend = 0
    int proof = 0
    float pbRatio = na
    float atrValue = na
    bool pbNear = false
    float departureATR = na
    int origin = na
    int pbStart = na
    int pbEnd = na
    int mssTime = na
    bool firstAfterMss = false
    bool counterSwing = false
    int mainDir = 0
    float mainLo = na
    float mainHi = na
    int mainStart = na
    int mainEpoch = na
    int mainLeg = na
    float smallLow = na
    float smallHigh = na
    int smallLowTime = na
    int smallHighTime = na
    float fvgLo = na
    float fvgHi = na


f_nz_event(simple int lag) =>
    float srcAtr = ta.atr(14)
    float pivotH = ta.pivothigh(high, z_swingLen, z_swingLen)
    float pivotL = ta.pivotlow(low, z_swingLen, z_swingLen)
    float smallPivotL = ta.pivotlow(low, 2, 2)
    float smallPivotH = ta.pivothigh(high, 2, 2)
    var float internalL = na
    var float internalH = na
    var int internalLTime = na
    var int internalHTime = na
    if not na(internalL) and low < internalL
        internalL := na
    if not na(internalH) and high > internalH
        internalH := na
    if not na(smallPivotL)
        internalL := smallPivotL
        internalLTime := time[2]
    if not na(smallPivotH)
        internalH := smallPivotH
        internalHTime := time[2]
    var float pendingH = na
    var float pendingL = na
    var float bookHigh = na
    var float bookPrevHigh = na
    var float bookLow = na
    var float bookPrevLow = na
    var int bookPrevHighTime = na
    var int bookPrevLowTime = na
    var int bookHighTime = na
    var int bookLowTime = na
    if not na(pivotH)
        bookPrevHighTime := bookHighTime
        bookPrevHigh := bookHigh
        bookHigh := pivotH
        bookHighTime := time[z_swingLen]
    if not na(pivotL)
        bookPrevLowTime := bookLowTime
        bookPrevLow := bookLow
        bookLow := pivotL
        bookLowTime := time[z_swingLen]
    int bookTrend = not na(bookPrevHigh) and not na(bookPrevLow) ? bookHigh > bookPrevHigh and bookLow > bookPrevLow ? 1 : bookHigh < bookPrevHigh and bookLow < bookPrevLow ? -1 : 0 : 0
    // Newly confirmed pivots belong to the same structure used below.
    if not na(pivotH)
        pendingH := pivotH
    if not na(pivotL)
        pendingL := pivotL
    bool upBreak = not na(pendingH) and close > pendingH
    bool downBreak = not na(pendingL) and close < pendingL
    int side = upBreak and close > open ? 1 : downBreak and close < open ? -1 : 0
    float eventLo = na
    float eventHi = na
    int bookProof = 0
    float pbRatio = na
    bool chosenPbNear = false
    int originTime = na
    float sourceFvgLo = na
    float sourceFvgHi = na
    float chosenDepartureATR = na
    bool pbSequence = side == 1 ? not na(bookPrevLowTime) and not na(bookHighTime) and not na(bookLowTime) and bookPrevLowTime < bookHighTime and bookHighTime < bookLowTime : side == -1 ? not na(bookPrevHighTime) and not na(bookLowTime) and not na(bookHighTime) and bookPrevHighTime < bookLowTime and bookLowTime < bookHighTime : false
    if side == 1 and pbSequence and not na(bookPrevLow) and bookHigh > bookPrevLow
        pbRatio := (bookHigh - bookLow) / (bookHigh - bookPrevLow)
    if side == -1 and pbSequence and not na(bookPrevHigh) and bookPrevHigh > bookLow
        pbRatio := (bookHigh - bookLow) / (bookPrevHigh - bookLow)
    bool sequenceOK = pbSequence and (side == 1 ? not na(bookPrevLow) and bookLow > bookPrevLow and close > bookHigh : side == -1 ? not na(bookPrevHigh) and bookHigh < bookPrevHigh and close < bookLow : false)
    // Crossing before the PB pivot confirms must not discard the setup.
    // Evaluate again using current confirmed facts; never backdate availability.
    // Once the ordered break exists, consume it once, even if candle filters fail.
    if sequenceOK
        if side == 1
            pendingH := na
        else if side == -1
            pendingL := na
    bool pbInRange = not na(pbRatio) and pbRatio >= book_pbMin and pbRatio <= book_pbMax
    float impulseBodyMin = book_qualityMode == "Strict" ? 0.45 : book_qualityMode == "Balanced" ? 0.35 : 0.30
    float departMin = book_qualityMode == "Strict" ? 0.85 : book_qualityMode == "Balanced" ? 0.65 : 0.50
    float baseMax = book_qualityMode == "Strict" ? 1.35 : book_qualityMode == "Balanced" ? 1.75 : 2.0
    // Protected source structure, distinct from the latest two pivot directions.
    // Bootstrap is not an MSS. A close through the protected boundary reverses
    // the regime; its first *subsequent* ordered PB/BOS consumes FIRST once,
    // even if no drawable origin passes the candle filters on that break.
    var int mainDir = 0
    var float mainLo = na
    var float mainHi = na
    var int mainLowTime = na
    var int mainHighTime = na
    var int mainStart = na
    var int mainEpoch = na
    var int mainLeg = na
    var int mssTime = na
    var bool awaitingFirst = false
    bool reversal = mainDir == 1 ? close < mainLo : mainDir == -1 ? close > mainHi : false
    if reversal
        mainDir := -mainDir
        mainEpoch := time_close
        mssTime := time
        mainStart := mainDir == 1 ? mainLowTime : mainHighTime
        mainLeg := time_close
        if low < mainLo
            mainLowTime := time
        if high > mainHi
            mainHighTime := time
        mainLo := math.min(mainLo, low)
        mainHi := math.max(mainHi, high)
        awaitingFirst := true
    if mainDir == 0 and sequenceOK
        mainDir := side
        mainEpoch := time_close
        mainStart := side == 1 ? bookLowTime : bookHighTime
        mainLeg := time_close
        mainLo := side == 1 ? bookLow : low
        mainHi := side == 1 ? high : bookHigh
        mainLowTime := side == 1 ? bookLowTime : time
        mainHighTime := side == 1 ? time : bookHighTime
    bool afterMssWave = not awaitingFirst or (side == 1 ? bookHighTime >= mssTime and bookLowTime > bookHighTime : side == -1 ? bookLowTime >= mssTime and bookHighTime > bookLowTime : false)
    // A valid internal counter-swing is not an external MSS. Keep it explicitly
    // classified instead of silently suppressing every counter-trend origin.
    bool counterSwing = sequenceOK and side != mainDir
    bool mainContinuation = not reversal and sequenceOK and side == mainDir and afterMssWave
    bool structureOK = not reversal and sequenceOK and (counterSwing or afterMssWave)
    bool firstAfterMss = mainContinuation and awaitingFirst
    if mainContinuation
        awaitingFirst := false
        mainStart := side == 1 ? bookLowTime : bookHighTime
        mainLeg := time_close
        mainLo := side == 1 ? bookLow : low
        mainHi := side == 1 ? high : bookHigh
        mainLowTime := side == 1 ? bookLowTime : time
        mainHighTime := side == 1 ? time : bookHighTime
    if mainDir == 1
        if high > mainHi
            mainHighTime := time
        mainHi := math.max(mainHi, high)
    else if mainDir == -1
        if low < mainLo
            mainLowTime := time
        mainLo := math.min(mainLo, low)

    if side != 0 and structureOK and (not book_confirmSequence or sequenceOK) and not na(srcAtr[1]) and srcAtr[1] > 0 and math.abs(close - open) >= srcAtr[1] * impulseBodyMin
        int chosen = na
        float bestRank = -1e20
        float pbAnchor = side == 1 ? bookLow : bookHigh
        int pbStartTime = side == 1 ? bookHighTime : bookLowTime
        int pbEndTime = side == 1 ? bookLowTime : bookHighTime
        for k = 1 to 64
            if book_confirmSequence and not na(pbStartTime) and (na(time[k]) or time[k] < pbStartTime)
                break
            bool originInPullback = pbSequence and time[k] >= pbStartTime and time[k] <= pbEndTime
            bool opposite = not na(open[k]) and (side == 1 ? close[k] < open[k] : close[k] > open[k])
            if opposite and (not book_confirmSequence or originInPullback) and not na(high[k]) and not na(low[k])
                float candidateLo = low[k]
                float candidateHi = high[k]
                float widthAtr = (candidateHi - candidateLo) / srcAtr[1]
                float departAtr = (side == 1 ? close - candidateHi : candidateLo - close) / srcAtr[1]
                bool valid = candidateHi > candidateLo and widthAtr <= baseMax and departAtr >= departMin
                bool departed = false
                if valid
                    for t = k - 1 to 0
                        if na(low[t]) or na(high[t]) or na(close[t])
                            valid := false
                            break
                        else if departed and (side == 1 ? low[t] <= candidateHi : high[t] >= candidateLo)
                            valid := false
                            break
                        else if not departed and (side == 1 ? close[t] > candidateHi : close[t] < candidateLo)
                            departed := true
                float pivotDist = not na(pbAnchor) ? math.abs((side == 1 ? candidateLo : candidateHi) - pbAnchor) / srcAtr[1] : na
                bool pbNear = pbSequence and not na(pivotDist) and pivotDist <= book_pbNearATR
                bool strictOK = book_qualityMode != "Strict" or (pbInRange and pbNear)
                if valid and departed and strictOK
                    // Prefer a base near a confirmed Pullback origin. Favor compact bases;
                    // small recency term breaks ties. Legacy retains closest opposite candle.
                    float rank = book_qualityMode == "Legacy" ? 100.0 - k : (pbNear ? 4.0 : 0.0) + (not na(pivotDist) ? math.max(0.0, 2.5 - pivotDist) : 0.0) + math.min(2.0, departAtr) - widthAtr * 0.65 - k * 0.03 + (pbInRange ? 1.0 : 0.0)
                    if na(chosen) or rank > bestRank
                        chosen := k
                        bestRank := rank
        if not na(chosen)
            originTime := time[chosen]
            eventLo := low[chosen]
            eventHi := high[chosen]
            chosenPbNear := pbSequence and not na(pbAnchor) and math.abs((side == 1 ? eventLo : eventHi) - pbAnchor) / srcAtr[1] <= book_pbNearATR
            chosenDepartureATR := (side == 1 ? close - eventHi : eventLo - close) / srcAtr[1]
            bool nearbyFvg = false
            // FVG must occur in the actual origin->break path, not just the final 3 bars.
            if chosen >= 2
                for t = 0 to chosen - 2
                    bool exists = side == 1 ? low[t] > high[t + 2] : high[t] < low[t + 2]
                    if exists
                        float gapLo = side == 1 ? high[t + 2] : high[t]
                        float gapHi = side == 1 ? low[t] : low[t + 2]
                        float gapDist = math.max(0.0, math.max(eventLo, gapLo) - math.min(eventHi, gapHi))
                        if gapDist <= srcAtr[1]
                            sourceFvgLo := gapLo
                            sourceFvgHi := gapHi
                            nearbyFvg := true
                            break
            // Sweep is a later lifecycle event of an identified IDM, never an eight-bar proxy.
            bookProof := nearbyFvg ? 1 : 0
            if book_qualityMode == "Strict" and bookProof == 0
                eventLo := na
                eventHi := na
    float outputLow = low
    float outputHigh = high
    float outputClose = close
    int outputPbStart = side == 1 ? bookHighTime : bookLowTime
    int outputPbEnd = side == 1 ? bookLowTime : bookHighTime
    // Offset every payload field explicitly, including metadata and phase state.
    nz_Packet.new(stamp=time_close[lag], barLow=outputLow[lag], barHigh=outputHigh[lag], barClose=outputClose[lag], direction=side[lag], eventLo=eventLo[lag], eventHi=eventHi[lag], trend=bookTrend[lag], proof=bookProof[lag], pbRatio=pbRatio[lag], pbNear=chosenPbNear[lag], departureATR=chosenDepartureATR[lag], origin=originTime[lag], pbStart=outputPbStart[lag], pbEnd=outputPbEnd[lag], mssTime=mssTime[lag], firstAfterMss=firstAfterMss[lag], mainDir=mainDir[lag], mainLo=mainLo[lag], mainHi=mainHi[lag], mainStart=mainStart[lag], mainEpoch=mainEpoch[lag], mainLeg=mainLeg[lag], smallLow=internalL[lag], smallHigh=internalH[lag], smallLowTime=internalLTime[lag], smallHighTime=internalHTime[lag], fvgLo=sourceFvgLo[lag], fvgHi=sourceFvgHi[lag], counterSwing=counterSwing[lag], atrValue=srcAtr[lag + 1])

type nz_Zone
    varip float lo
    varip float hi
    varip int side
    varip int knownTime
    varip string tf
    varip int tfSec
    varip int bookProof
    varip float pbRatio
    varip float sourceAtr
    varip bool originNear
    varip float departureATR
    varip int tests
    varip bool touching
    varip int lastChecked
    varip int sourceAge
    varip float testDepth
    varip int testClose
    varip bool defended
    varip int origin = na
    varip int pbStart = na
    varip int pbEnd = na
    varip int mssTime = na
    varip bool firstAfterMss = false
    varip bool counterSwing = false
    varip float fvgLo = na
    varip float fvgHi = na
    varip float idmLevel = na
    varip int idmKnownTime = 0
    varip int idmSweepTime = 0
    varip bool parentChecked = false
    varip bool parentBound = false
    varip string parentTf = ""
    varip int parentDir = 0
    varip int parentEpoch = na
    varip int parentLeg = na
    varip int parentStamp = na
    varip float parentLo = na
    varip float parentHi = na

varip array<nz_Zone> chartZones = array.new<nz_Zone>()
varip array<nz_Zone> parentZones = array.new<nz_Zone>()
varip int chartSeen = 0
varip int parentSeen = 0
varip int parentEpoch = na

f_nz_bind(nz_Zone zone, nz_Packet context) =>
    // At creation the latest admitted higher close was already known. This
    // single-parent edition needs no per-bar archive or later rebinding.
    if not na(context) and context.stamp <= zone.knownTime
        zone.parentEpoch := context.mainEpoch
        zone.parentDir := context.mainDir
        zone.parentBound := context.mainDir != 0 and not na(context.mainStart) and zone.origin >= context.mainStart and zone.origin <= zone.knownTime and zone.lo >= context.mainLo and zone.hi <= context.mainHi
    true

f_nz_parentTrend(nz_Zone zone, int epoch) =>
    book_context and zone.parentBound and not na(epoch) and epoch == zone.parentEpoch ? zone.parentDir : 0

// The small confirmed pivot is a named IDM candidate only when it lies between
// zone and departed price and is close to this zone's actual displacement FVG.
// It becomes usable at this source close; an earlier touch cannot count as a sweep.
f_nz_identifyIdm(nz_Zone zone, nz_Packet packet) =>
    int pivotTime = zone.side == 1 ? packet.smallLowTime : packet.smallHighTime
    if na(zone.idmLevel) and zone.tests == 0 and not na(zone.fvgLo) and pivotTime > zone.origin
        float level = zone.side == 1 ? packet.smallLow : packet.smallHigh
        float atr = zone.sourceAtr
        float separation = zone.side == 1 ? level - zone.hi : zone.lo - level
        float fvgDistance = math.max(0.0, math.max(zone.fvgLo - level, level - zone.fvgHi))
        bool departed = zone.side == 1 ? packet.barClose > level : packet.barClose < level
        if not na(level) and atr > 0 and separation > 0 and separation <= atr * 2.0 and fvgDistance <= atr and departed
            zone.idmLevel := level
            zone.idmKnownTime := packet.stamp
    true

f_nz_monitor(nz_Zone zone, nz_Packet packet) =>
    bool retire = false
    if packet.stamp > zone.lastChecked and not na(packet.barLow) and not na(packet.barHigh) and not na(packet.barClose)
        float atr = math.max(nz(zone.sourceAtr, zone.hi - zone.lo), syminfo.mintick)
        bool invalid = zone.side == 1 ? packet.barClose < zone.lo - atr * book_breakATR : packet.barClose > zone.hi + atr * book_breakATR
        bool hit = packet.barLow <= zone.hi and packet.barHigh >= zone.lo
        if zone.idmKnownTime > 0 and packet.stamp > zone.idmKnownTime and zone.idmSweepTime == 0
            bool crossed = zone.side == 1 ? packet.barLow < zone.idmLevel and packet.barHigh >= zone.idmLevel : packet.barHigh > zone.idmLevel and packet.barLow <= zone.idmLevel
            if crossed
                zone.idmSweepTime := packet.stamp
                zone.bookProof := zone.bookProof % 2 + 2
        if hit
            float depth = math.max(0.0, math.min(100.0, (zone.side == 1 ? zone.hi - packet.barLow : packet.barHigh - zone.lo) * 100.0 / math.max(zone.hi - zone.lo, syminfo.mintick)))
            zone.testDepth := not zone.touching or na(zone.testDepth) ? depth : math.max(zone.testDepth, depth)
            zone.testClose := zone.side == 1 ? (packet.barClose > zone.hi ? 1 : packet.barClose < zone.lo ? -1 : 0) : (packet.barClose < zone.lo ? 1 : packet.barClose > zone.hi ? -1 : 0)
            if not zone.touching
                zone.tests += 1
                zone.defended := false
        if zone.tests > 0
            zone.defended := zone.defended or (zone.side == 1 ? packet.barClose >= zone.hi + atr * book_defendATR : packet.barClose <= zone.lo - atr * book_defendATR)
        zone.touching := hit
        zone.lastChecked := packet.stamp
        zone.sourceAge += 1
        retire := invalid or zone.tests > book_maxTests or zone.sourceAge > book_maxAge
        if not retire
            f_nz_identifyIdm(zone, packet)
    retire

f_nz_ingest(array<nz_Zone> zones, int seen, string tf, int seconds, nz_Packet packet, nz_Packet context) =>
    int accepted = seen
    if not na(packet) and not na(packet.stamp) and packet.stamp > seen and not na(packet.barLow) and not na(packet.barHigh)
        int index = zones.size() - 1
        while index >= 0
            if f_nz_monitor(zones.get(index), packet)
                zones.remove(index)
            index -= 1
        if packet.direction != 0 and not na(packet.eventLo) and not na(packet.eventHi)
            nz_Zone created = nz_Zone.new(packet.eventLo, packet.eventHi, packet.direction, packet.stamp, tf, seconds, packet.proof, packet.pbRatio, packet.atrValue, packet.pbNear, packet.departureATR, 0, false, packet.stamp, 0, na, 0, false, origin=packet.origin, pbStart=packet.pbStart, pbEnd=packet.pbEnd, mssTime=packet.mssTime, firstAfterMss=packet.firstAfterMss, counterSwing=packet.counterSwing, fvgLo=packet.fvgLo, fvgHi=packet.fvgHi)
            f_nz_identifyIdm(created, packet)
            if book_context
                f_nz_bind(created, context)
            zones.push(created)
            if zones.size() > 12
                zones.shift()
        accepted := packet.stamp
    accepted

// Secondary STRUCT selection is intentionally separate from the Premium S/D engine.
f_book_eligible(nz_Zone zone, int parentTrend) =>
    bool pbOK = not na(zone.pbRatio) and zone.pbRatio >= book_pbMin and zone.pbRatio <= book_pbMax
    bool strictOK = book_qualityMode != "Strict" or (pbOK and zone.bookProof > 0 and (not book_context or parentTrend != -zone.side))
    bool touchOK = zone.tests == 0 or book_keepTested and zone.tests <= book_maxTests
    bool evidenceOK = not book_filter or zone.idmSweepTime > 0
    strictOK and touchOK and evidenceOK

// Audit-oriented evidence score, NOT a win probability. Maximum = 100 points.
// HTF 20; confirmed PB 18; origin near PB pivot 12; FVG 10; sweep 10;
// departure 12; compact source candle 8; Fresh 10.
f_book_focusScore(nz_Zone zone, int parentTrend) =>
    bool pbOK = not na(zone.pbRatio) and zone.pbRatio >= book_pbMin and zone.pbRatio <= book_pbMax
    float widthAtr = (zone.hi - zone.lo) / math.max(nz(zone.sourceAtr, syminfo.mintick), syminfo.mintick)
    float score = 0.0
    score += book_context and parentTrend == zone.side ? 20.0 : 0.0
    score += pbOK ? 18.0 : 0.0
    score += zone.originNear ? 12.0 : 0.0
    score += zone.bookProof % 2 == 1 ? 10.0 : 0.0
    score += zone.bookProof >= 2 ? 10.0 : 0.0
    score += nz(zone.departureATR, 0.0) >= 1.25 ? 12.0 : nz(zone.departureATR, 0.0) >= 0.85 ? 8.0 : nz(zone.departureATR, 0.0) >= 0.65 ? 4.0 : 0.0
    score += widthAtr <= 0.85 ? 8.0 : widthAtr <= 1.30 ? 4.0 : 0.0
    score += zone.tests == 0 ? 10.0 : zone.defended ? 4.0 : 0.0
    score


// One data request for the shared higher timeframe. Disabled modules skip their
// source engine, while the chart still processes 1,200 bars by default.
f_parentData() =>
    nz_Packet packet = showStruct ? f_nz_event(1) : na
    float demandLo = na
    float demandHi = na
    int demandTime = na
    float supplyLo = na
    float supplyHi = na
    int supplyTime = na
    bool demandTested = false
    bool supplyTested = false
    if showSD
        [dl, dh, dt, dTested, sl, sh, st, sTested] = f_zones(1)
        demandLo := dl
        demandHi := dh
        demandTime := dt
        supplyLo := sl
        supplyHi := sh
        supplyTime := st
        demandTested := dTested
        supplyTested := sTested
    [packet, demandLo, demandHi, demandTime, demandTested, supplyLo, supplyHi, supplyTime, supplyTested]

varip nz_Packet parentContext = na
if parentOK and (showSD or showStruct)
    [packet, dl, dh, dt, dTested, sl, sh, st, sTested] = request.security(syminfo.tickerid, parent, f_parentData(), lookahead=barmerge.lookahead_on, calc_bars_count=280)
    if showStruct and barstate.isconfirmed and not na(packet) and packet.stamp <= time
        parentSeen := f_nz_ingest(parentZones, parentSeen, parent, parentSeconds, packet, na)
        if packet.stamp == parentSeen
            parentContext := packet
            parentEpoch := packet.mainEpoch
    if showSD and drawNow
        f_offer(dl, dh, dt, time + stepMs * 10, 1, parent, dTested)
        f_offer(sl, sh, st, time + stepMs * 10, -1, parent, sTested)

if chartZonesOK and showSD
    [dl, dh, dt, dTested, sl, sh, st, sTested] = f_zones(0)
    if drawNow
        f_offer(barstate.isconfirmed ? dl : dl[1], barstate.isconfirmed ? dh : dh[1], barstate.isconfirmed ? dt : dt[1], time + stepMs * 6, 1, timeframe.period, barstate.isconfirmed ? dTested : dTested[1])
        f_offer(barstate.isconfirmed ? sl : sl[1], barstate.isconfirmed ? sh : sh[1], barstate.isconfirmed ? st : st[1], time + stepMs * 6, -1, timeframe.period, barstate.isconfirmed ? sTested : sTested[1])

if zonesOK and showStruct
    if chartZonesOK and barstate.isconfirmed
        nz_Packet chartPacket = f_nz_event(0)
        chartSeen := f_nz_ingest(chartZones, chartSeen, timeframe.period, seconds, chartPacket, parentContext)
    if drawNow
        array<nz_Zone> zones = array.copy(chartZones)
        zones.concat(parentZones)
        array<float> scores = array.new<float>()
        array<int> emphasisByZone = array.new<int>()
        for zone in zones
            int trend = f_nz_parentTrend(zone, parentEpoch)
            float gap = math.max(0.0, math.max(zone.lo - close, close - zone.hi))
            float evidence = f_book_focusScore(zone, trend)
            float score = evidence - math.min(25, gap / math.max(zone.sourceAtr, syminfo.mintick))
            scores.push(f_book_eligible(zone, trend) ? score : na)
            emphasisByZone.push(evidence >= 75 ? 2 : evidence >= 60 ? 1 : 0)
        int shown = 0
        for index in array.sort_indices(scores, order.descending)
            if not na(scores.get(index))
                nz_Zone zone = zones.get(index)
                bool isChart = zone.tfSec == seconds
                f_offer(zone.lo, zone.hi, zone.origin, time + stepMs * (isChart ? 6 : 10), 2 * zone.side, zone.tf, zone.tests > 0, emphasisByZone.get(index))
                shown += 1
                if shown >= 4
                    break
// Display grouping never feeds the source lifecycle or the evidence score.
if drawNow
    array<VisibleBand> groups = array.new<VisibleBand>()
    array<int> periods = array.new_int()
    for item in candidates
        periods.push(timeframe.in_seconds(item.tf))
    for idx in array.sort_indices(periods, order.ascending)
        VisibleBand item = candidates.get(idx)
        VisibleBand match = na
        int best = 0
        for g in groups
            if g.kind == item.kind
                int common = f_shared(g.lo, g.hi, item.lo, item.hi)
                if common > best
                    best := common
                    match := g
        if na(match)
            VisibleBand g = item.copy()
            groups.push(g)
            match := g
        else
            match.lo := math.max(match.lo, item.lo)
            match.hi := math.min(match.hi, item.hi)
            match.origin := math.max(match.origin, item.origin)
            match.right := math.max(match.right, item.right)
            match.tested := match.tested or item.tested
            match.emphasis := math.max(match.emphasis, item.emphasis)
        if showBoxText
            string name = f_caption(item.tf)
            string token = "|" + name + "|"
            if not str.contains(match.members, token)
                match.names := match.names == "" ? name : match.names + "+" + name
                match.members += token
    for [slot, g] in groups
        string caption = ""
        if showBoxText
            string kindName = switch g.kind
                2 => shortBoxText ? "SB" : "STRUCT BUY"
                -2 => shortBoxText ? "SS" : "STRUCT SELL"
                1 => shortBoxText ? "D" : "Demand"
                => shortBoxText ? "S" : "Supply"
            caption := g.names + " · " + kindName
            if math.abs(g.kind) == 2
                for sd in groups
                    if sd.kind * 2 == g.kind
                        int common = f_shared(g.lo, g.hi, sd.lo, sd.hi)
                        int narrower = math.round(math.min(g.hi - g.lo, sd.hi - sd.lo) / syminfo.mintick)
                        if common > 0 and common * 2 >= narrower
                            caption += sd.kind == 1 ? " +D" : " +S"
                            break
        color tint = g.kind == 2 ? #60A5FA : g.kind == -2 ? #C084FC : g.kind == 1 ? #22B8A9 : #E76F70
        f_draw(slot, g.lo, g.hi, g.origin, g.right, caption, tint, g.tested, g.emphasis)
    if groups.size() < boxes.size()
        for slot = groups.size() to boxes.size() - 1
            f_draw(slot, na, na, na, na, "", color.white)

float k = ta.sma(ta.stoch(close,high,low,9),3)
float d = ta.sma(k,3)
float rsi = ta.rsi(close,14)
const color guideStrong = #D4AA58
const color guideQuiet = #545B68
stoTop = hline(200, "Stochastic top (100)", color=color.new(guideQuiet, 15))
stoUpper = hline(180, "Stochastic overbought (80)", color=guideStrong, linestyle=hline.style_solid)
hline(150, "Stochastic midpoint (50)", color=color.new(guideQuiet, 24), linestyle=hline.style_dotted)
stoLower = hline(120, "Stochastic oversold (20)", color=guideStrong, linestyle=hline.style_solid)
divider = hline(100, "Divider: Stochastic above / RSI below", color=#8B95A3, linestyle=hline.style_solid, linewidth=2)
rsiUpper = hline(70, "RSI overbought (70)", color=guideStrong, linestyle=hline.style_solid)
hline(50, "RSI midpoint (50)", color=color.new(guideQuiet, 24), linestyle=hline.style_dotted)
rsiLower = hline(30, "RSI oversold (30)", color=guideStrong, linestyle=hline.style_solid)
rsiBottom = hline(0, "RSI bottom (0)", color=color.new(guideQuiet, 15))
fill(stoTop, stoUpper, color=showStoch ? color.new(#E27E83, 93) : na, title="Stochastic · 80–100")
fill(stoLower, divider, color=showStoch ? color.new(#58BDAA, 93) : na, title="Stochastic · 0–20")
fill(divider, rsiUpper, color=showRSI ? color.new(#E27E83, 95) : na, title="RSI · 70–100")
fill(rsiLower, rsiBottom, color=showRSI ? color.new(#58BDAA, 95) : na, title="RSI · 0–30")
plot(showStoch ? k + 100.0 : na, "Stochastic K (display +100)", color=color.white, linewidth=2, display=display.pane)
plot(showStoch ? d + 100.0 : na, "Stochastic D (display +100)", color=#F07178, linewidth=1, display=display.pane)
plot(showRSI ? rsi : na, "RSI", color=#EEF2F8, linewidth=2, display=display.pane)
